<Project ToolsVersion="4.0" DefaultTargets="Demo" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <UsingTask TaskName="TransformXml"
           AssemblyFile="$(MSBuildExtensionsPath)\v14.0\Web\Microsoft.Web.Publishing.Tasks.dll"/>

  <Target Name="Stage">
    <TransformXml Source="$(WORKSPACE)\Answer.Web\Web.config"
                  Transform="$(WORKSPACE)\Answer.Web\Web.Stage.config"
                  Destination="$(WORKSPACE)\Answer.Web\Web.config"/>
  </Target>
</Project>