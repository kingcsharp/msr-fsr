@using Msr.Models.Roles
@model Msr.Services.Roles.ViewModels.SaveRoleViewModel

@{
    ViewBag.Title = "Update Role or Certification";
    var isCertificateRole = Model.Comments.Length == 0 && Model.TrainingIdRev.Length == 0 && (Model.CertificationRoleList != null ? Model.CertificationRoleList.Any(x => x.StartDate.HasValue) : false);
}
<link rel="stylesheet" type="text/css" href="/assets/css/themes/flat-blue.css">
<link rel="stylesheet" type="text/css" href="/assets/css/ui.jqgrid-bootstrap-ui.css">
<link rel="stylesheet" type="text/css" href="/assets/css/ui.jqgrid.css">
<link rel="stylesheet" type="text/css" href="/assets/css/style.css">
<link rel="stylesheet" type="text/css" href="/assets/css/hopscotch.css">

@Styles.Render("~/bundles/css/fileinput")

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Role @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                @Html.Partial("Message")
                @using (Html.BeginForm("Edit", "Roles", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal addpart">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(x => x.Id)
                        @Html.HiddenFor(x => x.ObjectId)
                        @Html.HiddenFor(x => x.WfId)

                        <div class="form-group">
                            @Html.LabelFor(model => model.ParentRoles, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.TextBoxFor(model => model.ParentRoles, null, new { @class = "form-control", @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => model.ParentRoles, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.SecurityLevel, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.SecurityLevel, Model.SecurityLevels, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.SecurityLevel, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ChildRoles, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ChildRoles, Model.ListChildRoles, new { @class = "form-control select selectchildRoles", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.ChildRoles, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.PeopleAssigned, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.PeopleAssigned, Model.ListPeopleAssigned, new { @class = "form-control select selectassignedpeoples", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.PeopleAssigned, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @if (isCertificateRole)
                        {
                            <div class="form-group">
                                @Html.LabelFor(model => model.TrainingIdRev, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.TextBoxFor(model => model.TrainingIdRev, null, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TrainingIdRev, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.Partial("_FileUpload")
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.Partial("_TextAdder")
                                    @Html.TextAreaFor(model => model.Comments, new { onBlur = "checkMaxSize(this, 4000);;lastTextArea = 'document.editForm.Comments';", name = "Comments", rows = "10", cols = "80", @class = "text-formatter form-control", })
                                </div>
                            </div>
                        }
                        <div class="form-group">
                            @Html.LabelFor(model => model.PeoplePosAssigned, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.TextBoxFor(model => model.PeoplePosAssigned, null, new { @class = "form-control", @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => model.PeoplePosAssigned, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div id="person" class="form-group">
                            @if (Model.CertificationRoleList != null && Model.CertificationRoleList.Count() > 0)
                            {
                                foreach (CertificationRole certRole in Model.CertificationRoleList)
                                {
                                    if (isCertificateRole)
                                    {
                                        @Html.Partial("_PersonDate", certRole);
                                    }
                                }
                            }
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-8">
                                <input type="submit" value="Submit" class="btn btn-success" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @{
        var childRoles = string.Join(",", Model.ChildRoles);
        var selectedPeoples = string.Join(",", Model.PeopleAssigned);
    }

    <script src="~/assets/textformater/ValidateDocumentSubmit.js"></script>
    <script src="~/assets/textformater/textformatter.js"></script>

    @Scripts.Render("~/bundles/js/fileinput")
    @Scripts.Render("~/bundles/js/jqueryval")
    <script type="text/javascript">
        var ary = [];
        var fileUploader = new FileUploader();

        $(document).ready(function (parameters) {
            $('.select').select2();

                fileUploader.InitEditUploader('input-files',
                '@Url.Action("FileUploaderBootstrap", "Doc")',
                [@Html.Raw(ViewBag.Preview)],
                @Html.Raw(ViewBag.PreviewConfig),
                '@Model.ObjectId',
                true);


            var selectRoles = $(".selectchildRoles").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select Role",
                formatNoMatches: function () {
                    return '';
                }
            });
            var valueRoles = '@childRoles';
            var selectRolesList = valueRoles.split(",");
            selectRoles.val(selectRolesList).trigger("change");

            var selectPeoples = $(".selectassignedpeoples").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select People",
                formatNoMatches: function () {
                    return '';
                }
            });

            var valuePeople = '@selectedPeoples';
            var selectedPeoplesList = valuePeople.split(",");
            var currentPeopleList = selectedPeoplesList;

            $(".selectassignedpeoples").val(selectedPeoplesList).trigger("change");

            var IDs = [];
            $("#person>div").each(function (i) {
                IDs[i] = $(this).prop('id');
            });
            var isCertificateRole = '@isCertificateRole';


            $(".selectassignedpeoples").change(function (e) {

                if (isCertificateRole === 'False') {
                    return;
                }
                IDs = [];
                $("#person>div").each(function (i) {
                    IDs[i] = $(this).prop('id');
                });

                /* Logic here does not execute when val() is used */
                if ($(this).val() != null) {
                    currentPeopleList = $(this).val().toString().split(",");
                } else {
                    currentPeopleList = [];
                }

                //currentPeopleList not in the DIVS
                //This would be someone was added to the people list
                for (var i = currentPeopleList.length; i--;) {
                    if (IDs.indexOf(currentPeopleList[i]) === -1) {

                        var roleId = window.location.href.match(/(\d+)$/g);

                        $.ajax({
                            url: '@Url.Action("LoadPersonDate", "Roles")?RoleId=' + roleId + '&userId=' + currentPeopleList[i],
                            type: 'GET',
                            error: function (xhr) {
                                alert('Error: ' + xhr.statusText);
                            },
                            success: function (result) {
                                $('#person').append(result);

                                $('.date-picker').datepicker({
                                    format: 'mm/dd/yyyy',
                                    autoclose: true
                                });
                            }
                        });
                    }
                }

                //Needs to be removed
                //Someone was removed from the people list
                for (var i = IDs.length; i--;) {
                    if (currentPeopleList.indexOf(IDs[i]) === -1) {
                        $('#' + IDs[i]).remove();
                    } else if (currentPeopleList.length == 0) {
                        alert("Remove2");
                        $('#' + IDs[i]).remove();
                    }
                }
            });


            $('.date-picker').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true
            });
        });

        //function SelectIds() {
        //    new FileUploaderGrid().SelectIds();
        //}

        function SelectIds() {
            FileUploaderGrid().SelectIdsForAdd('@Url.Action("FileUploaderBootstrap", "Doc")');
        }
    </script>
}
