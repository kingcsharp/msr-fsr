@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "People";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <i class="fa fa-user-md" aria-hidden="true"></i>
                User Roles @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-role"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row  row-bottom-buttons">
            <a href="~/Roles/Create" class="btn btn-success help-btn">Add</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-roles")

    <script>
        $(document).ready(function () {
            Msr.RoleGrid.LoadRolesTypesGrid('@Url.Action("UserRolesData", "Roles")');
        });
    </script>

}
