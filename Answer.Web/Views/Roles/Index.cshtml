@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "User Roles";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-group"></span>
                User Roles @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/Roles/Create" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-roles")

    <script>
        $.jgrid.defaults.styleUI = 'Bootstrap';

        $(document).ready(function () {
            LoadRolesTypesGrid('@Url.Action("UserRolesData", "Roles")','@Request.Url.OriginalString');
        });
    </script>

}
