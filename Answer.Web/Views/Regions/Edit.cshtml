@model Msr.Services.Regions.ViewModels.SaveRegionViewModel
@{
    ViewBag.Title = "Update Region";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Region @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        @Html.Partial("Message")
                        @using (Html.BeginForm("Edit", "Regions", FormMethod.Post, new { @class = "form form-horizontal" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ObjectId)

                            <div class="form-group">
                                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-lg-offset-2 col-lg-8">
                                    <input type="submit" value="Submit" class="btn btn-success" />
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                                </div>
                            </div>

                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
}