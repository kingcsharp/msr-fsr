@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Regions";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-globe"></span>
                Regions @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGridRegions"></table>
                <div id="jqGridPagerRegions"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/Regions/Create" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")

    <script type="text/javascript" src="~/assets/js/grids/regions.js"></script>

    <script type="text/javascript">

        $(document).ready(function() {

            SetUpRegionGrid('@Request.Url.OriginalString');

        });
    </script>

}
