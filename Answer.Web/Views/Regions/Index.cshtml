@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Locations";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-globe"></span>
                Regions @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-regions"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/Regions/Create" class="btn btn-success help-btn">Add</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-regions")

    <script type="text/javascript">
        $(document).ready(function() {
            Msr.RegionGrid.SetUpRegionGrid('@Url.Action("RegionsData", "Regions")');
        });
    </script>

}
