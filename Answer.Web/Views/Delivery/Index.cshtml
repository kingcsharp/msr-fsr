@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Parts Recieved by Customer";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-truck"></span>
                Parts Recieved by Customer <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")

    <script src="~/assets/js/grids/delivery.js"></script>
    <script>
        //$.jgrid.defaults.responsive = true;
        $.jgrid.defaults.styleUI = 'Bootstrap';



    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            LoadDeliveryGrid('@Url.Action("DeliveryScreenData", "Delivery")','@Request.Url.OriginalString');
        });

    </script>
}
