@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Workflows";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-check-circle"></span>
                Approval Workflows
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-approval-workflow"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row row-bottom-buttons">
            <a href="~/ApprovalWorkflows/Add" class="btn btn-success help-btn">Add</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-approval-workflows")

    <script type="text/javascript">
        $(document).ready(function () {

            Msr.ApprovalWorkflowsGrid.LoadApprovalWorkflows('@Url.Action("ApprovalWorkflowsData", "ApprovalWorkflows")');

        });
    </script>
}
