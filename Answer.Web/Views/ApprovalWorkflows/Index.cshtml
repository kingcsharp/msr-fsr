@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Approval Workflows";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-check-circle"></span>
                Approval Workflows <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/ApprovalWorkflows/Add" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-approval-workflows")

    <script>
        //$.jgrid.defaults.responsive = true;
        $.jgrid.defaults.styleUI = 'Bootstrap';

    </script>
}


