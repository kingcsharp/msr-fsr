@model Msr.Services.ApprovalWorkflows.ViewModels.ApprovalWorkflowsViewModel

@{
    ViewBag.Title = "Create Approval Workflow";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Create Approval Workflow<button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-10">
                @Html.Partial("Message")
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()                   
                    <input type="hidden" name="ObjectId" value="@Model.Object_Id" />
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Wf_Stages, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.Wf_Stages, Model.ListWf_Stages, new { @class = "form-control selectroles", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.Wf_Stages, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Activities, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                <div style="width: 96%; float: left;">
                                    @Html.ListBoxFor(m => m.Activities, Model.ListActivities, new { @id = "actv", multiple = "multiple" })
                                    @Html.ValidationMessageFor(model => model.Activities, "", new { @class = "text-danger" })
                                </div>

                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Stamp_Name, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.Stamp_Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Stamp_Name, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.PictureFiles, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                <div style="width: 96%; float: left;">
                                    @Html.ListBoxFor(m => m.PictureFiles, Model.ListPictureFiles, new { @class = "form-control selectitem", multiple = "multiple" })
                                    @Html.ValidationMessageFor(model => model.PictureFiles, "", new { @class = "text-danger" })
                                </div>
                                <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="PictureFiles" data-toggle="modal" data-target="#select-pic"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="PictureFiles"><i class="icon fa fa-minus-circle"></i></span> </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-10">
                                <input type="submit" value="Submit" class="btn btn-success" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@section scripts
{
    <script src="~/assets/js/common/documentFile.js"></script>
    <script src="~/assets/js/common/documentFiles.js"></script>

    <script src="~/assets/js/grids/files-dialog-single-selection.js"></script>
    <script src="//rawgit.com/saribe/eModal/master/dist/eModal.min.js"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script type="text/javascript">
        $("form").submit(function (e) {
            $('.selectitem option').prop('selected', true);
        });
    </script>
    @{
        var wf_Stages = string.Join(",", Model.Wf_Stages);
        var activities = Model.Activities;
        string ar = string.Empty;
        for (int i = 0; i < activities.Count; i++)
        {
            ar += activities[i] + ",";
        }
    }
    <script src="~/assets/js/grids/comman.js"></script>
    <script type="text/javascript">
    $(document).ready(function () {
        var selectRoles = $(".selectroles").select2({
            tags: [],
            tokenSeparators: [','],
            multiple: true,
            allowClear: true,
            placeholder: "Select Wf_Stages",
            formatNoMatches: function () {
                return '';
            }
        });

        var values = '@wf_Stages';
        var selectedWf_Stages = values.split(",");
            console.log(selectedWf_Stages);
            selectRoles.val(selectedWf_Stages).trigger("change");
            var activities = '@ar'; // comma separated value
           var array = activities.split(',');
    for (var i = 0; i < array.length; i++) {
        if (array[i].length > 0) {
            $('#actv option[value=' + array[i] + ']').attr("selected", true);
        }
    }
    });
        $('#actv').addClass("form-control activities");
    </script>
}