@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Actual Parts View History";
    TempData["actualPartId"] = ViewBag.ActualPartId;
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Actual Parts View History <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    
<script src="~/assets/js/grids/actualpartshistory.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            LoadActualPartViewHistoryGrid('@Url.Action("ActualPartsViewHistoryData", "ActualParts",new{ id = ViewBag.ActualPartId })');
        });
    </script>
}


