@model IEnumerable<Msr.Services.ActualParts.ViewModels.ActualPartImportViewModel>
@{
    ViewBag.Title = "Actual Parts Import";
}
<style>
    .validation-summary-errors {
        color: red;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Upload File
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                <div class="form-horizontal">
                    @Html.Partial("Message")
                    <div class="row">
                        <div >
                            The import file must be a tab delimited text file (.csv)<br />
                            It must have these columns in any order id, sn, nickname, owner, partID, qty<br />
                            The file must have the column names as the first row capitalized and spelled like above<br />
                            The field definitions are***<br />
                            id = unique ID in the external database for the Actual Part.<br />
                            sn = the serial number for the actual part<br />
                            nickname = the nickname for the actual part<br />
                            owner = the unique ID for the owner company in the external database<br />
                            partID = the unique ID of the part in the external database<br />
                            qty = the qty of this actual part.<br />
                            locationID = the unique ID of the location of this actual part in the external database or ANSWER database.<br />
                        </div>
                       
                    </div>
                    @using (Html.BeginForm("Import", "ActualParts", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()
                        <table>
                            <tr>
                                <td>
                                    <label class="btn btn-primary" for="postedFile">
                                        <input id="postedFile" type="file" name="postedFile" accept=".csv" style="display:none"  />
                                        Browse...
                                    </label>
                                </td>
                                <td style="padding-left: 5px;">
                                    <input type="submit" class="btn btn-success" value="Process Import" />
                                </td>
                                <td style="padding-left: 5px;">
                                    <a class="btn btn-link" href="~/ActualParts/ImportSampleFile" target="_blank">Download sample file </a>
                                </td>
                            </tr>
                        </table>
                    }
                </div>
                
                @if (Model != null && Model.Any())
                {
                    <table class="table">
                        <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Id)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Sn)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NickName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Processed)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Messages)
                            </th>

                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Id)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Sn)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.NickName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Processed)
                                </td>
                                <td>
                                    @foreach (var message in item.Messages)
                                    {
                                        @message <br />
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                

            </div>
        </div>
    </div>
</div>