@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Parts";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-clone"></span>
                Actual Parts/Assets <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-actual-part"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row row-bottom-buttons">
            <a href="~/ActualParts/Create" class="btn btn-success help-btn">Add</a>
            <a href="~/ActualParts/import" class="btn btn-success help-btn">Import</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>

        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-actualparts")

    <script type="text/javascript">
        $(document).ready(function () {

            Msr.ActualPartsGrid.LoadActualPartsGrid('@Url.Action("ActualPartsData", "ActualParts")');

        });
    </script>
}

