
@model Msr.Services.ActualParts.ViewModels.ReassignTaskViewModel
@{
    ViewBag.Title = "Re-Assign Task";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Re-Assign Task
                <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-10">
                @Html.Partial("Message")
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group">
                            @Html.LabelFor(model => model.PersonToReAssign, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.PersonToReAssign, Model.PeopleList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.PersonToReAssign, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.GroupToReassign, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.GroupToReassign, Model.GroupList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.GroupToReassign, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReAssignComments, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.TextAreaFor(model => model.ReAssignComments, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.ReAssignComments, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-10">
                                <input type="submit" value="Re-Assign Now" class="btn btn-success" />
                                @Html.ActionLink("Do Not Re-Assign Now", "Index", null, new { @class = "btn btn-warning" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function() {

            $('.select').select2();


        });
    </script>

}





