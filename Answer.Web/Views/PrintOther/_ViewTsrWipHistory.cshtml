@model Msr.Services.Orders.Messaging.WipHistoryTsrResponse

<div class="col-md-12 col-sm-12 visible-print" style="margin-top:20px;">
    <h2>WIP History Report</h2>
</div>
<div class="col-md-12 col-sm-12" style="margin-bottom:5px;">
    <table class="table table-bordered report-table">
        <tbody>
        <tr>
            <td rowspan="2" style="border: 1px solid #ccc">@Model.WipHistoryDetailResult.SupplierName</td>
            <td> @Model.WipHistoryDetailResult.ProcedureName</td>
            <td style="padding-left: 5px; padding-right: 5px;">Rev #:</td>
            <td>@Model.WipHistoryDetailResult.Rev</td>
        </tr>
        <tr>
            <td colspan="3" style="border: 1px solid #ccc">@Model.WipHistoryDetailResult.FillObjectDescription</td>
        </tr>
        </tbody>
    </table>
</div>

<div class="col-md-12 col-sm-12">
    <table class="table table-bordered report-table">
        <tr>
            <th>Step</th>
            <th>Title</th>
            <th>Latest Requestee Name</th>
            <th>Actual Start Date</th>
            <th>Actual Stop Date</th>
            <th>Location </th>
            <th>Status</th>
        </tr>
        @{
            int i = 1;
        }
        @foreach (var task in Model.WipTaskResult)
        {
            <tr>
                <td>@i</td>
                <td>@task.Title </td>
                <td>@task.LatestRequesteeName</td>
                <td>@task.ActualStartDate</td>
                <td>@task.ActualStopDate</td>
                <td>@task.Location</td>
                <td>@task.Status</td>
            </tr>
            if (task.WipSubTasks.Any())
            {
                <tr>
                    <td></td>
                    <td colspan="6">
                        <table class="table-bordered table">
                            <tr>
                                <th>Monitor @task.Id</th>
                                <th>Result</th>
                                <th>Pass/Fail</th>
                            </tr>
                            @foreach (var subTask in task.WipSubTasks)
                            {
                                <tr>
                                    <td>@subTask.Description </td>
                                    <td>@subTask.PrintResult</td>
                                    <td>@subTask.IsPassing</td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            }
            i++;
         }
        </table>
</div>
