@model Msr.Services.Orders.Messaging.WipHistoryTsrResponse
<div id="qrcodeTable" style="margin: 35px; text-align: center;"></div>
<div id="qrcodeCanvas">
</div>
<div class="row">
    <table cellpadding="5" cellspacing="5">
        <tbody>
        <tr>
            <td rowspan="2" style="border: 1px solid #ccc">@Model.WipHistoryDetailResult.SupplierName</td>
            <td> @Model.WipHistoryDetailResult.ProcedureName</td>
            <td style="padding-left: 5px; padding-right: 5px;">Rev #:</td>
            <td>@Model.WipHistoryDetailResult.CustomerPerson</td>
        </tr>
        <tr>
            <td colspan="3" style="border: 1px solid #ccc">@Model.WipHistoryDetailResult.FillObjectDescription</td>
        </tr>
        </tbody>
    </table>
</div>

<div class="row">
    <table class="table table-bordered">
        <tr>
            <th>Step</th>
            <th>Description</th>
            <th>Latest Requestee Name</th>
            <th>Actual Start Date</th>
            <th>Actual Stop Date</th>
            <th>Location </th>
            <th>Status</th>
        </tr>
        @{
            int i = 1;
        }
        @foreach (var task in Model.WipTaskResult)
        {
            <tr>
                <td>@i</td>
                <td>@task.Description </td>
                <td>@task.LatestRequesteeName</td>
                <td>@task.ActualStartDate</td>
                <td>@task.ActualStopDate</td>
                <td>@task.Location</td>
                <td>@task.Status</td>
            </tr>
            <tr>
                <td></td>
                <td colspan="6">
                    @if (task.WipSubTasks.Any())
                    {
                        <table class="table-bordered">
                            <tr>
                                <th>Monitor @task.Id</th>
                                <th>Result</th>
                                <th>Pass/Fail</th>
                            </tr>
                            @foreach (var subTask in task.WipSubTasks)
                            {
                                <tr>
                                    <td>@subTask.Description </td>
                                    <td>@subTask.PrintResult</td>
                                    <td>@subTask.IsPassing</td>
                                </tr>
                            }
                        </table>
                    }
                </td>
            </tr>
            i++;
        }
    </table>
</div>
<script src="~/assets/js/qrcode.js"></script>
<script src="~/assets/js/jquery.qrcode.js"></script>
@{
    string baseUrl = string.Format("{0}://{1}{2}", HttpContext.Current.Request.Url.Scheme, HttpContext.Current.Request.Url.Authority, Url.Content("~"));
}
<script>
    jQuery('#qrcodeTable').qrcode({ width: 130, height: 130, text: '@baseUrl' + 'wip/details/' + '@Model.FillId' });
</script>