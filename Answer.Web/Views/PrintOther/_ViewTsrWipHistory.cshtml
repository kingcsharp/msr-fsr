@model Msr.Services.Orders.Messaging.WipHistoryTsrResponse
@using Answer.Web.Helpers

<div class="col-md-12 col-sm-12 visible-print" style="margin-top:20px;">
    <h2>WIP History Report</h2>
</div>
<div class="col-md-12 col-sm-12">
    <table class="table table-bordered report-table">
        <tbody>
            <tr>
                <td rowspan="2" style="border: 1px solid #ccc">@Model.WipHistoryDetailResult.SupplierName</td>
                <td> @Model.WipHistoryDetailResult.ProcedureName</td>
                <td style="padding-left: 5px; padding-right: 5px;">Rev #:</td>
                <td>@Model.WipHistoryDetailResult.Rev</td>
            </tr>
            <tr>
                <td colspan="3" style="border: 1px solid #ccc">@Model.WipHistoryDetailResult.FillObjectDescription</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="col-md-12 col-sm-12">
    <table class="table table-bordered report-table">
        <tr>
            <th>Step</th>
            <th>Title</th>
            <th>Latest Requestee Name</th>
            <th>Actual Start Date</th>
            <th>Actual Stop Date</th>
            <th>Location </th>
            <th>Status</th>
        </tr>
        @{
            int i = 1;
        }
        @foreach (var task in Model.WipTaskResult)
        {
            <tr>
                <td>@i</td>
                <td>@task.Title </td>
                <td>@task.LatestRequesteeName</td>
                <td>@task.ActualStartDate</td>
                <td>@task.ActualStopDate</td>
                <td>@task.Location</td>
                <td>@task.Status</td>
            </tr>
            if (Model.GetDocumentsOfTask(task.ProcedureStepId).Any())
            {
                <tr>
                    <td></td>
                    <td colspan="6" style="padding:0;">
                        <table class="table table-bordered table-striped">
                            <tr>
                                <th>Files</th>
                                <th>Actions</th>
                            </tr>
                            @foreach (var item in Model.GetDocumentsOfTask(task.ProcedureStepId))
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>
                                        @*<span class="data-toggle=" data-call-back-item="@item.Name" data-toggle="modal" data-target="#view-images" title="View File">
                                            <i class="icon fa fa-eye"></i>
                                        </span>*@
                                        @FilePreviewHelper.FilePreview(item.Name, item.DocId)
                                        @*<a class="btn btn-xs btn-success" data-toggle="modal" href="NC types.jpg"
                                               data-target="#" onclick="viewerLoad('@file.DocumentURL','@file.Name')" title="View Inline">
                                                View
                                                <span data-toggle="tooltip" data-placement="top" data-original-title="Launch Viewer" data-flobwicket="{%=file.name%}">
                                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                                </span>
                                            </a>*@
                                    </td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            }

            if (task.WipSubTasks.Any())
            {
                <tr>
                    <td></td>
                    <td colspan="6" style="padding:0;">
                        <table class="table table-bordered table-striped">
                            <tr>
                                <th>Monitor @task.Id</th>
                                <th>Result</th>
                                <th>Pass/Fail</th>
                            </tr>
                            @foreach (var subTask in task.WipSubTasks)

                            {

                                var cssClass = "";

                                if (subTask.IsPassing == "Pass")
                                {
                                    cssClass = "success";
                                }
                                else if (subTask.IsPassing == "Fail")
                                {
                                    cssClass = "danger";
                                }
                                <tr>
                                    <td>@subTask.Description </td>
                                    <td>@subTask.PrintResult</td>
                                    <td class="@cssClass">@subTask.IsPassing</td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            }
            i++;
        }
    </table>
</div>
<script type="text/javascript">
    $(function () {
        Msr.JqGridCommon.DocPreview();
    });
</script>