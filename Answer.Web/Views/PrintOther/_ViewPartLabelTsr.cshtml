@model Msr.Services.Orders.Messaging.PartLabelTsrDetailsResponse
<style>
    @@media print {

        @@page {
            size:8.5in 11in;
        }
        body {
           margin-top:1.015in;
           margin-left:1.015in;
           margin-left:.1725in;
           margin-right:.1725in;
        }
    }
    
    .page-container {
        width:8.5in;
        height:11in;
    }
    table.tight {
        font: small Arial, Helvetica, sans-serif !important;
        font-size: 12px !important;
        width: 100%;
    }
    tr {
        height:20px;
    }
    td {
      text-align: left;
    }
    .date {
        float:right;
    }
    .OL250 {
        height:1.495in;
        width:4in;
        padding:.2in;
        float:left;
        border:1px dashed #ccc;
        border-radius:0.0625in;
    }
 
    .OL250:nth-child(odd){
        margin-right:.155in;
    }
</style>
<div class="page-container">
    @foreach (var partLabel in Model.GetPartsAndKitsLabelsResult)
    {
    <div class="OL250">
        <table class="tight">
            <tbody>
                <tr>
                    <td width="35%"><strong>MSR-FSR @partLabel.Site_Name</strong></td>
                    <td width="65%">Customer: <strong>@partLabel.WO_Item_Number</strong></td>
                </tr>
                <tr>
                    <td>Part #: <strong>@partLabel.Company_Part_Number</strong></td>
                    <td>Serial #: <strong>@(partLabel.Serial != null ? @partLabel.Serial : "N/A")</strong></td>
                </tr>
                <tr>
                    <td colspan="2">Part Desc: <strong>@partLabel.Part_Desc</strong></td>
                <tr>
                    <td>PO #: <strong>@partLabel.PO_Number</strong></td>
                    <td><span class="date">Date:<strong>@partLabel.Due_Date</strong></span></td>
                </tr>
                <tr>
                    <td colspan="2">This Part Processed <strong>@partLabel.Count</strong> time(s) </td>
                </tr>
            </tbody>
        </table>
    </div>
    }
</div>
