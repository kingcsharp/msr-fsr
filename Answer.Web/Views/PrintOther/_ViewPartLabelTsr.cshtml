@model Msr.Services.Orders.Messaging.PartLabelTsrDetailsResponse
<style>
    table.tight {
        font: small Arial, Helvetica, sans-serif !important;
        font-size: 7px !important;
    }
</style>

<div style="top:0px;left:0px;width:7.95in;height:9.95in;">
    @foreach (var partLabel in Model.GetPartsAndKitsLabelsResult)
    {
        <div style="padding-left:.3in;height:0.995in;width:2.35in;padding-top:0;padding-bottom:0;padding-right:0;margin:0;left:0in;top:0in;float:left">
            <br>
            <table class="tight" style="font-size: 7px; width: 100%;">
                <tbody>
                <tr>
                    <td colspan="2"><b>MSR-FSR</b></td>
                </tr>
                <tr>
                    <td style="width: 30%"><div style="text-align: left">Procedure***</div></td>
                    <td style="width: 70%"><div style="text-align: left">@partLabel.Proc_Name</div>
                    </td>
                </tr>
                <tr>
                    <td style="border-top: thin black solid;">
                        <div style="text-align: left">Part Number:***</div></td>
                    <td style="border-top: thin black solid;">
                        @partLabel.Company_Part_Number<br>@partLabel.Part_Desc
                    </td></tr>
                <tr>
                    <td>
                        <div style="text-align: left">Serial***</div></td>
                    <td>
                        <div style="text-align: left">@partLabel.Serial</div></td>
                    </tr>
                <tr>
                    <td colspan="2">This Part Processed*** 0 times*** </td>
                </tr>
                </tbody>
            </table>
        </div>
    }
</div>