@model Msr.Services.Orders.Messaging.MonitorLabelTsrDetailsResponse
<div style="width: 7.95in; height: 9.95in;">
    @foreach (var monitorLabel in Model.GetMonitorLabelTsrDetailsResult)
    {
        <div style="padding-left: .3in; height: 1.99in; width: 3.6750000000000002in; padding-top: 0; padding-bottom: 0; padding-right: 0; margin: 0;">
            <br>
            <div style="font-size: x-small;">
                <div style="border-bottom: solid 1px black">
                    <b>@monitorLabel.Task_Description</b>
                    <br>
                    @monitorLabel.Description
                </div>
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td>Part #:</td>
                            <td>@monitorLabel.Company_Part_Number</td>
                            <td>Part Name:</td>
                        </tr>
                        <tr>
                            <td>Purch Item #:</td>
                            <td>@monitorLabel.Purch_Item_Id</td>
                            <td>@monitorLabel.Part_Desc</td>
                        </tr>
                    </tbody>
                </table>
                <div style="border-bottom: solid 1px black; width: 100%;"></div>
                <table style="font-size: 8px; border-bottom: 1px solid black; width: 100%;">
                    <tbody>
                        <tr>
                            <td>Requestee:</td>
                            <td>@monitorLabel.Latest_Requestee_Name</td>
                        </tr>
                        <tr>
                            <td>Date:</td>
                            <td>@monitorLabel.Actual_Stop_Date</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>