@model Msr.Services.Orders.Messaging.PartLabelTsrDetailsResponse
<style>
    @@media print {

        @@page {
            size:4.125in auto;
        }
        body {
           margin-top:.0625in;
           margin-left:.0625in;
        }
    }
    .roll-container {
       display: table-cell;
       vertical-align: middle;
       margin-top:.0625in;
       margin-left:.0625in;
       width:4.125in;
    }
    table.tight {
        font: small Arial, Helvetica, sans-serif !important;
        font-size: 12px !important;
        width:100%;
    }
    tr {
        height:20px;
    }
    td {
      text-align: left;
    }
    .date {
        float:right;
    }
    .roll-label {
        height:1.5in;
        width:4in;
        margin-bottom:0.125in;
        padding:.25in;
        left:0in;
        top:0in;
        border:1px dashed #ccc;
        border-radius:6px;
    }
</style>
<div class="roll-container">
    @foreach (var rollLabel in Model.GetPartsAndKitsLabelsResult)
    {

        <div class="roll-label">
            <table class="tight">
                <tbody>
                    <tr>
                        <td width="38%"><strong>MSR-FSR @rollLabel.Site_Name</strong></td>
                        <td width="62%">Customer: <strong>@rollLabel.WO_Item_Number</strong></td>
                    </tr>
                    <tr>
                        <td>Part #: <strong>@rollLabel.Company_Part_Number</strong></td>
                        <td>Serial #: <strong>@(rollLabel.Serial != null ? rollLabel.Serial : "N/A")</strong></td>
                    </tr>
                    <tr>
                        <td colspan="2">Part Desc: <strong>@rollLabel.Part_Desc</strong></td>
                    <tr>
                        <td>PO #: <strong>@rollLabel.PO_Number</strong></td>
                        <td><span class="date">Date:<strong>@rollLabel.Due_Date</strong></span></td>
                    </tr>
                    <tr>
                        <td colspan="2">This Part Processed <strong>@rollLabel.Cycle_Count</strong> time(s) </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>
