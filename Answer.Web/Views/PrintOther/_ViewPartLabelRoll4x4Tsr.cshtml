@model Msr.Services.Orders.Messaging.PartLabelTsrDetailsResponse
<style>
    @@media print {

        @@page {
            size: 4.125in auto;
        }

        body {
            margin-top: .0625in;
            margin-left: .0625in;
        }
    }

    .roll-container {
        display: table-cell;
        vertical-align: middle;
        margin-top: .0625in;
        margin-left: .0625in;
        width: 4.125in;
    }

    table.tight {
        font: small Arial, Helvetica, sans-serif !important;
        font-size: 12px !important;
        table-layout: fixed;
        width: 100%;
    }

    tr {
        height: 20px;
        padding: 3px;
    }

    table.tight td {
        text-align: left;
        padding: 4px;
    }

    .roll-label {
        height: 4in;
        width: 4in;
        margin-bottom: 0.125in;
        padding: 0 .1in;
        left: 0in;
        top: 0in;
        border: 1px dashed #ccc;
        border-radius: 6px;
    }

    .coded {
        border: 1px solid #000;
        width: 100%;
        display: block;
        padding: 5px;
    }

    p {
        margin: 0 0 2px;
    }

    .part-image {
        margin-top: 36px;
    }

    .part-image img {
        width: 136px;
        max-width: 136px;
        min-width: 136px;
    }
</style>
<div class="roll-container">
    @foreach (var rollLabel in Model.GetPartsAndKitsLabelsResult)
    {

    <div class="roll-label">
        <table class="tight">
            <tbody>
                <tr>
                    <td width="60%">
                        <div class="img-responsive" style="margin-top: 16px;width:185px;">
                            <img src="~/assets/img/msr-label-logo.png" border="0" /><br />
                        </div>
                        <p class="date">Date:<strong>@rollLabel.Due_Date</strong></p>
                        <p>Site: <strong>MSR-FSR @rollLabel.Site_Name</strong><p />
                        <p>WO: <strong>@rollLabel.WO_Item_Number</strong></p>
                        <div class="coded">
                            PO #: <strong>@rollLabel.PO_Number</strong><br />
                            <svg class="barcode"
                                 jsbarcode-value="@rollLabel.PO_Number"
                                 jsbarcode-format="CODE128"
                                 jsbarcode-displayValue="false"
                                 jsbarcode-margin="3" ,
                                 jsbarcode-width="1"
                                 jsbarcode-height="20">
                            </svg>
                        </div>

                    </td>
                    <td width="40%">
                        <div id="@rollLabel.Actual_Part_ID" class="image-container img-responsive part-image" data-divId="@rollLabel.Actual_Part_ID" data-imageId="@rollLabel.Part_Image_ID">
                        </div>
                    </td>
                </tr>

                <tr>
                    <td colspan="2">
                        <div class="coded">
                            Part Desc: <strong>@rollLabel.Part_Desc</strong><br />
                            <table class="tight">
                                <tr>
                                    <td width="50%">
                                        Customer Part #: <strong>@rollLabel.Company_Part_Number</strong><br />
                                        <svg class="barcode"
                                             jsbarcode-value="@rollLabel.Company_Part_Number"
                                             jsbarcode-format="CODE128"
                                             jsbarcode-displayValue="false"
                                             jsbarcode-margin="3" ,
                                             jsbarcode-width="1"
                                             jsbarcode-height="20">
                                        </svg>
                                    </td>

                                    <td width="50%">
                                        OEM Part #: <strong>@rollLabel.Oem_Part_Number</strong><br />
                                        <svg class="barcode"
                                             jsbarcode-value="@rollLabel.Oem_Part_Number"
                                             jsbarcode-format="CODE128"
                                             jsbarcode-displayValue="false"
                                             jsbarcode-margin="3" ,
                                             jsbarcode-width="1"
                                             jsbarcode-height="20">
                                        </svg>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td width="40%">
                        <div class="coded">
                            Serial #: <strong>@(rollLabel.Serial != null ? rollLabel.Serial : "N/A")</strong><br />
                            <svg class="barcode"
                                 jsbarcode-value="@(rollLabel.Serial != null ? rollLabel.Serial : " N/A")"
                            jsbarcode-format="CODE128"
                            jsbarcode-displayValue="false"
                            jsbarcode-margin="3" ,
                            jsbarcode-width="1"
                            jsbarcode-height="20">
                            </svg><br />
                            This Part Processed <strong>@rollLabel.Cycle_Count</strong> time(s)
                        </div>
                    </td>
                    <td style="text-align:center">CAN ONLY OPEN IN <br />CLASS 100 CLEANROOM <br />OR BETTER</td>
                </tr>
            </tbody>
        </table>
    </div>
    }
</div>
<script src="~/assets/js/JsBarcode.all.min.js"></script>
<script>
    $(document).ready(function () {
        JsBarcode(".barcode").init();

        // process image by id and populate for each label
        $('.image-container').each(function () {
            var image_id = $(this).attr('data-imageId');
            var div_id = '#' + $(this).attr('data-divId');
            console.log('Div ID: ' + div_id);
            if (typeof (image_id) != "undefined" && image_id !== null && image_id !== "") {
                console.log('Image ID: ' + image_id);
                $.ajax({
                    type: "GET",
                    url: '/Files/ViewFile?id=' + image_id,
                    dataType: 'json',
                    cache: false,
                    success: function (data) {
                        if (data.FileUrl) {
                            $(div_id).prepend($('<img>', { id: 'image-' + div_id, src: data.FileUrl, title: data.FileName, border: 0 }));
                        }
                        else {
                            $(div_id).prepend($('<img>', { id: 'image-' + div_id, src: '/assets/img/msr-label-no-parts-image.png', title: 'No Image Provided', border: 0 }));
                        }
                    },
                    error: function (error) {
                        console.log("Error retrieving image by id" + image_id + "Error :" + error);
                    }
                });
            }
            else {
                console.log('No Image ID found.');
                $(div_id).prepend($('<img>', { id: 'image-' + div_id, src: '/assets/img/msr-label-no-parts-image.png', title: 'No Image Provided', border: 0 }));
            }
        });
    });
</script>