@model Msr.Services.Orders.Messaging.TechnicalWorkReportTsrDetailsResponse
<div id="work-report-purchase-summary">
    <table class="tsrHeader">
        <tbody>
        <tr>
            <td class="tsrHeader">
                <div>
                    <table style="border: 1px solid #ccc;">
                        <tbody>
                        <tr>
                            <td rowspan="2" style="border: 1px solid #ccc">@Model.WipHistoryDetailResult.SupplierName</td>
                            <td > @Model.WipHistoryDetailResult.ProcedureName</td>
                            <td style="padding-left: 5px; padding-right: 5px;">Rev #:</td>
                            <td>@Model.WipHistoryDetailResult.CustomerPerson</td>
                        </tr>
                        <tr>
                            <td colspan="3" style="border: 1px solid #ccc">@Model.WipHistoryDetailResult.FillObjectDescription</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </td>
        </tr>
        </tbody>
    </table>
    <table>
        <tbody>
        @foreach (var task in Model.TasksFindForFillIdResult)
        {
            <tr>
                <td style="padding-right: 5px; vertical-align: top">@task.Step_Id</td>
                <td style="vertical-align: top">
                    @Html.Raw(task.Step_Text_All_Html)
                    @foreach (var monitor in task.FillGetMonitorsForNcrResult)
                    {
                        <table>
                            <thead>
                            <tr>
                                <th style="border: 1px solid #ccc">Desciption</th>
                                <th style="border: 1px solid #ccc">Result</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td style="border: 1px solid #ccc">@monitor.Description</td>
                                <td style="border: 1px solid #ccc">@monitor.Print_Result</td>
                            </tr>
                            </tbody>
                        </table>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>