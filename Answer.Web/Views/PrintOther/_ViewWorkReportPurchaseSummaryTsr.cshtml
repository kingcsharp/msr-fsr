@model IEnumerable<Msr.Services.Orders.Procedures.GetPurchaseWorkReportTsrDetailsResult>
<div id="work-report-technical-summary">
    <div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Purchase #</th>
                    <th>Purchase Item #</th>
                    <th>Single PO# (Customer Purchase #)</th>
                    <th>Blanket PO #</th>
                    <th>Line Item</th>
                    <th>Actual Part Database ID #</th>
                    <th>Serial #</th>
                    <th>Qty #</th>
                    <th>Purchasing Accounts #</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PurchaseId</td>
                        <td>@item.PurchaseItemId</td>
                        <td>@item.CustomerPurchaseNumber</td>
                        <td>@item.CustomerPurchaseNumber</td>
                        <td>@item.LineItem</td>
                        <td>@item.ActualPartDbId</td>
                        <td>@item.Serial</td>
                        <td>@item.Quantity</td>
                        <td>@item.AccountId</td>
                    </tr>
                }
            </tbody>
        </table>
        <br />
        <table style="width: 8in">
            <tbody>
            <tr>
                <td>
                    <table>
                        <tbody>
                        <tr>
                            <td class="subTitle">Supplier:</td>
                        </tr>
                        <tr>
                            <td>@Model.FirstOrDefault().SupplierName</td>
                        </tr>
                        </tbody>
                    </table>
                </td>
                <td style="padding-left: 5px;">
                    <table>
                        <tbody>
                        <tr>
                            <td class="subTitle">Customer:</td>
                        </tr>
                        <tr>
                            <td>@Model.FirstOrDefault().CustomerName</td>
                        </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
            </tbody>
        </table>
        <br/>
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <td class="bold standard">Product Name (#):</td>
                    <td class="standard">@Model.FirstOrDefault().ProductName (@Model.FirstOrDefault().ProductId)</td>
                </tr>
                <tr>
                    <td class="bold standard">Procedure Name (#):</td>
                    <td class="standard"> @Model.FirstOrDefault().ProcedureName (@Model.FirstOrDefault().ProcedureId)</td>
                </tr>
                <tr>
                    <td class="bold standard">Current Owner's Part Name (#):</td>
                    <td class="standard">@Model.FirstOrDefault().OwnerPartName</td>
                </tr>
                <tr>
                    <td class="bold standard">Fill Date:</td>
                    <td class="standard">@Model.FirstOrDefault().FillDate</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>