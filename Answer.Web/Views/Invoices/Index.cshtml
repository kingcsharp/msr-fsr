@model Msr.Services.Invoices.ViewModel.InvoiceViewModel
@{
    ViewBag.Title = "Invoices";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-exchange"></span>
                Invoices @Html.Partial("_HelpViewButton")
                <button class="btn btn-primary help-btn pull-right" data-toggle="modal" data-target="#invModal" data-intro="Create a New Invoice" data-position="bottom" style="margin-left: 10px"><i class="fa fa-plus"></i> New</button>
                &nbsp;
                <button id="butDownloadAllInvoices" class="btn btn-primary help-btn pull-right" style="margin-left: 10px" value="Download All Invoices" OnClick="Msr.InvoicesGrid.DownloadAllInvoices();">Download All Invoices</button>
                &nbsp;
                <button id="butDownloadFilteredInvoices" class="btn btn-primary help-btn pull-right" style="margin-left: 10px" value="Download Filtered Invoices" OnClick="Msr.InvoicesGrid.DownloadFilteredInvoices();">Download Filtered Invoices</button>
                &nbsp;
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-invoice"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>

        <div class="row">
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>
<div id="invModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Add Invoice</h4>
            </div>
            <div class="modal-body" style="max-height:100%;width:100%;">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>
<div id="editInvModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Edit Invoice</h4>
            </div>
            <div class="modal-body" style="max-height:100%;width:100%;">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-invoices")
    @Scripts.Render("~/bundles/js/invoice-setup")

    <script type="text/javascript">

		$(document).ready(function () {

			var invoice = new Invoice();

			Msr.InvoicesGrid.LoadInvoices('@Url.Action("InvoicesData", "Invoices")');

			invoice.LoadInvoiceModal();

			invoice.EditInvoiceModal();

        });

    </script>

}


