@model Msr.Services.Invoices.ViewModel.InvoiceDetailViewModel

@{
    ViewBag.Title = "Invoice Details";
}

<link href="~/assets/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />

<div class="container-fluid">
<div class="side-body padding-top">
<div class="row">
<h2 class="page-header">
    Invoice Details<button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
</h2>
@Html.Partial("Message")

@using (Html.BeginForm("Detail", "Invoices", FormMethod.Post, new { @class = "form form-horizontal" }))
{ 
    <input type="hidden" id="ButtonType" name="ButtonType" />
    <input type="hidden" name="purchaseId" id="purchaseId" value="@Model.PURCHASE_ID" />
    <input type="button" value="Edit Invoice Info" onclick="showhide()" id="editinvoiceinfo" class="btn btn-warning" />
    <div id="editAccountInvoice" style="display: none;">
        <table class="table" width="500px;" style="margin-left:100px;">
            <tr>
                <th style="width:100px;">
                    Name
                </th>
                <td style="float:left;width:500px;">@Html.EditorFor(model => model.INVOICE_NAME, new { htmlAttributes = new { @class = "form-control" } })</td>
            </tr>

            <tr>
                <th style="width:100px;">
                    Invoice Status
                </th>
                <td style="float:left;width:500px;">@Html.DropDownListFor(model => model.STATUS, Model.InvoiceStatusList, new { @class = "form-control" })</td>
            </tr>

            <tr>
                <th style="width:200px;">
                    Set Tax For All Items To
                </th>
                <td style="float:left;width:500px;">
                    @Html.EditorFor(model => model.SALES_TAX, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.SALES_TAX, "", new { @class = "text-danger" })
                </td>
            </tr>
            @if (Model.CUST_PURCH_NUM != null)
            {
                <tr>
                    <th style="width:140px;">
                        Customer Po Number
                    </th>
                    <td style="float:left;width:500px;">@Html.EditorFor(model => model.CUST_PURCH_NUM, new { htmlAttributes = new { @class = "form-control" } })</td>
                </tr>
            }

        </table>            
        <div class="form-group">
            <div class="col-md-offset-2 col-md-5">
                <input type="submit" value="Submit" class="btn btn-success" />
                <input type="button" value="Cancel" onclick="showhide()" id="cancel" class = "btn btn-warning" />
            </div>
        </div>
    </div>

    <br /><br />

    <table class="table" width="100%;">
    <table class="table table-bordered" width="500px;" style="margin-left:100px;">
        <tr>
            <th style="width:100px;">Account Id:</th>
            <td style="float:left;width:500px;">
                @Html.EditorFor(model => model.ACCOUNT_ID, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.ACCOUNT_ID, "", new { @class = "text-danger" })
            </td>
        </tr>
        <tr>
            <th style="width:100px;">Invoice Id:</th>
            <td style="float:left;width:500px;">
                @Html.EditorFor(model => model.INVOICE_ID, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.INVOICE_ID, "", new { @class = "text-danger" })
            </td>
        </tr>
        <tr>
            <th style="width:100px;">Invoice Date:</th>
            <td style="float:left;width:500px;">
                @Html.EditorFor(model => model.INVOICE_DATE, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.INVOICE_DATE, "", new { @class = "text-danger" })
            </td>
        </tr>
        <tr>
            <th style="width:200px;">New Payments and Credits:</th>
            <td style="float:left;width:500px;">
                <div class="input-group">
                    <span class="input-group-addon">$</span>
                    @Html.EditorFor(model => model.PAYMENT_AMOUNT, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                </div>
            </td>

        </tr>
        <tr>
            <th style="width:100px;">New Debits:</th>
            <td style="float:left;width:500px;">
                <div class="input-group">
                    <span class="input-group-addon">$</span>
                    @Html.EditorFor(model => model.NEW_ITEMS_AMT, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                </div>
            </td>
        </tr>
        <tr>
            <th style="width:100px;">New Late Fees:</th>
            <td style="float:left;width:500px;">
                <div class="input-group">
                    <span class="input-group-addon">$</span>
                    @Html.EditorFor(model => model.LATE_FEES, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                </div>
            </td>

        </tr>
        <tr>
            <th style="width:100px;">Tax:</th>
            <td style="float:left;width:500px;">
                <div class="input-group">
                    <span class="input-group-addon">$</span>
                    @Html.EditorFor(model => model.TOTAL_TAX, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                </div>
            </td>

        </tr>
        <tr>
            <th style="width:100px;">Total Due:</th>

            <td style="float:left;width:500px;">
                <div class="input-group">
                    <span class="input-group-addon">$</span>
                    @Html.EditorFor(model => model.INVOICE_BALANCE, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                </div>
            </td>

        </tr>
        <tr>
            <td></td>
            @if (Model.STATUS == "INVOICED" || Model.STATUS == "CREATING")
            {
                <td>
                    <input id="SubmitWorkflow" type="button" name="BSUBMIT" class="btn btn-success" value="Move Selected To Another Invoice" />
                </td>
            }

        </tr>
    </table>
    <table class="table table-bordered" style="margin-top:-418px; margin-left:800px;">

        <tr>
            <th style="width:100px;">Invoice Status:</th>
            <td style="float:left;width:500px;">
                INV_STAT_@Model.STATUS
                @Html.ValidationMessageFor(model => model.STATUS, "", new { @class = "text-danger" })
            </td>
        </tr>
        <tr>
            <th style="width:100px;">REF PO ID:</th>
            <td style="float:left;width:500px;">
                @Html.EditorFor(model => model.REFERENCE_PO, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.REFERENCE_PO, "", new { @class = "text-danger" })
            </td>
        </tr>
        <tr>
            <th style="width:160px;">REF PO NAME:</th>
            <td style="float:left;width:500px;">
                @Html.EditorFor(model => model.REFERENCE_NAME, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                @Html.ValidationMessageFor(model => model.REFERENCE_NAME, "", new { @class = "text-danger" })
            </td>
        </tr>
        <tr>
            <td></td>
            <td>
                <a href="@Url.Action("EditCreditDebit", "Invoices", new { invoiceId=Model.INVOICE_ID,accId=Model.ACCOUNT_ID})" class="btn btn-success">Record Credit</a>
            </td>
        </tr>
        @if (Model.STATUS == "CREATING")
        {
            <tr>
                <td></td>
                <td>
                    <input type="button" value="Mark Invoice as Invoiced" onclick="invoiceToCustomerShowHide()" id="invoiceToCustomer" class="btn btn-warning" />
                    <div id="invoiceCustomer" style="display: none;">
                        <table class="table" width="500px;" style="margin-left:100px;">
                            <tr>
                                <th style="width:130px;">
                                    Date Invoiced
                                </th>
                                <td style="float:left;width:500px;">
                                    <div class="input-group datepick" style="width:600px;">
                                        @Html.EditorFor(model => model.INVOICE_DATE, new { htmlAttributes = new { @class = "form-control" } })
                                        <span class="input-group-addon">
                                            <span class="glyphicon glyphicon-calendar"></span>
                                        </span>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <th style="width:100px;">
                                    Due Date
                                </th>
                                <td style="float:left;width:500px;">
                                    <div class="input-group datepick" style="width:600px;">
                                        @Html.EditorFor(model => model.DUE_DATE, new { htmlAttributes = new { @class = "form-control" } })
                                        <span class="input-group-addon">
                                            <span class="glyphicon glyphicon-calendar"></span>
                                        </span>
                                    </div>
                                </td>
                            </tr>


                        </table>
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-5">
                                <input type="button" value="Mark as Invoiced" id="MarkaInvoicedToCustomer" class="btn btn-success" />
                                <input type="button" value="Cancel" onclick="invoiceToCustomerShowHide()" id="cancel" class="btn btn-warning" />
                            </div>
                        </div>
                    </div>

                </td>
            </tr>
        }


        @if (Model.STATUS == "INVOICED" || Model.STATUS == "SENT_TO_CUSTOMER")
        {
            <tr>
                <td></td>
                <td>
                    <input type="button" value="Send Invoice To Customer" onclick="invoiceToCustomerMailShowHide()" id="invoiceToCustomerEmail" class="btn btn-warning" />

                    <div id="invoiceCustomerEmail" style="display: none;">
                        <table class="table" width="500px;" style="margin-left:100px;">
                            <tr>
                                <th style="width:200px;">
                                    Customer Email Address
                                </th>
                                <td style="float:left;width:500px;">@Html.EditorFor(model => model.CUST_EMAIL, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>

                            <tr>
                                <th style="width:200px;">
                                    Additional Emails
                                </th>
                                <td style="float:left;width:500px;">@Html.EditorFor(model => model.ADD_EMAILS, new { htmlAttributes = new { @class = "form-control" } })</td>
                            </tr>


                        </table>
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-5">
                                <input type="submit" value="Send Now" class="btn btn-success" />
                                <input type="button" value="Cancel" onclick="invoiceToCustomerMailShowHide()" id="cancel" class="btn btn-warning" />
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }

        <tr>
            <td></td>
            <td>
                <a href="@Url.Action("PrintableInvoice", "Invoices", new { id=Model.INVOICE_ID})" class="btn btn-success">Printer Friendly</a>

            </td>
        </tr>

    </table>
    </table>
}
<table class="table table-bordered" style="margin-top:150px; width:100%;">
    <tr>
        <th>Date Posted</th>
        <th>Act Inv Item Type</th>
        <th>Cust Purchase Number</th>
        <th>AII Purchase Number</th>
        <th>AII Item Id</th>
        <th>Inv Item Description</th>
        <th>Inv Item Comments</th>
        <th>Quantity</th>
        <th>Unit Price</th>
        <th>Amt of Inv Items</th>
        <th>Tax</th>
        <th>Total</th>
        <th>Actions</th>
    </tr>


    @for (int i = 0; i < Model.invoiceDetailList.Count; i++)
    {
        <tr>
            <td style="width:150px;">
                @Html.DisplayFor(x => Model.invoiceDetailList[i].DATE_POSTED, new { @class = "form-control", @readonly = "readonly",@style = "width:170px;" })
            </td>
            <td style="width:100px;">
                @Html.DisplayFor(x => Model.invoiceDetailList[i].ITEM_TYPE, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
            </td>

            <td style="width:100px;">
                @Html.DisplayFor(x => Model.invoiceDetailList[i].CUST_PURCH_NUM, new { @class = "form-control", @readonly = "readonly" })
            </td>
            <td style="width:130px;">
                @Html.DisplayFor(x => Model.invoiceDetailList[i].PURCHASE_ID, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
            </td>
            <td style="width:140px;">
                @Html.DisplayFor(x => Model.invoiceDetailList[i].PURCH_ITEM_ID, new { @class = "form-control", @readonly = "readonly" })
            </td>
            <td style="width:150px;">
                @Html.DisplayFor(x => Model.invoiceDetailList[i].DESCRIPTION, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
            </td>
            <td style="width:100px;">
                @Html.DisplayFor(x => Model.invoiceDetailList[i].COMMENTS, new { @class = "form-control", @readonly = "readonly", @style = "width:80px;" })
            </td>
            <td style="width:60px;">
                @Html.DisplayFor(x => Model.invoiceDetailList[i].QTY, new { @class = "form-control", @readonly = "readonly", @style = "width:80px;" })
            </td>
            <td style="width:100px;">
                $@Html.DisplayFor(x => Model.invoiceDetailList[i].UNIT_PRICE, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
            </td>
            <td style="width:80px;">
                $@Html.DisplayFor(x => Model.invoiceDetailList[i].AMOUNT, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
            </td>
            <td style="width:100px;">
                $@Html.DisplayFor(x => Model.invoiceDetailList[i].TAX, new { @class = "form-control", @readonly = "readonly", @style = "width:80px;" })
            </td>
            <td style="width:100px;">
                $@Html.DisplayFor(x => Model.invoiceDetailList[i].TOTAL, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
            </td>
            @if (Model.invoiceDetailList[i].PURCHASE_ID != null)
            {
                <td style="width:100px;">
                    <a href="@Url.Action("InvoiceListDetail", "Invoices", new { purchaseId=Model.invoiceDetailList[i].PURCHASE_ID})" class="btn btn-xs btn-success"><i class="fa fa-eye"></i></a>
                    <a href="@Url.Action("EditCreditDebit", "Invoices", new { id=Model.invoiceDetailList[i].ID})" class="btn btn-xs btn-success"><i class="fa fa-edit"></i></a>
                    <button type="button" onclick="deleteInvoice(@Model.invoiceDetailList[i].ID,@Model.invoiceDetailList[i].INVOICE_ID);" class="btn btn-xs btn-danger deleteInvoice"><i class="fa fa-trash-o"></i></button>
                </td>
            }
        </tr>
    }
       
</table>

</div>
</div>
</div>

<script src="~/assets/js/jquery.min.js"></script>
<script src="~/assets/js/moment.min.js"></script>
<script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
<script src="~/assets/js/dataTables.bootstrap.min.js"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>

<script>
    $('.datepick').datetimepicker();

    function showhide() {
        var div = document.getElementById("editAccountInvoice");
        if (div.style.display !== "none") {
            div.style.display = "none";
        }
        else {
            div.style.display = "block";
        }
    }


    function invoiceToCustomerShowHide() {
        var div = document.getElementById("invoiceCustomer");
        if (div.style.display !== "none") {
            div.style.display = "none";
        }
        else {
            div.style.display = "block";
        }
    }

    function invoiceToCustomerMailShowHide() {
        var div = document.getElementById("invoiceCustomerEmail");
        if (div.style.display !== "none") {
            div.style.display = "none";
        }
        else {
            div.style.display = "block";
        }
    }

    $(document).ready(function () {
        $('#editinvoiceinfo').click(function () {
            $('#editinvoiceinfo').hide();
        });
    });
    $(document).ready(function () {
        $('#cancel').click(function () {
            $('#editinvoiceinfo').show();
        });
    });



    function deleteInvoice(valueId, valueInvoiced) {
            eModal.confirm(
                'Are you sure?')
                .then(confirmCallback, optionalCancelCallback);

            function confirmCallback() {
                window.location.href = "/Invoices/InvoiceDetailDelete/?id=" + valueId + "&invoiceId=" + valueInvoiced;
            }

            function optionalCancelCallback() {

            }
        }


    $('#MarkaInvoicedToCustomer').click(function () {
            var invoiceDate = $("#INVOICE_DATE").val();
            var dueDate = $("#INVOICE_DATE").val();
            var invoiceId = '@Model.INVOICE_ID';
            var accId = '@Model.ACCOUNT_ID';
            
            $.ajax({
                type: "POST",
                url: "@Url.Action("InvoiceToCustomer", "Invoices")" + "/?invoiceId=" + invoiceId + "&accId=" + accId +"&invoiceDate="+invoiceDate + "&dueDate=" + dueDate,
                dataType: "json",
                contentType: "application/json; charset=utf-8",
               
                success: function (result) {
                    window.location.reload();
                },
                error : function(error) {
                    alert(error.Message);
                }
            });
        });

</script>
