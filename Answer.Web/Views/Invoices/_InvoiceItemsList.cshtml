@model Msr.Services.Invoices.ViewModel.InvoiceViewModel
<h4>Purchase Items to Apply (Check All that Apply)</h4>
@if (Model.InvoiceDetailList != null)
{
    <table class="table table-bordered" id="records_table">
        <tr>
            <th></th>
            <th>Date Posted</th>
            <th>Cust Purchase Number</th>
            <th>AII Purchase Number</th>
            <th>AII Item Id</th>
            <th style="width:100px;">Description</th>
            <th>Qty</th>
            <th>Product Cost Calculation</th>
            <th>Unit Price</th>
            <th>Amt of Inv Items</th>
            <th>Total</th>
        </tr>
        @for (int i = 0; i < Model.InvoiceDetailList.Count; i++)
        {

            <tr>
                <td class="getId">
                    <input name="checkbox" class="checkAmount" value="@Model.InvoiceDetailList[i].ID" id="poId" type="checkBox">
                </td>
                <td>
                    @string.Format("{0:M/d/yyyy}", Model.InvoiceDetailList[i].DATE_POSTED)
                </td>
             
                <td>
                    @Model.InvoiceDetailList[i].CUST_PURCH_NUM
                </td>
                <td>
                    @Model.InvoiceDetailList[i].PURCHASE_ID
                </td>
                <td>
                    @Model.InvoiceDetailList[i].PURCH_ITEM_ID
                </td>
                <td>
                    @Model.InvoiceDetailList[i].DESCRIPTION
                </td>
                <td>
                    @Model.InvoiceDetailList[i].QTY
                </td>
                <td class="poAmount">
                    @if (Model.InvoiceDetailList[i].TotalSalePrice.HasValue)
                    {
                        <span> $@Model.InvoiceDetailList[i].TotalSalePrice</span>
                        @Html.HiddenFor(x => Model.InvoiceDetailList[i].TotalSalePrice, new { @id = "amountPo" })
                    }
                </td>
                <td>
                    @if (Model.InvoiceDetailList[i].AMOUNT.HasValue)
                    {
                        <span> $@Model.InvoiceDetailList[i].AMOUNT</span>
                    }                    
                </td>

                <td>
                    @if (Model.InvoiceDetailList[i].TOTAL.HasValue)
                    {
                        <span>$ @Model.InvoiceDetailList[i].TOTAL</span>
                    }                   
                    
                </td>
            </tr>
        }
    </table>
}

<script src="~/assets/js/grids/invoice-tax.js"></script>

<script type="text/javascript">

    $(document).ready(function () {
        $('input[type="checkbox"]').click(function () {
            CheckBoxSelection($('#editId').val(), this, $(this).closest('tr').find('.poAmount').find('#amountPo').val());
        });
    });

</script>
