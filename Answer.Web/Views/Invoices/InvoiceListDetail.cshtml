@model Msr.Services.Invoices.ViewModel.InvoiceViewPurchaseItemViewModels
@{
    ViewBag.Title = "View Purchase-Quote Items";
}


<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                View Purchase-Quote Items
            </h2>
            @Html.Partial("Message")
            <table class="table table-bordered">
                <tr>
                    <th>Supplier</th>
                    <th>Product Name</th>
                    <th>App Obj Desc</th>
                    <th>Procedure Name</th>
                    <th>Purchasing Account</th>
                    <th>Purchased Qty</th>

                    <th>Product Unit</th>
                    <th>TOTAL PRICE</th>
                   
                </tr>

                @foreach (var item in Model.invoiceViewItemList)

                {
                    <tr>
                        <td style="width:150px;">
                            @Html.DisplayFor(x => item.SUPPLIER_NAME, new { @class = "form-control", @readonly = "readonly", @style = "width:170px;" })
                        </td>
                        <td style="width:150px;">
                            @Html.DisplayFor(x => item.PROD_SHOW_NAME, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
                        </td>

                        <td style="width:180px;">
                            @Html.DisplayFor(x => item.APP_OBJ_DESC, new { @class = "form-control", @readonly = "readonly" })
                        </td>
                        <td style="width:150px;">
                            @Html.DisplayFor(x => item.PROC_NAME, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
                        </td>
                        <td style="width:150px;">
                            @Html.DisplayFor(x => item.ACCT_NAME, new { @class = "form-control", @readonly = "readonly" })
                        </td>
                        <td style="width:170px;">
                            @Html.DisplayFor(x => item.QTY, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
                        </td>


                        <td style="width:100px;">
                            
                                @Html.DisplayFor(x => item.PROD_UNIT, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
                            
                        </td>

                        <td style="width:100px;">
                           
                               $ @Html.DisplayFor(x => item.TOTAL_PRICE, new { @class = "form-control", @readonly = "readonly", @style = "width:150px;" })
                           
                        </td>

                    </tr>
                }


            </table>
</div></div></div>




