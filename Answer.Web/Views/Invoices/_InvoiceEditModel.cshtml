@model Msr.Services.Invoices.ViewModel.InvoiceViewModel

<style>
    .no-border {
        border-bottom: 0px !important;
    }

        .no-border th, .no-border td {
            border: 1px !important;
        }

    .quote-header th {
        text-align: right;
    }

    .items-table th {
        text-align: center;
    }

    .items-table > tbody > tr > td {
        min-height: 35px;
        height: 35px;
    }

    .line-caption {
        font-size: 9px;
        padding-top: 2px !important;
    }
</style>

<link href="~/assets/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />

@Html.Partial("Message")
@using (Html.BeginForm("Save", "Invoices", FormMethod.Post, new { @class = "form-horizontal", @id = "invoice-edit" }))
{
    <p>
    <h4 class="modal-title">Invoice: @Model.InvoiceIdString</h4>
    </p>

    @Html.HiddenFor(model => model.Id, new { @class = "form-control", @id = "editId" })
    @Html.HiddenFor(model => model.Items, new { @class = "form-control", @id = "itemId" })
    @Html.HiddenFor(model => model.InvoiceNumber, new { @class = "form-control" })
    <table class="table quote-header" width="100%">

        <tr>
            <th width="20%">Client:</th>
            <td width="30%">
                @Html.DropDownListFor(model => model.Client, Model.ClientList, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Client, "", new { @class = "text-danger" })
            </td>
            <th style="width:200px;">Invoice Description:</th>
            <td>@Html.EditorFor(model => model.InvoiceDescription, new { htmlAttributes = new { @class = "form-control" } })</td>
        </tr>
        <tr>
            <th align="right">Status:</th>
            <td>
                @Html.DropDownListFor(model => model.Status, Model.StatusList, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
            </td>
            <th align="right">Cust PO #:</th>
            <td>
            </td>
        </tr>
        <tr>
            <th align="right">Invoice Date:</th>
            <td>
                <div class="input-group datepick">
                    @Html.EditorFor(model => model.InvoiceDate, new { htmlAttributes = new { @class = "form-control datepick" } })
                    @Html.ValidationMessageFor(model => model.InvoiceDate, "", new { @class = "text-danger" })
                    <span class="input-group-addon">
                        <span class="glyphicon glyphicon-calendar"></span>
                    </span>
                </div>
                @Html.ValidationMessageFor(model => model.InvoiceDate, "", new { @class = "text-danger" })
            </td>
            <th align="right">Facility:</th>
            <td>
                @Html.DropDownListFor(model => model.InvoiceClass, Model.InvoiceIdList, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
            </td>
        </tr>
    </table>
    <table>
        <tr>
            <td colspan="4">
                <div class="alert alert-info alert-dismissable">
                    List all available (completed and not-yet invoiced) Purchase Items for this client
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <div id="invoice-po-edit" style="height:400px;overflow-y:auto;">
                    @Html.Partial("_InvoiceEditItemsList")
                </div>
            </td>
        </tr>
    </table>
    <table class="table  no-border" width="100%">
        <tr>
            <td align="right">

                <input id="invoice-update" type="button" name="BSUBMIT" class="btn btn-primary" value="Submit">


                <input type="button" name="BCLOSE" class="btn btn-danger" data-dismiss="modal" value="Cancel">
            </td>
        </tr>
    </table>
}

@Scripts.Render("~/bundles/js/jqueryval")
@Scripts.Render("~/bundles/js/invoice-setup")
<script src="~/assets/js/moment.min.js"></script>
<script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
<script src="~/assets/js/dataTables.bootstrap.min.js"></script>
<script>

	$(document).ready(function () {

		var invoice = new Invoice();

		$('.datepick').datetimepicker();

		invoice.CustPoChangeForEdit();

		invoice.UpdateInvoice();

	});


</script>
