@model Msr.Services.Invoices.ViewModel.InvoiceViewModel


<link href="~/assets/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />
<link href="~/assets/css/invoice_tables.css" rel="stylesheet" />

@Html.Partial("Message")
@using (Html.BeginForm("Save", "Invoices", FormMethod.Post, new { @class = "form-horizontal", @id = "invoice-edit" }))
{
    <p>
    <h4 class="modal-title">Invoice: @Model.InvoiceIdString</h4>
    </p>

    @Html.HiddenFor(model => model.Id, new { @class = "form-control", @id = "editId" })
    @Html.HiddenFor(model => model.Items, new { @class = "form-control", @id = "itemId" })
    @Html.HiddenFor(model => model.InvoiceNumber, new { @class = "form-control" })
<div class="container-fluid">
    <div class="row">
        <div class="col-xs-2 control-label">Invoice Date:</div>
        <div class=" col-xs-4">
            <div class="input-group datepick">
                @Html.EditorFor(model => model.InvoiceDate, new { htmlAttributes = new { @class = "form-control datepick" } })
                @Html.ValidationMessageFor(model => model.InvoiceDate, "", new { @class = "text-danger" })
                <span class="input-group-addon">
                    <span class="fa fa-calendar"></span>
                </span>
            </div>
            @Html.ValidationMessageFor(model => model.InvoiceDate, "", new { @class = "text-danger" })
        </div>
        <div class="col-xs-2 control-label">Tax %:</div>
        <div class="col-xs-4">
            <div class="input-group">
                @Html.EditorFor(model => model.Tax, new { htmlAttributes = new { @class = "form-control", @id = "total-tax-amount" } })
                <span class="input-group-addon">%</span>
            </div>
        </div>

    </div>
    <div class="row">

        <div class="col-xs-2 control-label">Description:</div>
        <div class=" col-xs-10">
            @Html.EditorFor(model => model.InvoiceDescription, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div class="alert alert-info alert alert-dismissible fade in" style="margin-bottom:0">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                <i class="fa fa-info"></i> <strong>Please Note!</strong>The following values entered here will filter the PO results listed below
            </div>
        </div>
        <div class="col-xs-2 control-label">Client:</div>
        <div class="col-xs-5">
            @Html.DropDownListFor(model => model.Client, Model.ClientList, new { @class = "form-control", @disabled = "disabled"})
            @Html.ValidationMessageFor(model => model.Client, "", new { @class = "text-danger" })
        </div>
        <div class="col-xs-2 control-label">Facility:</div>
        <div class="col-xs-3">
            @Html.DropDownListFor(model => model.InvoiceClass, Model.InvoiceIdList, new { @class = "form-control", @disabled = "disabled" })
        </div>
    </div>
    <div class="row">
        <div class="col-xs-2 control-label">With Product(s):</div>
        <div class="col-xs-10">
            <!-- this is a placeholder for the model control -->
            <select id="products" name="products[]" multiple="multiple">
                <option value="1">Product 1</option>
                <option value="2">Product 2</option>
                <option value="3">Product 3</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12" id="invoice-po" style="height:400px;">
            <table class="table table-bordered table-striped table-condensed" id="records_table">
                <thead>
                    <tr>
                        <th><span data-toggle="tooltip" data-placement="right" title="Check to add to Invoice. Uncheck to remove."><i class="fa fa-check-square" aria-hidden="true"></i></span></th>
                        <th>Closed On</th>
                        <th>Cust PO #</th>
                        <th>AII PO #</th>
                        <th>AII Item Id</th>
                        <th>Description</th>
                        <th>Qty</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody class="list-content">
                    @Html.Partial("_InvoiceEditItemsList")
                </tbody>
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <input type="button" name="BCLOSE" class="btn btn-danger pull-right" data-dismiss="modal" value="Cancel">
            <input id="invoice-update" type="button" name="BSUBMIT" class="btn btn-primary pull-right" value="Submit" style="margin-right:10px">
            <div id="status-message" class="pull-right"></div>
        </div>
    </div>
</div>
}

@Scripts.Render("~/bundles/js/jqueryval")
@Scripts.Render("~/bundles/js/invoice-setup")
<script src="~/assets/js/moment.min.js"></script>
<script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
<script src="~/assets/js/dataTables.bootstrap.min.js"></script>
<script src="~/assets/js/scrollable_tables.js"  type="module"></script>
<script>

	$(document).ready(function () {

        $('[data-toggle="tooltip"]').tooltip();

        var invoice = new Invoice();

        $('.datepick').datetimepicker();

        $('#products').select2({
            placeholder: "Select Invoiceable Products to filter"
        });

		invoice.CustPoChangeForEdit();

		invoice.UpdateInvoice();

	});


</script>
