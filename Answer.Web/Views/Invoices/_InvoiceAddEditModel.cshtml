@model Msr.Services.Invoices.ViewModel.InvoiceViewModel
<style>
    .no-border {
        border-bottom: 0px !important;
    }

        .no-border th, .no-border td {
            border: 1px !important;
        }

    .quote-header th {
        text-align: right;
    }

    .items-table th {
        text-align: center;
    }

    .items-table > tbody > tr > td {
        min-height: 35px;
        height: 35px;
    }

    .line-caption {
        font-size: 9px;
        padding-top: 2px !important;
    }
</style>
<link href="~/assets/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />
@Html.Partial("Message")
@using (Html.BeginForm("Create", "Invoices", FormMethod.Post, new { @class = "form-horizontal", @id = "FormId" }))
{
    @Html.HiddenFor(model => model.Id, new { @class = "form-control", @id = "editId" })

    @Html.HiddenFor(model => model.Items, new { @class = "form-control", @id = "itemId" })

    @Html.HiddenFor(model => model.InvoiceNumber, new { @class = "form-control", @id = "itemId" })
    <table class="table quote-header" width="100%">

        <tr>
            <th width="20%">Client:</th>
            <td width="30%">
                @Html.DropDownListFor(model => model.Client, Model.ClientList, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Client, "", new { @class = "text-danger" })
            </td>
            <th>Invoice Description :</th>
            <td>@Html.EditorFor(model => model.InvoiceDescription, new { htmlAttributes = new { @class = "form-control" } })</td>
        </tr>
        <tr>
            <th align="right">Status:</th>
            <td>
                @Html.DropDownListFor(model => model.Status, Model.StatusList, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
            </td>
            <th align="right">Cust PO #:</th>
            <td>
                @Html.DropDownListFor(model => model.CustPo, Model.PoList, new { @class = "form-control select" })
                @Html.ValidationMessageFor(model => model.CustPo, "", new { @class = "text-danger" })
            </td>
        </tr>
        <tr>
            <th align="right">Invoice Date</th>
            <td>
                <div class="input-group datepick">
                    @Html.EditorFor(model => model.InvoiceDate, new { htmlAttributes = new { @class = "form-control datepick" } })
                    <span class="input-group-addon">
                        <span class="glyphicon glyphicon-calendar"></span>
                    </span>
                </div>
            </td>
            <th align="right">Invoice #:</th>
            <td>
                @Html.DropDownListFor(model => model.InvoiceClass, Model.InvoiceIdList, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
            </td>

        </tr>

    </table>
    <table>
        <tr>
            <td colspan="4">
                <div class="alert alert-info alert-dismissable">
                    List all available (completed and not-yet invoiced) Purchase Items for this client
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <div id="invoicePo">
                    @Html.Partial("_InvoiceItemsList")
                </div>
            </td>
        </tr>
    </table>

        <table>

            <tr>
                <th align="right">Total Due:</th>
                <td>
                    <div class="input-group">
                        <span class="input-group-addon">$</span>
                        @Html.EditorFor(model => model.TotalDue, new { htmlAttributes = new { @class = "form-control", @id = "totalAmount" } })
                    </div>
                </td>
                <th align="right">Tax %:</th>
                <td>
                    <div class="input-group">
                        @Html.EditorFor(model => model.Tax, new { htmlAttributes = new { @class = "form-control", @id = "totalTaxAmount" } })
                        <span class="input-group-addon">%</span>
                    </div>
                </td>
            </tr>
            <br />
            <br />

            <tr>
                <td colspan="4"></td>
            </tr>
        </table>

        <table class="table  no-border" width="100%">
            <tr>
                <td align="right">

                    <input type="submit" name="BSUBMIT" class="btn btn-primary" value="Submit">


                    <input type="submit" name="BCLOSE" class="btn btn-danger" value="Cancel">
                </td>
            </tr>
        </table>
}
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
<script src="~/assets/js/moment.min.js"></script>
<script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
<script src="~/assets/js/dataTables.bootstrap.min.js"></script>
<script>
    $(document).ready(function () {
        //$('.select').select2();
        $('.datepick').datetimepicker();
        if ('@Model.CustPo' !== '') {
                    $.ajax({
                        type: "POST",
                        url: "/Invoices/InvoiceModelDetail/" + '@Model.CustPo',
                        dataType: 'html',
                        success: function (data) {
                            console.log(data);
                            $('#invoicePo').html(data);

                            var values = '@Model.Items';
                            var items = values.split(",");
                            $("input:checkbox[class=checkAmount]").each(function () {
                                if (jQuery.inArray($(this).val(), items) !== -1) {
                                    $(this).prop('checked', true);
                                }
                            });
                        }
                    });
        }

        $('#CustPo').on('change', function () {
            var po = $(this).val();
            $.ajax({
                type: "POST",
                url: "/Invoices/InvoiceModelDetail/" + po,
                dataType: 'html',
                success: function (data) {
                    console.log(data);
                    $('#invoicePo').html(data);
                }
            });
        });


    });
</script>
