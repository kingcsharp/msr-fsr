@model Msr.Services.Invoices.ViewModel.InvoiceViewModel
    <h4>Invoiced Work Order Items </h4>
@if (Model.InvoiceItemList != null)
{
        for (int i = 0; i < Model.InvoiceItemList.Count; i++)
        {

            <tr>
                <td class="getId">
                    <input name="invoiceDetailListStrings" class="checkAmount" value="@Model.InvoiceItemList[i].FillItemId" id="poId" type="checkBox" @(Model.InvoiceItemList[i].selected ? "checked" : "")>
                    @Html.HiddenFor(x => Model.InvoiceItemList[i].FillItemId)
                </td>
                <td>
                    @string.Format("{0:M/d/yyyy}", Model.InvoiceItemList[i].OpenDate)
                </td>

                <td>
                    @Model.InvoiceItemList[i].CustPurchNum
                </td>
                <td>
                    @Model.InvoiceItemList[i].PurchaseId
                </td>
                <td>
                    @Model.InvoiceItemList[i].PurchaseItemId
                </td>
                <td>
                    @Model.InvoiceItemList[i].Description
                </td>
                <td align="center">
                    @Model.InvoiceItemList[i].FillQty
                </td>
                <td align="right">
                    @if (Model.InvoiceItemList[i].TotalSalePrice.HasValue)
                    {
                        <span> @String.Format("{0:C}", @Model.InvoiceItemList[i].TotalSalePrice)</span>
                    }
                </td>
                <td align="right">
                    @if (Model.InvoiceItemList[i].Amount.HasValue)
                    {
                        <span> @String.Format("{0:C}", @Model.InvoiceItemList[i].Amount)</span>
                    }
                </td>
            </tr>
        }
}

<script src="~/assets/js/grids/invoice-tax-edit.js"></script>
<script type="text/javascript">

    $(document).ready(function () {
		$('input:checkbox[class=checkAmount]').click(function () {

	        CheckBoxSelectionOnEdit($('#editId').val(), this, $(this).closest('tr').find('.poAmount').find('#amountPo').val());
        });
    });

</script>
