@model  Msr.Models.ShowPurchaseStatus.PurchaseItem
    @{
        ViewBag.Title = "Products Actual Part";
    }

    <div class="container-fluid">
        <div class="side-body padding-top">
            <div class="row">
                @Html.Partial("_Purchase", Model)
                <h2 class="page-header">
                    Products Actual Part <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
                </h2>
                <div class="col-lg-12">
                    @Html.Partial("Message")
                    <table id="jqGrid"></table>
                    <div id="jqGridPager"></div>
                </div>
            </div>
        </div>
    </div>

    @section scripts
{
        @Scripts.Render("~/bundles/js/jqgrid")
        <script src="~/assets/js/grids/showpruchasestatus.js"></script>
        <script>
        $(document).ready(function() {
            LoadShowPurchaseStatusGrid('@Url.Action("ShowPurchaseStatusData", "ShowPurchaseStatus", new { id = ViewBag.TaskId })');
        });
        </script>

    }

