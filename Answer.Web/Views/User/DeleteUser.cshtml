@model Answer.Web.ViewModel.EditUserViewModel
@{
    ViewBag.Title = "Delete User";
}

<link rel="stylesheet" type="text/css" href="/assets/css/themes/flat-blue.css">

<link rel="stylesheet" type="text/css" href="/assets/css/style.css">
<link rel="stylesheet" type="text/css" href="/assets/css/hopscotch.css">

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">Delete User
                </h2>
            <div class="col-lg-10">
                
                @using (Html.BeginForm("DeleteUser", "User", FormMethod.Post, new {@class = "form form-horizontal", role = "form"}))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x=>x.UserSummary.Id)

                    <h2>Are you sure, you want to delete "@Model.UserSummary.UserName"</h2>

                    
                    <div class="form-group">
                        <div class="col-lg-offset-2 col-lg-10">
                            <button type="submit" class="btn btn-success">Submit</button>
                            <a href="~/user/master" class="btn btn-warning">Cancel</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>





@section scripts
{

<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
        
}

