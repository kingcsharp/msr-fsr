@using Msr.Infrastructure.Common.Constansts
@model Msr.Services.EquipmentMaintenances.ViewModels.EditEquipmentMaintainanceViewModel
@{
    ViewBag.Title = "Update Equipment Maintenance";
}
<link rel="stylesheet" type="text/css" href="/assets/css/themes/flat-blue.css">
<link rel="stylesheet" type="text/css" href="/assets/css/ui.jqgrid-bootstrap-ui.css">
<link rel="stylesheet" type="text/css" href="/assets/css/ui.jqgrid.css">
<link rel="stylesheet" type="text/css" href="/assets/css/style.css">
<link rel="stylesheet" type="text/css" href="/assets/css/hopscotch.css">


<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">Edit Equipment Maintenance</h2>
        </div>
        <div class="row" id="maintenanceForm">
            <div class="col-lg-12">
                @using (Html.BeginForm("Edit", "EquipmentMaintenance", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="ObjectId" value="@Model.ObjectId" />
                    @Html.Partial("Message")

                    <fieldset>
                        @Html.Partial("_Controls")
                    </fieldset>
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    @Scripts.Render("~/bundles/js/jqueryval")
    @Scripts.Render("~/bundles/js/fileinput")

    <script type="text/javascript">

        $(document).ready(function () {
            $('.select').select2();

            var hasProductionManagerRole = '@Model.Roles.Any(x => x.Role_Name == RoleConstants.ProductionManager)'
            var hasMaintenanceTechnician = '@Model.Roles.Any(x => x.Role_Name == RoleConstants.MaintenanceTechnician)'

            $("#PrimaryLocation").hide();
            $("#SubLocation1").hide();


            if (hasProductionManagerRole === 'True') {
                $('.readonly').attr("disabled", true);
            }
            else if (hasMaintenanceTechnician === 'True') {
                $(".lastcompletedate").prop("readonly", true);
                $('.readonly').attr("disabled", true);
            } else {
                $('.readonly').attr("disabled", true);
                $(".lastcompletedate").prop("readonly", true);
                $('.readonly').attr("disabled", true);
                $('.submit-form-equipment').hide();
            }

            $('.datepick').datetimepicker();

            $('.dateSelecter').click(function(parameters) {
                $(this).find('.datepick').focus();
            });


            var selectRoomEquipment = $(".selectroomequipment").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: false,
                allowClear: true,
                placeholder: "Select Room/Equipment",
                formatNoMatches: function () {
                    return '';
                }
            });


            $("#btnSubmit").click(function () {
                $(".selectroomequipment").prop("disabled", false);
            }); 
        });
    </script>
}
