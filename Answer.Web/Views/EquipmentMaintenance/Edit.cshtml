@using Msr.Infrastructure.Common.Constansts
@model Msr.Services.EquipmentMaintenances.ViewModels.EditEquipmentMaintainanceViewModel
@{
    ViewBag.Title = "Update Equipment Maintenance";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">Edit Equipment Maintenance</h2>
        </div>
        <div class="row" id="maintenanceForm">
            <div class="col-lg-12">
                @using (Html.BeginForm("Edit", "EquipmentMaintenance", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="ObjectId" value="@Model.ObjectId" />
                    <input type="hidden" name="PrimaryLocationId" value="@Model.PrimaryLocationId" />
                    @Html.Partial("Message")

                    <fieldset>
                        @Html.Partial("_Controls")
                    </fieldset>
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    @Scripts.Render("~/bundles/js/jqueryval")

    <script type="text/javascript">

        $(document).ready(function () {

            var hasProductionManagerRole = '@Model.Roles.Any(x => x.Role_Name == RoleConstants.ProductionManager)'
            var hasMaintenanceTechnician = '@Model.Roles.Any(x => x.Role_Name == RoleConstants.MaintenanceTechnician)'

            if (hasProductionManagerRole === 'True') {
                $('.readonly').attr("disabled", true);
            }
            else if (hasMaintenanceTechnician === 'True') {
                $(".lastcompletedate").prop("readonly", true);
                $('.readonly').attr("disabled", true);
            } else {
                $('.readonly').attr("disabled", true);
                $(".lastcompletedate").prop("readonly", true);
                $('.readonly').attr("disabled", true);
                $('.submit-form-equipment').hide();
            }

            $('.datepick').datetimepicker();

            $('.dateSelecter').click(function(parameters) {
                $(this).find('.datepick').focus();
            });


            $("#PrimaryLocationId").change(function() {

                var id = $("#PrimaryLocationId").val();
                eLoaderOpen()
                $.ajax({
                    type: 'POST',
                    url: "/EquipmentMaintenance/GetChildLocations/" + id,
                    success: function(data) {

                        $("#SubLocationFirstId").empty();
                        $("#SubLocationSecondId").empty();

                        if (data === '') {
                            $("#SubLocationFirstId").prop('disabled', true);
                            $("#SubLocationSecondId").prop('disabled', true);
                        } else {
                            $("#SubLocationFirstId").prop('disabled', false);
                            $("#SubLocationSecondId").prop('disabled', false);

                            $.each(data.locations,
                                function(i, row) {
                                    $("#SubLocationFirstId")
                                        .append("<option value='" + row.Value + "'>" + row.Text + "</option>");
                                });
                        }
                        eLoaderClose()
                    },
                    error: function (error) {
                        eLoaderError(error)
                    }
                });

            });


            $("#SubLocationFirstId").change(function() {

                var id = $("#SubLocationFirstId").val();
                eLoaderOpen()
                $.ajax({
                    type: 'POST',
                    url: "/EquipmentMaintenance/GetChildLocations/" + id,
                    success: function(data) {

                        $("#SubLocationSecondId").empty();

                        if (data === '') {
                            $("#SubLocationSecondId").prop('disabled', true);
                        } else {
                            $("#SubLocationSecondId").prop('disabled', false);
                            $.each(data.locations,
                                function(i, row) {
                                    $("#SubLocationSecondId")
                                        .append("<option value='" + row.Value + "'>" + row.Text + "</option>");
                                });
                        }
                        eLoaderClose()
                    },
                    error: function (error) {
                        eLoaderError(error)
                    }
                });

            });

        });
    </script>
}
