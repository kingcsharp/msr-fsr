        //    multiple: false,
        //    allowClear: true,
        //    placeholder: "Select Room/Equipment",
        //    formatNoMatches: function () {
        //        return '';
        //    }
        //});

        @*var valueRoomEquipment = '@selectRoomEquipment';
        var selectedRoomEquipmentList = valueRoomEquipment.split(",");
        var currentRoomEquipmentList = selectedRoomEquipmentList;*@

        //$(".selectroomequipment").val(selectedRoomEquipmentList).trigger("change");




