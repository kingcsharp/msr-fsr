@using Msr.Infrastructure.Common.Constansts
@model Msr.Services.EquipmentMaintenances.ViewModels.CreateEquipmentMaintenanceViewModel
@{
    ViewBag.Title = "Create Equipment Maintenance";
}
<link href="~/assets/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />
<link rel="stylesheet" type="text/css" href="/assets/css/themes/flat-blue.css">
<link rel="stylesheet" type="text/css" href="/assets/css/ui.jqgrid-bootstrap-ui.css">
<link rel="stylesheet" type="text/css" href="/assets/css/ui.jqgrid.css">
<link rel="stylesheet" type="text/css" href="/assets/css/style.css">
<link rel="stylesheet" type="text/css" href="/assets/css/hopscotch.css">

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">Create Equipment Maintenance</h2>
        </div>
        <div class="row" id="maintenanceForm">
            <div class="col-lg-12">
                @using (Html.BeginForm("Create", "EquipmentMaintenance", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    @Html.Partial("Message")

                    <fieldset>
                        <div class="form-group">
                            <label class="col-md-2 control-label" for="scancode">Scan Barcode</label>
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.ScanBarcode, new { htmlAttributes = new { @class = "form-control input-md", @placeholder = "Put cursor here to scan" } })
                                @Html.ValidationMessageFor(model => model.ScanBarcode, "", new { @class = "text-danger" })
                                <span class="help-block">Or Manually select Location below</span>
                                <div class="alert alert-info">Entry of barcode above will update the select values below on match</div>
                                <div id="error" class="alert alert-danger"></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-2 control-label" for="Sublocation2">Select Room/Equipment</label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.RoomEquipmentId, Model.RoomEquipmentList, "Please Select a Room/Equipment", new { @class = "form-control select selectroomequipment" })
                                @Html.ValidationMessageFor(model => model.RoomEquipmentId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-2 control-label" for="DateTime">Created On</label>
                            <div class="input-group datepick  col-md-8">
                                @Html.EditorFor(model => model.DateTime, new { htmlAttributes = new { @class = "form-control datepick ", @placeholder = "Current Date Time", @style = "width:530px; margin-left:13px;", } })
                                <div style="width:80px; height:35px;margin-left:515px;">
                                    <span class="input-group-addon"><span class="glyphicon glyphicon-th" style="height:20px;"></span></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-md-2 control-label" for="EquipmentTroubleState">Trouble State</label>
                            <div class="col-md-8">
                                <div class="checkbox">
                                    <label for="EquipmentState-0">
                                        @Html.CheckBoxFor(model => model.TroubleState, new { @class = "checkbox" })
                                        @Html.ValidationMessageFor(model => model.TroubleState, "", new { @class = "text-danger" })
                                        Yes
                                    </label>
                                </div>
                            </div>
                        </div>
                        @if (Model.Roles.Any(x => x.Role_Name == RoleConstants.ProductionManager || x.Role_Name == RoleConstants.MaintenanceTechnician))
                        {
                            <div class="form-group">
                                <label class="col-md-2 control-label" for="comments">Comments</label>
                                <div class="col-md-8">
                                    @Html.TextAreaFor(model => model.Comments, new { @class = "form-control input-md" })
                                </div>
                            </div>
                        }
                        else
                        {
                            @Html.HiddenFor(model => model.Comments)
                        }
                        @if (Model.Roles.Any(x => x.Role_Name == RoleConstants.ProductionManager))
                        {
                            <div class="form-group">
                                <label class="col-md-2 control-label" for="PMLastCompletedDate">PM Last Completed Date</label>
                                <div class="col-md-8">
                                    <div style="width: 91%;float: left">
                                        @Html.EditorFor(model => model.PemLastCompletedDate, new { htmlAttributes = new { @class = "form-control datepick lastcompletedate", @placeholder = "PM Last Completed Date", @style = "", } })
                                        @Html.ValidationMessageFor(model => model.PemLastCompletedDate, "", new { @class = "text-danger" })
                                    </div>
                                    <div style="width: 9%; height: 35px;float: left">
                                        <span class="input-group-addon"><i class="fa fa-calendar" style="height: 19px;"></i></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-md-2 control-label" for="scancode">Frequency Field:</label>
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.FrequencyField, new { htmlAttributes = new { @class = "form-control input-md", @placeholder = "" } })
                                    @Html.ValidationMessageFor(model => model.FrequencyField, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        }
                        else
                        {
                            @Html.HiddenFor(model => model.PemLastCompletedDate)
                            @Html.HiddenFor(model => model.FrequencyField)
                        }
                        <div class="form-group">
                            <label class="col-md-2 control-label" for="save"></label>
                            <div class="col-md-8">
                                <input type="submit" value="Submit" class="btn btn-success" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-danger" })
                            </div>
                        </div>
                    </fieldset>
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    @Scripts.Render("~/bundles/js/jqueryval")
    <script type="text/javascript">

        $(document).ready(function () {
            $('.select').select2();
            $('#error').hide();
            $('.datepick').datetimepicker();

            $('.dateSelecter').click(function (parameters) {
                $(this).find('.datepick').focus();
            });

            $('#ScanBarcode').on('keyup', function () {
                if ($(this).val().length > 3) {

                    var id = $(this).val();
                    eLoaderOpen();
                    $.ajax({
                        type: "POST",
                        url: "/EquipmentMaintenance/GetChildLocations/" + id,
                        success: function (data) {
                            if (data.locations === "") {
                                $('#error').html('Location not found, please select manually');
                                $('#error').show();
                                //$("#RoomEquipmentId").empty();

                                //$("#RoomEquipmentId").prop('disabled', true);
                            } else {
                                //$("#RoomEquipmentId").empty();

                                //if (data.locations !== "") {
                                //    $.each(data.locations, function (i, row) {
                                //        $("#RoomEquipmentId").append("<option value='" + row.Value + "'>" + row.Text + "</option>");
                                //    });
                                //    var id1 = $("#RoomEquipmentId").val();
                                //}

                            }
                            eLoaderClose();
                        },
                        error: function (error) {
                            eLoaderError(error);
                        }
                    });
                }
            });
        });


        //var selectRoomEquipment = $(".selectroomequipment").select2({
