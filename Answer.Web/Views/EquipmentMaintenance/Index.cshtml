@{
    ViewBag.Title = "Utilities";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-plus-square"></span>
                Equipment Maintenance @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row row-bottom-buttons">
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
            <a href="~/EquipmentMaintenance/Create" class="btn btn-success help-btn">Add</a>
        </div>

    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-equipment-maintenance")

    <script type="text/javascript">
        $(document).ready(function () {

            Msr.EquipmentGrid.LoadEquipment('@ViewBag.HasMaintenanceTechnicianRole','@ViewBag.HasProductionManagerRole',@Html.Raw(Json.Encode(ViewBag.AssignedTo)));
        });
    </script>
}
