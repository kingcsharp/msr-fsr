@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Part Types";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-list"></span>
                Part Types
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-part-type"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row">
            <a href="@Url.Action("Create", "PartTypes")" class="btn btn-success help-btn">Add</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-parttype")

    <script type="text/javascript">
        $(document).ready(function () {
            Msr.PartTypeGrid.LoadPartTypesGrid('@Url.Action("PartTypesData", "PartTypes")');
        });
    </script>

}
