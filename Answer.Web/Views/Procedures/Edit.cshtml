@model Msr.Services.Procedures.ViewModels.SaveProcedureViewModel
@{
    ViewBag.Title = "Update Procedure";

}
<link rel="stylesheet" type="text/css" href="/assets/css/themes/flat-blue.css">
<link rel="stylesheet" type="text/css" href="/assets/css/ui.jqgrid-bootstrap-ui.css">
<link rel="stylesheet" type="text/css" href="/assets/css/ui.jqgrid.css">
<link rel="stylesheet" type="text/css" href="/assets/css/style.css">
<link rel="stylesheet" type="text/css" href="/assets/css/hopscotch.css">

@Styles.Render("~/bundles/css/fileinput")

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Procedure

            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                @using (Html.BeginForm())
            {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Id" name="Id" value="@Model.Id" />
                    <input type="hidden" id="ObjectId" name="ObjectId" value="@Model.ObjectId" />
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="col-sm-6 col-md-8 col-lg-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.Verb, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.Verb, Model.VerbList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.Verb, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.SystemId, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.SystemId, Model.SystemList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.SystemId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.Partial("_FileUpload")
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.TextAreaFor(model => model.Comments, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Comments, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-9 col-md-6 col-lg-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.SecurityLevel, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.SecurityLevel, Model.SecurityLevelList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.SecurityLevel, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Roles, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.Roles, Model.RolesList, new { @class = "form-control select selectroles" })
                                    @Html.ValidationMessageFor(model => model.Roles, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.StepInAp, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.StepInAp, Model.SetpInApList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.StepInAp, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Duration, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.Duration, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.DurationType, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.DurationType, Model.DurationTypeList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.DurationType, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.WipMsg, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.WipMsg, Model.WipMsgList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.WipMsg, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.IsActive, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-offset-1 col-md-8">
                                <input type="submit" id="rollBackButton" value="Update" name="command" class="btn btn-success" />
                                <a href="@Url.Action("Index", "Procedures")" class="btn btn-warning">Cancel</a>

                            </div>
                        </div>
                    </div>
                }
                @Html.Partial("Steps", Model.GetStepDataResults)
            </div>
        </div>
    </div>
</div>

@section scripts
{
    @{
        var selectRoles = string.Join(",", Model.Roles);
    }

    @Scripts.Render("~/bundles/js/jqueryval")
    @Scripts.Render("~/bundles/js/fileinput")
    <script src="~/assets/js/common/documentFiles.js"></script>
    <script src="~/assets/js/grids/comman.js"></script>
    <script src="~/assets/js/comman.js"></script>
    <script src="~/assets/js/procedure-steps.js"></script>
    <script src="https://code.jquery.com/ui/1.10.4/jquery-ui.js"></script>

    <script type="text/javascript">

     
        var fileUploaderGrid = new FileUploaderGrid();

        $(document).ready(function() {


            $('.delete-step').on('click', function(e) {
                    e.preventDefault();

                    var formId = $(this).closest('form').attr('id');

                    eModal.confirm('Are you sure?').then(confirmCallback);

                    function confirmCallback() {
                        $('.step-action').val('delete');
                        $('#' + formId + '').submit();
                    }

                });


            $("step-form").submit(function(e) {
                $('.formPostStep .submitselect option').prop('selected', true);
            });

            $('.addNewStep').click(function(parameters) {
                eLoaderOpen();
                var procObjectId = $('#ProcObjectId').val();
                var procedure = $('#Procedure').val();
                $.ajax({
                    type: "POST",
                    url: '/Procedures/SaveStep',
                    data: { ProcObjectId: procObjectId, Procedure: procedure },
                    dataType: 'html',
                    success: function(data) {
                        location.reload();
                    },
                    error: function(error) {
                        eLoaderError(error);
                    }
                });

            });

            var fileUploader = new FileUploader();
            fileUploader.InitEditUploader($('#input-files'),
                '@Url.Action("FileUploaderBootstrap", "Doc")',
                [@Html.Raw(ViewBag.Preview)],
                @Html.Raw(ViewBag.PreviewConfig),
                '@Model.ObjectId',
                true);

            fileUploaderGrid.SetupSelectImage();

            $(".select").select2();

            var selectRoles = $(".selectroles").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select Roles",
                formatNoMatches: function() {
                    return '';
                }
            });
            var values = '@selectRoles';
            var selectedRoles = values.split(",");
            selectRoles.val(selectedRoles).trigger("change");

        });

        function SelectIds() {
            fileUploaderGrid.SelectIds();
        }

    </script>
}