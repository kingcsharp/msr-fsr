@model IEnumerable<Msr.Services.Procedures.ViewModels.ProcedureImportViewModel>
@{
    ViewBag.Title = "Parts Import";
}
<style>
    .validation-summary-errors {
        color: red;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Add File<button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-10">
                <div class="form-horizontal">
                    @Html.Partial("Message")
                    <div class="row">
                        <div class="alert alert-warning">
                            The Import File must be an Excel document<br />
                            It must have these columns in any order: ProcedureId,ProcedureName,AnsId,ProcType<br />
                            The file must have the column names as the first row capitalized and spelled like above<br />
                            The field definitions are: * means required<br />
                            ProcedureId* = unique ID in the external database or ANSWER for the Procedure.<br />
                            ProcedureName* = Name of the procedure.<br />
                            @*STEP_TEXT* = Text for the step***
                                PRINT_ORDER* = the print order of the step.***
                                REF_DOC_ID = The ID of the reference doc in ANSWER or the external DB.***
                                COMMENT = The Comment for the step***
                                STEP_TIME = Hours for each step***
                                EXTRA_NOTE1, EXTRA_NOTE2, EXTRA_NOTE3, EXTRA_NOTE4, EXTRA_NOTE5 = Extra information to go in the step text.***
                                ANS_ID = If you manually entered this procedure then you should put the ANSWER ID here otherwise duplicates will be made.***
                                SERIALIZE = NORMAL or null if regular serialize. MONITOR if need to use a monitor for serial number collection. ****@
                            PROC_TYPE = The name of the procedure type you want the procedure to have<br />
                            @*Info about the roles below:***
                                Tech Role Does the steps - Required***
                                Receiving Role receives the part into the shop - Leave blank for no receiving step***
                                Return Role returns the part to the customer site - Leave blank for no return step***
                                Final Inspection Role - Leave blank for no final inspection***
                                Procedure Type - This will add a procedure type to your procedure - Leave blank for no procedure type****@
                        </div>
                        <div class="alert alert-info">
                            <a class="btn btn-link" href="https://ra2.s3.amazonaws.com/Answer2/51029aae-b96f-46e5-bf04-b7ac1e9dffbc-Part.xlsx" target="_blank">Download excel file sample </a>
                        </div>
                    </div>

                    @using (Html.BeginForm("Import", "Procedures", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()
                        <label class="btn btn-primary" for="postedFile">
                            <input id="postedFile" type="file" name="postedFile" accept="application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" style="display:none" onchange="$('#upload-file-info').html(this.files[0].name)" />
                            Browse...
                        </label>
                        <span class='label label-info' id="upload-file-info"></span><br />
                        <input type="submit" class="btn btn-success" value="Process Import" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>