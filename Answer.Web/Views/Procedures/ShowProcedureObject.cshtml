@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "List of Parts Provide Stay";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Parts <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            @*<a href="~/Procedures/Index" class="btn btn-success help-btn">Add</a>*@
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")

    <script src="~/assets/js/grids/ProcedureObjectStay.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            LoadProcedureObjectstepGrid('@Html.Raw(Url.Action("ShowProcedureView", "Procedures",new{ Pid = ViewBag.id, ViewBag.relation }))',
                '@ViewBag.id',
            '@ViewBag.relation');
        });
    </script>
}
