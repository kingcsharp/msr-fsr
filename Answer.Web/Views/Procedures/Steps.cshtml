@model Msr.Services.Procedures.Messages.GetStepDataResult

@{
    ViewBag.Title = ViewBag.ProdecureName + " :Steps";
}

<div class="container-fluid">

    <div class="side-body padding-top">

        <div class="row">
            <h2 class="page-header">
                @ViewBag.ProdecureName :Steps
            </h2>

            <div class="panel-body bio-graph-info">
                @Html.Partial("Message")

                @using (Html.BeginForm("SaveStep", "procedures", FormMethod.Post, new { @class = "form form-horizontal" }))
                {
                    <div class="row">
                        <div class="col-lg-10">
                            <div class="form-horizontal">

                                <input type="hidden" name="ProcObjectId" value="@ViewBag.ProcObjectId" />

                                <div class="form-group">
                                    <label class="control-label col-md-2">Template:</label>
                                    <div class="col-md-5">
                                        @Html.DropDownList("Procedure", (IEnumerable<SelectListItem>)ViewBag.Accounts, null, new { @class = "form-control", name = "Procedure" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-md-offset-2 col-md-10">
                                        <button type="submit" class="btn btn-success">Add New Step</button>
                                        <a href="@Url.Action("Edit", "Procedures", new{ id= ViewBag.ProcObjectId })" class="btn btn-warning">Cancel</a>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
            <ul id="sortable" class="sortable-container">
                @foreach (var step in Model.GetStepDataResults)
                {

                    <li id="@step.Print_Order,@step.Id" data-MainObjectId="@ViewBag.ProcObjectId" class="sortable-item">
                        <span class="fa fa-arrows handle sortable-fa" style="float: left;margin: -4px;"></span>

                        @using (Html.BeginForm("EditStep", "Procedures", FormMethod.Post, new { @class = "formPost" }))
                        {

                            <input type="hidden" name="procstepId" value="@ViewBag.ProcObjectId" />
                            <input type="hidden" id="StepId" name="Id" value="@step.Id" />
                            <div class="procedure-step row" id='step1'>

                                <div class="col-lg-6 ">

                                    <table class="table table-condensed left-table">
                                        <tr>
                                            <th style='width: 95px'>Step Number:</th>
                                            <td class='step-number'>@step.Print_Order</td>
                                            <th style='width: 95px'>Predecessor:</th>
                                            <td><input type='text' name='a0' class='form-control' value='@step.Id' /></td>
                                            <th>Location:</th>
                                            <td><input type='text' name='b0' class='form-control' value='Non-CU S/R' /></td>
                                        </tr>
                                        <tr>
                                            <th>Step Title:</th>
                                            <td colspan=5><input type='text' name='c0' class='form-control pre-populated' value='Test Inception' /></td>
                                        </tr>
                                        <tr>
                                            <th>Step Text:</th>
                                            <td colspan="5">@Html.TextArea("Step_Text", step.Step_Text, new { @class = "form-control" })</td>
                                        </tr>
                                        <tr>
                                            <td></td>
                                            <th colspan="2" align='right'>Labor Time:</th>
                                            <td>
                                                <div class="input-group">
                                                    <input type='number' name='e0' class='form-control pre-populated' value='15' />
                                                    <span class="input-group-addon">mins.</span>
                                                </div>
                                            </td>
                                            <th align='right'>Equipment Time:</th>
                                            <td>
                                                <div class="input-group">
                                                    <input type='number' name='f0' class='form-control pre-populated' value='@step.Duration' />
                                                    <span class="input-group-addon">mins.</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-lg-2">
                                    <table class="table">
                                        <tr>
                                            <th>Auth Roles:</th>
                                        </tr>
                                        <tr>
                                            <td>
                                                @Html.ListBox("GetStepLabors", step.GetStepLaborsList, new { @class = "form-control submitselect" })
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-lg-3">
                                    <table class="table">
                                        <tr>
                                            <th>Monitors:</th>
                                        </tr>
                                        <tr>
                                            <td>
                                                <ul class="nav nav-tabs" role="tablist">
                                                    @foreach (var item in @step.GetMoniterViewModels)
                                                    {
                                                        <li><a data-toggle="modal" data-procedure-name="@ViewBag.ProdecureName" data-moniter-type="@item.Monitor_Type" data-fail-action="@item.Fail_Action" data-description="@item.Description" data-object-id="@item.Id" data-related-object="@item.Related_Object_Id" data-step-id="@item.Step_Id" data-target="#addMoniterModal" href="#monitor_@item.Id">Monitor @item.Id</a> <span style="cursor: pointer;" class="deleteMoniter" data-ProcedureName="@ViewBag.ProdecureName" data-ProcId="@item.Related_Object_Id" data-id="@item.Id"> x </span></li>
                                                    }
                                                    <li>
                                                        <a data-procedure-name="@ViewBag.ProdecureName" data-moniter-type="@step.AddMonitorForProcedureViewModel.Monitor_Type" data-fail-action="@step.AddMonitorForProcedureViewModel.Fail_Action" data-description="@step.AddMonitorForProcedureViewModel.Description" data-object-id="@step.AddMonitorForProcedureViewModel.Id" data-related-object="@ViewBag.ProcObjectId" data-step-id="@step.Id" data-toggle="modal" data-target="#addMoniterModal" href="#" data-value="@step.Id" class="add-monitor_@step.Id add-monitor">+ Add Monitor</a>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                            </div>
                            <input type="submit" class="btn btn-success" value="Save" />
                        }
                    </li>

                }
            </ul>
        </div>
    </div>

</div>
<div id="addMoniterModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width: 50%;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Moniter</h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" id="submit-moniter-form" class="btn btn-info"><i class="fa fa-print"></i> Submit</button>
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>

<style type="text/css">
    .sortable-container {
        padding: 0;
    }

    .sortable-item {
        list-style-type: none;
        padding: 10px;
        margin: 10px 0;
        border: 1px solid #1ABC9C;
        border-left-width: 5px;
        border-radius: 3px;
        background-color: #EFEFEF;
    }
</style>
@section scripts{
    <script src="https://code.jquery.com/ui/1.10.4/jquery-ui.js"></script>
    <script type="text/javascript">
        var referenceMoniter;
        $('#addMoniterModal').on('show.bs.modal',
            function (event) {
                var button = $(event.relatedTarget);
                //var id = button.data('id');
                var moniterType = button.data('moniter-type');
                var failAction = button.data('fail-action');
                var description = button.data('description');
                var objectId = button.data('object-id');
                var relatedObject = button.data('related-object');
                var stepId = button.data('step-id');
                var procedureName = button.data('procedure-name');
                var modal = $(this);
                modal.find('.modal-body').html('');
                $.ajax({
                    type: "GET",
                    url: '/Procedures/AddMoniter?moniterType=' + moniterType + '&failAction=' + failAction + '&description=' + description + '&objectId=' + objectId + '&relatedObject=' + relatedObject + '&stepId=' + stepId + '&procedureName=' + procedureName,
                    dataType: 'html',
                    success: function (data) {
                        modal.find('.modal-body').html(data);
                    },
                    error: function () {

                    }
                });
            });

        $(document).ready(function () {
            $('#submit-moniter-form').on('click',
                function () {
                    $('#moniter-form').submit();
                });

            $("#sortable").sortable({
                handle: '.sortable-fa',
                delay: 100,
                cancel: "input,textarea,select",

                placeholder: "highlight",
                start: function (event, ui) {
                    console.log("Start");
                    //alert("Start");
                },
                change: function (event, ui) {
                    console.log("Change");
                },
                update: function (event, ui) {
                    console.log("Update");

                    var productOrder = $(this).sortable('toArray');
                    console.log(productOrder);

                    var procObjectId = $(this).find('li').data("mainobjectid");

                    $.ajax({
                        type: "POST",
                        url: "/Procedures/ReorderSteps",
                        dataType: 'json',
                        data: {
                            array: productOrder, procObjectId: procObjectId

                        },
                        success: function (data) {
                            location.reload();
                        },
                        error: function () {
                            alert("something went wrong");
                        }
                    });
                }

            }).disableSelection();
            $('#monitor1-switch').bootstrapSwitch();
            $('#monitor1-switch').on('switchChange.bootstrapSwitch', function (e, state) {
                e.preventDefault();
                if (state) {
                    $("#1a tr.on-off-row").show();
                    console.log('on');
                } else {
                    $("#1a tr.on-off-row").hide();
                    console.log('off');
                }
            });

            $('#monitor2-switch').bootstrapSwitch();
            $('#monitor2-switch').on('switchChange.bootstrapSwitch', function (e, state) {
                e.preventDefault();
                if (state) {
                    $("#2a tr.on-off-row").show();
                    console.log('on');
                } else {
                    $("#2a tr.on-off-row").hide();
                    console.log('off');
                }
            });

            $(".nav-tabs").on("click", "a", function (e) {
                    e.preventDefault();
                    if (!$(this).hasClass('add-monitor')) {
                        $(this).tab('show');
                    }
                })
                .on("click", "span", function () {
                    var clicked = $(this);
                    eModal.confirm(
                            'Are you sure?')
                        .then(confirmCallback, optionalCancelCallback);

                    function confirmCallback() {

                        var id = clicked.data('id');
                        var stepId = clicked.data('procid');
                        var ProdecureName = clicked.data('ProcedureName');
                        if (stepId == null && ProdecureName == null) {
                            location.reload();
                        }
                        else {
                            $.ajax({
                                type: "POST",
                                url: "/Procedures/DeleteStep",
                                dataType: 'json',
                                data: { id: id, procStepId: stepId, ProdecureName: ProdecureName },
                                success: function (data) {
                                    location.reload();
                                },
                                error: function () {
                                    alert("something went wrong");
                                }
                            });
                        }


                    }

                    function optionalCancelCallback() {
                        console.log("Cancel");
                    }

                });
            $("form").submit(function (e) {
                $('.submitselect option').prop('selected', true);
            });

            $('.deleteMoniter').click(function (e) {

            });
        });
    </script>
}



