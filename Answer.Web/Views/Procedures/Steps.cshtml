@model Msr.Services.Procedures.Messages.GetStepDataResult

<div class="row">
    
    <h2 class="page-header">
        Steps
    </h2>

    <div class="panel-body bio-graph-info">
        <div class="row">
            <div class="col-lg-10">
                <div class="form-horizontal">
                    <input type="hidden" id="ProcObjectId" name="ProcObjectId" value="@ViewBag.ProcObjectId"/>
                    <div class="form-group">
                        <label class="control-label col-md-1">Template:</label>
                        <div class="col-md-4">
                            @Html.DropDownList("Procedure", (IEnumerable<SelectListItem>) ViewBag.Accounts, null, new {@class = "form-control", name = "Procedure"})
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-success addNewStep">Add New Step</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <ul id="sortable" class="sortable-container">
        @for (int i = 0; i < Model.GetStepDataResults.Count; i++)
        {

            <li id="@Model.GetStepDataResults[i].Print_Order,@Model.GetStepDataResults[i].Id" data-MainObjectId="@ViewBag.ProcObjectId" class="sortable-item">
                <span class="fa fa-arrows handle sortable-fa" style="float: left; margin: -4px;"></span>

                @using (Html.BeginForm("EditStep", "Procedures", FormMethod.Post, new {@class = "formPostStep"}))
                {

                    <input type="hidden" name="procstepId" value="@ViewBag.ProcObjectId"/>
                    <input type="hidden" id="StepId" name="Id" value="@Model.GetStepDataResults[i].Id"/>
                    <div class="procedure-step row" id='step1'>

                        <div class="col-lg-6 ">
                            l

                            <table class="table table-condensed left-table">
                                <tr>
                                    <th style='width: 95px'>Step Number:</th>
                                    <td class='step-number'>@Model.GetStepDataResults[i].Print_Order</td>
                                    <th style='width: 95px'>Predecessor:</th>
                                    <td><input type='text' name='a0' class='form-control' value='@Model.GetStepDataResults[i].Id'/></td>
                                </tr>
                                <tr>
                                    <th>Step Title:</th>
                                    <td colspan=5><input type='text' name='c0' class='form-control pre-populated' value='@Model.GetStepDataResults[i].StepTitle' disabled="disabled"/></td>
                                </tr>
                                <tr>
                                    <th>Step Text:</th>
                                    <td colspan="5">@Html.TextAreaFor(model => Model.GetStepDataResults[i].Step_Text, new {@class = "form-control"})</td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <th colspan="2" align='right'>Labor Time:</th>
                                    <td>
                                        <div class="input-group">
                                            <input type='number' name='e0' class='form-control pre-populated' value='15'/>
                                            <span class="input-group-addon">mins.</span>
                                        </div>
                                    </td>
                                    <th align='right'>Equipment Time:</th>
                                    <td>
                                        <div class="input-group">
                                            <input type='number' name='f0' class='form-control pre-populated' value='@Model.GetStepDataResults[i].Duration'/>
                                            <span class="input-group-addon">mins.</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-lg-2">
                            <table class="table">
                                <tr>
                                    <th>Auth Roles:</th>
                                </tr>
                                <tr>
                                    <td>
                                        @Html.ListBox("GetStepLabors", Model.GetStepDataResults[i].GetStepLaborsList, new {@class = "form-control submitselect"})
                                    </td>
                                </tr>
                                <tr>
                                    <th>Reference Object:</th>
                                </tr>
                                <tr>
                                    <td>
                                        @Html.ListBoxFor(m => Model.GetStepDataResults[i].REFERENCE_OBJECT, Model.GetStepDataResults[i].ListReferenceObjects, new { @id = "ReferenceObject_" + i, @class = "form-control submitselect selectReferenceObject", multiple = "multiple" })
                                        @Html.ValidationMessageFor(model => Model.GetStepDataResults[i].REFERENCE_OBJECT, "", new { @class = "text-danger" })
                                        <div style="float: right;">
                                            <span class="data-toggle=" data-call-back-id="ReferenceObject_@i" data-toggle="modal" data-target="#select-objects"><i class="icon fa fa-file"></i></span>
                                            <span class="deletefiles" data-call-back-id="ReferenceObject_@i"><i class="icon fa fa-trash-o"></i></span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-lg-4">

                            <ul class="nav nav-tabs">
                                <li class="active"><a href="#">Monitors</a></li>
                            </ul>

                            <table style="width: 100%" class="table table-condensed">
                                <thead>
                                <tr>
                                    <th>Monitor Type</th>
                                    <th>Description</th>
                                    <th>Input Type</th>
                                    <th>Target Object</th>
                                    <th></th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in Model.GetStepDataResults[i].GetMoniterViewModels)
                                {
                                    <tr>
                                        <td>@item.Monitor_Type</td>
                                        <td>@item.Description</td>
                                        <td>@item.Input_Type</td>
                                        <td>@item.Target</td>
                                        <td>
                                            <span title="Edit Monitor" class="btn btn-xs btn-success" data-toggle="modal" data-procedure-name="@ViewBag.ProdecureName"
                                                  data-moniter-type="@item.Monitor_Type"
                                                  data-input-type="@item.Input_Type"
                                                  data-fail-action="@item.Fail_Action"
                                                  data-description="@item.Description"
                                                  data-object-id="@item.Id"
                                                  data-related-object="@item.Related_Object_Id"
                                                  data-step-id="@item.Step_Id"
                                                  data-step-shouldbe="@item.Should_Be"
                                                  data-step-highestthreshold="@item.Highest_Threshold"
                                                  data-step-highthreshold="@item.High_Threshold"
                                                  data-step-target="@item.Target"
                                                  data-step-lowthreshold="@item.Low_Threshold"
                                                  data-step-lowestthreshold="@item.Lowest_Threshold"
                                                  data-step-Target-Object="@item.Target_Object"
                                                  data-target="#addMoniterModal"
                                                  href="#monitor_@item.Id"><i class="fa fa-edit" aria-hidden="true"></i></span>
                                            <span title="Delete Monitor" style="cursor: pointer;" class="deleteMoniter btn btn-xs btn-danger" data-ProcedureName="@ViewBag.ProdecureName" data-ProcId="@item.Related_Object_Id" data-id="@item.Id">
                                                <i class="fa fa-trash-o" aria-hidden="true"></i>
                                            </span>
                                        </td>
                                    </tr>
                                }
                                <tr>
                                    <td>
                                        <a data-step-Target-Object="@Model.GetStepDataResults[i].AddMonitorForProcedureViewModel.Target_Object" data-procedure-name="@ViewBag.ProdecureName" data-moniter-type="@Model.GetStepDataResults[i].AddMonitorForProcedureViewModel.Monitor_Type" data-fail-action="@Model.GetStepDataResults[i].AddMonitorForProcedureViewModel.Fail_Action" data-description="@Model.GetStepDataResults[i].AddMonitorForProcedureViewModel.Description" data-object-id="@Model.GetStepDataResults[i].AddMonitorForProcedureViewModel.Id" data-related-object="@ViewBag.ProcObjectId" data-step-id="@Model.GetStepDataResults[i].Id" data-toggle="modal" data-target="#addMoniterModal" href="#" data-value="@Model.GetStepDataResults[i].Id" class="btn btn-xs btn-success add-monitor_@Model.GetStepDataResults[i].Id add-monitor " title="Add Monitor"> <i class="fa fa-plus" aria-hidden="true"></i> Add Monitor</a>
                                    </td>
                                    <td></td>
                                    <td></td>
                                </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                    <input type="submit" class="btn btn-success" value="Save"/>
                }
            </li>

        }
    </ul>
</div>

<div id="addMoniterModal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width: 50%;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title"> Monitor</h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" id="submit-moniter-form" class="btn btn-info"><i class="fa fa-print"></i> Submit</button>
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>

<style type="text/css">
    .sortable-container {
        padding: 0;
    }

    .sortable-item {
        list-style-type: none;
        padding: 10px;
        margin: 10px 0;
        border: 1px solid #1ABC9C;
        border-left-width: 5px;
        border-radius: 3px;
        background-color: #EFEFEF;
    }
</style>

<script type="text/javascript">
   
</script>
