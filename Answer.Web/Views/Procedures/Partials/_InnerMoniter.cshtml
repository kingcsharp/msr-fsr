@model List<Msr.Services.Procedures.ViewModels.GetMoniterViewModel>

@foreach (var item in Model)
{
    <tr>
        <td width="17%">@item.Monitor_Type</td>
        <td width="38%">@item.Description</td>
        <td width="15%">@item.Input_Type</td>

        @if (item.Monitor_Type == "NUMBER" && item.Should_Be == "BETWEEN")
        {
            <td width="15%">Between @item.Lowest_Threshold and @item.Highest_Threshold</td>
        }
        else if (item.Monitor_Type == "NUMBER" && item.Should_Be != "BETWEEN")
        {
            <td width="15%">@item.Target</td>
        }
        else if (item.Monitor_Type == "EQUIPMENT")
        {
            <td width="15%">@item.Target</td>
        }
        else if (item.Monitor_Type == "TEXT")
        {
            <td width="15%">@item.Text_Target</td>
        }
        else if (item.Monitor_Type == "YES_NO")
        {
            if (item.YES_NO_ANSWER == 1)
            {
                <td width="15%">Yes</td>
            }
            else
            {
                <td width="15%">No</td>
            }
        }
        else if (item.Monitor_Type == "SELECT")
        {
            <td width="15%">From List</td>
        }
        else if (item.Monitor_Type == "PASS_FAIL")
        {
            <td width="15%">@item.Target_Object</td>
        }
        <td width="13%">
            <span title="Edit Monitor" class="btn btn-xs btn-success edit-monitor" data-toggle="modal"
                  data-object-id="@item.Id"
                  data-target="#editMoniterModal"
                  href="#monitor_@item.Id">
                <i class="fa fa-edit" aria-hidden="true"></i>
            </span>

            <span onclick="DeleteMonitor(this)" title="Delete Monitor" style="cursor: pointer;" class="btn btn-xs btn-danger" data-step-id="@item.Step_Id" data-id="@item.Id">
                <i class="fa fa-trash-o" aria-hidden="true"></i>
            </span>
        </td>
    </tr>
}

<script type="text/javascript">
    $(document).ready(function() {
        EditMonitor();
    });
</script>