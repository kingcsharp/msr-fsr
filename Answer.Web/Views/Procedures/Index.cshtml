@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Runnable Procedures";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-step-forward"></span>
                Runnable Procedures <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="@Url.Action("Create", "Procedures")" class="btn btn-success help-btn">Add</a>
            <a href="@Url.Action("Import", "Procedures")" class="btn btn-success help-btn">Import</a>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-procedures")

    <script type="text/javascript">

        $(document).ready(function () {
            $.jgrid.defaults.styleUI = 'Bootstrap';

            var hasAdministratorRole = '@User.IsInRole("Administrators")' === "True";

            Msr.ProceduresGrid.LoadProceduresGrid('@Url.Action("ProceduresData", "Procedures")', '@Url.Action("Index", "Procedures")', hasAdministratorRole);
        });
    </script>
}

