@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Procedures";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-step-forward"></span>
                Runnable Procedures <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-procedure"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row row-bottom-buttons">
            <a href="@Url.Action("Create", "Procedures")" class="btn btn-success help-btn">Add</a>
            <a href="@Url.Action("Import", "Procedures")" class="btn btn-success help-btn">Import</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>

        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-procedures")

    <script type="text/javascript">

        var hasAdministratorRole = '@User.IsInRole("Administrators")' === 'True';

        $(document).ready(function () {

            Msr.ProceduresGrid.LoadProceduresGrid('@Url.Action("ProceduresData", "Procedures")', '@Url.Action("Index", "Procedures")');
        });
    </script>
}

