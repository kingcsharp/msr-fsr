@model Msr.Services.Procedures.ViewModels.AssignProcedureViewModel

@{
    ViewBag.Title = "Assign Procedure";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
               Assign Procedure
            </h2>
            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        
                        @Html.Partial("Message")
                        @using (Html.BeginForm())
                        {
                            <div class="form-horizontal addpart">
                                
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@Model.Id"/>

                                <div class="form-group">
                                    @Html.ValidationSummary(true, "", new {@class = "text-danger"})

                                    @Html.LabelFor(model => model.ProcedureName, htmlAttributes: new {@class = "control-label col-md-4"})
                                    <div class="col-md-5">
                                        @Model.ProcedureName
                                        @Html.ValidationMessageFor(model => model.ProcedureName, "", new {@class = "text-danger"})
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.AssignToPeople, htmlAttributes: new {@class = "control-label col-md-4"})
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.AssignToPeople, Model.Peoples, new {@class = "form-control select selectpeoples", multiple = "multiple"})
                                        @Html.ValidationMessageFor(model => model.AssignToPeople, "", new {@class = "text-danger"})
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.DatetimeToStart, htmlAttributes: new {@class = "control-label col-md-4"})
                                    <div class="col-md-5">
                                        @Html.EditorFor(model => model.DatetimeToStart, new {htmlAttributes = new {@class = "form-control date-picker"}})
                                        @Html.ValidationMessageFor(model => model.DatetimeToStart, "", new {@class = "text-danger"})
                                    </div>
                                </div>


                                <div class="form-group">
                                    <div class="col-md-offset-4 col-md-10">
                                        <input type="submit" value="Assign Now" class="btn btn-success"/>
                                        @Html.ActionLink("Cancel", "Index", null, new {@class = "btn btn-warning"})
                                    </div>
                                </div>
                                
                            </div>
                                }

                            </div>
                </section>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @{
        var memberPeoples = string.Join(",", Model.AssignToPeople);
    }
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.6.4/js/bootstrap-datepicker.min.js"></script>
    
    <script type="text/javascript">
        $(document).ready(function () {

            $('.date-picker').datepicker();

            var selectPeoples = $(".selectpeoples").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select People",
                formatNoMatches: function () {
                    return '';
                }
            });

            var values = '@memberPeoples';
            var selectedPeoples = values.split(",");

            selectPeoples.val(selectedPeoples).trigger("change");

        });
    </script>
}

