@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "ShowProductPartStay";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Parts  @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/Procedures/Index" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")

    <script src="~/assets/js/grids/PartProductStay.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            LoadProcedureObjectstepGrid('@Html.Raw(Url.Action("ShowProductPartStayView", "Procedures",new{ Pid = ViewBag.id, ViewBag.relation }))',
                '@ViewBag.id',
                '@ViewBag.relation');
        });
    </script>
}

