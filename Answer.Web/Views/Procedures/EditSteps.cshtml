@model List<Msr.Services.Procedures.Messages.GetStepDataResult>
@{
    ViewBag.Title = "EditSteps";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                View Part
            </h2>
            <div class="col-lg-12">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        <table>
                            <tr>
                                <th>Order</th>
                                <th>#</th>
                                <th>Text</th>
                                <th>Duration</th>
                                <th>Duration Unit</th>
                                <th>Preceding Step</th>
                            </tr>
                            @foreach (var step in Model)
                            {
                                <tr>
                                    <td>
                                        @step.Print_Order
                                    </td>
                                    <td>
                                        @step.Id
                                    </td>
                                    <td>
                                        @Html.Raw(step.Step_Text)
                                    </td>
                                    <td>@step.Duration</td>
                                    <td>
                                        @step.Duration_Type
                                </td>
                                    <td>@step.Pre_Step</td>
                                </tr>
                            }
                        </table>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>