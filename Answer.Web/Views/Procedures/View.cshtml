@model Answer.Web.ViewModel.ProcedureViewModel
@{
    ViewBag.Title = "Procedure View";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Procedure: @Model.ProcedureView.Name <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>

            <div class="col-lg-12">
                @Html.Partial("Message")
                Procedure Status: @Model.ProcedureView.Status <br/>
                Procedure number: @Model.ProcedureView.ObjectId <br />
                Rev number: @Model.ProcedureView.Rev<br />
                Security clearance level: @Model.ProcedureView.SecurityName
            </div>

        </div>
        <div>
            <table class="table table-bordered">
                <thead>
                <tr>
                    <th>Number</th>
                    <th>Id</th>
                    <th>Title</th>
                    <th>Text</th>
                    <th>Duration Type</th>
                    <th>Duration</th>
                </tr>
                </thead>
                <tbody>
                @for (int i = 0; i < Model.StepDataList.OrderBy(x => x.Print_Order).Count(); i++)
                {
                    <tr>
                        <td>@Model.StepDataList[i].Print_Order</td>
                        <td>@Model.StepDataList[i].Id</td>
                        <td>@Model.StepDataList[i].Title</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(Model.StepDataList[i].Step_Text))
                            {
                                @Html.Raw(Model.StepDataList[i].Step_Text.Replace(Environment.NewLine, "<br/>")) 
                            }   
                        </td>
                        <td>@Model.StepDataList[i].Duration_type</td>
                        <td>@Model.StepDataList[i].Duration</td>
                    </tr>

                }
                </tbody>
            </table>
        </div>
        <div class="row">
            <a href="@Url.Action("Index", "Procedures")" class="btn btn-warning">Cancel</a>
        </div>
    </div>
</div>
