@model Answer.Web.ViewModel.ProcedureViewModel
@{
    ViewBag.Title = "Procedure View";
}

<link href="~/assets/css/procedures.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Procedure : @Model.ProcedureView.Name <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <h3>@Model.ProcedureView.Name</h3>
                procedureViewAPPROVED (procedure number : @Model.ProcedureView.ObjectId,rev number :@Model.ProcedureView.Rev)<br />
                Security clearance level : @Model.ProcedureView.SecurityName
            </div>
        </div>
        <div>
            <table class="table table-bordered">
                <thead>
                <tr>
                    <th>Number</th>
                    <th>ID</th>
                    <th>TEXT</th>
                    <th>Duration Type</th>
                </tr>
                </thead>
                <tbody>
                @{ var a = 1;}
                @for (int i = 0; i < Model.StepDataList.OrderBy(x=>x.Print_Order).Count(); i++)
                {
                    {
                        a = (i + 1);
                    }
                    <tr>
                        <td>@a</td>
                        <td>@Model.StepDataList[i].Id</td>
                        <td>@Html.Raw(Model.StepDataList[i].Step_Text)</td>
                        <td>@Model.StepDataList[i].Duration @Model.StepDataList[i].Duration_Type</td>
                    </tr>
                    <tr><td colspan="6">LABOR_ROLE_LABOR_OWNER :@if (@Model.StepDataList[i].GetStepLaborsList.Count > 0)
                                                                {
                                                                    @Model.StepDataList[i].GetStepLaborsList.SingleOrDefault().Text
                                                                } @Model.StepDataList[i].Duration @Model.StepDataList[i].Duration_Type</td>
                    </tr>
                }
                </tbody>
            </table>

        </div>
        <div class="row">
            <a href="@Url.Action("Index", "Procedures")" class="btn btn-warning">Cancel</a>

        </div>
    </div>
</div>
