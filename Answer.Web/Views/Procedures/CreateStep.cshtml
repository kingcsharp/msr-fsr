@model Msr.Services.Procedures.ViewModels.GetStepEditDataViewModel
@{
    ViewBag.Title = "CreateStep";
}
<link href="~/assets/textformater/general.css" rel="stylesheet" />
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Step
            </h2>
            <div class="col-lg-10">
                @Html.Partial("Message")
                @using (Html.BeginForm("CreateStep", "Procedures", FormMethod.Post, new { @class = "form form-horizontal", onSubmit = "escapeAllSelects();", name = "editForm", }))
                {
                    <div class="form-horizontal">

                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <input type="hidden" name="ProcObjId" value="@Model.ProcObjId" />
                        <div class="form-group">
                            <label class="control-label col-md-4">Base Start On Counter?</label>
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.GetStepEditData.Start_On_Counter, Model.BaseCounterList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.GetStepEditData.Start_On_Counter, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">Preceding Step/s:</label>
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.SelectedPrecedingSteps, Model.GetStepListOfOtherSteps, new { @class = "form-control submitselect", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.SelectedPrecedingSteps, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">Estimated Step Duration:</label>
                            <div class="col-md-5">
                                @Html.TextBoxFor(model => model.GetStepEditData.Duration, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.GetStepEditData.Duration, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">Duration Type:</label>
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.GetStepEditData.Duration_Type, Model.DurationTypeList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.GetStepEditData.Duration_Type, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        @*<div class="form-group">
                                <label class="control-label  col-md-4">Value</label>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(model => model.GetStepEditData.Counter_Value, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.GetStepEditData.Counter_Value, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label  col-md-4">Unit</label>
                                <div class="col-md-5">
                                    @Html.TextBoxFor(model => model.GetStepEditData.Counter_Unit, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.GetStepEditData.Counter_Unit, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="control-label col-md-4">Relative to Other Step or Absolute?:</label>
                                <div class="col-md-5">
                                    @Html.DropDownListFor(model => model.GetStepEditData.REL_OR_ABS, Model.RelativeOrAbsoluteList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.GetStepEditData.REL_OR_ABS, "", new { @class = "text-danger" })
                                </div>
                            </div>*@

                        <div class="form-group">
                            <label class="control-label col-md-4">Labor:</label>
                            @*<div class="col-md-5">
                                    <table class="table table-bordered table-responsive">
                                        <tr>
                                            <td>Role Name</td>
                                            <td>Time</td>
                                        </tr>
                                        @foreach (var role in Model.GetStepLabors)
                                        {
                                            <tr>
                                                <td>@role.Role_Name</td>
                                                <td>@role.Qty @role.QtyType</td>
                                            </tr>
                                        }
                                    </table>
                                </div>*@
                        </div>
                        @*<div class="form-group">
                                <label class="control-label col-md-4">Step Text:</label>
                                <div class="col-md-5">
                                    @Html.TextAreaFor(model => model.GetStepEditData.Step_Text, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.GetStepEditData.Step_Text, "", new { @class = "text-danger" })
                                </div>
                            </div>*@
                        <table class="form" style="margin-left: 245px;">
                            <script language="JavaScript" type="text/javascript">
                                arrForms = arrForms.concat(new Array("editForm"));

                            </script>
                            <label class="control-label col-md-2" for="Title" style="margin-left: -15px;">Step Text:</label>
                            <tr>
                                <td class="form" colspan="" style="">
                                    @Html.TextAreaFor(model => model.GetStepEditData.Step_Text, new { onBlur = "checkMaxSize(this, 4000);;lastTextArea = 'document.editForm.GetStepEditData_Step_Text';", name = "StepText", rows = "10", cols = "80", @class = "text-formatter", style = "height:150px;" })
                                </td>
                                <td>
                                    <div style="width: 3%; float: right;"></div>
                                </td>
                            </tr>

                            <span class="tight" ID="document_editForm_cancelConfirm"> </span>

                        </table>

                        <div style="width: 300px; height: 300px; margin-left: 60%; margin-top: -150px;">

                            <td>
                                @Html.Partial("_TextAdder")
                            </td>

                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">System Task:</label>
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.GetStepEditData.System_Task, Model.SystemTasks, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.GetStepEditData.System_Task, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="systemcomptest">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NumTestQuestion, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-5">
                                    @Html.EditorFor(model => model.NumTestQuestion, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NumTestQuestion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">Reference Procedure:</label>
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.SelectedReferenceProcedures, Model.ReferenceProcedures, new { @class = "form-control select", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.SelectedReferenceProcedures, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">Reference Verbs:</label>
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.SelectedReferenceProcedureTypes, Model.ReferenceProcedureTypes, new { @class = "form-control select", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.SelectedReferenceProcedureTypes, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceObject, htmlAttributes: new { @class = "control-label  col-md-4" })
                            <div class="col-md-5">
                                <div style="width: 96%; float: left;">
                                    @Html.ListBoxFor(m => m.ReferenceObject, Model.ListReferenceObjects, new { @class = "form-control submitselect", multiple = "multiple" })
                                    @Html.ValidationMessageFor(model => model.ReferenceObject, "", new { @class = "text-danger" })
                                </div>
                                <div style="width: 3%; float: right;">
                                    <span class="data-toggle=" data-call-back-id="ReferenceObject" data-toggle="modal" data-target="#select-objects"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceObject"><i class="icon fa fa-trash"></i></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label  col-md-4" })
                            <div class="col-md-5">
                                <div style="width: 96%; float: left;">
                                    @Html.ListBoxFor(m => m.ReferenceFiles, Model.ListReferenceFiles, new { @class = "form-control submitselect", multiple = "multiple" })
                                    @Html.ValidationMessageFor(model => model.ReferenceFiles, "", new { @class = "text-danger" })
                                </div>
                                <div style="width: 3%; float: right;">
                                    <span class="data-toggle=" data-call-back-id="ReferenceFiles" data-toggle="modal" data-target="#select-images"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceFiles"><i class="icon fa fa-trash"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceTheory, htmlAttributes: new { @class = "control-label  col-md-4" })
                            <div class="col-md-5">
                                <div style="width: 96%; float: left;">
                                    @Html.ListBoxFor(m => m.ReferenceTheory, Model.ListReferenceTheories, new { @class = "form-control submitselect", multiple = "multiple" })
                                    @Html.ValidationMessageFor(model => model.ReferenceTheory, "", new { @class = "text-danger" })
                                </div>
                                <div style="width: 3%; float: right;">
                                    <span class="data-toggle=" data-call-back-id="ReferenceTheory" data-toggle="modal" data-target="#select-theory"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceTheory"><i class="icon fa fa-trash"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-4">Comments:</label>
                            <div class="col-md-5">
                                @Html.TextAreaFor(model => model.GetStepEditData.Comments, new { onBlur = "checkMaxSize(this, 4000);;lastTextArea = 'document.editForm.GetStepEditData_Comments';", name = "StepText", rows = "10", cols = "80", @class = "text-formatter", style = "height:150px;" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-10">

                                <button type="submit" class="btn btn-success">Save</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/textformater/ValidateDocumentSubmit.js"></script>
    <script src="~/assets/textformater/textformatter.js"></script>
    <script src="~/assets/js/grids/comman.js"></script>
    <script>
        $('.select').select2();
        $('.deletefiles').click(function () {

            var callBackId = $(this).data('call-back-id');

            eModal.confirm('Do you really want to Remove ' + callBackId + ' ?', 'Confirmation delete')
                .then(confirmCallback, optionalCancelCallback);

            function confirmCallback() {
                console.log("ok");
                $('#' + callBackId + ' option:selected').remove();
            }

            function optionalCancelCallback() {
                console.log("cancel");
            }
        });
        switch ('@Model.GetStepEditData.System_Task') {
        case "SYS_COMP_TEST":
            $(".systemcomptest").show();
            break;
        default:
            $(".systemcomptest").hide();
            break;
        }
        $('#GetStepEditData_System_Task').on('change', function () {
            switch (this.value) {
            case 'SYS_COMP_TEST':
                $(".systemcomptest").show();
                break;
            default:
                $(".systemcomptest").hide();
                break;
            }
        });
    </script>
}
