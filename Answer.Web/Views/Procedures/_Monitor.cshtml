@model Msr.Services.Procedures.Messages.GetStepDataResult
@using (Html.BeginForm("SaveMonitor", "Procedures", FormMethod.Post, new { @id = "moniter-form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.AddMonitorForProcedureViewModel.Id)
    @Html.HiddenFor(x => x.AddMonitorForProcedureViewModel.Related_Object_Id)
    @Html.HiddenFor(x => x.AddMonitorForProcedureViewModel.Step_Id)
    @Html.HiddenFor(x => x.AddMonitorForProcedureViewModel.ProcedureName)
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Monitor_Type, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-5">
                @Html.DropDownListFor(model => model.AddMonitorForProcedureViewModel.Monitor_Type, Model.AddMonitorForProcedureViewModel.MonitorTypesList, new { @class = "form-control selectroles" })
                @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Monitor_Type, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Input_Type, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-5">
                @Html.DropDownListFor(model => model.AddMonitorForProcedureViewModel.Input_Type, Model.AddMonitorForProcedureViewModel.InputTypesList, new { @class = "form-control selectroles" })
                @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Input_Type, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group showifEquipment">
            @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Target_Object, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-5">
                @Html.TextBoxFor(model => model.AddMonitorForProcedureViewModel.Target_Object, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Target_Object, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Fail_Action, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-5">
                @Html.DropDownListFor(model => model.AddMonitorForProcedureViewModel.Fail_Action, Model.AddMonitorForProcedureViewModel.FailNextActionList, new { @class = "form-control selectroles" })
                @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Fail_Action, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Description, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-5">
                @Html.TextAreaFor(model => model.AddMonitorForProcedureViewModel.Description, new { @class = "form-control", data_content = "Description" })
                @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Description, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="showMoniterIfNumner">
            <div class="form-group">
                @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Should_Be, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-5">
                    @Html.DropDownListFor(model => model.AddMonitorForProcedureViewModel.Should_Be, Model.AddMonitorForProcedureViewModel.ShouldBeList, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Should_Be, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Highest_Threshold, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-5">
                    @Html.EditorFor(model => model.AddMonitorForProcedureViewModel.Highest_Threshold, new { htmlAttributes = new { @class = "form-control", data_content = "Description" } })
                    @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Highest_Threshold, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.High_Threshold, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-5">
                    @Html.EditorFor(model => model.AddMonitorForProcedureViewModel.High_Threshold, new { htmlAttributes = new { @class = "form-control", data_content = "Description" } })
                    @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.High_Threshold, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Target, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-5">
                    @Html.EditorFor(model => model.AddMonitorForProcedureViewModel.Target, new { htmlAttributes = new { @class = "form-control", data_content = "Description" } })
                    @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Target, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Low_Threshold, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-5">
                    @Html.EditorFor(model => model.AddMonitorForProcedureViewModel.Low_Threshold, new { htmlAttributes = new { @class = "form-control", data_content = "Description" } })
                    @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Low_Threshold, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.AddMonitorForProcedureViewModel.Lowest_Threshold, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-5">
                    @Html.EditorFor(model => model.AddMonitorForProcedureViewModel.Lowest_Threshold, new { htmlAttributes = new { @class = "form-control", data_content = "Description" } })
                    @Html.ValidationMessageFor(model => model.AddMonitorForProcedureViewModel.Lowest_Threshold, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
}
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
<script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
<script type="text/javascript">
    $(document).ready(function () {
        var selectedValue = $('#AddMonitorForProcedureViewModel_Monitor_Type').val();

        if (selectedValue != 'NUMBER') {
            $('.showMoniterIfNumner').hide();
        }
        else {
            $('.showMoniterIfNumner').show();
        }
     
      
    });
    $('#AddMonitorForProcedureViewModel_Monitor_Type').on('change', function () {
        var value = $(this).val();

        if (value == "NUMBER") {
            $('.showMoniterIfNumner').show();
        }
        else {
            $('.showMoniterIfNumner').hide();
        }
  
    });
</script>