@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Parts Provide tack back";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Parts Provide Tack Back
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="@Url.Action("CreatePartsProvideTakeBack","Procedures")" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")


    <script src="~/assets/js/grids/ProcedureObjectStay.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            LoadShowPartsProvidedTakeBackGrid('@Html.Raw(Url.Action("ShowProcedureView", "Procedures",new{ Pid = ViewBag.id, ViewBag.relation }))',
                '@ViewBag.id',
            '@ViewBag.relation');
        });
    </script>
}
