@model Msr.Services.ApprovalGroups.ViewModels.EditApprovalGroupsViewModel
@{
    ViewBag.Title = "Create Approval Group";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Create Approval Group<button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-10">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.MemberPeoples, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.MemberPeoples, Model.ListMemberPeoples, new { @class = "form-control select selectpeoples", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.MemberPeoples, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.MemberRoles, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.MemberRoles, Model.ListMemberRoles, new { @class = "form-control select selectroles", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.MemberRoles, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.SpecialMembers, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.SpecialMembers, Model.ListSpecialMembers, new { @class = "form-control select selectMembers", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.SpecialMembers, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-8">
                                <input type="submit" value="Submit" class="btn btn-success" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @{
        var memberPeoples = string.Join(",", Model.MemberPeoples);
        var memberRoles = string.Join(",", Model.MemberRoles);
        var specialMembers = string.Join(",", Model.SpecialMembers);
    }
    
@Scripts.Render("~/bundles/js/jqueryval")

    <script type="text/javascript">
        $(document).ready(function () {
            var selectPeoples = $(".selectpeoples").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select People",
                formatNoMatches: function () {
                    return '';
                }
            });
            var values = '@memberPeoples';
            var selectedPeoples = values.split(",")
            console.log(selectedPeoples);
            selectPeoples.val(selectedPeoples).trigger("change");


            var selectRoles = $(".selectroles").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select Roles",
                formatNoMatches: function () {
                    return '';
                }
            });
            var values = '@memberRoles';
            var selectedRoles = values.split(",")
            console.log(selectedRoles);
            selectRoles.val(selectedRoles).trigger("change");


            var selectMembers = $(".selectMembers").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select Members",
                formatNoMatches: function () {
                    return '';
                }
            });
            var values = '@specialMembers';
            var selectedMembers = values.split(",")
            console.log(selectedMembers);
            selectMembers.val(selectedMembers).trigger("change");
        });
    </script>
}