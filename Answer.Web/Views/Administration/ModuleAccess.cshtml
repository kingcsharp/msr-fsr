@model Answer.Web.ViewModel.Administration.ModuleAccessViewViewModel

@{
    ViewBag.Title = "Assign Roles to view Modules";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Assign Roles to view Modules
                @Html.Partial("_HelpViewButton")
            </h2>

            <div class="row">

                <div class="col-lg-2">
                    @Html.Partial("_AdminSetup")
                </div>
                <div class="col-lg-4">
                    @Html.Partial("Message")

                    @using (Html.BeginForm("ModuleAccess", "Administration", FormMethod.Post, new {id = "assign-form"}))
                    {
                        <table class="table table-bordered" style="width: 600px;">
                            <tr>
                                <th>Module Name</th>
                                <th>Roles (Groups)</th>
                            </tr>
                            @{
                                var groupName = string.Empty;
                            }
                            @for (int index = 0; index < Model.ModuleAccess.Count; index++)
                            {
                                if (groupName != Model.ModuleAccess[index].Menu_Group)
                                {
                                    groupName = Model.ModuleAccess[index].Menu_Group;
                                    <tr>
                                     <td colspan="2"><strong>@groupName</strong></td>
                                    </tr>
                                }
                                <tr>
                                    <td>@Model.ModuleAccess[index].Name</td>
                                    <td style="width: 300px;">
                                        @Html.Hidden("items[" + index + "].Id", Model.ModuleAccess[index].Id)
                                        @Html.DropDownList("items[" + index + "].RoleId", new SelectList(Model.Roles, "Value", "Text", Model.SelectedRoles.Where(x=>x.Menu_Id == Model.ModuleAccess[index].Id).Select(x=>x.Role_Id)), new { @class = "form-control select-"+index+"", multiple = "multiple" })
                                        
                                    </td>
                                </tr>
                            }

                        </table>
                        <input type="submit" value="Update" class="btn btn-success"/>
                    }
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts
{
    @{
        var roles = string.Join(",", Model.Roles);
    }

    <script type="text/javascript">
        $(document).ready(function() {

            @for (int index = 0; index < Model.ModuleAccess.Count; index++)
            {
                <text>
                    
                   $('.select-@index').select2();

                    var selectPeoples = $(".select-@index").select2({
                        tags: [],
                        tokenSeparators: [','],
                        multiple: true,
                        allowClear: true,
                        placeholder: "Select Role",
                        formatNoMatches: function () {
                            return '';
                        }
                    });
                    var values = '@string.Join(",",Model.SelectedRoles.Where(x => x.Menu_Id == Model.ModuleAccess[index].Id).Select(x => x.Role_Id))';
                    var selectedPeoples = values.split(",");
                    selectPeoples.val(selectedPeoples).trigger("change");

                </text>
            }

          

        });
    </script>

}

