@model Answer.Web.ViewModel.Administration.ModuleAccessViewViewModel

@{
    ViewBag.Title = " MODULE ACCESS";
}


<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                ASSIGN WSCR CLOSER & ROLE & CHECK MAIL LOCATION
                <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>

            <div class="row">

                <div class="col-lg-2">
                    @Html.Partial("_AdminSetup")
                </div>
                <div class="col-lg-6">
                    @Html.Partial("Message")

                    @using (Html.BeginForm("ModuleAccess", "Administration", FormMethod.Post, new {id = "assign-form"}))
                    {
                        <table class="table table-bordered" style="width: 600px;">
                            <tr>
                                <th>Company/Dept</th>
                                <th>Roles (Groups)</th>
                            </tr>

                            @for (int index = 0; index < Model.CompaniesToView.Count; index++)
                            {
                                <tr>
                                    <td>@Model.CompaniesToView[index].Name</td>
                                    <td>
                                        @Html.Hidden("items[" + index + "].CoId", Model.CompaniesToView[index].Id)
                                        @Html.DropDownList("items[" + index + "].RoleId", Model.Roles, new { @class = "form-control select roles-select", multiple = "multiple" })
                                    </td>
                                </tr>
                            }

                        </table>
                        <input type="submit" value="Update" class="btn btn-success"/>
                    }
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts
{
    @{
        var roles = string.Join(",", Model.Roles);
    }

    <script type="text/javascript">
        $(document).ready(function() {

            $('.select').select2();

            var selectPeoples = $(".roles-select").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select Role",
                formatNoMatches: function () {
                    return '';
                }
            });
            var values = '@roles';
            var selectedPeoples = values.split(",");
            selectPeoples.val(selectedPeoples).trigger("change");

        });
    </script>

}

