@model Answer.Web.ViewModel.Administration.ModuleAccessViewViewModel

@{
    ViewBag.Title = " MODULE ACCESS";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                MODULE ACCESS
                <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
        </div>

        <div class="col-lg-12">
            <div class="row">
                @using (Html.BeginForm("AssignAccRecievableRole", "Administration", FormMethod.Post, new { id = "assign-form" }))
                {
                    <table class="table table-bordered" style="width: 600px;">
                        <tr>
                            <th>Company/Dept</th>
                            <th>Roles (Groups)</th>
                        </tr>

                        @for (int index = 0; index < Model.CompaniesToView.Count; index++)
                        {
                            <tr>
                                <td>@Model.CompaniesToView[index].Name</td>
                                <td>
                                    @Html.Hidden("items[" + index + "].CoId", Model.CompaniesToView[index].Id)
                                    @Html.DropDownList("items[" + index + "].RoleId", Model.Roles, new { @class = "form-control select" })
                                </td>
                            </tr>
                        }

                    </table>
                    <input type="submit" value="Update" class="btn btn-default" />
                }
            </div>

        </div>

    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function() {

            $('.select').select2();

        });
    </script>

}

