@model Answer.Web.ViewModel.Administration.ModuleAccessViewViewModel
    

@{
    ViewBag.Title = "Edit Global words";
}


<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                ASSIGN WSCR CLOSER & ROLE & CHECK MAIL LOCATION
                <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>

            <div class="row">

                <div class="col-lg-2">
                    @Html.Partial("_AdminSetup")
                </div>
                <div class="col-lg-6">
                    @Html.Partial("Message")

                    @using (Html.BeginForm("UpdateGlobalSettings", "Administration", FormMethod.Post, new { @class = "form form-horizontal", role = "form" }))
                    {
                        <div class="form-group">
                            <label class="col-lg-4">
                                Codded:
                            </label>
                            <label class="col-lg-4">
                                Displayed:
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="col-lg-4">
                                <input type="text" name="GlobalSettings[@Model.GlobalSettings.Count].Id" class="form-control" />
                            </label>
                            <div class="col-lg-4">
                                <input type="text" name="GlobalSettings[@Model.GlobalSettings.Count].Value" class="form-control" />
                            </div>
                        </div>
                        for (int i = 0; i < Model.GlobalSettings.Count; i++)
                        {
                            <div class="form-group">
                                <label class="col-lg-4">
                                    @Model.GlobalSettings[i].Id
                                    @Html.HiddenFor(x => Model.GlobalSettings[i].Id)
                                </label>
                                <div class="col-lg-4">
                                    @Html.TextBoxFor(x => Model.GlobalSettings[i].Value, new {@class="form-control"})
                                </div>
                            </div>
                        }

                        <div class="form-group">
                            <label class="col-lg-6 control-label"></label>
                            <div class="col-lg-6">
                                <button type="submit" class="btn btn-success">Save</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
