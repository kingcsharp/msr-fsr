
@model Answer.Web.ViewModel.Administration.ReAssignBossViewModel
@{
    ViewBag.Title = "Re-Assign Boss";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Re-Assign Boss
                <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-10">
                @Html.Partial("Message")
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()                   
                    
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                       
                        <div class="form-group">
                            @Html.LabelFor(model => model.Id, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.Id, Model.BossList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ToBossId, htmlAttributes: new { @class = "control-label col-md-4" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.ToBossId, Model.BossList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.ToBossId, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-10">
                                <input type="submit" value="Reassign Now" class="btn btn-default" />
                            </div>
                        </div>
                    </div>
                }
            </div> 
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function() {

            $('.select').select2();
           

        });
    </script>

}





