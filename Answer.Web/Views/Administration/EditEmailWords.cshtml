@model Msr.Services.Administration.ViewModels.EmailWordsViewModel
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            @using (Html.BeginForm("UpdateEmailWords", "Administration", FormMethod.Post, new { @class = "form form-horizontal", role = "form" }))
            {
                <div class="form-group">
                    <label class="col-lg-6">
                        New ID***
                    </label>
                    <label class="col-lg-6">
                        Value:
                    </label>
                </div>
                <div class="form-group">
                    <label class="col-lg-6">
                        <input type="text" name="EmailWords[@Model.EmailWords.Count].Id" />
                    </label>
                    <div class="col-lg-6">
                        <textarea name="EmailWords[@Model.EmailWords.Count].Value"></textarea>
                    </div>
                </div>
                for (int i = 0; i < Model.EmailWords.Count; i++)
                {
                    <div class="form-group">
                        <label class="col-lg-6">
                            @Model.EmailWords[i].Id
                            @Html.HiddenFor(x => Model.EmailWords[i].Id)
                        </label>
                        <div class="col-lg-6">
                            @Html.TextAreaFor(x => Model.EmailWords[i].Value)
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label class="col-lg-6 control-label"></label>
                    <div class="col-lg-6">
                        <button type="submit" class="btn-success">Save</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>