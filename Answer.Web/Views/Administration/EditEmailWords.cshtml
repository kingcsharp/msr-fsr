@model Msr.Services.Administration.ViewModels.EmailWordsViewModel
    
@{
    ViewBag.Title = "Edit Email words";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            @Html.Partial("Message")

            
            @using (Html.BeginForm("UpdateEmailWords", "Administration", FormMethod.Post, new {@class = "form form-horizontal", role = "form"}))
            {
                <div class="form-group">
                    <label class="col-lg-6">
                        New ID***
                    </label>
                    <label class="col-lg-6">
                        Value:
                    </label>
                </div>
                <div class="form-group">
                    <label class="col-lg-6">
                        <input type="text" name="EmailWords[@Model.EmailWords.Count].Id" class="form-control"/>
                    </label>
                    <div class="col-lg-6">
                        <textarea name="EmailWords[@Model.EmailWords.Count].Value" class="form-control"></textarea>
                    </div>
                </div>
                for (int i = 0; i < Model.EmailWords.Count; i++)
                {
                    <div class="form-group">
                        <label class="col-lg-6">
                            @Model.EmailWords[i].Id
                            @Html.HiddenFor(x => Model.EmailWords[i].Id, new {@class = "form-control"})
                        </label>
                        <div class="col-lg-6">
                            @Html.TextAreaFor(x => Model.EmailWords[i].Value, new {@class = "form-control"})
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label class="col-lg-6 control-label"></label>
                    <div class="col-lg-6">
                        <button type="submit" class="btn btn-success">Save</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>