@model Answer.Web.ViewModel.Administration.AssignCompaniesToViewViewModel

@{
    ViewBag.Title = "Assign companies to view my company and departments";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Assign Companies to View My Company and Departments
                @Html.Partial("_HelpViewButton")
            </h2>

            <div class="row">

                <div class="col-lg-2">
                    @Html.Partial("_AdminSetup")
                </div>
                <div class="col-lg-6">
                    @Html.Partial("Message")

                    @using (Html.BeginForm("AssignCompaniesToView", "Administration", FormMethod.Post, new { id = "assign-form" }))
                    {
                        <table class="table table-bordered" style="width: 600px;">
                            <tr>
                                <th>Company/Department</th>
                                <th>Companies Allowed to View</th>
                            </tr>

                            @for (int index = 0; index < Model.CompaniesToView.Count; index++)
                            {
                                <tr>
                                    <td>@Model.CompaniesToView[index].Name</td>
                                    <td>
                                        @Html.Hidden("items[" + index + "].CoId", Model.CompaniesToView[index].Id)
                                        @Html.DropDownList("items[" + index + "].RoleId", Model.Companies, new { @class = "form-control select" })
                                    </td>
                                </tr>
                            }

                        </table>
                        <input type="submit" value="Update" class="btn btn-success" />
                    }
                </div>
            </div>
        </div>

    </div>
</div>


@section scripts
{
    <script type="text/javascript">
        $(document).ready(function() {

            $('.select').select2();

        });
    </script>

}

