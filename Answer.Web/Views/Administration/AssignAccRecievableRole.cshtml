@model Answer.Web.ViewModel.Administration.AssignAccRecievableRoleViewModel

@{
    ViewBag.Title = "ASSIGN WSCR CLOSER & ROLE & CHECK MAIL LOCATION";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                ASSIGN WSCR CLOSER & ROLE & CHECK MAIL LOCATION
                @Html.Partial("_HelpViewButton")
            </h2>

            <div class="row">

                <div class="col-lg-2">
                    @Html.Partial("_AdminSetup")
                </div>
                <div class="col-lg-6">
                    @Html.Partial("Message")

                    @using (Html.BeginForm("AssignAccRecievableRole", "Administration", FormMethod.Post, new {id = "assign-form"}))
                    {
                        <table class="table table-bordered" style="width: 600px;">
                            <tr>
                                <th>Company/Dept</th>
                                <th>Role To Close Weekly Service Call Reports</th>
                                <th>Location to Mail Checks</th>
                            </tr>

                            @for (int index = 0; index < Model.Companies.Count; index++)
                            {
                                <tr>
                                    <td>@Model.Companies[index].Co_Name</td>
                                    <td>
                                        @Html.Hidden("recievableRoleItems[" + index + "].CoId", Model.Companies[index].Co_Id)
                                        @Html.DropDownList("recievableRoleItems[" + index + "].RoleId", new SelectList(Model.Roles, "Value", "Text", Model.Companies[index].Role_Id), new {@class = "form-control select"})
                                    </td>
                                    <td>
                                        @Html.DropDownList("recievableRoleItems[" + index + "].LocationId", new SelectList(Model.Locations, "Value", "Text", Model.Companies[index].Location_Id), new {@class = "form-control select"})
                                    </td>
                                </tr>
                            }

                        </table>
                        <input type="submit" value="Update" class="btn btn-success"/>
                    }
                </div>
            </div>
        </div>

    </div>
</div>





@section scripts
{
    <script type="text/javascript">
        $(document).ready(function() {

            $('.select').select2();

        });
    </script>

}

