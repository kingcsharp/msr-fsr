@{
    ViewBag.Title = "Operations Dashboard";
}

<link href="~/Content/ej/web/bootstrap-theme/ej.web.all.min.css" rel="stylesheet" />
<link href="~/Content/ej/web/ej.web.overrides.css" rel="stylesheet" />
<link href="#" rel="stylesheet" />
<div id="gridsContainer" class="side-body">
    <div class="row">
        <div class="col-xs-12">
            <div class="datatable" style="padding:10px">
                <div class="page-header"><h1 ndtype="heading">Revenue by Customer</h1></div>
                <div class="col-xs-6">
                    <div id="RevenueByCustomerChart"></div>
                </div>
                <div class="col-xs-6">
                    <div id="RevenueByCustomerGrid"></div>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-xs-12">
            <div class="datatable" style="padding:10px">
                <div class="page-header"><h1 ndtype="heading">Revenue by Kit</h1></div>
                <div class="col-xs-6">
                    <div id="RevenueByKitChart"></div>
                </div>
                <div class="col-xs-6">
                    <div id="RevenueByKitGrid"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div class="datatable" style="padding:10px">
                <div class="page-header"><h1 ndtype="heading">Count of Kits</h1></div>
                <div class="col-xs-6">
                    <div id="CountofKitsChart"></div>
                </div>
                <div class="col-xs-6">
                    <div id="CountofKitsGrid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @*<script src="~/assets/js/reports/libs/js-xlsx/xlsx.core.min.js"></script>*@

    <script src="//unpkg.com/xlsx/dist/shim.min.js"></script>
    <script src="//unpkg.com/xlsx/dist/xlsx.full.min.js"></script>

    <script src="https://cdn.syncfusion.com/js/assets/external/jquery.easing.1.3.min.js"></script>
    <script src="https://cdn.syncfusion.com/js/assets/external/jquery.globalize.min.js"></script>
    <script src="https://cdn.syncfusion.com/js/assets/external/jsrender.min.js"></script>
    <script src="~/Scripts/ej/web/ej.web.all.min.js"></script>
    <script type="text/javascript">
        $(function () {
            function setGridOptions(options) {
                var defaultGridOptions = {
                    enableLoadOnDemand: false,
                    allowPaging: true,
                    pageSettings: { enableQueryString: true },
                    allowFiltering: true,
                    allowResizeToFit: true,
                    filterSettings: {
                        filterType: "excel"
                    },

                    allowScrolling: true,
                    scrollSettings: { height: 840 },
                    allowSorting: true,
                    isResponsive: true,
                    enableResponsiveRow: true,
                    pageSettings: { pageSize: 25, pageSizeList: [25, 50, 100] },
                    columnLayout: ej.Grid.ColumnLayout.Auto,
                    toolbarSettings: { showToolbar: true, toolbarItems: [ej.Grid.ToolBarItems.ExcelExport,ej.Grid.ToolBarItems.Search] },
                    toolbarClick: function (args) {

                        if (args.itemName == "Excel Export") {
                            args.cancel = true;
                            doit(options, 'xlsx');
                        }
                    },
                };
                Object.assign(defaultGridOptions, options);
                return defaultGridOptions;
            }

            function doit(options,type, fn, dl) {
                var grid = $('#' + options.gridId).ejGrid('instance');

                const wb = { SheetNames: [], Sheets: {} };
                wb.Props = {
                    Title: "Stats from app",
                    Author: "John Doe"
                };
                var data = grid.getFilteredRecords().length > 0 ? grid.getFilteredRecords() : grid.model.dataSource;

                var colHeaders = {};
                var colsLength = options.columns.length;

                while(colsLength--){
                    colHeaders[options.columns[colsLength].field] = options.columns[colsLength].headerText;
                }

                var updatedData = [];
                for (var i = 0; i < data.length; i++) {
                    updatedData.push(renameKeys(data[i], colHeaders));
                }

                var ws = XLSX.utils.json_to_sheet(updatedData);
                var ws_name = "DataSheet1";
                XLSX.utils.book_append_sheet(wb, ws, ws_name);

                var colsLength = options.columns.length;
                var wscols = [];
                while (colsLength--) {
                    wscols.push({ wpx: options.columns[colsLength].width });
                }
                wb.Sheets["DataSheet1"]["!cols"] = wscols;

                return XLSX.writeFile(wb, options.title+'.xlsb');
            }

            function renameKeys(obj, newKeys) {
                var retObj = {};
                var keyValues = Object.keys(obj).map(function (key) {
                    if (newKeys[key] !== undefined) {
                        var newKey = newKeys[key];
                        retObj[newKey] = obj[key];
                    }
                    return;
                });
                return retObj;
            }

            // revenue customer
            var dataManager = ej.DataManager({
                url: '@ViewBag.RevenueByCustomerURL',
                crossDomain: true, adaptor: new ej.ODataV4Adaptor()
            });

            var revenueByCustomerCols = [
                { field: "month", headerText: 'Year-Month', textAlign: ej.TextAlign.Right, width: 130},
                { field: "customerName", headerText: 'Customer Name', textAlign: ej.TextAlign.Center, width: 80 },
                { field: "site", headerText: 'Site', textAlign: ej.TextAlign.Center, width: 80 },
                { field: "revenue", headerText: 'Revenue', textAlign: ej.TextAlign.Right, width: 80 }
            ];

            var query = new ej.Query();
            var promise = dataManager.executeQuery(query);
            promise.done(function (e) {
                $("#RevenueByCustomerGrid").ejGrid(
                    setGridOptions({
                        dataSource: e.result, columns: revenueByCustomerCols, gridId: 'RevenueByCustomerGrid', title: 'Revenue_By_Customer',
                        actionComplete: function (args) {
                            if (args.model && args.requestType === "filtering") {
                                var records = $("#RevenueByCustomerGrid").ejGrid("instance").getFilteredRecords();

                                if (!records || records.length === 0) {
                                    records = args.model.dataSource;
                                }

                                SetChartStacked("stackingcolumn", "#RevenueByCustomerChart", records, "month", "revenue", "Revenue", "customerName");
                            }
                        }
                    })
                );
                SetChartStacked("stackingcolumn", "#RevenueByCustomerChart", e.result, "month", "revenue", "Revenue", "customerName");
            });

            // kits revenue
            var dataManager = ej.DataManager({
                url: '@ViewBag.RevenueByKitURL',
                crossDomain: true, adaptor: new ej.ODataV4Adaptor()
            });

            var revenueByKitCols = [
                { field: "kitName", headerText: 'Kit Name', textAlign: ej.TextAlign.Left, width: 130 },
                { field: "month", headerText: 'Year-Month', textAlign: ej.TextAlign.Center, width: 80},
                { field: "site", headerText: 'Site', textAlign: ej.TextAlign.Center, width: 80 },
                { field: "revenue", headerText: 'Revenue', textAlign: ej.TextAlign.Right, width: 80 }
                ];

            var query = new ej.Query();
            var promise = dataManager.executeQuery(query);
            promise.done(function (e) {

                $("#RevenueByKitGrid").ejGrid(
                    setGridOptions({
                        dataSource: e.result, columns: revenueByKitCols, gridId: 'RevenueByKitGrid', title: 'Revenue_By_Kit',
                        actionComplete: function (args) {
                            if (args.model && args.requestType === "filtering") {
                                var records = $("#RevenueByKitGrid").ejGrid("instance").getFilteredRecords();

                                if (!records || records.length === 0) {
                                    records = args.model.dataSource;
                                }
                                SetChartStacked("stackingcolumn","#RevenueByKitChart",records,"month","revenue","Revenue","kitName");
                            }
                        }
                    })
                );
                SetChartStacked("stackingcolumn","#RevenueByKitChart",e.result,"month","revenue","Revenue","kitName");
            });

            // kits count
            var dataManager = ej.DataManager({
                url: '@ViewBag.CountofKitsURL',
                crossDomain: true, adaptor: new ej.ODataV4Adaptor()
            });

            var CountofKitsCols = [
                { field: "kitName", headerText: 'Kit Name', textAlign: ej.TextAlign.Left, width: 130 },
                { field: "month", headerText: 'Year-Month', textAlign: ej.TextAlign.Center, width: 80},
                { field: "site", headerText: 'Site', textAlign: ej.TextAlign.Center, width: 80 },
                { field: "count", headerText: 'Count', textAlign: ej.TextAlign.Center, width: 80 }
                ];

            var query = new ej.Query();
            var promise = dataManager.executeQuery(query);
            promise.done(function (e) {

                $("#CountofKitsGrid").ejGrid(
                    setGridOptions({
                        dataSource: e.result, columns: CountofKitsCols, gridId: 'CountofKitsGrid', title: 'Count_of_Kits',
                        actionComplete: function (args) {
                            if (args.model && args.requestType === "filtering") {
                                var records = $("#CountofKitsGrid").ejGrid("instance").getFilteredRecords();

                                if (!records || records.length === 0) {
                                    records = args.model.dataSource;
                                }
                                SetChartStacked("stackingcolumn","#CountofKitsChart",records,"month","count","Count","kitName");
                            }
                        }
                    })
                );
                SetChartStacked("stackingcolumn","#CountofKitsChart",e.result,"month","count","Count","kitName");
            });

            function SetChartStacked(type,name,data,xName,yName,seriesName, stackBy) {
                $(name).ejChart({
                    
                    primaryXAxis: {
                        title: { text: 'Month (Previous 12 Months Rolling)' }
                    },
                    primaryYAxis: {
                        title: { text: 'Revenue(%) Per Month' }
                    },
                    series: [{
                        type: type,
                        dataSource: data,
                        xName: xName,
                        yName: yName,
                        name: seriesName,
                        stackingGroup: stackBy,
                        tooltip: { visible: true, format: "#series.name# <strong>#point.y#</strong>" },
                    }],
                    isResponsive: true,
                    theme: "azure",
                    load: "loadTheme",	 
                    size: { height: "600"},                        
                    legend: { visible: false }
                });
            }
        });

    </script>
}
