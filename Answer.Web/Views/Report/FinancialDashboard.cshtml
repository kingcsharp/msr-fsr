@using Syncfusion.EJ2

@{
    ViewBag.Title = "FinancialDashboard";
    var reportingUrl = Url.RouteUrl("", new { httproute = "", controller = "/Reporting/CombinedFinancialData" });
    var v = "";
}
<link href="~/Content/ej/web/bootstrap-theme/ej.web.all.min.css" rel="stylesheet" />
<div class="side-body">
    <div class="row">
        <div class="col-xs-12">
            <div class="datatable" style="padding:10px">
                <table id="table1" class="table table-striped table-bordered" style="width:700px">
                    <thead>
                        <tr>
                            <th>WO Item</th>
                            <th>Creation Date</th>
                            <th>Due Date</th>
                            <th>Ship Date</th>
                            <th>Facility</th>
                            <th>Customer</th>
                            <th>Specification</th>
                            <th>Kit Name</th>
                            <th>Part #</th>
                            <th>MTTN</th>
                            <th>Invoice #</th>
                            <th>Invoice Date</th>
                            <th>Qty</th>
                            <th>Amount</th>
                            <th>SubTotal</th>
                            <th>w/ Tax</th>


                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

