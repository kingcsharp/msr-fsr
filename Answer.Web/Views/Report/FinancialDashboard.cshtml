@*@using Syncfusion.EJ2*@

@{
    ViewBag.Title = "FinancialDashboard";
    //var odataUrl = Url.HttpRouteUrl("DefaultApi", new { controller = "Reporting/CombinedFinancialData" });
}
<link href="~/Content/ej/web/bootstrap-theme/ej.web.all.min.css" rel="stylesheet" />
<div id="gridsContainer" class="side-body">
    <div class="row">
        <div class="col-xs-12">
            <div class="datatable" style="padding:10px">
                <div id="combinedFinancialGrid"></div>
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-xs-12">
            <div class="datatable" style="padding:10px">
                <div id="wONoInvoiceURLGrid"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @*<script src="~/assets/js/reports/libs/js-xlsx/xlsx.core.min.js"></script>*@

    <script src="//unpkg.com/xlsx/dist/shim.min.js"></script>
    <script src="//unpkg.com/xlsx/dist/xlsx.full.min.js"></script>

    <script src="http://cdn.syncfusion.com/js/assets/external/jquery.easing.1.3.min.js"></script>
