    <script type="text/javascript">
        $(function () {
            function setGridOptions(options) {
                var defaultGridOptions = {
                    enableLoadOnDemand: false,
                    allowPaging: true,
                    pageSettings: { enableQueryString: true },
                    allowFiltering: true,
                    allowScrolling:true,
                    scrollSettings: {height: 400 },
                    allowResizeToFit: true,
                    filterSettings: {
                        filterType: "excel"
                    },
                    allowSorting: true,
                    isResponsive: true,
                    enableResponsiveRow: true,
                    pageSettings: { pageSize: 25, pageSizeList: [25, 50, 100] },
                    columnLayout: ej.Grid.ColumnLayout.Auto,
                    toolbarSettings: { showToolbar: true, toolbarItems: [ej.Grid.ToolBarItems.PrintGrid, ej.Grid.ToolBarItems.ExcelExport, ej.Grid.ToolBarItems.PdfExport, ej.Grid.ToolBarItems.Search] },
                    toolbarClick: function (args) {
                        if (args.itemName == "Print") {
                            var gridObj = $("#viewLista").data("ejGrid");
                            gridObj.hideColumns("Foto");
                            gridObj.hideColumns("BCI");
                            gridObj.hideColumns("Mapa");
                            gridObj.hideColumns("Croqui");
                            $("#viewLista").ejGrid("print");
                            args.cancel = true;
                            gridObj.showColumns("Foto");
                            gridObj.showColumns("BCI");
                            gridObj.showColumns("Mapa");
                            gridObj.showColumns("Croqui");
                            //args.cancel = true;
                        }
                        if (args.itemName == "Excel Export") {
                            //showMessage('Exportar para Excel');
                            args.cancel = true;
                            doit(options.columns, 'xlsx');
                            //this.export("api/Export/ExcelExport"); // Excel Export method.
                        }
                        if (args.itemName == "PDF Export") {
                            showMessage('Exportar para Pdf');
                            args.cancel = true;
                            //this.export("api/Export/PdfExport"); // PDF Export method.
                        }
                    },
                };
                Object.assign(defaultGridOptions, options);
                return defaultGridOptions;
            }

            function updateGridScroll(gridID, container) {
                var gridObj = $("#" + gridID).ejGrid("instance");
                let removalHeightNeeded = 170;
                var scrollerheight = (($("." + container).height()) - ($(".e-gridheader").outerHeight()) - ($(".e-pager").outerHeight())) / 2 - removalHeightNeeded;//Obtain the height of the container and subtract it from gridheader and pager
                gridObj.option({ allowScrolling: true, scrollSettings: {height: scrollerheight } });//pass the obtainer width and height to gridmodel options
            }
            
            function doit(cols,type, fn, dl) {
                //var elt2 = $('#combinedFinancialGrid table')[0];
                var elt = $('#combinedFinancialGrid .e-gridcontent table');
                var clonedHtml = elt.clone();
                clonedHtml.find('tbody').prepend($(getHeaders(cols)));
                var wb = XLSX.utils.table_to_book(clonedHtml[0], { sheet: "Sheet JS" });
                return dl ?
                    XLSX.write(wb, { bookType: type, bookSST: true, type: 'base64' }) :
                    XLSX.writeFile(wb, fn || ('SheetJSTableExport.' + (type || 'xlsx')));
            }

            function getHeaders(cols) {
                var cols = cols.map(function (elem) {
                    return '<td>' + elem.headerText +'</td>';
                });
                return '<tr>' + cols.join('') + '</tr>';
            }

            var dataManager = ej.DataManager({
                url: '@ViewBag.CombinedURL',
                crossDomain: true, adaptor: new ej.ODataV4Adaptor()
            });

            var combinedFinancialGridCols = [
                { field: "wONumber", headerText: 'WO Item', textAlign: ej.TextAlign.Right, width: 75 },
                { field: "wOCreationDate", headerText: 'Creation Date', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "dueDate", headerText: 'Due Date', textAlign: ej.TextAlign.Left, width: 120 },
                { field: "shipDate", headerText: 'Ship Date', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "mSRFSRFacility", headerText: 'Facility', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "customerName", headerText: 'Customer', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "specno", headerText: 'Specification', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "kitName", headerText: 'Kit Name', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "pono", headerText: 'Part #', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "mttn", headerText: 'MTTN', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "invoiceId", headerText: 'Invoice #', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "invoiceDate", headerText: 'Invoice Date', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "fillQty", headerText: 'Qty', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "amount", headerText: 'Amount', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "subTotal", headerText: 'SubTotal', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "wTax", headerText: 'w/ Tax', textAlign: ej.TextAlign.Left, width: 100 }
            ];

            var query = new ej.Query();
            var promise = dataManager.executeQuery(query);
            promise.done(function (e) {
                $("#combinedFinancialGrid").ejGrid(
                    setGridOptions({
                        dataSource: e.result, columns: combinedFinancialGridCols})
                );
                updateGridScroll('combinedFinancialGrid', 'app-container');
            });

            var dataManager = ej.DataManager({url: '@ViewBag.WONoInvoiceURL',crossDomain: true, adaptor: new ej.ODataV4Adaptor() });

            var query = new ej.Query();
            var promise = dataManager.executeQuery(query);
            promise.done(function (e) {
                $("#wONoInvoiceURLGrid").ejGrid(
                    setGridOptions({
                        dataSource: e.result, columns: [
                            { field: "cust_Purch_Num", headerText: 'Customer Purchase', textAlign: ej.TextAlign.Right, width: 75 },
                            { field: "work_Order_Item", headerText: 'Work Order Iteme', textAlign: ej.TextAlign.Left, width: 100 },
                            { field: "product_Name", headerText: 'Product Name', textAlign: ej.TextAlign.Left, width: 120 },
                            { field: "work_Order_Completed_Date", headerText: 'WO Complete Date', textAlign: ej.TextAlign.Left, width: 100 },
                            { field: "total_Sale_Price", headerText: 'Total', textAlign: ej.TextAlign.Left, width: 100 }
                        ]
                    })
                );
                updateGridScroll('wONoInvoiceURLGrid', 'app-container');
            });
        });

