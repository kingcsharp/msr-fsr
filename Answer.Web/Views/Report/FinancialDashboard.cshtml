            var dataManager = ej.DataManager({
                url: 'http://localhost:55170/api/Reporting/CombinedFinancialData',
                crossDomain: true, adaptor: new ej.ODataV4Adaptor()
            });
            var query = new ej.Query();
            var promise = dataManager.executeQuery(query);
            promise.done(function (e) {
                $("#FlatGrid").ejGrid({
                    dataSource: e.result,
                    dataManager:dataManager,
                    enableLoadOnDemand: false,
                    allowPaging: true,
                    pageSettings: { enableQueryString: true },
                    allowFiltering: true,
                    filterSettings: {
                        filterType: "excel"
                    },
                    //  allowResizeToFit: true,
                    allowSorting: true,
                    isResponsive: true,
                    enableResponsiveRow: true,
                    columnLayout: ej.Grid.ColumnLayout.Auto,
                    columns: [
                        { field: "wONumber", headerText: 'WO Item', textAlign: ej.TextAlign.Right, width: 75 },
                        { field: "wOCreationDate", headerText: 'Creation Date', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "dueDate", headerText: 'Due Date', textAlign: ej.TextAlign.Left, width: 120 },
                        { field: "shipDate", headerText: 'Ship Date', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "mSRFSRFacility", headerText: 'Facility', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "customerName", headerText: 'Customer', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "specno", headerText: 'Specification', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "kitName", headerText: 'Kit Name', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "pono", headerText: 'Part #', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "mttn", headerText: 'MTTN', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "invoiceId", headerText: 'Invoice #', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "invoiceDate", headerText: 'Invoice Date', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "fillQty", headerText: 'Qty', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "amount", headerText: 'Amount', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "subTotal", headerText: 'SubTotal', textAlign: ej.TextAlign.Left, width: 100 },
                        { field: "wTax", headerText: 'w/ Tax', textAlign: ej.TextAlign.Left, width: 100 }
                    ]
                });
            });
        });

