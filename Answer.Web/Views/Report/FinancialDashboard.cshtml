@{
    ViewBag.Title = "FinancialDashboard";
}
<style>
    .datatable {
        padding: 10px;
        min-height: 150px
    }
</style>

<link href="~/Content/ej/web/bootstrap-theme/ej.web.all.min.css" rel="stylesheet" />
<link href="~/Content/ej/web/ej.web.overrides.css" rel="stylesheet" />
<link href="#" rel="stylesheet" />
<div id="gridsContainer" class="side-body">
    <div class="row">
        <div class="col-xs-12">
            <div class="datatable">
                <div class="page-header">
                    <h1 ndtype="heading">Combined Financial Data</h1>
                    @Html.Partial("_ViewArchivesButton")
                    @Html.Partial("_HelpViewButton")


                </div>
                <div class="report-content" id="combinedFinancialGrid"></div>
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-xs-12">
            <div class="datatable">
                <div class="page-header"><h1>Work Orders Not Invoiced</h1></div>
                <div class="report-content" id="wONoInvoiceURLGrid"></div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_ArchivesModal")

@section Scripts{
    @*<script src="~/assets/js/reports/libs/js-xlsx/xlsx.core.min.js"></script>*@

    <script src="//unpkg.com/xlsx/dist/shim.min.js"></script>
    <script src="//unpkg.com/xlsx/dist/xlsx.full.min.js"></script>

    <script src="//cdn.syncfusion.com/js/assets/external/jquery.easing.1.3.min.js"></script>
    <script src="//cdn.syncfusion.com/js/assets/external/jquery.globalize.min.js"></script>
    <script src="//cdn.syncfusion.com/js/assets/external/jsrender.min.js"></script>
    <script src="~/Scripts/ej/web/ej.web.all.min.js"></script>
    <script type="text/javascript">
        $(function () {
            // haxors for help button alignment
            $('.page-help').css("margin-top", "-40px");

            //loading on page load
            $('.report-content').block({ message: '<h1><img src="/assets/img/nice_loader.gif" />  Loading. Please wait...</h1>' });
            $('.blockElement').css("width","50%","margin-left","250px");

            function setGridOptions(options) {
                var defaultGridOptions = {
                    enableLoadOnDemand: false,
                    allowPaging: true,
                    pageSettings: { enableQueryString: true },
                    allowFiltering: true,
                    allowResizeToFit: true,
                    filterSettings: {
                        filterType: "excel"
                    },

                    allowScrolling: true,
                    scrollSettings: { height: 840 },
                    allowSorting: true,
                    isResponsive: true,
                    enableResponsiveRow: true,
                    pageSettings: { pageSize: 25, pageSizeList: [25, 50, 100] },
                    columnLayout: ej.Grid.ColumnLayout.Auto,
                    toolbarSettings: { showToolbar: true, toolbarItems: [ej.Grid.ToolBarItems.ExcelExport,ej.Grid.ToolBarItems.Search] },
                    toolbarClick: function (args) {

                        if (args.itemName == "Excel Export") {
                            args.cancel = true;
                            doit(options, 'xlsx');
                        }
                    },
                };
                Object.assign(defaultGridOptions, options);
                return defaultGridOptions;
            }

            function doit(options,type, fn, dl) {
                var grid = $('#' + options.gridId).ejGrid('instance');

                const wb = { SheetNames: [], Sheets: {} };
                wb.Props = {
                    Title: "Stats from app",
                    Author: "John Doe"
                };
                var data = grid.getFilteredRecords().length > 0 ? grid.getFilteredRecords() : grid.model.dataSource;

                var colHeaders = {};
                var colsLength = options.columns.length;

                while(colsLength--){
                    colHeaders[options.columns[colsLength].field] = options.columns[colsLength].headerText;
                }

                var updatedData = [];
                for (var i = 0; i < data.length; i++) {
                    updatedData.push(renameKeys(data[i], colHeaders));
                }

                var ws = XLSX.utils.json_to_sheet(updatedData);
                var ws_name = "DataSheet1";
                XLSX.utils.book_append_sheet(wb, ws, ws_name);

                var colsLength = options.columns.length;
                var wscols = [];
                while (colsLength--) {
                    wscols.push({ wpx: options.columns[colsLength].width });
                }
                wb.Sheets["DataSheet1"]["!cols"] = wscols;

                return XLSX.writeFile(wb, options.title+'.xlsb');
            }

            function renameKeys(obj, newKeys) {
                var retObj = {};
                var keyValues = Object.keys(obj).map(function (key) {
                    if (newKeys[key] !== undefined) {
                        var newKey = newKeys[key];
                        retObj[newKey] = obj[key];
                    }
                    return;
                });
                return retObj;
            }

            var dataManager = ej.DataManager({
                url: '@ViewBag.CombinedURL',
                crossDomain: true, adaptor: new ej.ODataV4Adaptor()
            });

            var combinedFinancialGridCols = [
                { field: "woNumber", headerText: 'WO Item', textAlign: ej.TextAlign.Right, width: 130 },
                { field: "poNumber", headerText: 'PO #', textAlign: ej.TextAlign.Left, width: 60 },
                { field: "woCreationDate", headerText: 'Creation Date', textAlign: ej.TextAlign.Left, width: 60, type:"datetime", format: "{0:MM-dd-yyyy}" },
                { field: "dueDate", headerText: 'Due Date', textAlign: ej.TextAlign.Left, width: 60, type:"datetime", format: "{0:MM-dd-yyyy}" },
                { field: "shipDate", headerText: 'Ship Date', textAlign: ej.TextAlign.Left, width: 60, type:"datetime", format: "{0:MM-dd-yyyy}" },
                { field: "msrfsrFacility", headerText: 'Facility', textAlign: ej.TextAlign.Left, width: 60 },
                { field: "customerName", headerText: 'Customer', textAlign: ej.TextAlign.Left, width: 90 },
                { field: "customerPartNumber", headerText: 'Customer Part #', textAlign: ej.TextAlign.Left, width: 60 },
                { field: "specificationNumber", headerText: 'Specification', textAlign: ej.TextAlign.Left, width: 100 },
                { field: "kitName", headerText: 'Kit Name', textAlign: ej.TextAlign.Left, width: 120 },
                { field: "serial", headerText: 'Serial #', textAlign: ej.TextAlign.Left, width: 90 },
                { field: "mttn", headerText: 'MTTN', textAlign: ej.TextAlign.Left, width: 60 },
                { field: "invoiceId", headerText: 'Invoice #', textAlign: ej.TextAlign.Left, width: 70 },
                { field: "invoiceDate", headerText: 'Invoice Date', textAlign: ej.TextAlign.Left, width: 60, type:"datetime", format: "{0:MM-dd-yyyy}" },
                { field: "fillQty", headerText: 'Qty', textAlign: ej.TextAlign.Left, width: 40 },
                { field: "amount", headerText: 'Amount', textAlign: ej.TextAlign.Left, width: 55 },
                { field: "subTotal", headerText: 'SubTotal', textAlign: ej.TextAlign.Left, width: 60 },
                { field: "wTax", headerText: 'w/ Tax', textAlign: ej.TextAlign.Left, width: 60 }
            ];

            var query = new ej.Query();
            var promise = dataManager.executeQuery(query);
            promise.done(function (e) {
                $("#combinedFinancialGrid").unblock().ejGrid(
                    setGridOptions({
                        dataSource: e.result,
                        sortSettings: { sortedColumns: [{ field: "invoiceDate", direction: "descending" }] },
                        columns: combinedFinancialGridCols,
                        gridId: 'combinedFinancialGrid',
                        title: 'Combined_Financial_Data'
                    })
                );
            });

            var dataManager = ej.DataManager({url: '@ViewBag.WONoInvoiceURL',crossDomain: true, adaptor: new ej.ODataV4Adaptor() });

            var query = new ej.Query();
            var promise = dataManager.executeQuery(query);
            promise.done(function (e) {
                var wONoInvoiceURLGridCols = [
                    { field: "cust_Purch_Num", headerText: 'Customer Purchase', textAlign: ej.TextAlign.Right, width: 70 },
                    { field: "work_Order_Item", headerText: 'Work Order Item', textAlign: ej.TextAlign.Left, width: 70 },
                    { field: "location_Name", headerText: 'Location', textAlign: ej.TextAlign.Left, width: 70 },
                    { field: "product_Name", headerText: 'Product Name', textAlign: ej.TextAlign.Left, width: 200 },
                    { field: "work_Order_Completed_Date", headerText: 'WO Complete Date', textAlign: ej.TextAlign.Left, width: 40, type:"datetime", format: "{0:MM-dd-yyyy}" },
                    { field: "total_Sale_Price", headerText: 'Total', textAlign: ej.TextAlign.Left, width: 40 }
                ];
                $("#wONoInvoiceURLGrid").unblock().ejGrid(
                    setGridOptions({
                        dataSource: e.result,
                        sortSettings: { sortedColumns: [{ field: "work_Order_Completed_Date", direction: "descending" }] },
                        columns: wONoInvoiceURLGridCols,
                        gridId: 'wONoInvoiceURLGrid',
                        title: 'Work_Orders_Not_Invoiced'
                    })
                );
            });
        });

    </script>
}