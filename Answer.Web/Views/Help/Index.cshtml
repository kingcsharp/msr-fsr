@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Help Pages";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-life-bouy"></span>
                Help Pages
                     @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/help/create" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-help")
    <script>
        $.jgrid.defaults.styleUI = 'Bootstrap';

        $(document).ready(function () {
            Msr.HelpGrid.SetUpGrid('@Request.Url.OriginalString');
        });

    </script>
}