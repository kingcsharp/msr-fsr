@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Monitors";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-desktop"></span>
                Monitors
                @Html.Partial("_HelpViewButton")
            </h2>
            <div style="width:100%;">
                @Html.Partial("Message")
                <table id="jq-grid-monitors"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row row-bottom-buttons">
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-Monitors")

    <script type="text/javascript">
        $(document).ready(function () {
            Msr.MonitorsGrid.LoadMonitorsGrid('@Url.Action("MonitorsData", "Monitors")', '@Request.QueryString["description"]');
        });

    </script>
}
