@model Msr.Services.Workflows.ViewModels.SubmitWorkflowViewModel
@{
    ViewBag.Title = "Delete Approval Workflow & Submit";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Delete Approval Workflow & Submit
                <div class=" pull-right" data-toggle="modal">
                </div>
            </h2>
            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        @Html.Partial("Message")
                        @using (Html.BeginForm("Delete", "Workflow", FormMethod.Post, new { @class = "form form-horizontal" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(model => model.ObjectId)
                            @Html.HiddenFor(model => model.CompletionStart)
                            @Html.HiddenFor(model => model.ReturnUrl)

                            <div class="form-group">
                                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Model.Name
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Comment, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.TextAreaFor(model => model.Comment, new { htmlAttributes = new { @class = "form-control " } })
                                    @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.ApprovalWorflowId, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.ApprovalWorflowId, Model.WorkflowsList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.ApprovalWorflowId, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="form-group">
                                @Html.LabelFor(model => model.AllRevs, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.AllRevs, Model.DeleteAllRevisionsList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.AllRevs, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-lg-offset-2 col-lg-8">
                                    <input type="submit" value="Submit" class="btn btn-success" />
                                    <a href="@Model.ReturnUrl" class="btn btn-warning">Cancel</a>
                                </div>
                            </div>

                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
}