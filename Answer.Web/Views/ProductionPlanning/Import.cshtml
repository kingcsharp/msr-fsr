@model IEnumerable<Msr.Services.ProductionPlanning.ViewModels.ProductImportViewModel>
@{
    ViewBag.Title = "Products Import";
}
<style>
    .validation-summary-errors {
        color: red;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Upload File @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                <div class="form-horizontal">
                    @Html.Partial("Message")
                    <div class="row">
                        <div>
                            The import file must be a tab delimited text file (.csv)<br />
                            It must have these columns in any order ExternalProductId,ExternalCustId,ExternalPartId,ExternalProcedureId,ExternalProductSupplierId,ExternalAccountSupplierId,InternalCustomerId,InternalProductSupplierId,</br>
                            InternalAccountSupplierId,InternalRoleId,InternalPartId,ProductName,Oem,Model,Area,Cu,Mm,Price,ResponseTime,SalesTax,InternalProcedureId,IsKit,KitId,KitQty<br />
                            If PRODUCT_ID exists - update, not create, blank always makes a new one.<br />
                            The file must have the column names as the first row capitalized and spelled like above<br />
                            The field definitions are<br />
                            ExternalProductId = unique ID in the external database or ANSWER for the part.<br />
                            ExternalCustId = unique ID in the external database or ANSWER for the CUSTOMER company.<br />
                            ResponseTime = number of days for the response time.<br />
                            ProductName = the name for the product.<br />
                            Price = the price of the product.<br />
                            ExternalPartId = unique ID in the external database or ANSWER for the part.<br />
                            ExternalProcedureId = unique ID in the external database or ANSWER for the procedure.<br />
                            SalesTax = 1 or 0 1 for yes sales tax and 2 for no sales tax<br />
                            ExternalProductSupplierId = unique ID in the external database or ANSWER for the Supplier Department or Company.<br />
                            InternalRoleId = unique ID in the external database or ANSWER for the Role that does the Default Step of the procedure.<br />
                        </div>
                    </div>
                    @using (Html.BeginForm("Import", "ProductionPlanning", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()
                        <table>
                            <tr>
                                <td>
                                    <label class="btn btn-primary" for="postedFile">
                                        <input id="postedFile" type="file" name="postedFile" accept=".csv" style="display: none" />
                                        Browse...
                                    </label>
                                </td>
                                <td style="padding-left: 5px;">
                                    <input type="submit" class="btn btn-success" value="Process Import" />
                                </td>
                                <td style="padding-left: 5px;">
                                    <a class="btn btn-link" href="~/ProductionPlanning/ImportSampleFile" target="_blank">Download sample file </a>
                                </td>
                            </tr>
                        </table>
                    }
                </div>
                @if (Model != null && Model.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.ExternalProductId)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.ProductName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Processed)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Messages)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ExternalProductId)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ProductName)
                                    </td>
                                    <td>
                                        @if (item.Processed)
                                        {
                                            <span class="btn btn-xs btn-success"> <i class="fa fa fa-check"></i> </span>
                                        }
                                        else
                                        {
                                            <span class="btn btn-xs btn-danger"> <i class="fa fa fa-exclamation-circle"></i> </span>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var message in item.Messages)
                                        {
                                            @message <br />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
