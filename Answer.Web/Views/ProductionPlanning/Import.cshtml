@model IEnumerable<Msr.Services.Parts.ViewModels.AddPartViewModel>

@{
    ViewBag.Title = "Products Import";
}
<style>
    .validation-summary-errors {
        color: red;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Add File<button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-10">
                <div class="form-horizontal">
                    @Html.Partial("Message")
                    <div class="row">
                        <div class="alert alert-warning">
                            The Import File must be an Excel file<br />
                            It must have these columns in any order PRODUCT_ID,COMPANY_ID,RESPONSE_TIME,PRODUCT_NAME,PRICE,PART_ID,PROCEDURE_ID,SALES_TAX,SUPPLIER_ID<br />
                            If PRODUCT_ID exists - update, not create, blank always makes a new one.<br />
                            The file must have the column names as the first row capitalized and spelled like above<br />
                            The field definitions are<br />
                            PRODUCT_ID = unique ID in the external database or ANSWER for the part.<br />
                            COMPANY_ID = unique ID in the external database or ANSWER for the CUSTOMER company.<br />
                            RESPONSE_TIME = number of days for the response time.<br />
                            PRODUCT_NAME = the name for the product.<br />
                            PRICE = the price of the product.<br />
                            PART_ID = unique ID in the external database or ANSWER for the part.<br />
                            PROCEDURE_ID = unique ID in the external database or ANSWER for the procedure.<br />
                            SALES_TAX = 1 or 0 1 for yes sales tax and 2 for no sales tax<br />
                            SUPPLIER_ID = unique ID in the external database or ANSWER for the Supplier DEpartment or Company.<br />
                            ROLE_ID = unique ID in the external database or ANSWER for the Role that does the Default Step of the procedure.<br />
                            PROCEDURE_NAME = The Name of the procedure if the system has to create it.<br />
                            PART_NAME = The Name of the part if the system has to create it.<br />
                        </div>
                        <a class="btn btn-link" href="" target="_blank">Download excel file sample </a>
                    </div>

                    @using (Html.BeginForm("Import", "ProductionPlanning", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()
                        <label class="btn btn-primary" for="postedFile">
                            <input id="postedFile" type="file" name="postedFile" accept="application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" style="display:none" onchange="$('#upload-file-info').html(this.files[0].name)" />
                            Browse...
                        </label>
                        <span class='label label-info' id="upload-file-info"></span><br />
                        <input type="submit" class="btn btn-success" value="Process Import" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>