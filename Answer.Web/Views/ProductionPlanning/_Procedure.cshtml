@model Msr.Services.Procedures.ViewModels.SaveProcedureViewModel


<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">

            @using (Html.BeginForm("CreateProcedure", "ProductionPlanning", FormMethod.Post, new { @id = "AddProcedure", @class = "form-horizontal", @role = "form" }))
            {
                <div class="form-horizontal addpart part">

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })


                    <div class="form-group">
                        @Html.LabelFor(model => model.Verb, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.Verb, Model.VerbList, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Verb, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.SystemId, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.SystemId, Model.SystemList, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.SystemId, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">

                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            <div style="width: 96%; float: left;">
                                @Html.ListBoxFor(m => m.ReferenceFiles, Model.ReferenceFilesList, new { @class = "form-control submitselect", multiple = "multiple", @id = "ReferenceFile" })
                                @Html.ValidationMessageFor(model => model.ReferenceFiles, "", new { @class = "text-danger" })
                            </div>
                            <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="ReferenceFile" data-toggle="modal" data-target="#select-images"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceFile"><i class="icon fa fa-trash"></i></span> </div>
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.TextAreaFor(model => model.Comments, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Comments, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.SecurityLevel, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.SecurityLevel, Model.SecurityLevelList, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.SecurityLevel, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Roles, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.Roles, Model.RolesList, new { @class = "form-control", multiple = "multiple", style = "z-index: 999;" })
                            @Html.ValidationMessageFor(model => model.Roles, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.StepInAp, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.StepInAp, Model.SetpInApList, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.StepInAp, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Duration, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.EditorFor(model => model.Duration, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.DurationType, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.DurationType, Model.DurationTypeList, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.DurationType, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.WipMsg, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.WipMsg, Model.WipMsgList, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.WipMsg, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input id="ProcedureSubmit" type="button" value="Submit" class="btn btn-success" />
                            <input id="procedureClose" type="button" value="Cancel" class="btn btn-warning" data-dismiss="modal" />
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>
</div>





<script type="text/javascript">
    $('#ProcedureSubmit').on('click',
        function() {
            var form = $('#AddProcedure').serialize();
            $.ajax({
                type : "POST",
                url : "@Url.Action("CreateProcedure","ProductionPlanning")",
                dataType : "json",
                data: form,
                success : function(result) {
                    // alert(result.Message); // result is an object which is created from the returned JSON
                    $('#ProductProcedureId').html('');
                    console.log(result.data);
                    $.each(result.data, function (i, item) {
                        $('#ProductProcedureId').append($('<option>', {
                            value: item.Value,
                            text : item.Show
                        }));
                    });
                    console.log(result.ProcedureId);
                    $('#ProductProcedureId').val(result.ProcedureId);
                    $('#ProductProcedureId').trigger('click');
                    $('#procedureClose').click();
                },
                error : function(error) {
                    alert(error.Message);
                }
            });
        });
</script>


