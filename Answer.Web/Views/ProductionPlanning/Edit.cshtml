@model Msr.Models.CustomerRequirements.CustomerSubmittedRequirement
@{

    ViewBag.Title = "Create Product";
}
<div class="app-container">
<div class="row content-container">
<div class="container-fluid">
<div class="side-body padding-top" style="visibility:hidden;">
    <div class="row">

        <div class="col-lg-12">
            <table id="custReqsGrid"></table>
        </div>
        <div id=""></div>
    </div>

</div>
<div class="row" id="reqDetail" style="margin-top:-200px;">
<div class="col-lg-9 col-md-8">
    <h2 class="page-header" style="margin-left:50px;">Create Product <span id="partNumTitle">@Model.PartKitNo</span> </h2>
</div>
<div class="col-lg-3 col-md-4" style="display:block;">

    <div style="display:inline-block;" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="Show/Hide Finincial Columns">
        <div class="form-group">
            <label style="margin-top:-200px; margin-left:-130px; width:360px;">Show All Columns</label>
            <div style="width:100px;height:50px; margin-top:-200px;">
                <div class="make-switch switch-small" data-on="success" data-off="warning" style="display:inline-block;padding-top: 166px;">
                    <div id="colSwitch" class="bootstrap-switch-off bootstrap-switch-id-showHiddenColumns bootstrap-switch bootstrap-switch-wrapper bootstrap-switch-animate" style="width: 108px; background-color:white;height:36px;"><div class="bootstrap-switch-container" style="width: 159px; margin-left: -20px; text-align:center; height:34px !important;"><span class="bootstrap-switch-handle-on bootstrap-switch-primary" style="width: 53px;">ON</span><span class="bootstrap-switch-label" style="margin-left:-60px;">&nbsp;</span><span class="bootstrap-switch-handle-off bootstrap-switch-default" style="margin-left:-90px;">OFF</span><input id="showHiddenColumns" name="unhide-switch" type="checkbox"></div></div>
                </div>
            </div>
        </div>
    </div>
    
    @if (!string.IsNullOrWhiteSpace(Model.CustomerRequirementJson))
    {
        <div style="display: inline-block; margin-left: 10px; position: relative; top: 19px;" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="View Orginally Submitted Requirements from Customer">
            <button type="button" class="btn btn-primary pull-right" data-call-back-id="@Model.Id" data-toggle="modal" data-target="#userRequirementsModal"><i class="fa fa-eye"></i> View Requirements</button>
        </div>
    }
</div>
               
<div class="col-lg-12" style="padding-left:75px">
    <div class="col-lg-12 col-md-11">
        <div>@Html.Partial("Message")</div>
        <div style="text-align:left;padding-left:52px">@Html.ValidationSummary(false, "", new { @class = "text-danger" })</div>
    </div>
    @using (Html.BeginForm("Edit", "ProductionPlanning", FormMethod.Post, new { @id = "stepForm", @class = "form form-horizontal", role = "form" }))
    {
        @*<div class="row clearfix">
            <div class="col-md-12 column">
                <input type="hidden" value="@Model.requirementSteps.Count" id="totalRecords" />
                <input type="hidden" value="" id="postType" name="postType" />
                <table class="table table-bordered table-hover table-striped table-condensed" id="process_steps">
                    <thead>
                    <tr data-toggle="tooltip" data-placement="top" title="">
                        <th class="text-center" width="15%">
                            Process
                        </th>
                        <th class="text-center" width="5%">
                            Step #
                        </th>
                        <th class="text-center">
                            Standard Direct Labor Minutes
                        </th>
                        <th class="text-center">
                            Standard Machine Minutes
                        </th>
                        <th class="text-center hidden hide-col" width="10%">
                            Replacement Cost
                        </th>
                        <th class="text-center hidden hide-col" width="10%">
                            Utilization
                        </th>
                        <th class="text-center hidden hide-col" width="10%">
                            Useful Life
                        </th>
                        <th class="text-center hidden hide-col" width="10%">
                            Equip. Expense Per Minute
                        </th>
                        <th class="text-center hidden hide-col" width="10%">
                            Annual R&amp;M
                        </th>
                        <th class="text-center hidden hide-col" width="10%">
                            R&amp;M Per Minute
                        </th>

                    </tr>
                    </thead>
                    <tbody>

                    @for (int i = 0; i < Model.requirementSteps.Count; i++)
                    {
                        var rowid = "row" + i;
                        <tr id="@rowid" data-toggle="tooltip" data-placement="top" title="">
                            <td>
                                @for (int j = 0; j < Model.ProcessList.Count; j++)
                                {
                                    if (Model.ProcessList[j].Value == Model.requirementSteps[i].Process)
                                    {
                                        Model.ProcessList[j].Selected = true;
                                    }
                                    else
                                    {
                                        Model.ProcessList[j].Selected = false;
                                    }
                                }
                                @Html.DropDownListFor(model => model.requirementSteps[i].Process, Model.ProcessList, new { @id = "proId", @class = "form-control" })
                                @Html.ValidationMessageFor(model => Model.requirementSteps[i].Process, "", new { @class = "text-danger" })
                            </td>
                            <td>
                                @Html.HiddenFor(x => Model.requirementSteps[i].Id, new { @id = "stepId", @class = "form-control" })
                                @Html.TextBoxFor(x => Model.requirementSteps[i].Step, new { @class = "form-control", @onkeyup = "javascript:checkType(this)" })
                                @Html.ValidationMessageFor(x => Model.requirementSteps[i].Step, "", new { @class = "text-danger" })
                            </td>
                            <td>
                                @Html.TextBoxFor(x => Model.requirementSteps[i].StandardDirectLaborMinutes, new { @class = "form-control labor-mins", @onkeyup = "javascript:checkType(this)" })
                                @Html.ValidationMessageFor(x => Model.requirementSteps[i].StandardDirectLaborMinutes, "", new { @class = "text-danger" })
                            </td>
                            <td>
                                @Html.TextBoxFor(x => Model.requirementSteps[i].StandardMachineMinutes, new { @class = "form-control machine-mins", @onkeyup = "javascript:checkType(this)" })
                                @Html.ValidationMessageFor(x => Model.requirementSteps[i].StandardMachineMinutes, "", new { @class = "text-danger" })
                            </td>
                            <td class="text-center hidden hide-col">
                                <div class="input-group">
                                    <span class="input-group-addon">$</span>
                                    @Html.TextBoxFor(x => Model.requirementSteps[i].ReplacementCost, new { @class = "form-control", @onkeyup = "javascript:checkType(this)", @onblur = "javascript:checkBlank(this)" })
                                    @Html.ValidationMessageFor(x => Model.requirementSteps[i].ReplacementCost, "", new { @class = "text-danger" })
                                    <span class="input-group-addon">.00</span>
                                </div>
                            </td>
                            <td class="text-center hidden hide-col">
                                <div class="input-group">
                                    @Html.TextBoxFor(x => Model.requirementSteps[i].Utilization, new { @class = "form-control", @onkeyup = "javascript:checkType(this)", @onblur = "javascript:checkBlank(this)" })
