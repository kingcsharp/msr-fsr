@model Msr.Services.ProductionPlanning.ViewModels.RequirementStepsViewModel

@{
    ViewBag.Title = "Requirements Step Definition";
}

<div class="app-container">
    <div class="row content-container">
        <div class="container-fluid">
            <div class="side-body padding-top" style="visibility:hidden;">
                <div class="row">

                    <div class="col-lg-12">
                        <table id="custReqsGrid"></table>
                    </div>
                    <div id=""></div>
                </div>
            </div>

            <div class="container-fluid" style="margin-top:-10%;">
                <div class="side-body padding-top">
                    <div class="" id="reqDetail">

                        <div class="row">
                            <div class="col-sm-9">
                                <h2>New Product Definition</h2>
                            </div>
                            @if (!Model.HasQuote)
                            {
                                <div class="col-sm-3" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="View Orginally Submitted Requirements from Customer">
                                    <button type="button" class="btn btn-primary pull-right" data-call-back-id="@Model.Id" data-toggle="modal" data-target="#userRequirementsModal"><i class="fa fa-eye"></i> View Requirements</button>
                                </div>
                            }
                        </div>

                        @using (Html.BeginForm("Edit", "ProductionPlanning", FormMethod.Post, new { @id = "production-planning-form", @class = "", role = "form"}))
                        {
                            @Html.HiddenFor(x=>x.Id)
                            @Html.HiddenFor(x=>x.OldProductProcedureId)
                            @Html.HiddenFor(x=>x.HasQuote)
                            @Html.HiddenFor(x => x.SubmittedRequirement.Status)

                            @Html.Partial("_Product")

                            @Html.Partial("_Steps")

                         
                        }

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@Html.Partial("_Models")

<div id="partmodel" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">part Details</h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>
<div id="proceduremodel" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Procedure Details</h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    
    <script type="text/javascript" src="~/assets/js/ObjectAssign.js"></script>
    <script type="text/javascript" src="~/assets/js/grids/requirement-steps.js"></script>
    
    <script src="~/assets/js/grids/comman.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#Print').on('click', function () {
                $('#printThis').printThis();
            });

            $('#ProductProcedureId').on('change', function () {
                $('#form-change').trigger('click');
            });

            $(".selectPart").select2();

            $(".selectProcedure").select2();

            $(".selectroles").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select Roles",
                formatNoMatches: function () {
                    return '';
                }
            });

            $('#partmodel').on('show.bs.modal',
                function (event) {


                    var modal = $(this);

                    $.ajax({
                        type: "GET",
                        url: '@Url.Action("Part", "ProductionPlanning")',
                        dataType: 'html',
                        success: function (data) {
                            modal.find('.modal-body').html(data);

                        },
                        error: function (data) {
                        }
                    });
                });

            $('#proceduremodel').on('show.bs.modal',
                function (event) {


                    var modal = $(this);

                    $.ajax({
                        type: "GET",
                        url: '@Url.Action("Procedure", "ProductionPlanning")',
                        dataType: 'html',
                        success: function (data) {
                            modal.find('.modal-body').html(data);

                        },
                        error: function (data) {
                        }
                    });
                });

        });
    </script>
}



