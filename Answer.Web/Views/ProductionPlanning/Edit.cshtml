@model Msr.Services.ProductionPlanning.ViewModels.RequirementStepsViewModel
@{
    ViewBag.Title = "Requirements Step Definition";
}

<div class="app-container">
    <div class="row content-container">
        <div class="container-fluid">
            <div class="side-body padding-top" style="visibility:hidden;">
                <div class="row">
                    <div class="col-lg-12">
                        <table id="custReqsGrid"></table>
                    </div>
                    <div id=""></div>
                </div>
            </div>
            <div class="container-fluid" style="margin-top:-10%;">
                <div class="side-body padding-top">
                    <div class="" id="reqDetail">
                        <div class="row">
                            <div class="col-sm-9">
                                <h2>New Product Definition</h2>
                            </div>
                            @if (!Model.HasQuote)
                            {
                                <div class="col-sm-3" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="View Orginally Submitted Requirements from Customer">

                                    <button type="button" class="btn btn-primary pull-right"
                                            data-id="@Model.Id"
                                            data-object="@Model.PObjectId"
                                            data-toggle="modal"
                                            data-target="#userRequirementsModal">
                                        <i class="fa fa-eye"></i> View Requirements
                                    </button>
                                </div>
                            }
                        </div>
                        @Html.Partial("Message")
                        @using (Html.BeginForm("Edit", "ProductionPlanning", FormMethod.Post, new { @id = "production-planning-form", @class = "production-planning-form", role = "form" }))
                        {
                            <input type="hidden" id="QuoteProcedureName" name="QuoteProcedureName" value="@ViewBag.QuoteProcedureName" />
                            @Html.HiddenFor(x => x.Id)
                            @Html.HiddenFor(x => x.CustomerSubmitId)
                            @Html.HiddenFor(x => x.NewProcedure)
                            @Html.HiddenFor(x => x.PObjectId)
                            @Html.HiddenFor(x => x.OldProductProcedureId)
                            @Html.HiddenFor(x => x.HasQuote)
                            @Html.HiddenFor(x => x.ProductSupplierId)
                            @Html.HiddenFor(x => x.SubmittedRequirement.Status)
                            @Html.HiddenFor(x => x.AdminCostSettings.RmAnnualRate, new { @class = "admin-cost-settings-rm-annual-rate" })
                            @Html.HiddenFor(x => x.AdminCostSettings.HourMinutes, new { @class = "admin-cost-settings-hour-minutes" })
                            @Html.HiddenFor(x => x.AdminCostSettings.LaborRateMinute, new { @class = "admin-cost-settings-labor-rate-minute" })
                            @Html.HiddenFor(x => x.AdminCostSettings.YearsHours, new { @class = "admin-cost-settings-years-hours" })

                            @Html.Partial("_Product")

                            if (Model.Steps.Any())
                            {
                                @Html.Partial("_Steps")
                            }

                            <div>
                                @if (Model.ProductStatus != "APPROVED")
                                {
                                    @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-warning back-step pull-right", title = "Back To Production Planning", style = "margin-left: 10px;" })
                                    <button id="form-change" class="hidden" style="margin-left: 10px;" data-toggle="tooltip" data-placement="top" title="" data-original-title="Saves and Sends Quoation to Client" name="" value=""> Submit</button>
                                    <button id="submit" type="submit" class="pull-right btn btn-success" style="margin-left: 10px;" data-toggle="tooltip" data-placement="top" title="" data-original-title="Saves and Sends Quoation to Client" name="SaveSubmit" value="SaveSubmit"><i class="fa fa-send"></i> Save &amp; Submit</button>
                                    <button id="save_draft" class="pull-right btn btn-info" style="margin-left: 10px;" data-toggle="tooltip" data-placement="top" title="" data-original-title="Saves with In Progress Status" type="submit" name="SaveSubmit"><i class="fa fa-save"></i> Save Draft</button>
                                }
                                @if (Model.HasQuote)
                                {
                                    <span class="pull-right btn btn-primary" style="margin-left: 10px;"
                                          data-id="@Model.CustomerSubmitId"
                                          data-object="@Model.PObjectId"
                                          data-placement="top" title=""
                                          data-original-title="Generates a Quote Preview"
                                          data-toggle="modal"
                                          data-target="#quoteModal">
                                        <i class="fa fa-eye"></i>Preview Quote
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_Models")

@section scripts
{
    <script type="text/javascript" src="~/assets/js/ObjectAssign.js"></script>
    <script type="text/javascript" src="~/assets/js/grids/requirement-steps.js"></script>
    <script src="~/assets/js/msr/grid-common.js"></script>
    @Scripts.Render("~/bundles/js/jqueryval")

    <script type="text/javascript">
        $(document).ready(function() {
            @if (Model.Steps.Count > 0)
            {
                <text>
                    $('.preDefinedStep').css("display", "none");
                </text>
            }
            var i = parseInt($('#totalRecords').val());
            var myoptions = $('#defaultProcessList').html();
            LoadSteps(i, myoptions);
            //override value if manually edited
            if (!isNaN(parseFloat('@Model.TotalSalePrice'))) {
                $("#totalSalePrice").val(parseFloat(@Model.TotalSalePrice).toFixed(2));
            }

            $('#Print').on('click', function () {
                $('#printThis').printThis();
            });
            $('.quote-requirements-preview').on('click', function () {
                $('.quote-requirements-print').printThis();
            });

            $('.selectProcedure').on('change', function () {
                $('#step-grid').block({ message: '<h1><img src="/assets/img/nice_loader.gif" />  Loading. Please wait...</h1>' });
                $('#production-planning-form').removeData('validator');
                $('#production-planning-form').removeData('unobtrusiveValidation');
                $('#production-planning-form').validate().cancelSubmit = true;
                $('#form-change').trigger('click');
            });

            $('#new-procedure').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                window.open('/Procedures/Create', '_blank');
            });

            $('#new-part').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                window.open('/parts/AddPart', '_blank');
             });

            $(".selectroles").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select Roles",
                formatNoMatches: function() {
                    return '';
                }
            });
            $("#refresh-parts").on('click', function (e) {
                e.preventDefault();
                $this = $(this);
                var url = "/ProductionPlanning/Parts";
                $.ajax({
                    data: {},
                    type: 'POST',
                    cache: false,
                    dataType: 'json',
                    url: url,
                    beforeSend: function () {
                        $this.attr('disabled', true);
                        $this.children('i').addClass('fa-spin');
                        $this.tooltip('hide');
                    },
                    success: function (result) {
                        $('#partsList').find('option').remove().end().append('<option value="">Select a Part</option>');
                        $.each(result.records, function (i, item) {
                            $('#partsList').append('<option value="' + item.Value + '">' +
                                item.Show + '</option>');
                        });
                    },
                    error: function () {

                        alert('Sorry, We could not update the list. Please contact support');
                    },
                    complete: function () {
                        $this.attr('disabled', false).blur();
                        $this.children('i').removeClass('fa-spin');
                    }
                });
            });
            $("#refresh-procedures").on('click', function (e) {
                $this = $(this);
                e.preventDefault();
                var url = "/ProductionPlanning/ApprovedProcedures";
                $.ajax({
                    data: {},
                    type: 'POST',
                    cache: false,
                    dataType: 'json',
                    url: url,
                    beforeSend: function () {
                        $this.attr('disabled', true);
                        $this.children('i').addClass('fa-spin');
                        $this.tooltip('hide');
                    },
                    success: function (result) {
                        $("#ProductProcedureId").find('option').remove().end().append('<option value="">Select a Procedure</option>');
                        $.each(result.records, function (i, item) {
                            $("#ProductProcedureId").append('<option value="' + item.Value + '">' +
                                item.Show + '</option>');
                        });
                    },
                    error: function (ex) {
                        alert('Sorry, We could not update the list. Please contact support');
                    },
                    complete: function () {
                        $this.attr('disabled', false);
                        $this.children('i').removeClass('fa-spin');
                    }
                });
            });
        });
    </script>
}