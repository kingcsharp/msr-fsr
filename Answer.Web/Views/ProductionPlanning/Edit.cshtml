                                @Html.ValidationMessageFor(x => Model.requirementSteps[i].UsefulLife, "", new { @class = "text-danger" })

                            </td>
                            <td class="text-center hidden hide-col">
                                <div class="input-group">
                                    <span class="input-group-addon">$</span>
                                    @Html.TextBoxFor(x => Model.requirementSteps[i].EquipExpensePerMinute, new { @class = "form-control", @onkeyup = "javascript:checkType(this)", @onblur = "javascript:checkBlank(this)" })
                                    @Html.ValidationMessageFor(x => Model.requirementSteps[i].EquipExpensePerMinute, "", new { @class = "text-danger" })
                                    <span class="input-group-addon">.00</span>
                                </div>
                            </td>
                            <td class="text-center hidden hide-col">
                                <div class="input-group">
                                    <span class="input-group-addon">$</span>
                                    @Html.TextBoxFor(x => Model.requirementSteps[i].AnnualRM, new { @class = "form-control", @onkeyup = "javascript:checkType(this)", @onblur = "javascript:checkBlank(this)" })
                                    @Html.ValidationMessageFor(x => Model.requirementSteps[i].AnnualRM, "", new { @class = "text-danger" })
                                    <span class="input-group-addon">.00</span>
                                </div>
                            </td>
                            <td class="text-center hidden hide-col">
                                <div class="input-group">
                                    <span class="input-group-addon">$</span>
                                    @Html.TextBoxFor(x => Model.requirementSteps[i].RMPerMinute, new { @class = "form-control", @onkeyup = "javascript:checkType(this)", @onblur = "javascript:checkBlank(this)" })
                                    @Html.ValidationMessageFor(x => Model.requirementSteps[i].RMPerMinute, "", new { @class = "text-danger" })
                                    <span class="input-group-addon">.00</span>
                                </div>
                            </td>
                        </tr>

                    }
                    @{
                        var trows = "row" + Model.requirementSteps.Count;
                    }

                    <tr id="@trows"></tr>
                    </tbody>
                    <tfoot>
                    <tr>
                        <td>&nbsp;</td>
                        <td class="text-right">Total:</td>
                        <td class="text-right">
                            @Html.EditorFor(model => model.TotalDirectMins, new { htmlAttributes = new { @id = "totalDirectMins", @class = "form-control" } })
                        </td>
                        <td class="text-right">
                            @Html.EditorFor(model => model.TotalMachineMins, new { htmlAttributes = new { @id = "totalMachineMins", @class = "form-control" } })
                        </td>
                        <td colspan="6" class="hidden hide-col">&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td class="text-right">Dollars:</td>
                        <td class="text-right">
                            <div class="input-group">
                                <span class="input-group-addon">$</span>
                                @Html.EditorFor(model => model.TotalDirectDollar, new { htmlAttributes = new { @id = "totalDirectDollar", @class = "form-control" } })
                            </div>
                        </td>
                        <td class="text-right">
                            <div class="input-group">
                                <span class="input-group-addon">$</span>
                                @Html.EditorFor(model => model.StandardMachineDollar, new { htmlAttributes = new { @id = "standardMachineDollar", @class = "form-control" } })
                            </div>
                        </td>
                        <td colspan="6" class="hidden hide-col">&nbsp;</td>
                    </tr>
                    <tr>
                        <td>&nbsp;</td>
                        <td colspan="2" class="text-right">Recommended Sale Price:</td>
                        <td class="text-right">
                            <div class="input-group">
                                <span class="input-group-addon">$</span>
                                @Html.EditorFor(model => model.TotalSalePrice, new { htmlAttributes = new { @id = "totalSalePrice", @class = "form-control" } })
                            </div>
                        </td>
                        <td colspan="6" class="hidden hide-col">&nbsp;</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>*@
        <a id="add_row" class="btn btn-primary pull-left" data-toggle="tooltip" data-placement="top" title="" data-original-title="Add a Step to the Definition"><i class="fa fa-plus-circle"></i> Add Step</a>
        <a id="delete_row" class="pull-left btn btn-warning" style="margin-left: 10px;" data-toggle="tooltip" data-placement="top" title="" data-original-title="Removes Last Step from Definition"><i class="fa fa-minus-circle"></i> Remove Step</a>
        <span data-toggle="tooltip" data-placement="top" title="" data-original-title="Back To Production Planning">&nbsp;&nbsp; @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-warning back-step" })</span>

        <button id="submit" class="pull-right btn btn-success" style="margin-left: 10px;" data-toggle="tooltip" data-placement="top" title="" data-original-title="Saves and Sends Quoation to Client" onclick="saveSubmit()"><i class="fa fa-send"></i> Save &amp; Submit</button>
        <button id="save_draft" class="pull-right btn btn-info" style="margin-left: 10px;" data-toggle="tooltip" data-placement="top" title="" data-original-title="Saves with In Progress Status" type="submit" onclick="draft()"><i class="fa fa-save"></i> Save Draft</button>

        if (!string.IsNullOrWhiteSpace(Model.QuoteJson))
         {
             <span class="pull-right btn btn-primary" style="margin-left: 10px;" data-id="@Model.Id" data-placement="top" title="" data-original-title="Generates a Quote Preview" data-toggle="modal" data-target="#quoteModal"><i class="fa fa-eye"></i>Preview Quote</span>
         }
        
    }
</div>

</div>
</div>
</div>
</div>

<div id="userRequirementsModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">×</button>
                <h4 class="modal-title">Requirements Submission Details</h4>
            </div>
            <div class="modal-body" style="max-height: 100% !important;">
                <div class="modal-footer">
                    <button type="button" class="btn btn-info" onclick="js:window.print()"><i class="fa fa-print"></i> Print </button>
                    <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
                </div>
            </div>

        </div>
    </div>
</div>

<div id="quoteModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">×</button>
                <h4 class="modal-title">Quote Preview</h4>
            </div>
            <div class="modal-body" style="max-height: 100% !important;">
               
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-info" onclick="js:window.print()"><i class="fa fa-print"></i> Print </button>
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>

    </div>
</div>

<div id="wipHelpModal" class="modal fade" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">×</button>
                <h4 class="modal-title">Work Order Screen Help</h4>
            </div>
            <div class="modal-body">
                <h4>Help Information for Work Order Screens</h4>

                <div class="alert alert-info">Here is where the help information will go for this section. </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary pull-left" data-toggle="modal" data-target="#supportModal"><i class="fa fa-life-bouy"></i> Open Ticket</button>
                <button type="button" class="btn btn-info" onclick="js:window.print()"><i class="fa fa-print"></i> Print Help</button>
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>

    </div>
</div>

