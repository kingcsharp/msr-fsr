@model Msr.Services.ProductionPlanning.ViewModels.RequirementStepsViewModel
@{
    ViewBag.Title = "Requirements Step Definition";
}
<div class="app-container">
    <div class="row content-container">
        <div class="container-fluid">
            <div class="side-body padding-top" style="visibility:hidden;">
                <div class="row">
                    <div class="col-lg-12">
                        <table id="custReqsGrid"></table>
                    </div>
                    <div id=""></div>
                </div>
            </div>
            <div class="container-fluid" style="margin-top:-10%;">
                <div class="side-body padding-top">
                    <div class="" id="reqDetail">
                        <div class="row">
                            <div class="col-sm-9">
                                <h2>View Product Definition</h2>
                            </div>
                            @if (!Model.HasQuote)
                            {
                                <div class="col-sm-3" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="View Orginally Submitted Requirements from Customer">
                                    <button type="button" class="btn btn-primary pull-right" data-call-back-id="@Model.Id" data-toggle="modal" data-target="#userRequirementsModal"><i class="fa fa-eye"></i> View Requirements</button>
                                </div>
                            }
                        </div>
                        @using (Html.BeginForm("Edit", "ProductionPlanning", FormMethod.Post, new { @id = "production-planning-form", @class = "", role = "form" }))
                        {
                            @Html.HiddenFor(x => x.Id)
                            @Html.HiddenFor(x => x.OldProductProcedureId)
                            @Html.HiddenFor(x => x.HasQuote)
                            @Html.HiddenFor(x => x.SubmittedRequirement.Status)

                            @Html.Partial("_Product")

                            @Html.Partial("_Steps")


                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_Models")
@section scripts
{
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>

    <script type="text/javascript" src="~/assets/js/ObjectAssign.js"></script>
    <script type="text/javascript" src="~/assets/js/grids/requirement-steps.js"></script>

    <script src="~/assets/js/grids/comman.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            var i = parseInt($('#totalRecords').val());
            var myoptions = $('#defaultProcessList').html();
            LoadSteps(i, myoptions);

            $('#Print').on('click', function () {
                $('#printThis').printThis();
            });

            $("input,select").prop('disabled', true);

        });
    </script>
}

