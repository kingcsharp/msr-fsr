@model Msr.Services.ProductionPlanning.ViewModels.RequirementStepsViewModel
@{
    ViewBag.Title = "Requirements Step Definition";
}
<div class="app-container">
    <div class="row content-container">
        <div class="container-fluid">
            <div class="side-body padding-top" style="visibility:hidden;">
                <div class="row">
                    <div class="col-lg-12">
                        <table id="custReqsGrid"></table>
                    </div>
                    <div id=""></div>
                </div>
            </div>
            <div class="container-fluid" style="margin-top:-10%;">
                <div class="side-body padding-top">
                    <div class="" id="reqDetail">
                        <div class="row">
                            <div class="col-sm-9">
                                <h2>View Product Definition</h2>
                            </div>
                            @if (!Model.HasQuote)
                            {
                                <div class="col-sm-1 pull-right" style="margin-left: 20px;" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="View Orginally Submitted Requirements from Customer">
                                    <button type="button" class="btn btn-primary pull-right view-requirment" id="view-requirment" data-call-back-id="@Model.Id" data-toggle="modal" data-target="#userRequirementsModal"><i class="fa fa-eye"></i> View Requirements</button>
                                </div>
                                if (Model.ProductStatus == "APPROVED" || Model.ProductStatus == "APPROVED_BUT_REVISING")
                                {
                                    <div class="col-sm-1 pull-right" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="View Quote">
                                        <button type="button" class="btn btn-primary pull-right view-requirment" id="view-requirment" data-call-back-id="@Model.PObjectId" data-toggle="modal" data-target="#userRequirementsQuoteModal"><i class="fa fa-eye"></i> View Quote</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="pull-right btn btn-primary" style="margin-left: 10px;" data-id="@Model.Id" data-object="@Model.PObjectId" data-placement="top" title="" data-original-title="Generates a Quote Preview" data-toggle="modal" data-target="#quoteModal"><i class="fa fa-eye"></i> Preview Quote</span>
                            }
                        </div>
                        @using (Html.BeginForm("Edit", "ProductionPlanning", FormMethod.Post, new { @id = "production-planning-form", @class = "", role = "form" }))
                        {
                            @Html.HiddenFor(x => x.Id)
                            @Html.HiddenFor(x => x.OldProductProcedureId)
                            @Html.HiddenFor(x => x.HasQuote)
                            @Html.HiddenFor(x => x.SubmittedRequirement.Status)
                            @Html.HiddenFor(x => x.AdminCostSettings.RmAnnualRate, new { @class = "admin-cost-settings-rm-annual-rate" })
                            @Html.HiddenFor(x => x.AdminCostSettings.HourMinutes, new { @class = "admin-cost-settings-hour-minutes" })
                            @Html.HiddenFor(x => x.AdminCostSettings.LaborRateMinute, new { @class = "admin-cost-settings-labor-rate-minute" })
                            @Html.HiddenFor(x => x.AdminCostSettings.YearsHours, new { @class = "admin-cost-settings-years-hours" })

                            @Html.Partial("_Product")

                            @Html.Partial("_Steps")
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_Models")
<div id="userRequirementsQuoteModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">×</button>
                <h4 class="modal-title">Quote Requirements Preview</h4>
            </div>
            <div class="modal-body" style="max-height: 100% !important;" id="printThis">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-info" id="Print"><i class="fa fa-print"></i> Print </button>
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript" src="~/assets/js/ObjectAssign.js"></script>
    <script type="text/javascript" src="~/assets/js/grids/requirement-steps.js"></script>
    <script src="~/assets/js/grids/comman.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
        @if (Model.Steps.Count > 0)
            {
                <text>
                    $('.preDefinedStep').css("display", "none");
                </text>
            }
            var i = parseInt($('#totalRecords').val());
            var myoptions = $('#defaultProcessList').html();
            LoadSteps(i, myoptions);

            if (!isNaN(parseFloat('@Model.TotalSalePrice'))) {
                $("#totalSalePrice").val(parseFloat(@Model.TotalSalePrice).toFixed(2));
            }

            $('#Print').on('click', function () {
                $('#printThis').printThis();
            });

            $("input,select,button").prop('disabled', true);
            $('.view-requirment').prop('disabled', false);
            $('.modal-footer button').prop('disabled', false);
            $('.modal-header button').prop('disabled', false);
            $('#add_row').hide();
            $('#delete_row').hide();

        });
    </script>
}
