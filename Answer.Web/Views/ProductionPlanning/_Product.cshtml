@model Msr.Services.ProductionPlanning.ViewModels.RequirementStepsViewModel
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label class="sr-only">Supplier </label>
            @Html.DropDownListFor(model => model.ProductCustomerId, Model.Customers, "Select Customer", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.ProductCustomerId, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="sr-only">Location </label>
            @Html.DropDownListFor(model => model.ProductLocationId, Model.ProductLocationList, "Select Location", new { @class = "form-control" })
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="sr-only">Supplier Name </label>
            @Html.DropDownListFor(model => model.ProductSupplierId, Model.Suppliers, "Select Supplier", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.ProductSupplierId, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="sr-only">Division/Fab # </label>
            @Html.TextBoxFor(x => Model.ProductCustomerDivision, new { @class = "form-control", placeholder = "Division/Fab #", data_toggle = "tooltip", data_placement = "bottom" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label class="sr-only">Product Name </label>
            @Html.TextBoxFor(x => Model.ProductName, new { @class = "form-control", data_toggle = "tooltip", data_placement = "bottom" })
            @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="sr-only">Part </label>
            <div class="col-sm-10">
                @Html.DropDownListFor(model => model.ProductPartId, Model.PartList, "Select Part", new { @class = "form-control selectPart" })
                @Html.ValidationMessageFor(model => model.ProductPartId, "", new { @class = "text-danger" })
            </div>
            <div class="col-sm-1">
                <button type="button" class="btn btn-default" style="margin-left: -30px; margin-top: -0px" data-toggle="modal" data-target="#partmodel" data-placement="right" title="Add new customer part in modal"><i class="fa fa-plus-circle" aria-hidden="true"></i></button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="sr-only">Procedure </label>
            <div class="col-sm-11">
                @Html.DropDownListFor(model => model.ProductProcedureId, Model.ProcedureList, "Select Procedure", new { @class = "form-control  selectProcedure" })
            </div>
            <div class="col-sm-1">
                <button type="submit" id="new-procedure" name="IsNewProcedure" value="true" class="pull-right btn btn-default cancel" style="margin-left: 10px; margin-top: 0px !important" data-toggle="tooltip" data-placement="top" title="" data-original-title="Create New Procedure"><i class="fa fa-plus-circle" aria-hidden="true"></i></button>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="sr-only">Cycle Time </label>
            @Html.TextBoxFor(x => Model.CycleTime, new { @class = "form-control", placeholder = "Cycle Time" })
            @Html.ValidationMessageFor(model => model.CycleTime, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
