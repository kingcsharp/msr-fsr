@{
    ViewBag.Title = "Quotes";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-paper-plane-o"></span>
                Quotes <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/CustomerRequirement/Create" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/assets/js/plugins/bootstrap3/bootstrap-dialog.min.js"></script>
    <script type="text/javascript" src="~/assets/js/i18n/grid.locale-en.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.jqGrid.min.js"></script>
    <script src="//cdn.rawgit.com/noelboss/featherlight/1.6.1/release/featherlight.min.js" type="text/javascript" charset="utf-8"></script>
    <script type="text/javascript" src="~/assets/js/Grids/production-planning.js"></script>
    
    <script>
        $.jgrid.defaults.styleUI = 'Bootstrap';

        $(document).ready(function () {
            LoadGrid('@Url.Action("ProductionPlanningData", "ProductionPlanning")','@Url.Action("Index", "ProductionPlanning")');
        });
    </script>
  
}