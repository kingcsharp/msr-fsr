@{
    ViewBag.Title = "Quotes";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-paper-plane-o"></span>
                Quotes @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-quote"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/CustomerRequirement/Create" class="btn btn-success help-btn">Add</a>
            <a href="~/ProductionPlanning/import" class="btn btn-success help-btn">Import</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-production-planning")

    <script type="text/javascript">

        $(document).ready(function () {

            Msr.QuotesGrid.LoadGrid('@Url.Action("ProductionPlanningData", "ProductionPlanning")');
        });
    </script>

}