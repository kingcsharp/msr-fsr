                                            <span class="input-group-addon"><i class="glyphicon glyphicon-user"></i></span>
                                            @Html.EditorFor(model => model.Company, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                </div>

                                <!-- Text input-->
