                    <div class="form-group">
                        @Html.LabelFor(model => model.AddPartViewModel.SubParts, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-5">
                            @Html.TextBoxFor(model => model.AddPartViewModel.SubParts, new { @class = "form-control", @Value = "NONE", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.AddPartViewModel.SubParts, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-5">
                            <input id="PartSubmit" type="button" value="Submit" class="btn btn-success" />
                            <input id="partClose" type="button" value="Cancel" class="btn btn-warning" data-dismiss="modal" />
                        </div>
                    </div>
                </div>



            }
        </div>
    </div>
</div>

<script src="~/assets/js/jquery.min.js"></script>
<script src="~/assets/js/select2.full.min.js"></script>
<script src="~/assets/js/grids/comman.js"></script>

<script>
    $(document).ready(function () {
        if ('@Model.AddPartViewModel.CreateProd' == '') {
            $('.hiddenpart').hide();
        }
        else {
            $('.hiddenpart').show();
        }
        $('#CreateProd').on('change', function () {
            $('.hiddenpart').toggle();
        })

        $("form").submit(function (e) {
            $('.partCreate .submitselect option').prop('selected', true);
        });
    });
    $('#select-companies').on('show.bs.modal',
        function (event) {

            var button = $(event.relatedTarget);
            var callBackId = button.data('call-back-id');
            var modal = $(this);

            $.ajax({
                type: "GET",
                url: '/Companies/GetCompanies?callBackId=' + callBackId,
                dataType: 'html',
                success: function (data) {
                    modal.find('.modal-body').html(data);
                },
                error: function () {

                }
            });
        });

    $('#select-images').on('show.bs.modal',
        function (event) {

            var button = $(event.relatedTarget);
            var callBackId = button.data('call-back-id');
            var modal = $(this);

            $.ajax({
                type: "GET",
                url: '/Files/GetFiles?callBackId=' + callBackId,
                dataType: 'html',
                success: function (data) {
                    modal.find('.modal-body').html(data);
                },
                error: function () {

                }
            });

        });
    $('#PartSubmit').on('click',
        function() {
            var form = $('#AddPart').serialize();
            $.ajax({
                type : "POST",
                url : "@Url.Action("AddPart", "ProductionPlanning")",
                dataType : "json",
                data: form,
                success : function(result) {
                    // alert(result.Message); // result is an object which is created from the returned JSON
                    $('#ProductPartId').html('');
                    $.each(result.data, function (i, item) {
                        $('#ProductPartId').append($('<option>', {
                            value: item.Value,
                            text : item.Show
                        }));
                    });
                    $('#partClose').click();
                    console.log($("#ProductPartId").data('select2'));
                    $(".selectPart").next(".select2").remove();
                    var selectPart = $("#ProductPartId").select2();
                    selectPart.val(result.PartId).trigger("change");
                },
                error : function(error) {
                    alert(error.Message);
                }
            });
        });
</script>



