                        <div class="form-group">
                            @Html.LabelFor(model => model.AddPartViewModel.InternalEqualParts, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.AddPartViewModel.InternalEqualParts, Model.AddPartViewModel.ListInternalEqualParts, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.AddPartViewModel.InternalEqualParts, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.AddPartViewModel.ExternalEqualParts, htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-5">
                                @Html.ListBoxFor(model => model.AddPartViewModel.ExternalEqualParts, Model.AddPartViewModel.ListExternalEqualParts, new { @class = "form-control", @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => model.AddPartViewModel.ExternalEqualParts, "", new { @class = "text-danger" })
                            </div>
                        </div>
