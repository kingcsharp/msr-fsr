                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.AddPartViewModel.SupplierSeeInstallBase, Model.AddPartViewModel.Availabilities, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.AddPartViewModel.SupplierSeeInstallBase, "", new { @class = "text-danger" })
