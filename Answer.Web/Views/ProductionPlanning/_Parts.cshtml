@model Msr.Services.Parts.ViewModels.AddPartViewModel

<div id="partmodel" class="modal fade" role="dialog">
<div class="modal-dialog modal-lg">

<!-- Modal content-->
<div class="modal-content">
<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal">&times;</button>
    <h4 class="modal-title">Part Details</h4>
</div>
<div class="modal-body">
<style>
    .form-horizontal .control-label {
        text-align: right !important;
    }
</style>
<div class="container-fluid">
<div class="row">
                       
                     
<div class="col-lg-12">
                          
@using (Html.BeginForm("AddPart", "ProductionPlanning", FormMethod.Post, new { @id="AddPart", @class = "form-horizontal"}))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal addpart part">

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(model => model.CompanyPartNumber, htmlAttributes: new { @class = "control-label col-md-3" })
        <div class="col-md-5">
            @Html.EditorFor(model => model.CompanyPartNumber, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CompanyPartNumber, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-3" })
        <div class="col-md-5">
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })

            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label col-md-3" })
        <div class="col-md-5">
            <div style="width: 96%; float: left;">
                @Html.ListBoxFor(m => m.ReferenceFiles, Model.ListReferenceFiles, new { @class = "form-control submitselect", multiple = "multiple",@id= "ReferenceFiles" })
                @Html.ValidationMessageFor(model => model.ReferenceFiles, "", new { @class = "text-danger" })
            </div>
            <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="ReferenceFiles" data-toggle="modal" data-target="#select-images"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceFiles"><i class="icon fa fa-trash"></i></span> </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.PictureFiles, htmlAttributes: new { @class = "control-label col-md-3" })
        <div class="col-md-5">
            <div style="width: 96%; float: left;">
                @Html.ListBoxFor(m => m.PictureFiles, Model.ListPictureFiles, new { @class = "form-control submitselect", multiple = "multiple", @id = "PictureFiles" })
            </div>
            <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="PictureFiles" data-toggle="modal" data-target="#select-images"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="PictureFiles"><i class="icon fa fa-trash"></i></span>  </div>
        </div>
    </div>

    <button type="button" class="btn btn-info collapsed" data-toggle="collapse" data-target="#AdvanceItems"></button>
    <div id="AdvanceItems" class="collapse">
        <div class="form-group">
            @Html.LabelFor(model => model.Unit, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-5">
                @*@Html.DropDownListFor(model => model.AddPartViewModel.Unit, Model.AddPartViewModel.OrderingUnits, new { @class = "form-control" })*@
                @Html.ValidationMessageFor(model => model.Unit, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.UnitShippingWeight, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-5">
                @Html.EditorFor(model => model.UnitShippingWeight, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.UnitShippingWeight, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.WeightType, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-5">
                @*@Html.DropDownListFor(model => model.AddPartViewModel.WeightType, Model.AddPartViewModel.ShippingWeightTypes, new { @class = "form-control" })*@
                @Html.ValidationMessageFor(model => model.WeightType, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.CreateProd, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-5">
                @*@Html.DropDownListFor(model => model.AddPartViewModel.CreateProd, Model.AddPartViewModel.CreateProds, new { @class = "form-control",@id="CreateProd" })*@
                @Html.ValidationMessageFor(model => model.CreateProd, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="hiddenpart">
            <div class="form-group">
                @Html.LabelFor(model => model.SupplierCo, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-5">
                    @Html.DropDownListFor(model => model.SupplierCo, Model.ListSupplierCompany, new { @class = "form-control select" })
                    @Html.ValidationMessageFor(model => model.SupplierCo, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.ProductType, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-5">
                    @*@Html.DropDownListFor(model => model.AddPartViewModel.ProductType, Model.AddPartViewModel.ProductTypes, new { @class = "form-control" })*@
                    @Html.ValidationMessageFor(model => model.ProductType, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.ProcVerb, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-5">
                @Html.EditorFor(model => model.ProcVerb, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ProcVerb, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="hiddenpart">
            <div class="form-group">
                @Html.LabelFor(model => model.Price, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-5">
                    @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.SpecialCustomers, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-5">
                    <div style="width: 96%; float: left;">
                        @Html.ListBoxFor(m => m.SpecialCustomers, Model.ListSpecialCustomers, new { @class = "form-control", multiple = "multiple" })
                    </div>
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.CustomerExceptions, htmlAttributes: new { @class = "control-label col-md-3" })
                <div class="col-md-5">
                    <div style="width: 96%; float: left;">
                        @Html.ListBoxFor(m => m.CustomerExceptions, Model.ListCustomerExceptions, new { @class = "form-control submitselect", multiple = "multiple" })
                    </div>
                    <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="CustomerExceptions" data-toggle="modal" data-target="#select-companies"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="CustomerExceptions"><i class="icon fa fa-trash"></i></span>  </div>
                </div>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ReferenceTheories, htmlAttributes: new { @class = "control-label col-md-3" })

            <div class="col-md-5">
                <div style="width: 96%; float: left;">
                    @Html.ListBoxFor(m => m.ReferenceTheories, Model.ListReferenceTheories, new { @class = "form-control submitselect", multiple = "multiple", @id = "ReferenceTheories" })
                </div>
                <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="ReferenceTheories" data-toggle="modal" data-target="#select-images"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceTheories"><i class="icon fa fa-trash"></i></span>  </div>
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.PartType, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-5">
                @Html.DropDownListFor(model => model.PartType, Model.ListPartsTypes, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.PartType, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Spare, htmlAttributes: new { @class = "control-label col-md-3" })
            <div class="col-md-5">
                @*@Html.DropDownListFor(model => model.AddPartViewModel.Spare, Model.AddPartViewModel.Spares, new { @class = "form-control" })*@
                @Html.ValidationMessageFor(model => model.Spare, "", new { @class = "text-danger" })
            </div>
        </div>

    
    </div>


    <div class="form-group">
        @Html.LabelFor(model => model.SubParts, htmlAttributes: new { @class = "control-label col-md-3" })
        <div class="col-md-5">
            @Html.TextBoxFor(model => model.SubParts, new { @class = "form-control", @Value = "NONE", @readonly = "readonly" })
            @Html.ValidationMessageFor(model => model.SubParts, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-5">
            <input id="PartSubmit" type="button" value="Submit" class="btn btn-success" />
            <input id="partClose" type="button" value="Cancel" class="btn btn-warning" data-dismiss="modal" />
        </div>
    </div>
    </div>

}
</div>
</div>
</div>
</div>
          
</div>

</div>
</div>
<script src="~/assets/js/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        $('#PartSubmit').on('click',
            function() {
                var form = $('#AddPart').serialize();
                $.ajax({
                    type : "POST",
                    url : "@Url.Action("AddPart","ProductionPlanning")",
                    dataType : "json",
                    data: JSON.stringify(form),
                    success : function(result) {
                      
                        $('#ProductPartId').html('');
                        $.each(result.data, function (i, item) {
                            $('#ProductPartId').append($('<option>', { 
                                value: item.Value,
                                text : item.Show 
                            }));
                        });
                        console.log(result.PartId);
                        $('#ProductPartId').val(result.PartId);
                        $('#partClose').click();
                    },
                    error : function(error) {
                        alert(error.Message);
                    }
                });
            });
        if ('@Model.CreateProd' == '') {
            $('.hiddenpart').hide();
        }
        else {
            $('.hiddenpart').show();
        }
        $('#CreateProd').on('change', function () {
            $('.hiddenpart').toggle();
        })
        $(".select").select2({
            placeholder: "Select",
            allowClear: true
        });
        $("form").submit(function (e) {
            $('.partCreate .submitselect option').prop('selected', true);
        });
    });
    $('#select-companies').on('show.bs.modal',
        function (event) {

            var button = $(event.relatedTarget);
            var callBackId = button.data('call-back-id');
            var modal = $(this);

            $.ajax({
                type: "GET",
                url: '/Companies/GetCompanies?callBackId=' + callBackId,
                dataType: 'html',
                success: function (data) {
                    modal.find('.modal-body').html(data);
                },
                error: function () {

                }
            });
        });
    
    $('#select-images').on('show.bs.modal',
        function (event) {

            var button = $(event.relatedTarget);
            var callBackId = button.data('call-back-id');
            var modal = $(this);

            $.ajax({
                type: "GET",
                url: '/Files/GetFiles?callBackId=' + callBackId,
                dataType: 'html',
                success: function (data) {
                    modal.find('.modal-body').html(data);
                },
                error: function () {

                }
            });

        });
        
</script>







