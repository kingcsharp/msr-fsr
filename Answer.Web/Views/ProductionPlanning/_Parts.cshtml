                            <div class="col-md-5">
                                @Html.EditorFor(model => model.AddPartViewModel.SelectedInternalEqualParts, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.AddPartViewModel.SelectedInternalEqualParts, "", new { @class = "text-danger" })
