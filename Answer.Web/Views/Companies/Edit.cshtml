@model Msr.Services.Companies.ViewModels.EditCompanyViewModel
@{
    ViewBag.Title = "Update Company";
}
@Styles.Render("~/bundles/css/fileinput")
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Company @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                @Html.Partial("Message")
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" id="ObjectId" name="ObjectId" value="@Model.ObjectId" />
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.CoType, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.CoType, Model.CompanyTypes, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.CoType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Parent, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Parent, Model.ListParents, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.Parent, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.Partial("_FileUpload")
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.HeadPeople, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.HeadPeople, Model.HeadPeoples, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.HeadPeople, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Phone, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.Location, Model.Locations, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.Location, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-8">
                                <input type="submit" value="Submit" class="btn btn-success" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqueryval")
    @Scripts.Render("~/bundles/js/fileinput")
    <script type="text/javascript">

        var fileUploaderGrid = new FileUploaderGrid();

        $(document).ready(function () {

            var fileUploader = new FileUploader();
            fileUploader.InitEditUploader($('#input-files'),
                '@Url.Action("FileUploaderBootstrap", "Doc")',
                [@Html.Raw(ViewBag.Preview)],
                @Html.Raw(ViewBag.PreviewConfig),
                '@Model.ObjectId',
                true);
            fileUploaderGrid.SetupSelectImage();

            $("form").submit(function(e) {
                $('.selectitem option').prop('selected', true);

            });

        });

        function SelectIds() {
            fileUploaderGrid.SelectIds();
        }

    </script>
}