@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Companies/Departments";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-building"></span>
                Companies/Departments @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-company"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/Companies/Create" class="btn btn-success help-btn">Add</a>
            <a href="~/Companies/import" class="btn btn-success help-btn">Import</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-companies")

    <script type="text/javascript">
		
        var hasAdministratorRole = '@User.IsInRole("Administrators")' === "True";

        $(document).ready(function () {

            Msr.CompanyGrid.LoadCompanyGrid('@Url.Action("CompaniesData", "Companies")');
        });

    </script>
}
