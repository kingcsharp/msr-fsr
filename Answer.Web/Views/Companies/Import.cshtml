@model IEnumerable<Msr.Services.Companies.ViewModels.CompanyImportViewModel>
@{
    ViewBag.Title = "Companies Import";
}
<style>
    .validation-summary-errors {
        color: red;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Import File
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                <div class="form-horizontal">
                    @Html.Partial("Message")
                    <div class="row">
                        <div class="alert">
                            The import file must be a tab delimited text file (.csv)<br/>
                            The field definitions are<br />
                            ParentID = unique ID in the external database for the Parent Company. It can be blank<br />
                            ParentName = The name of theparent company. It can be blank<br />
                            Id = unique ID in the external database for the company. It can not be blank<br />
                            Name<br />
                            Address <br />
                            City <br />
                            State<br />
                            Zip<br />
                            Country<br />
                            ShipName<br />
                            ShipAddress<br />
                            ShipCity<br />
                            ShipState<br />
                            ShipCountry<br />
                            Phone<br />
                            SupplierId<br />
                            LinkedId
                        </div>
                    </div>

                    @using (Html.BeginForm("Import", "Companies", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()
                        <table>
                            <tr>
                                <td>
                                    <label class="btn btn-primary" for="postedFile">
                                        <input id="postedFile" type="file" name="postedFile" accept=".csv" style="display:none"  />
                                        Browse...
                                    </label>
                                </td>
                                <td style="padding-left: 5px;">
                                    <input type="submit" class="btn btn-success" value="Process Import" />
                                </td>
                                <td style="padding-left: 5px;">
                                    <a class="btn btn-link" href="~/Companies/ImportSampleFile" target="_blank">Download sample file </a>
                                </td>
                            </tr>
                        </table>
                    }
                </div>
                
                @if (Model != null && Model.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.Id)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Processed)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Messages)
                                </th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Id)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Processed)
                                    </td>
                                    <td>
                                        @foreach (var message in item.Messages)
                                        {
                                            @message <br />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                

            </div>
        </div>
    </div>
</div>