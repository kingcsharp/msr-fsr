@{
    ViewBag.Title = "Users";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-user"></span>
                Users @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-people"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/People/Add" class="btn btn-success help-btn">Add</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-people")

    <script type="text/javascript">
		
        var hasAdministratorRole = '@User.IsInRole("Administrators")' === 'True';

        $(document).ready(function () {
            Msr.PeopleGrid.LoadPeopleGrid('@Url.Action("PeopleData", "People")');
        });

    </script>
}
