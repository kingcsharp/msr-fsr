@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Users";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-user"></span>
                Users @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/People/Add" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>
@section scripts
{
   
    @Scripts.Render("~/bundles/js/jqgrid")

    <script src="~/assets/js/grids/people.js"></script>

    <script type="text/javascript">

        $(document).ready(function () {
            LoadPeopleGrid('@Url.Action("PeopleData", "People")','@Request.Url.OriginalString');
        });

    </script>
}
