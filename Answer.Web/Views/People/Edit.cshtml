@model Msr.Services.People.ViewModels.EditPeopleViewModel
@{
    ViewBag.Title = "Update People";
}

@Styles.Render("~/bundles/css/fileinput")

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit People @Html.Partial("_HelpViewButton")
            </h2>

            <div class="col-lg-10">
                @Html.Partial("Message")

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x=> x.Id)
                    @Html.HiddenFor(x => x.ObjectId)
                    @Html.HiddenFor(x => x.EmailIdPrimary)

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.LabelFor(model => model.RealUser,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.RealUser, Model.ListRealUserTypes, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.RealUser, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.LoginId,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.HiddenFor(x=>x.LoginId)
                                @Html.EditorFor(model => model.LoginId, new {htmlAttributes = new {@class = "form-control", disabled = ""}})
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.FirstName,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.FirstName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.LastName,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.LastName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ScreenType,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.ScreenType, Model.ListScreenTypes, new { @class = "form-control select"})
                                @Html.ValidationMessageFor(model => model.ScreenType, "", new { @class = "text-danger" })
                            </div>
                        </div>
     
                        <div class="form-group">
                            @Html.LabelFor(model => model.CompanyEditPerson,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.CompanyEditPerson, Model.ListCompanyEditPerson, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.CompanyEditPerson, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.IsDepartmentHead,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.IsDepartmentHead, Model.ListIsDepartmentHead, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.IsDepartmentHead, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.OfficialPosition,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.OfficialPosition, Model.ListOfficialPosition, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.OfficialPosition, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceFiles,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.Partial("_FileUpload")
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.BossName,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.BossName, Model.ListBossInfo, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.BossName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.TimeZone,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.TimeZone, Model.ListTimeZones, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.TimeZone, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.HireDate,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.HireDate, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                @Html.ValidationMessageFor(model => model.HireDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.StatusEditPerson,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                @Html.DropDownListFor(model => model.StatusEditPerson, Model.ListStatusEditPerson, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.StatusEditPerson, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.PrimaryPhoneNumber,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                <div style="width: 96%; float: left; display: flex">
                                    @Html.DropDownListFor(model => model.TypePrimaryPhoneNumber, Model.ListPhoneTypes, new {@class = "form-control"})
                                    @Html.ValidationMessageFor(model => model.PrimaryPhoneNumber, "", new {@class = "text-danger"})
                                    @Html.EditorFor(model => model.PrimaryPhoneNumber, new {htmlAttributes = new {@class = "form-control"}})
                                    @Html.ValidationMessageFor(model => model.PrimaryPhoneNumber, "", new {@class = "text-danger"})
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-2"></div>
                            <div class="col-md-8">
                                <div style="width: 96%; float: left; display: flex">
                                    @Html.LabelFor(model => model.ExtPrimaryPhoneNumber,  new {@class = "control-label col-md-8"})
                                    @Html.EditorFor(model => model.ExtPrimaryPhoneNumber, new {htmlAttributes = new {@class = "form-control"}})
                                    @Html.ValidationMessageFor(model => model.ExtPrimaryPhoneNumber, "", new {@class = "text-danger"})

                                    @Html.LabelFor(model => model.PinPrimaryPhoneNumber,  new {@class = "control-label col-md-2"})

                                    @Html.EditorFor(model => model.PinPrimaryPhoneNumber, new {htmlAttributes = new {@class = "form-control"}})
                                    @Html.ValidationMessageFor(model => model.PinPrimaryPhoneNumber, "", new {@class = "text-danger"})
                                </div>
                            </div>
                        </div>
 
                        <div class="form-group">
                            @Html.LabelFor(model => model.EmailPrimary,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                <table style="width: 100%; border-spacing: 2px;">
                                    <tr>
                                        <td>
                                            @Html.DropDownListFor(model => model.EmailTypePrimary, Model.ListEmailTypes, new {@class = "form-control"})
                                            @Html.ValidationMessageFor(model => model.EmailTypePrimary, "", new {@class = "text-danger"})
                                        </td>
                                        <td>
                                            @Html.DropDownListFor(model => model.EmailTextTypePrimary, Model.ListEmailTextTypes, new {@class = "form-control"})
                                            @Html.ValidationMessageFor(model => model.EmailTextTypePrimary, "", new {@class = "text-danger"})
                                        </td>
                                        <td>
                                            @Html.EditorFor(model => model.EmailPrimary, new {htmlAttributes = new {@class = "form-control"}})
                                            @Html.ValidationMessageFor(model => model.EmailPrimary, "", new {@class = "text-danger"})
                                        </td>
                                        <td style="text-align: right;">
                                            <input type="submit" name="passowrdReminder" value="Password Reminder"  class="btn btn-success"/>
                                        </td>
                                    </tr>
                                </table>
           
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.AddressType,  new { @class = "control-label col-md-2" })
                            <div class="col-md-8">
                                <div style="width: 96%; float: left; display: flex">
                                    @Html.DropDownListFor(model => model.AddressType, Model.ListAddressTypes, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.AddressType, "", new { @class = "text-danger" })
                                    @Html.DropDownListFor(model => model.AddressLocation, Model.Locations, new { @class = "form-control select" })
                                </div>
                            </div>
                        </div>
  
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-8">
                                <input type="submit" value="Submit" class="btn btn-success" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqueryval")
    @Scripts.Render("~/bundles/js/fileinput")

    <script type="text/javascript">

        $(function () {

            var fileUploader = new FileUploader();

            fileUploader.InitEditUploader($('#input-files'),
                '@Url.Action("FileUploaderBootstrap", "Doc")',
                [@Html.Raw(ViewBag.Preview)],
                @Html.Raw(ViewBag.PreviewConfig),
                '@Model.ObjectId',
                true);

            $('.datepicker').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true
            });

            $('.datepicker').datepicker('setDate', 'now');

            $("form").submit(function(e) {
                $('.selectitem option').prop('selected', true);
            });
        });

        function SelectIds(parameters) {
            new FileUploaderGrid().SelectIds();
        }

    </script>
}
<style>
    .Address {
        width: 50% !important;
    }
</style>