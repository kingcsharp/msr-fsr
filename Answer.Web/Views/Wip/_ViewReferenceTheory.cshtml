@model Msr.Services.Orders.Messaging.ReferenceTheoryResponse
<div class="row">
    <div class="col-lg-8">

    </div>
    <div class="col-lg-4">
        Approved By: @Model.WorkflowDataResult.Name
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        @Model.TheoryGetInfoResult.Status (document #@Model.TheoryGetInfoResult.Root, revision # @Model.TheoryGetInfoResult.Rev)
        Approved By: @Model.WorkflowDataResult.Name
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        Reference Files:<br />
        @foreach (var file in Model.GetTheoryReferenceFilesResults)
        {
            @Html.ActionLink(file.Name, "GetReferenceTheoryFile", new { fileId = file.Doc_Id })<br />
        }
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        @if (!Model.TheoryGetParagraphDataResults.Any())
        {
            <div>No paragraphs entered</div>
        }
    </div>
</div>
@if (Model.TheoryGetRevisionDataResults.Any())
{
    <div class="row">
        <div class="col-lg-12">
            <table class="table">
                <thead>
                    <tr>
                        <td>Revision #</td>
                        <td>Revision Start Date</td>
                        <td>Revision Approval Date</td>
                        <td>Revision Comment</td>
                        <td>Reviser</td>
                        <td>Approval Workflow</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var revision in Model.TheoryGetRevisionDataResults)
                {
                        <tr>
                            <td>@revision.Rev</td>
                            <td>@revision.Create_Date</td>
                            <td>@revision.Approval_Date</td>
                            <td>@revision.Rev_Info</td>
                            <td>@revision.Creator_Name</td>
                            <td>@revision.Wf_Name</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
}