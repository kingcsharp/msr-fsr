@model Answer.Web.ViewModel.Wip.WipListViewModel


@foreach (var item in Model.WoItemsInprogress)
{
    <div class="row">
        <div class="col-lg-5 col-md-5 col-sm-6">
            <strong>Proc: @item.ProductName <br>@item.ProcName</strong>
        </div>


        <div class="col-lg-7 col-md-7 col-sm-6">
            @foreach (var proItem in Model.WoItemsByProcedures.Where(x => x.ProcName == item.ProcName).OrderByDescending(o => o.DueDate))
            {
                var statusText = "";
                var cssIconButton = "";
                var cssButton = "";

                if (proItem.Status == "CLOSED" || proItem.Status == "FINISHED")
                {
                    cssButton = "step-complete";
                }
                else if (proItem.Status == "ACCEPTED")
                {
                    cssIconButton = "fa fa-cog fa-spin fa-2x";
                    cssButton = "btn-success btn-accepted";
                    statusText = "In Progress";
                }
                else if (proItem.Status == "PENDING_PARENT_ACCEPTANCE")
                {
                    cssIconButton = "fa-cog";
                    cssButton = "btn btn-sq btn-success wip-button";
                    statusText = "Waiting to Start";
                }

                if (DateTime.Now > proItem.DueDate)
                {
                    cssIconButton = "fa fa-exclamation-circle fa-2x";
                    cssButton = "btn-danger";
                }

                if (string.IsNullOrWhiteSpace(proItem.RequesteeName))
                {
                    cssIconButton = "fa fa-ban fa-stack-2x";
                    cssButton = "btn-success";
                }

                var daysTillDueDate = proItem.DueDate?.Subtract(DateTime.Now).Days;
                if (daysTillDueDate <= proItem.Threshold)
                {
                    cssIconButton = "fa fa-clock-o fa-2x";
                    cssButton = "btn-warning";
                }

                <button data-toggle="tooltip" data-task-id="@proItem.TaskId" data-fill-id="@proItem.FillId" data-placement="bottom" data-html="true"
                        title="<strong>Serial #:</strong>@proItem.Serial<br />
                                       <strong>Status:</strong> @statusText<br />
                                       <strong>Assigned To:</strong> @proItem.RequesteeName"
                                            class="btn btn-sq @cssButton wip-button">
                                        <i class="@cssIconButton"></i>
                </button>
            }
        </div>

    </div>
}

<script>

    $('[data-toggle="tooltip"]').tooltip();
    $('.wip-button').on('click', function() {
        var fillId = $(this).data('fill-id');
        if ($(this).hasClass('btn-accepted')) {
            var id = $(this).data('task-id');
            eModal.confirm('Do you want to take ownership of this WO Item?')
                .then(function () {
                    $.ajax({
                        type: "POST",
                        url: "/wip/TakeTaskOwnersShip?taskId=" + id,
                        dataType: 'json',
                        success: function (data) {
                            if (data.Code === "OK") {
                                window.location.href = '/wip/Details/' + fillId;
                            } else {
                                alert(data.Message);
                            }
                        },
                        error: function () {

                        }
                    });
                }, null);
        } else {
            window.location.href = '/wip/Details/' + fillId;
        }
    });
</script>               