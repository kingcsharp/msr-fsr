@model Msr.Services.Orders.Messaging.TsrDetailsResponse
<style>
    h5 {
        font-size: 14px;
        background-color: #444;
        color: #fff;
        font-weight: 700;
        padding: 5px;
        margin: 2px -5px;
    }

    #qrcodeTable {
        margin-top: 35px;
        margin-bottom: 35px;
        text-align: center;
    }
    #part-header-image {
        background: #fff;
        padding: 3px
    }
    #part-header-image img {
        width: auto;
        height: 100%;
    }
    </style>

    <div class="col-lg-12">
        <div class="row">
            <div id="print-traveler-container">
                <div id="qrcodeTable"></div>
                <div id="qrcodeCanvas">
                </div>
            </div>
        </div>

        <div class="row">
            <h4>Purchase Item Info</h4>
            <table class="table table-bordered table-striped">
                <tr>
                    <td style="font-weight: bold;">Customer:</td>
                    <td>@Model.WorkOrderDetailsResponse.FileSearchResult.CustomerName</td>
                    <td id="part-header-image" rowspan="5">
                        <img src="~/assets/img/msr-label-no-parts-image.png"/>
                    </td>
                </tr>
                <tr><td style="font-weight: bold;">Product:</td>
                <td>@Model.WorkOrderDetailsResponse.FileSearchResult.ProductName</td></tr>
                <tr><td style="font-weight: bold;">Procedure:</td><td>@Model.WorkOrderDetailsResponse.FileSearchResult.ProcedureName - (Rev:@Model.WorkOrderDetailsResponse.FileSearchResult.Rev)</td> </tr>
                <tr><td style="font-weight: bold;">WO Item #:</td><td>@Model.WorkOrderDetailsResponse.FileSearchResult.PurchItemId</td> </tr>
                <tr><td style="font-weight: bold;">Customer PO /Line:</td><td>@Model.WorkOrderDetailsResponse.FileSearchResult.CustPurchNum / @Model.WorkOrderDetailsResponse.FileSearchResult.CustPurchLineNum</td> </tr>
            </table>
        </div>
        <p></p>
        <div class="row">
            <h4>Parts and Procedure Info</h4>
            <table class="table table-responsive table-condensed table-bordered">
                <tbody>
                    @if (Model.WorkOrderDetailsResponse.FileSearchResult != null)
                    {
                        <tr><td>@Model.WorkOrderDetailsResponse.FileSearchResult.FillObjDesc. qty:@Model.WorkOrderDetailsResponse.FileSearchResult.Qty</td></tr>
                    }

                    @foreach (var part in Model.WorkOrderDetailsResponse.Parts)
                    {
                        <tr><td>@part</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <p></p>
        <div class="row">
            <table class="table table-responsive table-condensed table-bordered">
                @foreach (var task in Model.TsrTaskResults.Where(x => x.Level == 2))
                {
                    <tr>
                        <td>
                            <h5>@task.Title</h5>
                            @Html.Raw(task.Des)
                        </td>
                    </tr>
                }
            </table>
        </div>

    </div>

<script src="~/assets/js/qrcode.js"></script>
<script src="~/assets/js/jquery.qrcode.js"></script>

<script>
    jQuery('#qrcodeTable').qrcode({ width: 130, height: 130, text: '@Model.FillUrl' });
</script>