@using Msr.Services.Helps
@{

    var helpUrl = "/wip/details/";

    var helpService = new HelpService();

    var vm = helpService.CanViewHelpPage(helpUrl, HttpContext.Current.User.Identity.Name);
}

@{
    string LabelStatus = "";
}

@model  Msr.Services.Orders.Messaging.WorkOrderDetailsResponse
@{
    ViewBag.Title = @*"Work Order Details " +*@ /**/
                                                           Model.FileSearchResult?.FillObjDesc @*+ " qty:" + Model.FileSearchResult?.Qty*@;
var status = new string[] { "COMPLETED", "FINISHED", "CLOSED" };
}

@Styles.Render("~/bundles/css/fileinput")

<style>
    .row > [class*="col-"] {
        margin-bottom: 0 !important;
    }
    .fa-stack {
        display: inline-block;
        height: inherit;
        line-height: 2em;
        position: relative;
        vertical-align: middle;
        width: inherit;
        margin: 0px !important;
    }
</style>

<div class="container-fluid">
    <div class="side-body padding-top">
        @Html.Partial("Message")

        @if (Model.FillId > 0)
        {
            <div class="row wip-detail-header">
                <div class="col-lg-6 col-md-5 col-sm-6 wip-detail-header-left">
                    <div class="form-group">
                        <div style="display: inline-block; float: right;">
                            <label>Hide Completed </label>
                            <div class="make-switch switch-small" data-on="success" data-off="warning" style="display: inline-block">
                                <input id="showCompletedSwitch" type="checkbox" name="completed-switch" checked>
                            </div>
                            <button type="button" data-toggle="modal" data-target="#wipListModal" class="btn btn-info cancel-btn pull-right wip-view-button"><i class="fa fa-list" aria-hidden="true"></i> WIP List</button>
                        </div>


                        <select id="wip-item-select" class="selectpicker form-control" name="wo-item">
                            <option data-content="<strong>Select Another WO Item...</strong>">Select an Item</option>
                            <optgroup label="Items Assigned to Me">
                                @if (Model.MyWoItems.Any())
                                {
                                    foreach (var item in Model.MyWoItems)
                                    {
                                        if (@item.Status == "ACCEPTED") { LabelStatus = "label-info"; }
                                        else if (@item.Status == "REQUESTED") { LabelStatus = "label-warning"; }
                                        else { LabelStatus = "label-success"; }
                                        <option data-content="<strong data-fill-id='@item.FillId'>@item.PurchaseItemId</strong><br>Proc: @item.ProcName<br>Serial: @item.Serial<span class='label @LabelStatus pull-right'>@item.Status</span>" data-status="@item.Status" data-fill-id="@Model.FillId">@item.FillId</option>
                                    }
                                }
                                else
                                {
                                    <option>No Search Filter Defined</option>
                                }

                            </optgroup>
                        </select>
                    </div>

                    <button class="btn btn-info btn-sm print-btn pull-right" data-toggle="modal" data-id="@Model.FillId" data-target="#wioDetailPrintOther"><i class="fa fa-print"></i> Print Other</button>
                    <button class="btn btn-info btn-sm print-btn pull-right" data-toggle="modal" data-id="@Model.FillId" data-target="#wioDetailPrintTraveler"><i class="fa fa-print"></i> Print Traveler</button>

                    @if (Model.TaskStepResults.Any(x => !status.Contains(x.Status)) && Model.HasProcedureRoles)
                    {

                        <button data-id="@Model.FillId" class="btn btn-danger btn-sm cancel-btn pull-right" data-toggle="modal" data-target="#wipDetailCancelStepsModal"><i class="fa fa-close"></i> Cancel Remaining Steps</button>

                    }

                </div>
                <div class="col-lg-6 col-md-7 col-sm-6 wip-detail-header-right">
                    @if (vm.CanView)
                    {
                        <button class="btn btn-info pull-right page-help" style="margin:2px 2px 0 10px;" data-page-url="@helpUrl">Help</button>
                    }
                    <div id="ncr-notification-button" class="badge hidden pull-right" title="There is at least One NCR on the WO. Click to view" style="background-color: #ff0000;margin:8px 10px 0 0;">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"></i>
                        <span style="font-size:1.5em">&nbsp;NC</span>
                    </div>
                    <ul class="nav nav-tabs" role="tablist" id="header-tabs">
                        <li role="presentation" id="parts-tab" class="active"><a id="header-parts" data-toggle="tab" href="#parts" aria-controls="parts" role="tab">Parts Info:</a></li>
                        <li role="presentation"><a id="header-purchase" data-toggle="tab" href="#purchase" aria-controls="parts" role="tab">Purchase Item Info:</a></li>
                    </ul>
                    <div class="tab-content">
                        <div role="tabpanel" id="parts" class="tab-pane fade in active">
                            <div id="parts-table" class="col-sm-12">
                                <table class="table table-responsive table-hover table-condensed">
                                    <tbody>
                                        @if (Model.FileSearchResult != null)
                                        {
                                            <tr><td>@Model.FileSearchResult.FillObjDesc (Cycle Count: @Model.FileSearchResult.CycleCount) (Qty: @Model.FileSearchResult.Qty) </td></tr>
                                        }

                                        @foreach (var part in Model.Parts)
                                        {
                                            <tr><td>@part</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        @if (Model.FileSearchResult != null)
                        {
                            <div role="tabpanel" id="purchase" class="tab-pane fade">
                                <table id="purchase-table" class="table table-responsive table-hover table-condensed">
                                    <tbody>
                                        <tr>
                                            <th nowrap style="text-align: right">Customer:</th>
                                            <td>@Model.FileSearchResult.CustomerName</td>
                                        </tr>
                                        <tr>
                                            <th nowrap style="text-align: right">Product:</th>
                                            <td>@Model.FileSearchResult.ProductName</td>
                                        </tr>
                                        <tr>
                                            <th nowrap style="text-align: right">Procedure:</th>
                                            <td>@Model.FileSearchResult.ProcedureName</td>
                                        </tr>
                                        <tr>
                                            <th nowrap style="text-align: right">Purchase Item #:</th>
                                            <td>@Model.FileSearchResult.PurchItemId</td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-lg-12">
                    <!-- Step Navigation -->
                    <div id="carousel" class="flexslider">
                        <ul class="slides">
                            @foreach (var step in Model.TaskStepResults)
                            {
                                var stepCss = "";

                                if (step.Status == "CLOSED" || step.Status == "FINISHED")
                                {
                                    stepCss = "step-complete";
                                }
                                else if (step.Status == "ACCEPTED")
                                {
                                    stepCss = "step-inprogress";
                                }
                                else if (step.Status == "PENDING_PARENT_ACCEPTANCE" || step.Status == "REQUESTED")
                                {
                                    stepCss = "waiting";
                                }
                                else
                                {
                                    stepCss = "requested";
                                }

                                if (!string.IsNullOrWhiteSpace(step.Title))
                                {
                                    <li class="step-task step @stepCss" data-stepId="@step.StepId" data-phStepId="@step.PhStepId" data-fill-id="@Model.FillId" title="@step.Title">
                                        <div>@step.Title</div>
                                    </li>
                                }
                                else
                                {
                                    <li class="step-task step @stepCss" data-stepId="@step.StepId" data-phStepId="@step.PhStepId" data-fill-id="@Model.FillId" title="@step.Description">
                                        <div>@step.Description</div>
                                    </li>
                                }

                            }
                        </ul>
                    </div>
                    <div id="slider" class="flexslider step-container">
                        <ul class="slides">

                            @foreach (var step in Model.TaskStepResults)
                            {
                                <li id="step-@step.StepId">
                                </li>
                            }

                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.FillId > 0)
{
    <div id="wipListModal" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">WIP List</h4>
                </div>
                <div class="modal-body"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-dismiss="modal"><i class="fa fa-times-circle" aria-hidden="true"></i> Close</button>
                </div>
            </div>

        </div>
    </div>

    <div id="wioDetailPrintTraveler" class="modal fade" role="dialog">
        <div class="modal-dialog" style="width: 900px;">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Print Traveler Report</h4>
                </div>
                <div class="modal-body" id="print-traveler-container"></div>
                <div class="modal-footer">
                    <button id="print-traveler-report" type="button" class="btn btn-info"><i class="fa fa-print"></i> Print Report</button>
                    <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-times-circle" aria-hidden="true"></i> Close</button>
                </div>
            </div>

        </div>
    </div>

    <div id="wioDetailPrintOther" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Print Other</h4>
                </div>
                <div class="modal-body" id="print-other-container"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-info" id="display-report"><i class="fa fa-print"></i> Display</button>
                    <button type="button" class="btn btn-info" id="print-other-report" style="display: none"><i class="fa fa-print"></i> Print Report</button>
                    <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-times-circle" aria-hidden="true"></i> Cancel</button>
                </div>
            </div>

        </div>
    </div>

    <div id="relatedDocument" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"></h4>
                </div>
                <div class="modal-body"></div>
                <div class="modal-footer">

                </div>
            </div>

        </div>
    </div>

    <div id="add-new-equipment-model" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Add Maintenance Task</h4>
                </div>

                <div class="modal-body" style="width: 100%;"></div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa fa-times-circle" aria-hidden="true"></i> Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div id="wipDetailCancelStepsModal" class="modal fade" role="dialog">
        @using (Html.BeginForm("CancelRemainingSteps", "Wip", FormMethod.Post, new { @class = "cancel-remaining-steps", @id="cancel-remaining-steps-form" }))
        {
            <input type="hidden" name="fillId" id="fillId" value="@Model.FillId" />
            <input type="hidden" id="invoice" name="invoice"/>
            <div class="modal-dialog modal-lg">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Cancel Remaining Steps Confirmation</h4>
                    </div>
                    <div class="modal-body" style="width: 100%;">
                        <h3>Are you sure you want to cancel the remaining steps?</h3>
                        <div class="alert alert-info  alert-dismissible fade in">
                            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                            <i class="fa fa-info-circle"></i> When Cancelling remaing steps you have <strong>two options</strong>:
                            <ol>
                                <li>If you wish close and invoice for this Work Order, click the <strong>Yes - And Invoice</strong> button below.</li>
                                <li>If you <u>do not</u> want to invoice for this Work Order click the <strong>Yes - But Do Not Invoice</strong> button below.</li>
                            </ol>
                            <p>Other wise click the<strong> Cancel</strong>button to continue with this Work Order.</p>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" data-invoice="1" class="btn btn-success cancel-steps">
                            <span class="fa-stack fa-1x icon-stack">
                                <i class="fa fa-usd fa-stack-2x" style="color:#006400" aria-hidden="true"></i>
                            </span> Yes - And Invoice
                        </button>
                        <button type="button" data-invoice="0" class="btn btn-warning cancel-steps">
                            <span class="fa-stack fa-1x icon-stack">
                                <i class="fa fa-usd fa-stack-1x" style="color:#ffffff" aria-hidden="true"></i>
                                <i class="fa fa-ban fa-stack-2x" style="color:#ff0000" aria-hidden="true"></i>
                            </span>
                            Yes - But Do Not Invoice
                        </button>
                        <button type="button" class="btn btn-danger" data-dismiss="modal">
                            <span class="fa-stack fa-1x">
                                <i class="fa fa-times-circle fa-stack-2x" aria-hidden="true"></i>
                            </span> Cancel
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
<input type="hidden" value="@Model.NcrCount" id="ncr-count" />
<input type="hidden" value="@Model.FileSearchResult?.FillObjectId" id="fill-obj-id" />
<input type="hidden" value="@Model.FillId" id="fill-id" />

@section scripts
{
    <script type="text/javascript" src="~/assets/js/jquery.flexslider.js"></script>
    <script type="text/javascript" src="~/assets/js/bootstrap-select.js"></script>
    <script type="text/javascript" src="~/assets/js/finger.min.js"></script>
    <script type="text/javascript" src="~/assets/js/timer.jquery.min.js"></script>
    <script type="text/javascript" src="~/assets/js/plugins/bootstrap3/bootstrap-dialog.min.js"></script>
    <script type="text/javascript" src="~/assets/js/ObjectAssign.js"></script>
    <script type="text/javascript" src="~/assets/js/wip-detail.js"></script>
    <script type="text/javascript" src="~/assets/js/printThis.js"></script>
    <script type="text/javascript" src="~/assets/js/Grids/procedure-select.js"></script>

    <script src="https://kit.fontawesome.com/f4e6b380f7.js"></script>

    <script type="text/javascript" src="~/assets/js/msr/grid-common.js"></script>
    @Scripts.Render("~/bundles/js/fileinput")

    <script type="text/javascript">
        $('#print-other-report').on('click', function () {
            $('#print-other-content').printThis({ canvas: true, printDelay: 1000 });
        });

        $('#ncr-print-button').on('click', function () {
            $('#ncr-print').printThis({ canvas: true, printDelay: 1000 });
        });

        $('#print-traveler-report').on('click', function () {
            $('#print-traveler-container').printThis({ canvas: true, printDelay: 1000 });
        });

        // tab failure fix
        $(function () {
            setTimeout(function () {
                $("#parts-tab").tab('show');
            }, 1000);
        });

    </script>
}
