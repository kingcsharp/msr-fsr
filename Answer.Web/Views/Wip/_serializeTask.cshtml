@model Msr.Services.Orders.Procedures.TaskItemPart
@{
    int i = 0;
    string readOnly = "";//(!Model.IsEditable).ToString();
}
@using (Html.BeginForm("UpdateRootParts", "Wip", FormMethod.Post))
{
    <input type="hidden" name="taskId" value="@Model.STEP_ID" />
    <table class="table">
        <tr>
            <td>Part</td>
            <td>Serial #</td>
        </tr>
        @foreach (var part in Model.GetActualPartsShowHierarchys)
    {
    <tr>
        <td>@part.Part_Desc</td>
        <td>
            <input name="parts[@i].Serial" type="text" value="@part.Serial" @readOnly />
            <input name="parts[@i].Id" type="hidden" value="@part.Id" />
            <input name="parts[@i].TreeLevel" type="hidden" value="@part.Tree_Level" />
            @if (part.Tree_Level == 0)
                {
                <button onclick="$('div#@part.Id').show()"   class="btn-success btn">Change</button>
                <div id="@part.Id" style="display: none">
                    S/N: <input type="text" />
                    <button id="submit-serial-number" data-part-id="@part.Id">Submit</button>
                </div>
                }
        </td>
    </tr>
        i++;
    }
        <tr>
            <td colspan="2">
                <button type="submit"  class="btn-success btn" id="btn-save">Save</button>
                <button type="submit" class="btn-success btn">Save & complete task</button>
            </td>
        </tr>
    </table>
}

<script>
    $('#submit-serial-number').on('click', function() {
        var partId = $(this).data('part-id');
        var serialNumber = $('div#' + partId).find('input').val();
        var taskId = @Model.STEP_ID;

        eLoaderOpen()

        $.ajax({
            type: "POST",
            url: "/wip/UpdateRootPart?partId=" + partId + "&serialNumber=" + serialNumber + "&taskId=" + taskId,
            dataType: 'html',
            success: function(data) {
                if (data === "OK") {
                    $('div#' + partId).hide();
                }
                eLoaderClose()
            },
            error: function (error) {
                eLoaderError(error)
            }
        });
    });
</script>