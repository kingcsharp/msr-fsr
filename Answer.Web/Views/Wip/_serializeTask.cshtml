@model Msr.Services.Orders.Procedures.TaskItemPart
@{
    int i = 0;
}

@using (Html.BeginForm("UpdateRootParts", "Wip", FormMethod.Post, new { id = "Update-root-part" }))
{
    <input type="hidden" name="taskId" value="@Model.STEP_ID" />
        <table class="table">
            <tr>
                <td><label class="control-label">Part</label></td>
                <td><label class="control-label">Serial #</label></td>
            </tr>
            @foreach (var part in Model.GetActualPartsShowHierarchys)
            {
                <tr>
                    <td style="width: 500px;"><label class="control-label">@part.Part_Desc</label></td>

                    <td class="text-td">
                        @if (part.Tree_Level == 0)
                        {
                            <input name="parts[@i].Serial" type="text" value="@part.Serial" disabled="disabled" />
                        }
                        else
                        {
                            <input name="parts[@i].Serial" type="text" class="serialize-serial-num" value="@part.Serial" />
                        }
                        <input name="parts[@i].Id" type="hidden" value="@part.Id" />
                        <input name="parts[@i].TreeLevel" type="hidden" value="@part.Tree_Level" />
                        @if (part.Tree_Level == 0)
                        {
                            <button type="button" class="btn-success btn change-button">Change</button>
                            <div id="@part.Id" style="display: none" class="divshow">
                                S/N: <input type="text" class="part-serail-number" />
                                <button id="submit-serial-number" type="button" data-part-id="@part.Id" class="btn-success btn">Submit</button>
                                <button type="button" class="btn-warning btn cancel-button">Cancel</button>
                            </div>
                        }
                    </td>

                </tr>  i++;
            }

        </table>    }

<script type="text/javascript">

	$(document).ready(function () {

		if ('@Model.Status' === "CLOSED") {
			$('input.serialize-serial-num').attr("disabled", true);
		}

		$('.change-button').click(function () {
			$('.divshow').css('display', 'block');
		});

		$('.cancel-button').click(function () {
			$('.divshow').css('display', 'none');
		});

		$('#submit-serial-number').on('click', function (e) {
			var partId = $(this).data('part-id');
			var serialNumber = $('div#' + partId).find('input').val();
			var taskId = @Model.STEP_ID;

			eLoaderOpen();
			var partSerailNum = $('.part-serail-number').val();
			if (partSerailNum === '') {
				eLoaderError('Please enter a serial number for parts in the screen before continuing');
			}
			else
			{
			$.ajax({
				type: "POST",
				url: "/wip/UpdateRootPart?partId=" + partId + "&serialNumber=" + serialNumber + "&taskId=" + taskId,
				dataType: 'json',
				success: function (data) {
					location.reload();
				},
				error: function (data) {
					eLoaderError(data);
				}
				});
			}
		});
	});
</script>