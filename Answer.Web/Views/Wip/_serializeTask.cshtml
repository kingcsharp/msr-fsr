@model Msr.Services.Orders.Procedures.TaskItemPart
@{
    var i = 0;
}

@using (Html.BeginForm("UpdateRootParts", "Wip", FormMethod.Post, new { id = "Update-root-part" }))
{
    <input type="hidden" name="taskId" value="@Model.STEP_ID" />
    <table class="table">
        <tr>
            <td><label class="control-label">Part</label></td>
            <td><label class="control-label">Serial #</label></td>
        </tr>
        @foreach (var part in Model.GetActualPartsShowHierarchys.GroupBy(x => x.Part_Desc))
        {
            <tr>
                <td>
                    <label class="control-label">@part.FirstOrDefault().Part_Desc</label>
                </td>
                @foreach (var subPart in part)
                {
                    <td class="text-td">
                        @if (subPart.Tree_Level == 0)
                        {
                            <input name="parts[@i].Serial" type="text" value="@subPart.Serial" disabled="disabled" />
                        }
                        else
                        {
                            <input name="parts[@i].Serial" type="text" class="serialize-serial-num" value="@subPart.Serial" />
                        }
                        <input name="parts[@i].Id" type="hidden" value="@subPart.Id" />
                        <input name="parts[@i].TreeLevel" type="hidden" value="@subPart.Tree_Level" />
                        <button id="@subPart.Id" type="button" class="btn-success btn change-button">Change</button>
                        <div id="@subPart.Id" style="display: none" class="divshow">
                            S/N: <input type="text" class="part-serial-number" />
                            <button id="submit-serial-number" type="button" data-part-id="@subPart.Id" class="btn-success btn">Submit</button>
                            <button type="button" class="btn-warning btn cancel-button">Cancel</button>
                        </div>
                    </td>
                    i++;
                }
            </tr>
        }
        <tr>
            <td colspan="2">
                <button type="button" class="btn-success btn" id="btn-save">Save</button>
                <button type="button" class="btn-success btn" id="btn-save-complete-task" data-button-id="completeTask">Save & complete task</button>
            </td>
        </tr>
    </table>    }

<script type="text/javascript">

	$(document).ready(function () {

		if ('@Model.Status' === "CLOSED") {
			$('input.serialize-serial-num').attr("disabled", true);
		}

		$('.change-button').click(function () {
                    var partId=$(this)[0].id;
                    $("div[class='divshow'][id=" + partId +"]").css('display', 'block');
		});

		$('.cancel-button').click(function () {
                    $('.divshow').css('display', 'none');
                    $('.part-serial-number').val('');
		});

        $('button#submit-serial-number').on('click', function (e) {
            var partId = $(this).data('part-id');
            var serialNumber = $('div[id=' + partId +']').find('input').val();
            var taskId = @Model.STEP_ID;

            eLoaderOpen();
            if (serialNumber !== '') {
                $.ajax({
                    type: "POST",
                    url: "/wip/UpdateRootPart?partId=" + partId + "&serialNumber=" + serialNumber + "&taskId=" + taskId,
                    dataType: 'json',
                    success: function (data) {
                        location.reload();
                    },
                    error: function (data) {
                        eLoaderError(data);
                    }
                });
            } else {
                eLoaderError('Please enter a serial number for parts in the screen before continuing');
            }
        });

		$('#btn-save,#btn-save-complete-task').on('click',
			function (e) {
				console.log($('.serialize-serial-num').val());
				var button = $(this).data('button-id');
				e.preventDefault();
				eLoaderOpen();

				$.ajax({
					type: "POST",
					url: "/wip/UpdateRootParts/?type=" + button + "&fillId=" + '@Model.FillId',
					data: $('#Update-root-part').serialize(),
					dataType: 'json',
					success: function (data) {
						if (data === 'OK') {
							location.reload();
						} else {
							eLoaderError(data);
						}
					},
					error: function (error) {
						eLoaderError(error);
					}
				});
			});
	});
</script>
