@model Msr.Services.Orders.Procedures.TaskItemPart
@{
    var i = 0;
    var j = 1;
}
<style>
    label.part-label {
        font-weight: normal;
        margin: 15px 0 0 0;
    }

    #serials .form-group {
        margin-bottom: 0 !important;
    }

    #serials .change-button {
        margin-top: 4px;
    }
</style>


@using (Html.BeginForm("UpdateRootParts", "Wip", FormMethod.Post, new { id = "Update-root-part" }))
{
    <input type="hidden" name="taskId" value="@Model.STEP_ID" />
    <table id="serials" class="table table-hover table-responsive table-bordered" style="margin-top:15px;">
        <thead>
            <tr>
                <th class="dark">Part</th>
                <th colspan="2" class="dark">Serial #</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var part in Model.GetActualPartsShowHierarchys.GroupBy(x => x.Part_Desc))
            {
                foreach (var subPart in part)
                {
                    <tr>
                        <td class="part-label-td">
                            @if (subPart.Qty > 1)
                            {
                                <label class="part-label">@part.FirstOrDefault().Part_Desc #@j</label>
                                j++;
                            }
                            else
                            {
                               <label class="part-label">@part.FirstOrDefault().Part_Desc</label>
                            }
                        </td>
                        <td class="text-td" style="border-right: unset;">
                            <div id="@i-show" data-index="@i" class="form-group">
                                @* if is parent part*@
                                @if (subPart.Tree_Level == 0)
                                {
                                    <input name="parts[@i].Status" type="hidden" value="@Model.Status" />
                                    <input id="@i-current-value" class="form-control" name="parts[@i].Serial" type="text" value="@subPart.Serial" disabled="disabled" />
                                }
                                @* MH- if is subpart part and step is CLOSED we can show subpart serials*@
                                else if (@Model.Status == "CLOSED")
                                {
                                    <input id="@i-current-value" class="form-control serialize-serial-num" name="parts[@i].Serial" type="text" value="@subPart.Serial" disabled="disabled" />
                                }
                                @* MH- if is subpart part and step is not FINISHED DO NOT prepop serials*@
                                else
                                {
                                    <input id="@i-current-value" class="form-control serialize-serial-num" name="parts[@i].Serial" type="text" disabled="disabled" />
                                }

                                @if (ViewBag.HasStepRoles == true)
                                {
                                    <input name="parts[@i].Id" type="hidden" value="@subPart.Id" />
                                    <input name="parts[@i].TreeLevel" type="hidden" value="@subPart.Tree_Level" />
                                    <button id="@subPart.Id" type="button" class=" btn btn-warning change-button">Change</button>
                                }
                            </div>

                            @if (ViewBag.HasStepRoles == true)
                            {
                                <div id="@i-change" class="hidden form-group" data-index="@i">
                                    <input id="@i-new-value" class="form-control part-serial-number" type="text" placeholder="@subPart.Serial" />
                                    <button id="@i-submit" type="button" data-index="@i" data-part-id="@subPart.Id" class="btn-success btn submit-serial-number">Submit</button>
                                    <button id="@i-cancel" type="button" class="btn-danger btn cancel-button">Cancel</button>
                                </div>
                            }

                        </td>
                        <td style="border-left:unset;">
                            <div id="@i-results" class="hidden" style="margin-top:10px;"></div>
                        </td>
                    </tr>
                    i++;

                    }

                }
            </tbody>
    </table>

    if (ViewBag.HasStepRoles == true)
    {
        <button type="button" class="btn-success btn" id="btn-save">Save</button>
        <button type="button" class="btn-success btn" id="btn-save-complete-task" data-button-id="completeTask">Save & Complete Task</button>
    }

}

<script type="text/javascript">

	$(document).ready(function () {

        $('.change-button').click(function () {
            var thisId = $(this).parent().data('index');
            $(this).parent('div').addClass('hidden');
            $('#'+thisId+'-change').removeClass('hidden');
		});

		$('.cancel-button').click(function () {
            var thisId = $(this).parent().data('index');
            $('#'+thisId+'-show').removeClass('hidden');
            $(this).parent('div').addClass('hidden');
		});

        $('button.submit-serial-number').on('click', function (e) {
            var index = $(this).data('index');
            $(this).attr("disabled", true).html('<i class="fa fa-refresh fa-spin fa-fw"></i><span class="sr-only">Saving...</span>');
            $('#'+index+'-cancel').addClass('hidden');
            var partId = $(this).data('part-id');
            var serialNumber = $('#' + index + '-new-value').val();
            var taskId = @Model.STEP_ID;

			//eLoaderOpen();
            if (serialNumber === '') {
                $('#' + index + '-results').addClass('text-danger').html('Please enter a serial number for parts in the screen before saving');
                $(this).attr("disabled", false).html('Change');
                $('#'+index+'-cancel').removeClass('hidden');
				//eLoaderError('Please enter a serial number for parts in the screen before continuing');
            }

			else {
			$.ajax({
				type: "POST",
				url: "/wip/UpdateRootPart?partId=" + partId + "&serialNumber=" + serialNumber + "&taskId=" + taskId,
                dataType: 'json',
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        $('#'+index+'-submit').attr("disabled", false).html('Submit');
                        $('#' + index + '-cancel').removeClass('hidden');
                        $('#' + index + '-change').addClass('hidden');
                        $('#' + index + '-current-value').val(serialNumber);
                        $('#' + index + '-show').removeClass('hidden');
                        $('#' + index + '-results').addClass('text-success').removeClass('hidden').html(response.responseText).fadeIn(1000).delay(5000).fadeOut("slow");
                    }
                    else {
                        $('#'+index+'-submit').attr("disabled", false).html('Submit');
                        $('#'+index+'-cancel').removeClass('hidden');
                        $('#' + index + '-results').addClass('text-danger').removeClass('hidden').html(response.responseText);
                    }
				},
                error: function (data) {
                    $('#'+index+'-submit').attr("disabled", false).html('Submit');
                    $('#'+index+'-cancel').removeClass('hidden');
                    $('#' + index + '-results').addClass('text-danger').html('Internal Error. Error:' +data);
				}
				});
			}
		});

		$('#btn-save,#btn-save-complete-task').on('click',
			function (e) {
				var button = $(this).data('button-id');
				e.preventDefault();
				eLoaderOpen();

				$.ajax({
					type: "POST",
					url: "/wip/UpdateRootParts/?type=" + button + "&fillId=" + '@Model.FillId',
					data: $('#Update-root-part').serialize(),
					dataType: 'json',
					success: function (data) {
						if (data === 'OK') {
							location.reload();
						} else {
							eLoaderError(data);
						}
					},
					error: function (error) {
						eLoaderError(error);
					}
				});
			});
	});
</script>