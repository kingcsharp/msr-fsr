@model Msr.Services.Orders.Procedures.TaskItemPart
@{
    var i = 0;
}
<style>
    label.part-label {
        font-weight: normal;
        margin: 15px 0 0 0;
    }

    #serials .form-control {
        display: inline-block;
        width: unset !important;
        margin-bottom: 0 !important;
    }

    #serials .form-group {
        margin-bottom: 0 !important;
    }

    #serials .change-button {
        margin-top: 4px;
    }

    th.dark {
        background-color: #353D47;
        color: white;
        text-align: left;
    }
</style>


@using (Html.BeginForm("UpdateRootParts", "Wip", FormMethod.Post, new { id = "Update-root-part" }))
{
    <input type="hidden" name="taskId" value="@Model.STEP_ID" />
    <table id="serials" class="table table-hover table-bordered" style="margin-top:15px;">
        <thead>
            <tr>
                <th class="dark">Part</th>
                <th class="dark">Serial #</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var part in Model.GetActualPartsShowHierarchys.GroupBy(x => x.Part_Desc))
            {
                <tr>
                    <td>
                        <label class="part-label">@part.FirstOrDefault().Part_Desc</label>
                    </td>
                    @foreach (var subPart in part)
                    {
                        <td class="text-td">
                            <div id="@i-show" data-index="@i" class="form-group">
                                @if (subPart.Tree_Level == 0)
                                {

                                    <input class="form-control" name="parts[@i].Serial" type="text" value="@subPart.Serial" disabled="disabled" />

                                }
                                else
                                {

                                    <input class="form-control serialize-serial-num" name="parts[@i].Serial" type="text" value="@subPart.Serial" disabled="disabled" />

                                }
                                <input name="parts[@i].Id" type="hidden" value="@subPart.Id" />
                                <input name="parts[@i].TreeLevel" type="hidden" value="@subPart.Tree_Level" />
                                <button id="@subPart.Id" type="button" class=" btn btn-warning change-button">Change</button>
                            </div>

                            <div id="@i-change" class="hidden form-group" data-index="@i">
                                <input id="@i-new-value" class="form-control part-serial-number" type="text" placeholder="@subPart.Serial" />
                                <button id="submit-serial-number" type="button" data-index="@i" data-part-id="@subPart.Id" class="btn-success btn">Submit</button>
                                <button type="button" class="btn-danger btn cancel-button">Cancel</button>
                            </div>
                        </td>
                        i++;
                    }
                </tr>
            }
        </tbody>
    </table>
    <button type="button" class="btn-success btn" id="btn-save">Save</button>
    <button type="button" class="btn-success btn" id="btn-save-complete-task" data-button-id="completeTask">Save & complete task</button>
}

<script type="text/javascript">

	$(document).ready(function () {

		if ('@Model.Status' === "CLOSED") {
			$('input.serialize-serial-num').attr("disabled", true);
		}

        $('.change-button').click(function () {
            var thisId = $(this).parent().data('index');
            $(this).parent('div').addClass('hidden');
            $('#' + thisId + '-change').removeClass('hidden');
		});

		$('.cancel-button').click(function () {
            var thisId = $(this).parent().data('index');
            $('#' + thisId + '-show').removeClass('hidden');
            $(this).parent('div').addClass('hidden');
		});

	    $('button#submit-serial-number').on('click', function (e) {
            var index = $(this).data('index');
            var partId = $(this).data('part-id');
            console.log('PartId: ' + partId);
            var serialNumber = $('#' + index + '-new-value').val();
            console.log('New Serial#: ' + serialNumber);
            var taskId = @Model.STEP_ID;
            console.log('Task Id#: ' + taskId);

			eLoaderOpen();
			if (serialNumber === '') {
				eLoaderError('Please enter a serial number for parts in the screen before continuing');
            }

			else {
			$.ajax({
				type: "POST",
				url: "/wip/UpdateRootPart?partId=" + partId + "&serialNumber=" + serialNumber + "&taskId=" + taskId,
				dataType: 'json',
				success: function (data) {
					location.reload();
				},
				error: function (data) {
					eLoaderError(data);
				}
				});
			}
		});

		$('#btn-save,#btn-save-complete-task').on('click',
			function (e) {
				console.log($('.serialize-serial-num').val());
				var button = $(this).data('button-id');
				e.preventDefault();
				eLoaderOpen();

				$.ajax({
					type: "POST",
					url: "/wip/UpdateRootParts/?type=" + button + "&fillId=" + '@Model.FillId',
					data: $('#Update-root-part').serialize(),
					dataType: 'json',
					success: function (data) {
						if (data === 'OK') {
							location.reload();
						} else {
							eLoaderError(data);
						}
					},
					error: function (error) {
						eLoaderError(error);
					}
				});
			});
	});
</script>