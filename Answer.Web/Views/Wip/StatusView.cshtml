@model Answer.Web.ViewModel.Wip.WipStatusViewModel
@{
    ViewBag.Title = "WIP Status";
}

<style>
    .table > tbody > tr > td {
        vertical-align: middle;
    }

    .table > tbody > tr > td, .table > tbody > tr > th, .table > tfoot > tr > td, .table > tfoot > tr > th, .table > thead > tr > td, .table > thead > tr > th {
        padding: 0 6px;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        @Html.Partial("Message")
        <table class="table table-reposnsive table-striped wip-status">
            <thead>

                <tr>
                    <th>
                        Product
                    </th>
                    <th>
                        PN/IPN
                    </th>
                    <th>
                        Procedure
                    </th>
                    <th>
                        <select class="form-control location-name">
                            @foreach (var location in Model.LocationList)
                            {
                                if (location.Selected)
                                {
                                    <option value="@location.Value" selected="selected">@location.Text</option>
                                }
                                else
                                {
                                    <option value="@location.Value">@location.Text</option>
                                }
                            }

                        </select>
                        @* @Html.DropDownListFor(model => model.Location, Model.LocationList, new { @class = "form-control location-name" })*@
                    </th>
                    <th colspan="4">
                        Open WO's
                        <div class="pull-right">Last Updated : <span class="livestamp now livestamp-display"></span></div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @Html.Partial("_StatusItems")
            </tbody>
        </table>
    </div>
</div>
@section scripts
{
    <script src="~/assets/js/grids/statusGrid.js"></script>
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/livestamp.js"></script>
    <script>
        $(document).ready(function () {
            var nowMs = +new Date(),
                now = Math.floor(nowMs / 1000);
            //update trhe time stamp every minute
            $.livestamp.interval(30);
            $('.now').livestamp(now);
            $('.now-display').text(now);
            //refresh every 15 minutes
            setInterval(function () {
                window.location.reload();
            }, 900000);
        });
    </script>
}
