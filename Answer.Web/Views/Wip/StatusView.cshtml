@model Answer.Web.ViewModel.Wip.WipStatusViewModel
@{
    ViewBag.Title = "WIP Status";
}

<style>
    .wip-status, .wip-status-header {
        font-size: 1.4em;
        font-weight: 700;
    }

    .wip-status-header {
        color: #777 !important;
        border-bottom: 1px solid #777;
        line-height: 1em;
        margin-bottom: .2em !important;
    }

    .vcenter {
        margin-top: 7px;
        white-space: nowrap;
        overflow-x: hidden;
    }

    .row.wip-status > [class*="col-"] {
        line-height: 19px;
        margin-bottom: -.2em !important;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        @Html.Partial("Message")
        <div class="col-lg-12 wip-detail-header-left">
            @if (!Model.WipStatusViewItems.Any())
            {
                <div>No records to view</div>
            }
            <div class="row" style="width: 100%; margin-top: 30px;">
                <div class="col-lg-3 col-md-3 col-sm-3 wip-status-header" style="width: 24%;margin-top:24px;">
                    Product
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2 wip-status-header" style="width: 17%;margin-top:24px;">
                    PN/IPN
                </div>
                <div class="col-lg-2 col-md-2 col-sm-2 wip-status-header" style="width: 17%;margin-top:24px;">
                    Procedure
                </div>
                <div div class="col-lg-5 col-md-5 col-sm-5 wip-status-header" style="width: 12%;">
                    <select class="form-control location-name">
                        @foreach (var location in Model.LocationList)
                        {
                            if (location.Selected)
                            {
                                <option value="@location.Value" selected="selected">@location.Text</option>
                            }
                            else
                            {
                                <option value="@location.Value">@location.Text</option>
                            }
                        }

                    </select>
                    @* @Html.DropDownListFor(model => model.Location, Model.LocationList, new { @class = "form-control location-name" })*@
                </div>
                <div class="col-lg-5 col-md-5 col-sm-5 wip-status-header" style="width: 30%;margin-top:24px;">
                    Open WO's
                </div>
            </div>
            <div id="status-items">
                @Html.Partial("_StatusItems")
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/js/grids/statusGrid.js"></script>
}