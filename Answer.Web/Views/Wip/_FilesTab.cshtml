@model Msr.Services.Orders.ViewModels.ImageViewModel

@if (ViewBag.HasStepRoles == true)
{
    <div id="file-tab-@Model.TaskId">
        @Html.Partial("_FileUpload")
    </div>
    <input  type="hidden" value="WIP_TASK_STEP"/>
}
else
{
    <div id="file-tab-@Model.TaskId">
        The current user does not have the proper roles for this task.
    </div>
}

<script type="text/javascript">
    $(function () {
        var fileUploader = new FileUploader();
        var fileId = 'file-tab-@Model.TaskId' + ' #input-files';

        fileUploader.InitEditUploader(fileId,
            '@Url.Action("FileUploaderForWipTask", "Doc")',
            [@Html.Raw(Model.Preview)],
            @Html.Raw(Model.PreviewConfig),
            '@Model.TaskId' + ',' + '@Model.ActualPartId',
            true,
            'WIP_TASK_STEP');
    });

    function SelectIds() {
        new FileUploaderGrid().SelectIds();
    }
</script>