@model Msr.Services.Orders.Procedures.MonitorTemplateResult

@using (Html.BeginForm("UpdateStepMonitor", "Wip", FormMethod.Post, new {@class = "form form-horizontal", role = "form"}))
{
    @Html.HiddenFor(x => x.Id)

    @Html.HiddenFor(x => x.TheSaurusId)
    @Html.HiddenFor(x => x.StrNtLogin)
    @Html.HiddenFor(x => x.FillId)

    <div class="form-group">
        <label class="col-lg-2 control-label">Monitor Type:</label>
        <div class="col-lg-2">
            @Html.DropDownListFor(x => x.Monitor_Type ?? "USER_NUMBER", Model.MonitorTypes, new { @id = "monitor-type" })
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">Monitor Description:</label>
        <div class="col-lg-2">
            @Html.TextAreaFor(x => x.Description)
        </div>
    </div>

    <div class="form-group" id="div-should-be">
        <label class="col-lg-2 control-label">Should Be:</label>
        <div class="col-lg-2">
            @Html.DropDownListFor(x => x.Should_Be, Model.ShouldBeItems)
        </div>
    </div>

    <div class="form-group" id="div-tolerance">
        <label class="col-lg-2 control-label">Tolerance percentage:</label>
        <div class="col-lg-2">
            @Html.TextBoxFor(x => x.Tolerance)
        </div>
    </div>

    <div class="form-group" id="div-yes-no">
        <label class="col-lg-2 control-label">Yes No Correct Answer:</label>
        <div class="col-lg-2">
            @Html.DropDownListFor(x => x.Yes_No_Answer, Model.ResultList, new {@class = "form-control"})
        </div>
    </div>

    <div class="form-group" id="div-highest-threshold">
        <label class="col-lg-2 control-label">Highest Threshold:</label>
        <div class="col-lg-2">
            @Html.TextBoxFor(x => x.Highest_Threshold)
        </div>
    </div>

    <div class="form-group" id="div-high-threshold">
        <label class="col-lg-2 control-label">High Threshold:</label>
        <div class="col-lg-2">
            @Html.TextBoxFor(x => x.High_Threshold)
        </div>
    </div>

    <div class="form-group" id="div-target">
        <label class="col-lg-2 control-label">Target:</label>
        <div class="col-lg-2" style="font-weight: bold;">
            @Html.TextBoxFor(x => x.Target)
        </div>
    </div>

    <div class="form-group" id="div-low-threshold">
        <label class="col-lg-2 control-label">Low Threshold:</label>
        <div class="col-lg-2">
            @Html.TextBoxFor(x => x.Low_Threshold)
        </div>
    </div>

    <div class="form-group" id="div-lowest-threshold">
        <label class="col-lg-2 control-label">Lowest Threshold:</label>
        <div class="col-lg-2">
            @Html.TextBoxFor(x => x.Lowest_Threshold)
        </div>
    </div>
    <div class="form-group" id="div-text-target">
        <label class="col-lg-2 control-label">Text Target:</label>
        <div class="col-lg-2" style="font-weight: bold;">
            @Html.TextBoxFor(x => x.Text_Target)
        </div>
    </div>

    <div class="form-group" id="div-type-of-object">
        <label class="col-lg-2 control-label">Type of Object:</label>
        <div class="col-lg-2">
            @Html.DropDownListFor(x => x.Target_Object_Type, Model.TargetObjectTypes)
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">
            Based on Opinion
        </label>
        <div class="col-lg-8">
            @Html.DropDownListFor(x => x.Opinion, Model.ResultList)
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">
            Use Result
        </label>
        <div class="col-lg-8">
            @Html.DropDownListFor(x => x.Use_Result, Model.ResultList)
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">
            Hide Target information
        </label>
        <div class="col-lg-8">
            @Html.DropDownListFor(x => x.Hide_Target, Model.ResultList)
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">
            If Fail Next Action:
        </label>
        <div class="col-lg-8">
            @Html.DropDownListFor(x => Model.Fail_Action, Model.FailActionList, new {@class = "form-control"})
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">
            Force end action
        </label>
        <div class="col-lg-8">
            @Html.DropDownListFor(x => x.Cant_Change, Model.ResultList)
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">
            Ignore Result and always Pass
        </label>
        <div class="col-lg-8">
            @Html.DropDownListFor(x => x.Always_Pass, Model.ResultList)
        </div>
    </div>

    <div class="row">
        <input class="btn-info" id="monitor-save-close" value="Add new monitor" type="button"/>
    </div>
}
<script>
    $("#monitor-save-close").on('click', function () {
        var form = $(this).parents('form:first');
        $.ajax({
            type: "POST",
            url: "/wip/UpdateStepMonitorAndClose",
            dataType: 'json',
            data: form.serialize(),
            success: function (data) {
                location.reload();
            },
            error: function () {

            }
        });
    });

    $("#monitor-type").on('change', function () {
        if (this.value == 'MULTIPLE') {
            $('#add-choices').show();
            $('#div-highest-threshold').hide();
            $('#div-should-be').hide();
            $('#div-high-threshold').hide();
            $('#div-target').hide();
            $('#div-text-target').hide();
            $('#div-tolerance').hide();
            $('#div-low-threshold').hide();
            $('#div-lowest-threshold').hide();
            $('#div-yes-no').hide();
            $('#div-type-of-object').hide();
        }
        else if (this.value == 'YES_NO') {
            $('#add-choices').hide();
            $('#div-highest-threshold').hide();
            $('#div-should-be').hide();
            $('#div-high-threshold').hide();
            $('#div-target').hide();
            $('#div-text-target').hide();
            $('#div-tolerance').hide();
            $('#div-low-threshold').hide();
            $('#div-lowest-threshold').hide();
            $('#div-yes-no').show();
            $('#div-type-of-object').hide();
        }
        else if (this.value == 'TEXT') {
            $('#add-choices').show();
            $('#div-highest-threshold').hide();
            $('#div-should-be').hide();
            $('#div-high-threshold').hide();
            $('#div-target').hide();
            $('#div-text-target').show();
            $('#div-tolerance').hide();
            $('#div-low-threshold').hide();
            $('#div-lowest-threshold').hide();
            $('#div-yes-no').hide();
            $('#div-type-of-object').hide();
        }
        else if (this.value == 'NUMBER') {
            $('#add-choices').hide();
            $('#div-highest-threshold').show();
            $('#div-should-be').show();
            $('#div-high-threshold').show();
            $('#div-target').show();
            $('#div-text-target').hide();
            $('#div-tolerance').show();
            $('#div-low-threshold').show();
            $('#div-lowest-threshold').show();
            $('#div-yes-no').hide();
            $('#div-type-of-object').hide();
        }
        else if (this.value == 'USER_NUMBER') {
            $('#add-choices').hide();
            $('#div-highest-threshold').hide();
            $('#div-should-be').hide();
            $('#div-high-threshold').hide();
            $('#div-target').show();
            $('#div-text-target').hide();
            $('#div-tolerance').show();
            $('#div-low-threshold').hide();
            $('#div-lowest-threshold').hide();
            $('#div-yes-no').hide();
            $('#div-type-of-object').hide();
        }
        else if (this.value == 'OBJECT') {
            $('#add-choices').hide();
            $('#div-highest-threshold').hide();
            $('#div-should-be').hide();
            $('#div-high-threshold').hide();
            $('#div-target').hide();
            $('#div-text-target').hide();
            $('#div-tolerance').hide();
            $('#div-low-threshold').hide();
            $('#div-lowest-threshold').hide();
            $('#div-yes-no').hide();
            $('#div-type-of-object').show();
        }
    });
</script>