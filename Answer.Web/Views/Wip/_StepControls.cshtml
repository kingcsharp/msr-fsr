@using Microsoft.AspNet.Identity
@using Msr.Models.Tasks
@model Msr.Services.Orders.Messaging.WipStepDetailsResponse

@{
    var timespan = "0 Hours";
    var resumeButton = "hidden";
    var startButton = "hidden";
    var pauseButton = "hidden";
    var doneButton = "hidden";
    var timerInput = "hidden";
    int? taskId = null;

    if (Model.TaskRunningDto != null)
    {
        taskId = Model.TaskRunningDto.Id;
        
    }
}

@if ((Model.TaskEditDataResult.Status == "REQUESTED" || Model.TaskEditDataResult.Status == "ACCEPTED") && Model.TaskRunningDto == null)
{
    startButton = "show";
    timerInput = "";
}

@if (Model.TaskRunningDto != null)
{
    timerInput = "";
}

<div class="row" id="@Model.StepId">
    <div id="timer-input" class="col-sm-4 timer-input @timerInput">
        <input  type="text" name="timer" class="form-control timer input-lg "  width="120">
    </div>
    <div class="col-sm-5">
        
    
        <button class="timer-btn btn btn-primary btn-lg print-btn pull-left start-timer-btn @startButton start-step" id="start-step"><i class="glyphicon glyphicon-step-forward"></i> Start</button> 

        @if (Model.TaskRunningDto != null && Model.TaskRunningDto.StatusId == TimerStatuseConstants.Paused)
        {
            resumeButton = "show";
            doneButton = "show";
        }

        <button class="timer-btn btn btn-warning btn-lg print-btn pull-left @resumeButton" data-task-log-id="@taskId" id="resume-step"><i class="glyphicon glyphicon-step-forward"></i> Resume</button>

        @if (Model.TaskRunningDto != null && Model.TaskRunningDto.StatusId == TimerStatuseConstants.InProgress)
        {
            pauseButton = "show";
            doneButton = "show";
        }
         
        <button class="timer-btn btn btn-warning btn-lg print-btn pull-left @pauseButton" data-task-log-id="@taskId" id="pause-step"><i class="glyphicon glyphicon-pause"></i> Pause</button>
        <button class="timer-btn btn btn-primary btn-lg print-btn pull-left @doneButton" data-task-log-id="@taskId" id="done-step"><i class="glyphicon glyphicon-stop"></i> Done</button>

    </div>
    <div class="col-sm-3">
        @if (!string.IsNullOrWhiteSpace(Model.TaskEditDataResult.RequesteeId) && Model.TaskEditDataResult.RequesteeId != Model.LoggedUserIdResult.Id)
        {
        <button class="btn btn-warning btn-lg print-btn pull-left show-timer-btn" id="assume-step"><i class="glyphicon glyphicon-step-forward"></i> Take over this task</button>
        }
        
        @if (Model.TaskEditDataResult.Status == "ACCEPTED" || Model.TaskEditDataResult.Status == "REQUESTED")
        {
            <button data-toggle="modal" data-fill-id="@ViewBag.FillId" data-id="@Model.StepId" data-target="#addNcrModal" class="btn btn-danger btn-lg print-btn pull-right"><i class="fa fa-plus-square"></i> Add NCR</button>
        }  
    </div>
</div>

<script>

    $(function () {

        @if (Model.TaskRunningDto !=null && Model.TaskRunningDto.Duration != "0s")
        {
            <text>
                $('.timer').timer({
                    seconds: @Model.TaskRunningDto.TotalSeconds,
                    duration: '@Model.TaskRunningDto.Duration'
                });
            </text>

        }


        $('#@Model.StepId #pause-step').on('click', function () {
            StepPauseClick($(this).data('task-log-id'));
            $('.timer').timer('pause');

        });

        $('#@Model.StepId #resume-step').on('click',function() {
            StepResumeClick($(this).data('task-log-id'));

            $('#@Model.StepId .timer').timer('resume');

        });

        $('#@Model.StepId #start-step').on('click', function () {

            StepStartClick();
        });

        $('#@Model.StepId #done-step').on('click', function() {
            StepDoneClick();
            $('.timer').timer('pause');

        });

        $('#@Model.StepId #assume-step').on('click',
            function() {
                StepAssumeClick();
            });

        $('#addNcrModal').on('hidden.bs.modal',
            function(event) {
                $(this).data('bs.modal', null);
            });

        $('#addNcrModal').on('show.bs.modal',
            function(event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var fillId = button.data('fill-id');
                var modal = $(this);

                $.ajax({
                    type: "GET",
                    url: '/Wip/AddNcrModel?parentId=' + id + '&fillid=' + fillId,
                    dataType: 'html',
                    success: function(data) {
                        modal.find('.modal-body').html(data);
                    },
                    error: function() {

                    }
                });
            });



    });

    function StepDoneClick() {
        var stepId = @Model.StepId;
        var fillId = @Model.FillId;

        $.ajax({
            type: "POST",
            url: "/wip/StepDoneClick?stepId=" + stepId + "&fillId=" + fillId,
            dataType: 'json',
            success: function(data) {
                TimerVisibility(data);

                var stepInProgress = $('#carousel ul.slides').find(".waiting").first();

                if (stepInProgress !== null) {
                    $(stepInProgress).removeClass('waiting');
                    $(stepInProgress).addClass('requested');
                    $(stepInProgress).trigger("click");
                }

                var stepRequested = $('[data-stepid=' + stepId + ']');

                if (stepRequested !== null) {
                    $(stepRequested).addClass('step-complete');
                }

            },
            error: function() {

            }
        });
    }

    function StepStartClick() {
        var stepId = @Model.StepId;
        var fillId = @Model.FillId;

        $.ajax({
            type: "POST",
            url: "/wip/StepStartClick?stepId=" + stepId + "&fillId=" + fillId,
            dataType: 'json',
            success: function (data) {
                TimerVisibility(data);

                if (data.ErrorMessage === '') {
                        $('.timer').timer({
                            editable: true
                        });
                    }

            },
            error: function () {

            }
        });
    }

    function StepAssumeClick() {

        var taskId = '@Model.StepId';

        $.ajax({
            type: "POST",
            url: "/wip/AssumeTaskClick?taskId=" + taskId,
            dataType: 'json',
            success: function (data) {
                location.reload();
            },
            error: function () {

            }
        });
    }

    function StepResumeClick(id) {
        var fillId = @Model.FillId;

        $.ajax({
            type: "POST",
            url: "/wip/stepResume?taskLogId=" + id + "&fillId=" + fillId,
            dataType: 'json',
            success: function (data) {
                TimerVisibility(data);
            },
            error: function () {

            }
        });
    }

    function StepPauseClick(id) {
        var fillId = @Model.FillId;

        $.ajax({
            type: "POST",
            url: "/wip/StepPause?taskLogId=" + id + "&fillId=" + fillId,
            dataType: 'json',
            success: function (data) {
                TimerVisibility(data);
            },
            error: function () {

            }
        });
    }

    function TimerVisibility(data) {

        if (data.ErrorMessage !== '') {
            alert(data.ErrorMessage);
        } else {

        $('.timer-btn').attr('data-task-log-id', data.Entity.Id);

        if (data.Entity.StatusId === 2) {
            $('#@Model.StepId #resume-step').removeClass('hidden');
            $('#@Model.StepId #pause-step').addClass('hidden');

        } else
            if (data.Entity.StatusId === 1) {
            $('#@Model.StepId #done-step').removeClass('hidden');
            $('#@Model.StepId #pause-step').removeClass('hidden');
            $('#@Model.StepId #resume-step').addClass('hidden');
            $('#@Model.StepId #start-step').addClass('hidden');
            }
            else if (data.Entity.StatusId === 3)
            {
            $('#@Model.StepId #pause-step').addClass('hidden');
            $('#@Model.StepId #resume-step').addClass('hidden');
            $('#@Model.StepId #done-step').addClass('hidden');
            }
        }
    }

</script>