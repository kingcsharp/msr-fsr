@using Microsoft.AspNet.Identity
@model Msr.Services.Orders.Messaging.WipStepDetailsResponse
@*getButtons(myRS)*@
@{
    var timespan = "0 Hours";
    if (Model.TaskRunningTimer != null)
    {
        TimeSpan timer = Model.TaskRunningTimer.EndTime?.Subtract(Model.TaskRunningTimer.StartTime) ?? DateTime.Now.Subtract(Model.TaskRunningTimer.StartTime);
        var timerInSeconds = timer.TotalSeconds;
        if (timerInSeconds <= 60)
        {
            timespan = timer.Seconds + " sec";
        }
        else if (timer.TotalMinutes <= 60)
        {
            timespan = timer.Minutes + " minutes " + timer.Seconds + " sec";
        }
        else
        {
            timespan = timer.Hours + " hours " + timer.Minutes + " minutes " + timer.Seconds + " sec";
        }
    }
}
<div class="row">
    <div id="timer-input" class="col-sm-4 timer-input">
        <input type="text" name="timer" class="form-control timer input-lg" placeholder="@timespan" width="120">
    </div>
    <div class="col-sm-6">
        @if (Model.TaskEditDataResult.Status != "ACCEPTED" && Model.TaskRunningTimer == null)
        {
            <button class="btn btn-primary btn-lg print-btn pull-left start-timer-btn" id="start-step"><i class="glyphicon glyphicon-step-forward"></i> Start</button>
        }
        else
        {
            <button class="btn btn-primary btn-lg print-btn pull-left show-timer-btn" id="show-step"><i class="glyphicon glyphicon-step-forward"></i> Show</button>
            if (Model.TaskEditDataResult.Assignee != User.Identity.GetUserId())
            {
                <button class="btn btn-primary btn-lg print-btn pull-left show-timer-btn" id="assume-step"><i class="glyphicon glyphicon-step-forward"></i> Take over this task</button>
            }
        }

        <button class="btn btn-warning btn-lg print-btn pull-left pause-timer-btn hidden" id="pause-step"><i class="glyphicon glyphicon-pause"></i> Pause</button>
        <button class="btn btn-warning btn-lg print-btn pull-left resume-timer-btn hidden" id="resume-step"><i class="glyphicon glyphicon-step-forward"></i> Resume</button>
        @if (Model.TaskRunningTimer != null && Model.TaskRunningTimer.EndTime == null)
        {
            <button class="btn btn-primary btn-lg print-btn pull-left " id="done-step"><i class="glyphicon glyphicon-stop"></i> Done</button>
        }
        @if (Model.TaskEditDataResult.Status == "ACCEPTED" && Model.TaskEditDataResult.Status == "REQUESTED")
        {
            <button class="btn btn-primary btn-lg print-btn pull-left" id="done-step">Add Procedure</button>
        }
    </div>
    <div class="col-sm-2">
        <button data-toggle="modal" data-id="@ViewBag.FillId" data-target="#ncrModal" class="btn btn-danger btn-lg print-btn pull-right" id="ncr-button"><i class="fa fa-plus-square"></i> NCR</button>
    </div>
</div>

<script>

    $('#start-step').on('click', function() {
        StepStartClick();
    });

    $('#done-step').on('click', function() {
        StepDoneClick();
    });

    $('#assume-step').on('click', function() {
        StepAssumeClick();
    });

    $('#ncrModal').on('hidden.bs.modal', function(event) {
        $(this).data('bs.modal', null);
    });

    $('#ncrModal').on('show.bs.modal', function(event) {
        var button = $(event.relatedTarget);
        var id = button.data('id');
        var modal = $(this);

        $.ajax({
            type: "GET",
            url: '/wip/getncrmodel?id=' + id,
            dataType: 'html',
            success: function(data) {
                modal.find('.modal-body').html(data);
            },
            error: function() {

            }
        });
    });


    function StepDoneClick() {
        var stepId = @Model.StepId;

        $.ajax({
            type: "POST",
            url: "/wip/StepDoneClick?stepId=" + stepId,
            dataType: 'json',
            success: function(data) {
                location.reload();
            },
            error: function() {

            }
        });
    }

    function StepStartClick() {
        var stepId = @Model.StepId;

        $.ajax({
            type: "POST",
            url: "/wip/StepStartClick?stepId=" + stepId,
            dataType: 'json',
            success: function (data) {
                location.reload();
            },
            error: function () {

            }
        });
    }

    function StepAssumeClick() {

        var taskId = '@Model.StepId';

        $.ajax({
            type: "POST",
            url: "/wip/AssumeTaskClick?taskId=" + taskId,
            dataType: 'json',
            success: function (data) {
                location.reload();
            },
            error: function () {

            }
        });
    }
</script>