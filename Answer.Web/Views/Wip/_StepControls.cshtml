@using Msr.Models.Tasks
@model Msr.Services.Orders.Messaging.WipStepDetailsResponse

@{
    var timespan = "0 Hours";
    var resumeButton = "hidden";
    var startButton = "hidden";
    var pauseButton = "hidden";
    var doneButton = "hidden";
    var timerInput = "hidden";
    int? taskId = null;

    if (Model.TaskRunningDto != null)
    {
        taskId = Model.TaskRunningDto.Id;
        
    }
}

@if ((Model.TaskEditDataResult.Status != "ACCEPTED" && Model.TaskRunningDto == null) && Model.TaskEditDataResult.Status != "FINISHED")
{
    startButton = "show";
    timerInput = "";
}

@if ((Model.TaskEditDataResult.Status == "ACCEPTED" && Model.TaskRunningDto == null))
{
    timerInput = "";
}

@if (Model.TaskRunningDto != null)
{
    timerInput = "";
}

<div class="row" id="@Model.StepId">

    @if (Model.HasStepRoles)
    {
        <div id="timer-input" class="col-sm-4 timer-input @timerInput">
            <input type="text" name="timer" class="form-control timer input-lg" width="120">
        </div>
        <div class="col-sm-3">

            <button class="timer-btn btn btn-primary btn-lg print-btn pull-left start-timer-btn @startButton start-step" id="start-step"><i class="glyphicon glyphicon-step-forward"></i> Start</button>

            @if ((Model.TaskRunningDto != null && Model.TaskRunningDto.StatusId == TimerStatuseConstants.Paused) || (Model.TaskEditDataResult.Status == "ACCEPTED" && Model.TaskRunningDto == null))
            {
                resumeButton = "show";
                doneButton = "show";
            }

            <button class="timer-btn btn btn-warning btn-lg print-btn pull-left @resumeButton" data-task-log-id="@taskId" id="resume-step"><i class="glyphicon glyphicon-step-forward"></i> Resume</button>

            @if (Model.TaskRunningDto != null && Model.TaskRunningDto.StatusId == TimerStatuseConstants.InProgress)
            {
                pauseButton = "show";
                doneButton = "show";
            }

            <button class="timer-btn btn btn-warning btn-lg print-btn pull-left @pauseButton" data-task-log-id="@taskId" id="pause-step"><i class="glyphicon glyphicon-pause"></i> Pause</button>
            <button class="timer-btn btn btn-primary btn-lg print-btn pull-left @doneButton"
                    data-task-log-id="@taskId"
                    data-system-task="@Model.TaskEditDataResult.SystemTask"
                    id="done-step">
                <i class="glyphicon glyphicon-stop"></i> Done
            </button>

        </div>
    }
    <div class="col-sm-5 pull-right">

        @if (Model.TaskEditDataResult.Status == "ACCEPTED" || Model.TaskEditDataResult.Status == "REQUESTED")
        {
            <button data-toggle="modal" data-fill-id="@ViewBag.FillId" data-id="@Model.StepId" data-target="#addNcrModal" class="btn btn-danger btn-lg print-btn pull-right"><i class="fa fa-plus-square"></i> Add NCR</button>
            <button data-toggle="modal" data-fill-id="@ViewBag.FillId" data-target="#add-new-equipment-model" class="btn btn-info btn-lg print-btn pull-right"><i class="fa fa-plus-square"></i> EM/PM</button>
        }

        @if (Model.TaskEditDataResult.RequesteeId != Model.LoggedUserIdResult.Id)
        {
            <button class="btn btn-warning btn-lg print-btn pull-right show-timer-btn" id="assume-step"><i class="glyphicon glyphicon-step-forward"></i> Take over this task</button>
        }

    </div>
</div>


@Scripts.Render("~/bundles/js/wip-step-controls")

<script type="text/javascript">
	$(document).ready(function () {

	    var fillId = @Model.FillId;
        var stepId = @Model.StepId;

		var stepControls = new StepControls();

		@if (Model.TaskRunningDto!=null)
        {
            <text>
	            $('#step-@Model.StepId .timer').timer({
		            seconds: @Math.Round(Model.TaskRunningDto?.TotalSeconds ?? 0),
		            duration: '@(Model.TaskRunningDto?.Duration ?? "0")'
	            });
            </text>

            if (Model.TaskRunningDto.StatusId == TimerStatuseConstants.InProgress)
            {
                 <text> $('#step-@Model.StepId .timer').timer('resume'); </text>
            } else if (Model.TaskRunningDto.StatusId == TimerStatuseConstants.Paused)
            {
                 <text> $('#step-@Model.StepId .timer').timer('pause'); </text>
            }
        }

		$('#@Model.StepId #pause-step').on('click', function () {
				var id = $(this).data('task-log-id');
				eLoaderOpen();
                stepControls.StepPauseClick(id, fillId, stepId);
				$('#step-@Model.StepId .timer').timer('pause');
			});

		$('#@Model.StepId #resume-step').on('click', function () {
				eLoaderOpen();
				var id = $(this).data('task-log-id');
                stepControls.StepResumeClick(id, stepId, fillId);
				$('#step-@Model.StepId .timer').timer('resume');
			});

        $('#@Model.StepId #start-step').on('click', function () {
                var parentId=@Model.ParentId;
				eLoaderOpen();
                stepControls.StepStartClick(stepId, fillId, parentId);
			});

        $('#@Model.StepId #done-step').on('click', function () {
            var parentPartId = @Model.ParentPartId;

			if ($(this).data('system-task') === 'SYS_SERIALIZE') {
			    stepControls.UpdateSerialNum(stepId, fillId, parentPartId);
			} else {
                stepControls.StepDone(stepId, fillId, parentPartId, false);
			}
	    });

		$('#@Model.StepId #assume-step').on('click', function() {
			eLoaderOpen();
            stepControls.StepAssumeClick(stepId);
		});

		$('#addNcrModal').on('hidden.bs.modal',function() {
			$(this).data('bs.modal', null);
		});

		stepControls.AddNcrModel();
		stepControls.AddNewEquipmentModel();
	});

</script>