@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "WIP Menu";
}
<link href="~/assets/css/dropzone/dropzone.min.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Work Orders <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/assets/js/plugins/bootstrap3/bootstrap-dialog.min.js"></script>
    <script type="text/javascript" src="~/assets/js/i18n/grid.locale-en.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.jqGrid.min.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.mockjax.js"></script>
    <script src="//cdn.rawgit.com/noelboss/featherlight/1.6.1/release/featherlight.min.js" type="text/javascript" charset="utf-8"></script>
    <script src="https://cdn.smooch.io/smooch.min.js"></script>
    <script src="~/assets/js/dropzone/dropzone.min.js"></script>
    <script type="text/javascript" src="~/assets/js/grids/engineer.js"></script>

    <script>
        //$.jgrid.defaults.responsive = true;
        $.jgrid.defaults.styleUI = 'Bootstrap';

        Smooch.init({ appToken: '9wxoxi2wbcbymhjf1ex1a0dux' });
        Dropzone.autoDiscover = false;
        var myDropzone = new Dropzone(
            ".dropzone",
            {
                url: "/doc/FileUploader", // Set the url
                paramName: "files",
                uploadMultiple: true,
                autoProcessQueue: false,
                parallelUploads: 10,
                init: function () {
                    this.on("success", function (file, response) {
                        if (this.getUploadingFiles().length === 0 && this.getQueuedFiles().length === 0) {
                            //alert("success");
                            console.log(response);
                        }
                    });
                    this.on("error", function (file, error) {
                        if (this.getUploadingFiles().length === 0 && this.getQueuedFiles().length === 0) {
                            console.log(error);
                            alert(error);
                        }
                    });
                }
            }
        );
        myDropzone.on('sending', function (file, xhr, formData) {
            var fillId = $("#FillID").val();
            formData.append('fillId', fillId);
        });
        function SubmitImages() {
            myDropzone.processQueue();
        }
    </script>

}
