@model Msr.Services.Orders.Messaging.WipHistoryTsrResponse

<center>WIP History Report - Work Order Item # @Model.WipHistoryDetailResult.PurchaseItemId</center>
<div id="qrcodeTable" style="margin: 35px; text-align: center;">
    <canvas width="130" height="130"></canvas>
</div><div id="qrcodeCanvas"></div>
<table class="tsrHeader">
    <tbody>
        <tr>
            <td class="tsrHeader">
                <table>
                    <tbody>
                        <tr><td class="subTitle"></td></tr>
                        <tr><td>@Model.WipHistoryDetailResult.SupplierName</td></tr>
                    </tbody>
                </table>
            </td>
            <td class="tsrHeader">
                <div>
                    <table>
                        <tbody>
                            <tr>
                                <td> @Model.WipHistoryDetailResult.ProcedureName</td>
                                <td style="padding-left: 5px; padding-right: 5px;">Rev #:</td>
                                <td>@Model.WipHistoryDetailResult.CustomerPerson</td>
                            </tr>
                        </tbody>
                    </table>@Model.WipHistoryDetailResult.FillObjectDescription<table></table>
                </div>
            </td>
        </tr>
    </tbody>
</table>
<table style="margin: auto">
    
</table>
<straighthtml>
    <table cellpadding="0" cellspacing="0" style="padding-left: 6px; padding-top: 8px; border-style: solid; border-width: 0px;">
        <tbody>
            <tr style="font-weight: bold; font-size: 15px;">
                <td style="padding-right: 5px; font-weight: bold;"> Step </td>
                <td style="padding-left: 5px;">Description</td>
                <td style="padding-left: 5px;">Latest Requestee Name</td>
                <td style="padding-left: 5px;">Actual Start Date</td>
                <td style="padding-left: 5px;">Actual Stop Date</td>
                <td style="padding-left: 5px;">Location</td>
                <td style="padding-left: 5px;">Status</td>
            </tr>
            @{
                int i = 1;
            }
            @foreach (var task in Model.WipTaskResult)
            {
                <tr>
                    <td style="text-align: right; padding-right: 5px;" align="right">@i.</td>
                    <td style="padding-left: 5px; padding-right: 5px;"><root>@task.Description </root></td>
                    <td style="padding-left: 5px; padding-right: 5px;">@task.LatestRequesteeName</td>
                    <td style="padding-left: 5px; padding-right: 5px;">@task.ActualStartDate</td>
                    <td style="padding-left: 5px; padding-right: 5px;">@task.ActualStopDate</td>
                    <td style="padding-left: 5px; padding-right: 5px;">@task.Location</td>
                    <td style="padding-left: 5px; padding-right: 5px;">@task.Status</td>
                </tr>
                i++;
                foreach (var subTask in task.WipSubTasks)
                 {
                     <tr>
                         <td></td>
                         <td colspan="6" style="padding-left: 5px;">
                             <table cellpadding="2" cellspacing="0" style="padding-top: 8px; padding-bottom: 8px; padding-left: 0">
                                 <tbody>
                                 <tr style="font-weight: bold; font-size: 12px;">
                                     <td style="border-top: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black;">Monitor @subTask.TaskId</td>
                                     <td style="border-top: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black;">Result</td>
                                     <td style="border-top: 1px solid black; border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black;">Pass / Fail</td>
                                 </tr>
                                 <tr>
                                     <td style="border-bottom: 1px solid black; border-left: 1px solid black;">@subTask.Description</td>
                                     <td style="border-bottom: 1px solid black; border-left: 1px solid black;">@subTask.PrintResult</td>
                                     <td style="border-bottom: 1px solid black; border-left: 1px solid black; border-right: 1px solid black;">@subTask.IsPassing</td>
                                 </tr>
                                 </tbody>
                             </table>
                         </td>
                     </tr>
                 }
            }
        </tbody>
    </table>
</straighthtml>
