@using Msr.Models.Tasks
@model Msr.Services.Orders.Messaging.WipStepDetailsResponse

@if (Model.HasStepRoles)
{
    if (Model.TaskEditDataResult.Status != "CLOSED")
    {
        @Html.Partial("_StepControls", Model)
    }
}

@{
    var descriptionId = "description" + Model.StepId;
    var monitorsId = "monitors" + Model.StepId;
    var filesId = "files" + Model.StepId;
    var timerInput = "hidden";

    if (Model.TaskRunningDto != null)
    {
        timerInput = "";
    }
}


<div class="row">
    @if (Model.TaskEditDataResult.Status == "CLOSED")
    {
        <div id="timer-input" class="col-sm-4 timer-input @timerInput">
            <input type="text" name="timer" class="form-control timer input-lg"  width="120">
        </div>
    }

    <div id="step-tabs" class="col-sm-12">
        <ul class="nav nav-tabs">
            <li class="active"><a data-toggle="tab" href="#@descriptionId">Task Description</a></li>
            <li><a data-toggle="tab" href="#@monitorsId">Monitors</a></li>
            <li><a data-toggle="tab" href="#@filesId">Files</a></li>
        </ul>
        <div class="tab-content">

            <div id="@descriptionId" class="tab-pane fade task-window in active">
                @Html.Partial("_InitialInspectionDetail", Model)
            </div>

            <div id="@monitorsId" class="tab-pane fade task-window">

                @*@if (Model.TaskEditDataResult.HasMonitor == true)*@
                <div class="col-sm-12">
                @Html.Partial("_MonitorsTab", Model.MonitorTemplateResult)
                </div>

                @*else
            {
                Html.RenderPartial("_AddMonitors", new MonitorTemplateResult {Step_Id = Model.StepId.ToString()});
            }*@

            </div>

            <div id="@filesId" class="tab-pane task-window fade">
                @Html.Partial("_FilesTab", Model.Images)
            </div>
        </div>
    </div>
</div>

@if (Model.TaskEditDataResult.Status == "CLOSED")
{
    <script type="text/javascript">

        @if (Model.TaskRunningDto !=null &&  Model.TaskRunningDto.Duration != "0s")
        {
            <text>
                $('#step-@Model.StepId .timer').timer({
                    seconds: @Math.Round(Model.TaskRunningDto.TotalSeconds),
                    duration: '@Model.TaskRunningDto.Duration'
                });

                $('#step-@Model.StepId .timer').timer('pause');
            </text>
        }

    </script>
}

