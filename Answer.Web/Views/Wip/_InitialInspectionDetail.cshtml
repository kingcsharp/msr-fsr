@using Answer.Web.Helpers
@model Msr.Services.Orders.Messaging.WipStepDetailsResponse
@{
    var cnt = 0;
}
<table class="table table-responsive table-bordered">
    <tbody>
        <tr>
            <th nowrap style="text-align: right; width: 180px;">Assignee: </th>
            <td>@Model.TaskEditDataResult.Assignee</td>
        </tr>
    <tr>
        <th nowrap style="text-align: right; width: 180px;">Task: </th>
        <td>
            @Html.Raw(@Model.TaskEditDataResult.StepTitle)
        </td>
    </tr>
    <tr>
        <th nowrap style="text-align: right; width: 180px;">Description: </th>
        <td>@Html.Raw(Model.TaskEditDataResult.Description)</td>
    </tr>
    <tr>
        <th nowrap style="text-align: right; width: 180px;">Related Documents: </th>
        <td>
            @if (Model.ReferenceTheories.Any())
            {
                <div class="col-lg-12">
                    @foreach (var file in Model.ReferenceTheories)
                    {
                        <span>@file.TheoryName :</span>
                        foreach (var item in file.DocLinks)
                        {
                            <div style="display:inline-block">@FilePreviewHelper.FilePreview(item.NAME, item.LINKED_DOC_ID)</div>
                        }
                        <br />
                        <hr />
                    }
                </div>
            }
        </td>
    </tr>
    
    <tr>
        <th nowrap style="text-align: right; width: 180px;">Reference Files: </th>
        <td>
            @if (Model.ReferenceFiles.Any())
            {
                <div class="col-lg-12">
                    @foreach (var file in Model.ReferenceFiles)
                    {
                        <span>@file.Name :</span>
                        <div style="display: inline-block">
                            @FilePreviewHelper.FilePreview(file.Name, file.Doc_Id)
                        </div><br/>
                    }
                </div>
            }
        </td>
    </tr>
    
    </tbody>
</table>

<script type="text/javascript">
    $(function () {
        Msr.JqGridCommon.DocPreview();
    });
</script>