@model Msr.Services.Orders.Messaging.WipStepDetailsResponse

@{
    var cnt = 0;
}

<table class="table table-responsive table-bordered">

    <tbody>
    
    <tr>
        <th nowrap style="text-align: right; width: 180px;">Assignee: </th>
        <td>@Model.TaskEditDataResult.Assignee</td>
    </tr>
    <tr>
        <td colspan=2>
            <strong>@Model.TaskEditDataResult.StepTitle</strong>
        </td>
    </tr>
    <tr>
        <td colspan=2>
            @{ var startIndex = Model.TaskEditDataResult.Description.IndexOf("<br/><br/>") + 10;}
            
            @if (Model.TaskEditDataResult.Description.Length > startIndex)
            {
                @Html.Raw(Model.TaskEditDataResult.Description.Substring(startIndex, (Model.TaskEditDataResult.Description.Length - startIndex)))
            }
            else
            {
                @Html.Raw(Model.TaskEditDataResult.Description.Substring(startIndex, (Model.TaskEditDataResult.Description.Length - startIndex)))
            }

         </td>
    </tr>

    @{
            int i = 0;
        }

        @foreach (var step in Model.TaskItemParts)
        {

            if ((step.Status == "REQUESTED" || step.Status == "ACCEPTED") && !string.IsNullOrWhiteSpace(step.Print_Order))
            {
                <tr>
                    <th nowrap style="text-align: right; width: 180px;">Assignee: </th>
                    <td>@step.LATEST_REQUESTEE_NAME</td>
                </tr>
                <tr>
                    <td colspan=2>
                        @Html.Raw(step.Description)
                    </td>
                </tr>
                if (step.SYSTEM_TASK == "SYS_SERIALIZE")
                {
                    <tr>
                        <td colspan=2>
                            @Html.Partial("_SerializeTask", step)
                        </td>
                    </tr>
                }
                if (i == 5)
                {
                    return;
                }

                i = i + 1;
            }
        }
    </tbody>
</table>
<div class="row">

    @if (Model.ReferenceFiles.Any())
    {
        <div class="col-lg-12">
            <label>Related Documents:</label>
            @foreach (var file in Model.ReferenceFiles)
            {
                <a href="#" data-toggle="modal" data-id="@file.Doc_Id" data-name="@file.Name" data-target="#relatedDocument" >@file.Name</a><br />
            }
        </div>
    }

    @if (Model.ReferenceTheories.Any())
    {
        <div class="col-lg-12">
            <label>Related Documents:</label>
            @foreach (var file in Model.ReferenceTheories)
            {
                <a href="#" data-toggle="modal" data-id="@file.TheoryId" data-name="@file.TheoryName" data-target="#relatedDocument">@file.TheoryName</a>
                <br />
            }
        </div>
    }
</div>