@model List<Msr.Services.Orders.Procedures.TaskItemPart>

@{
    var cnt = 0;


}



<table class="table table-responsive table-bordered">
    
    <tbody>
        @for (int i = 0; i < 5; i++)
        {

            if ((Model[i].Status == "REQUESTED"|| Model[i].Status == "ACCEPTED") && !string.IsNullOrWhiteSpace(Model[i].Print_Order))
            {
                <tr>
                    <th nowrap style="text-align: right; width: 180px;">Assignee: </th>
                    <td>@Model[i].LATEST_REQUESTEE_NAME</td>
                </tr>
                <tr>
                    <td colspan=2>
                        @Html.Raw(Model[i].Description)
                    </td>
                </tr>
                <tr>
                    <th nowrap style="text-align: right">Related Documents:</th>
                    <td><a target="_blank" href="../theory/viewTheory.asp?objID=&amp;ID=95845&amp;printable=trueBro">500228219 REX - Non Cu Run-Card</a></td>
                </tr>
            }
        }
   
    </tbody>
</table>