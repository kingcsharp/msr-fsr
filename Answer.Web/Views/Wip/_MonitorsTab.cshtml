@model Msr.Services.Orders.Procedures.MonitorTemplateResult
@{
    var isPassing = Model.Is_Passing.HasValue && Model.Is_Passing.Value;
    string failText = String.Empty;
}
@using (Html.BeginForm("UpdateStepMonitor", "Wip", FormMethod.Post, new { @class = "form form-horizontal", role = "form" }))
{
    @Html.HiddenFor(x => x.Id)

    @Html.HiddenFor(x => x.TheSaurusId)
    @Html.HiddenFor(x => x.StrNtLogin)
    @Html.HiddenFor(x => x.FillId)


    <div class="form-group">
        <label class="col-lg-2 control-label">Monitor Description:</label>
        <div class="col-lg-2">
            @Model.Description
        </div>
    </div>

    if (Model.Monitor_Type == "USER_NUMBER")
    {
        <div class="form-group">
            <label class="col-lg-2 control-label">Should Be:</label>
            <div class="col-lg-2">
                @Model.Should_Be
                @Html.HiddenFor(x => x.Should_Be)
            </div>
        </div>
        <div class="form-group">
            <label class="col-lg-2 control-label">Target:</label>
            <div class="col-lg-2">
                @Html.TextBoxFor(x => x.Target)
            </div>
        </div>

        <div class="form-group">
            <label class="col-lg-2 control-label">Tolerance %:</label>
            <div class="col-lg-2">
                @Html.TextBoxFor(x => x.Tolerance)
            </div>
        </div>
        <div class="form-group">
            <label class="col-lg-2 control-label">Result:</label>
            <div class="col-lg-2">
                @Html.TextBoxFor(x => x.Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
            </div>
        </div>
    }
    else if (Model.Monitor_Type == "MULTIPLE")
    {
        <div class="form-group">
            <label class="col-lg-2 control-label">Your Answer:</label>
            <div class="col-lg-2">
                @Html.DropDownListFor(x => x.Mult_Choice_Answer, Model.MonitorTemplateMultiChoices, new { @class = !isPassing ? "form-control input-validation-error" : "form-control" })
            </div>
        </div>
    }
    else if (Model.Monitor_Type == "YES_NO")
    {
        <div class="form-group">
            <label class="col-lg-2 control-label">Correct Answer:</label>
            <div class="col-lg-2" style="font-weight: bold;">
                @Model.Yes_No_Answer
            </div>
        </div>
        <div class="form-group">
            <label class="col-lg-2 control-label">Your Answer:</label>
            <div class="col-lg-2">
                @Html.DropDownListFor(x => string.IsNullOrWhiteSpace(x.Print_Result) ? "1" : x.Print_Result, Model.ResultList, new { @class = !isPassing ? "form-control input-validation-error" : "form-control" })
            </div>
        </div>
    }
    else if (Model.Monitor_Type == "NUMBER")
    {
        <div class="form-group">
            <label class="col-lg-2 control-label">Should Be:</label>
            <div class="col-lg-2">
                @Model.Should_Be
            </div>
        </div>
        if (!string.IsNullOrWhiteSpace(Model.Highest_Threshold))
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">HIGHEST_THRESHOLD:</label>
                <div class="col-lg-2">
                    @Model.Highest_Threshold
                </div>
            </div>
        }
        if (!string.IsNullOrWhiteSpace(Model.High_Threshold))
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">HIGH_THRESHOLD:</label>
                <div class="col-lg-2">
                    @Model.High_Threshold
                </div>
            </div>
        }
        if (!string.IsNullOrWhiteSpace(Model.Target))
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Target:</label>
                <div class="col-lg-2" style="font-weight: bold;">
                    @Model.Target
                </div>
            </div>
        }
        if (!string.IsNullOrWhiteSpace(Model.Low_Threshold))
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">LOW_THRESHOLD:</label>
                <div class="col-lg-2">
                    @Model.Low_Threshold
                </div>
            </div>
        }
        if (!string.IsNullOrWhiteSpace(Model.Lowest_Threshold))
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">LOWEST_THRESHOLD:</label>
                <div class="col-lg-2">
                    @Model.Lowest_Threshold
                </div>
            </div>
        }

        <div class="form-group">
            <label class="col-lg-2 control-label">Result:</label>
            <div class="col-lg-2">
                @Html.TextBoxFor(x => x.Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
            </div>
        </div>
    }
    else if (Model.Monitor_Type == "TEXT")
    {
        if (!string.IsNullOrWhiteSpace(Model.Target))
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Target:</label>
                <div class="col-lg-2" style="font-weight: bold;">
                    @Model.Target
                </div>
            </div>
        }
        else
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Target:</label>
                <div class="col-lg-2" style="font-weight: bold;">
                    BLANK -- Should be entered as a blank
                </div>
            </div>
        }

        <div class="form-group">
            <label class="col-lg-2 control-label">Result:</label>
            <div class="col-lg-2">
                @Html.TextBoxFor(x => x.Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
            </div>
        </div>
    }
    <div class="form-group">
        <label class="col-lg-2 control-label">Comments:</label>
        <div class="col-lg-2">
            @Html.TextAreaFor(x => x.Comment, new { @class = "form-control" })
        </div>
    </div>

    <hr />

    <div class="form-group">
        <label class="col-lg-2 control-label">Monitor #:</label>
        <div class="col-lg-2">
            1
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">Monitor Type:</label>
        <div class="col-lg-2">
            @Model.Monitor_Type
        </div>
    </div>

    <div class="form-group">
        <label class="col-lg-2 control-label">
            If fails:
        </label>
        <div class="col-lg-2">
            @if (!string.IsNullOrWhiteSpace(Model.Fail_Action))
            {
                failText = Model.FailActionList.Single(x => x.Value == Model.Fail_Action).Text;
            }
            @failText
        </div>
    </div>

    if (!string.IsNullOrWhiteSpace(Model.Step_Id))
    {
        <div class="form-group">
            <label class="col-lg-2 control-label">
                Proc Step Num
            </label>
            <div class="col-lg-2">
                @Model.Step_Id
            </div>
        </div>
    }

    if (Model.Opinion != 0)
    {
        <div class="form-group">
            <label class="col-lg-2 control-label">
            </label>
            <div class="col-lg-8">
                This Monitor is based on Opinion
            </div>
        </div>
    }

    if (Model.Use_Result != 0)
    {
        <div class="form-group">
            <label class="col-lg-2 control-label">
            </label>
            <div class="col-lg-8">
                This Monitor uses its result to match cases
            </div>
        </div>
    }

    if (Model.Hide_Target != 0)
    {
        <div class="form-group">
            <label class="col-lg-2 control-label">
            </label>
            <div class="col-lg-8">
                This Monitor will not show the user the target at entry time
            </div>
        </div>
    }

    <div class="form-group">
        <label class="col-lg-2 control-label">
            Fault Handling
        </label>
        <div class="col-lg-8">
            @Html.DropDownListFor(x => x.Fail_Action, Model.FailActionList, new { @class = "form-control" })
        </div>
    </div>

    <div class="row">
        <input class="btn-info" value="Save" type="submit"/>
        <input class="btn-info" id="monitor-save-close" value="Save & Close Task" type="button" />
    </div>
}
<script>
    $("#monitor-save-close").on('click', function () {
        debugger;
        var form = $(this).parents('form:first');
        $.ajax({
            type: "POST",
            url: "/wip/UpdateStepMonitorAndClose",
            dataType: 'json',
            data: form.serialize(),
            success: function (data) {
                location.reload();
            },
            error: function () {

            }
        });
    });
</script>