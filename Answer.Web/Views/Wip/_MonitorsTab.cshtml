@model List<Msr.Services.Orders.Procedures.MonitorTemplateResult>
<style>
    .red {
        background-color: red;
    }
    .form-horizontal .control-label {
        padding-top: 0px;
    }
</style>

@using (Html.BeginForm("UpdateStepMonitor", "Wip", FormMethod.Post, new { @class = "form form-horizontal", role = "form" }))
{

    for (int i = 0; i < Model.Count; i++)
    {
        var isPassing = Model[i].Is_Passing.HasValue && Model[i].Is_Passing.Value;
        string failText = String.Empty;


        @Html.HiddenFor(x => Model[i].Id)

        @Html.HiddenFor(x => Model[i].TheSaurusId)
        @Html.HiddenFor(x => Model[i].StrNtLogin)
        @Html.HiddenFor(x => Model[i].FillId)
        @Html.HiddenFor(x => Model[i].TASK_ID)
        @Html.HiddenFor(x => Model[i].Monitor_Type)

        <div class="form-group">
            <label class="col-lg-2 control-label">Monitor #:</label>
            <div class="col-lg-2">
                @i
            </div>
        </div>

        <div class="form-group">
            <label class="col-lg-2 control-label">Monitor Type:</label>
            <div class="col-lg-2">
                @Model[i].Monitor_Type
            </div>
        </div>

        if (Model[i].Monitor_Type == "USER_NUMBER")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Should Be:</label>
                <div class="col-lg-2">
                    @Model[i].Should_Be
                    @Html.HiddenFor(x => Model[i].Should_Be)
                </div>
            </div>
            <div class="form-group">
                <label class="col-lg-2 control-label">Target:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => Model[i].Target)
                </div>
            </div>

            <div class="form-group">
                <label class="col-lg-2 control-label">Tolerance %:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => Model[i].Tolerance)
                </div>
            </div>
            <div class="form-group">
                <label class="col-lg-2 control-label">Result:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
                </div>
            </div>
        }
        else if (Model[i].Monitor_Type == "MULTIPLE")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Your Answer:</label>
                <div class="col-lg-2">
                    @Html.DropDownListFor(x => Model[i].Mult_Choice_Answer, Model[i].MonitorTemplateMultiChoices, new { @class = !isPassing ? "form-control input-validation-error" : "form-control" })
                </div>
            </div>
        }
        else if (Model[i].Monitor_Type == "YES_NO")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Correct Answer:</label>
                @if (@Model[i].Yes_No_Answer == "1")
                {
                    <div class="col-lg-2" style="font-weight: bold;">
                        YES
                    </div>
                }
                else
                {
                    <div class="col-lg-2" style="font-weight: bold;">
                        No
                    </div>
                }
            </div>
            <div class="form-group">
                <label class="col-lg-2 control-label">Your Answer:</label>
                <div class="col-lg-2">
                    @if (Model[i].Yes_No_Answer == Model[i].Print_Result)
                    {
                        @Html.DropDownListFor(x => Model[i].Print_Result, Model[i].ResultList, new { @class = "form-control" })
                    }
                    else
                    {
                        @Html.DropDownListFor(x => Model[i].Print_Result, Model[i].ResultList, new { @class = "form-control red" })
                    }
                </div>
            </div>
        }
        else if (Model[i].Monitor_Type == "NUMBER")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Should Be:</label>
                <div class="col-lg-2">
                    @Model[i].Should_Be
                </div>
            </div>
            if (!string.IsNullOrWhiteSpace(Model[i].Highest_Threshold))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">HIGHEST_THRESHOLD:</label>
                    <div class="col-lg-2">
                        @Model[i].Highest_Threshold
                    </div>
                </div>
            }
            if (!string.IsNullOrWhiteSpace(Model[i].High_Threshold))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">HIGH_THRESHOLD:</label>
                    <div class="col-lg-2">
                        @Model[i].High_Threshold
                    </div>
                </div>
            }
            if (!string.IsNullOrWhiteSpace(Model[i].Target))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">Target:</label>
                    <div class="col-lg-2" style="font-weight: bold;">
                        @Model[i].Target
                    </div>
                </div>
            }
            if (!string.IsNullOrWhiteSpace(Model[i].Low_Threshold))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">LOW_THRESHOLD:</label>
                    <div class="col-lg-2">
                        @Model[i].Low_Threshold
                    </div>
                </div>
            }
            if (!string.IsNullOrWhiteSpace(Model[i].Lowest_Threshold))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">LOWEST_THRESHOLD:</label>
                    <div class="col-lg-2">
                        @Model[i].Lowest_Threshold
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="col-lg-2 control-label">Result:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
                </div>
            </div>
        }
        else if (Model[i].Monitor_Type == "TEXT")
        {
            if (!string.IsNullOrWhiteSpace(Model[i].Text_Target))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">Target:</label>
                    <div class="col-lg-2" style="font-weight: bold;">
                        @Model[i].Text_Target
                    </div>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">Target:</label>
                    <div class="col-lg-2" style="font-weight: bold;">
                        BLANK -- Should be entered as a blank
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="col-lg-2 control-label">Result:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
                </div>
            </div>
        }
    
        if (Model[i].Monitor_Type == "EQUIPMENT")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Target:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => Model[i].Target, new { @class = "form-control monitorTemplate_Target" })
                </div>
            </div>
        }

        <div class="form-group">
            <label class="col-lg-2 control-label">
                If fails:
            </label>
            <div class="col-lg-2">
                @if (!string.IsNullOrWhiteSpace(Model[i].Fail_Action))
                {
                    failText = Model[i].FailActionList.Single(x => x.Value == Model[i].Fail_Action).Text;
                }
                @failText
            </div>
        </div>

        if (Model[i].Step_Id != null && int.Parse(Model[i].Step_Id) > 0)
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">
                    Proc Step Num
                </label>
                <div class="col-lg-2">
                    @Model[i].Step_Id
                </div>
            </div>
        }

        if (Model[i].Opinion != 0)
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">
                </label>
                <div class="col-lg-8">
                    This Monitor is based on Opinion
                </div>
            </div>
        }

        if (Model[i].Use_Result != 0)
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">
                </label>
                <div class="col-lg-8">
                    This Monitor uses its result to match cases
                </div>
            </div>
        }

        if (Model[i].Hide_Target != 0)
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">
                </label>
                <div class="col-lg-8">
                    This Monitor will not show the user the target at entry time
                </div>
            </div>
        }

        <div class="form-group">
            <label class="col-lg-2 control-label">
                Fault Handling
            </label>
            <div class="col-lg-8">
                @Html.DropDownListFor(x => Model[i].Fail_Action, Model[i].FailActionList, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group">
            <label class="col-lg-2 control-label">Comments:</label>
            <div class="col-lg-2">
                @Html.TextAreaFor(x => Model[i].Comment, new { @class = "form-control" })
            </div>
        </div>

    }
    if (Model.Count > 0)
    {
        <div class="row">
            <div class="col-lg-offset-2 col-lg-8">
                <input class="btn btn-info" value="Save" type="submit" />
                <input class="btn btn-info monitor-save-close" id="monitor-save-close" value="Save & Close Task" type="button" />
            </div>
        </div>
    }

}
<script>
    $(".monitor-save-close").on('click', function () {
        var form = $(this).parents('form:first');
        eLoaderOpen()
        $.ajax({
            type: "POST",
            url: "/wip/UpdateStepMonitorAndClose",
            dataType: 'json',
            data: form.serialize(),
            success: function (data) {
                location.reload();
            },
            error: function (error) {
                eLoaderError(error)
            }
        });
    });
    $(".monitorTemplate_Target").on('change', function () {
        var textbox = $(this);
        var value = $(this).val();
        //alert(value);
        eLoaderOpen()
        $.ajax({
            type: "POST",
            url: "@Url.Action("CheckEquipmentStatusById", "Wip")",
            dataType: 'json',
            data: { 'Id': value },
            success: function(data) {
                if (data.CanUsed == false) {
                    eModal.alert(data.ErrorMessage);
                    textbox.val('');
                } else {
                    eLoaderClose()
                }                
            },
            error: function(error) {
                eLoaderError(error)
            }
    });
    });
    $('.select').select2();
</script>
