@model Msr.Services.Orders.Procedures.MonitorTemplateResult
<div class="row">
    <div class="col-md-4">Monitor Description:</div>
    <div class="col-md-8">@Model.Description</div>
    <div class="col-md-4">Target:</div>
    <div class="col-md-8">@(Model.Target ?? "Yes")</div>
    <div class="col-md-4">Result:</div>
    <div class="col-md-8">@Model.PrintResult</div>
    <div class="col-md-4">Comment:</div>
    <div class="col-md-8"> @Html.TextAreaFor(x => x.Description)</div>
</div>

<div class="row">
    <div class="col-md-4">Monitor #:</div>
    <div class="col-md-8">1</div>
    <div class="col-md-4">Monitor Type:</div>
    <div class="col-md-8">@Model.MonitorType.Replace("_", "/")</div>
    <div class="col-md-4">If fails:</div>
    <div class="col-md-8">@Model.FailAction</div>
    <div class="col-md-4">Fault Handling:</div>
    <div class="col-md-8">@Model.FailAction</div>
</div>