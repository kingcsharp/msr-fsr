@model List<Msr.Services.Orders.Procedures.MonitorTemplateResult>

<link href="~/assets/css/step-monitor.css" rel="stylesheet" />
<style>
    .red {
        background-color: red;
    }
</style>

@using (Html.BeginForm("UpdateStepMonitor", "Wip", FormMethod.Post, new { @class = "form form-horizontal", role = "form" }))
{
    <div class="row">
        @for (var i = 0; i < Model.Count; i++)
        {
            var isPassing = Model[i].Is_Passing.HasValue && Model[i].Is_Passing.Value;
            var failText = string.Empty;

            <div class="col-sm-4 mon-panel">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        @if (!string.IsNullOrWhiteSpace(Model[i].Description))
                        {
                            @Model[i].Description
                        }
                        else
                        {
                            <span>Monitor @(i + 1)</span>

                        }
                    </div>
                    <div class="panel-body monitor-body">
                        @Html.HiddenFor(x => Model[i].Id)
                        @Html.HiddenFor(x => Model[i].TheSaurusId)
                        @Html.HiddenFor(x => Model[i].StrNtLogin)
                        @Html.HiddenFor(x => Model[i].FillId, new { @Id = "fillid" })
                        @Html.HiddenFor(x => Model[i].Step_Id, new { @Id = "stepid" })
                        @Html.HiddenFor(x => Model[i].Ph_Step_Id, new { @Id = "phstepid" })
                        @Html.HiddenFor(x => Model[i].TASK_ID)
                        @Html.HiddenFor(x => Model[i].Monitor_Type)
                        @Html.HiddenFor(x => Model[i].Input_Type)
                        @Html.HiddenFor(x => Model[i].Monitor_Result_ID)
                        @Html.HiddenFor(x => Model[i].SEND_NCR_NOTIFICATION_EMAIL, new { @Id = "sendemailclient" })

                        <div class="form-group monitor-form">
                            <table class="table table-condensed" width="100%" border="0">
                                <tbody>
                                    <tr>
                                        <td class="nw-rght"><label class="control-label">Monitor #:</label></td>
                                        <td class="text-td">@(i + 1)</td>
                                    </tr>
                                    <tr>
                                        <td class="nw-rght"><label class="control-label">Monitor Type:</label></td>
                                        <td class="text-td">@Model[i].Monitor_Type</td>
                                    </tr>
                                    @if (Model[i].Monitor_Type == "USER_NUMBER")
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Target:</label></td>
                                            <td class="text-td">
                                                @Html.HiddenFor(x => Model[i].Should_Be)
                                                @Html.TextBoxFor(x => Model[i].Target)
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Tolerance %:</label></td>
                                            <td class="text-td">
                                                @Html.TextBoxFor(x => Model[i].Tolerance)
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Result :</label></td>
                                            <td class="text-td">
                                                @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "input-validation-error form-control" : "form-control" })
                                            </td>
                                        </tr>
                                    }
                                    else if (Model[i].Monitor_Type == "MULTIPLE")
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Your Answer:</label></td>
                                            <td class="text-td">
                                                @Html.DropDownListFor(x => Model[i].Mult_Choice_Answer, Model[i].MonitorTemplateMultiChoices, new { @class = !isPassing ? "form-control input-validation-error" : "form-control" })
                                            </td>
                                        </tr>
                                    }
                                    else if (Model[i].Monitor_Type == "YES_NO")
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Correct Answer</label></td>
                                            <td class="text-td">
                                                <div class="col-lg-2" style="font-weight: bold;">
                                                    @Html.HiddenFor(x => Model[i].Yes_No_Answer, new { @id = "yes-no-answer" })
                                                    @if (@Model[i].Yes_No_Answer == "1")
                                                    {
                                                        <text>YES</text>
                                                    }
                                                    else
                                                    {
                                                        <text>NO</text>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Your Answer:</label></td>
                                            <td class="text-td">
                                                @Html.DropDownListFor(x => Model[i].Print_Result, Model[i].ResultList, new { @class = "form-control", @id = "yes-no-monitor" })
                                            </td>
                                        </tr>
                                    }
                                    else if (Model[i].Monitor_Type == "NUMBER")
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Should be:</label></td>
                                            @if (Model[i].Should_Be == "BETWEEN")
                                            {
                                                <td class="text-td">
                                                    Between @Model[i].Lowest_Threshold and @Model[i].Highest_Threshold
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="text-td">
                                                    @Model[i].Should_Be  To @Model[i].Target
                                                </td>
                                            }
                                        </tr>

                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Result:</label></td>
                                            <td class="text-td">
                                                @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "input-validation-error form-control number" : "form-control number" })
                                                <span id="print-result-message"></span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="nw-rght"><label class="control-label"></label></td>
                                            <td class="text-td"></td>
                                        </tr>
                                    }
                                    else if (Model[i].Monitor_Type == "TEXT")
                                    {
                                        if (!string.IsNullOrWhiteSpace(Model[i].Text_Target))
                                        {
                                            <tr>
                                                <td class="nw-rght"><label class="control-label">Target:</label></td>
                                                <td class="text-td">
                                                    @Model[i].Text_Target
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Result:</label></td>
                                            <td class="text-td">
                                                @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "input-validation-error form-control" : "form-control" })
                                            </td>
                                        </tr>
                                    }
                                    else if (Model[i].Monitor_Type == "YES_NO")
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Correct Answer</label></td>
                                            <td class="text-td">
                                                <div class="col-lg-2" style="font-weight: bold;">
                                                    @Html.HiddenFor(x => Model[i].Yes_No_Answer, new { @id = "yes-no-answer" })
                                                    @if (@Model[i].Yes_No_Answer == "1")
                                                    {
                                                        <text>YES</text>
                                                    }
                                                    else
                                                    {
                                                        <text>NO</text>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Your Answer:</label></td>
                                            <td class="text-td">
                                                @Html.DropDownListFor(x => Model[i].Print_Result, Model[i].ResultList, new { @class = "form-control", @id = "yes-no-monitor" })
                                            </td>
                                        </tr>
                                    }
                                    else if (Model[i].Monitor_Type == "SELECT")
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">List Source:</label></td>
                                            <td class="text-td">
                                                <div style="font-weight: bold;">
                                                    @if (Model[i].List_Source?.Trim().ToUpper() == "NCR_CATEGORY" || Model[i].List_Source?.Trim().ToUpper() == "NCR_CATEGORIES")
                                                    {
                                                        <text>NCR Category</text>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Select:</label></td>
                                            <td class="text-td">
                                                @if (Model[i].List_Source?.Trim().ToUpper() == "NCR_CATEGORY" || Model[i].List_Source?.Trim().ToUpper() == "NCR_CATEGORIES")
                                                {
                                                    @Html.DropDownListFor(x => Model[i].Print_Result, new SelectList(Model[i].NCRCategoryList, "Value", "Text", Model[i].Print_Result), "Select Category", new { @class = "form-control", @id = "list-ncr-category" })
                                                }
                                            </td>
                                        </tr>
                                    }
                                    else if (Model[i].Monitor_Type?.Trim().ToUpper() == "EQUIPMENT" && Model[i].Input_Type?.Trim().ToUpper() == "SENSOR")
                                    {

                                        <tr>
                                            @if (Model[i].SENSOR_MAPPING_ID > 0)
                                            {
                                            <tr>
                                                <td class="nw-rght"><label class="control-label">Note:</label></td>
                                                <td class="text-td">
                                                    <div style="font-weight: bold; color: red;">This Monitor has already been saved and is in read-only mode.</div>
                                                </td>
                                            </tr>
                                        }

                                        <td class="nw-rght"><label class="control-label">Sensor Name:</label></td>
                                        <td class="text-td">
                                            @if (Model[i].SensorDataModels != null && Model[i].SensorDataModels.Any())
                                            {
                                                if (Model[i].SENSOR_MAPPING_ID > 0)  // if (string.IsNullOrWhiteSpace(Model[i].Print_Result) == false)
                                                {
                                                    @Html.DropDownListFor(x => Model[i].SensorMappingID, new SelectList(Model[i].SensorDataModels, "SensorMappingID", "SiteSensorName", Model[i].SENSOR_MAPPING_ID), "Select Sensor", new { @class = "form-control", @id = "equipment-sensor-list", @readonly = "", @disabled = "" })
                                                }
                                                else
                                                {
                                                    @Html.DropDownListFor(x => Model[i].SensorMappingID, new SelectList(Model[i].SensorDataModels, "SensorMappingID", "SiteSensorName", Model[i].SENSOR_MAPPING_ID), "Select Sensor", new { @class = "form-control", @id = "equipment-sensor-list" })
                                                }
                                            }
                                            else
                                            {
                                                <text>No sensors retrieved for this Site.</text>
                                            }
                                        </td>
                                        </tr>

                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Sensor Value:</label></td>
                                            <td class="text-td">
                                                <span id="spanSensorValue">@Model[i].Print_Result</span>&nbsp;&nbsp;&nbsp;
                                                @if (Model[i].SENSOR_MAPPING_ID == null || Model[i].SENSOR_MAPPING_ID <= 0)
                                                {
                                                    <i class="fas fa-sync" onclick="UpdateSensorCurrentValue();" style="cursor: pointer;"></i>
                                                }
                                            </td>
                                        </tr>

                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Target Value:</label></td>
                                            @if (Model[i].Should_Be == "EQUAL")
                                            {
                                                <td class="text-td">
                                                    Equal to @Model[i].Target
                                                </td>
                                            }
                                            else if (Model[i].Should_Be == "BELOW")
                                            {
                                                <td class="text-td">
                                                    Below @Model[i].Target
                                                </td>
                                            }
                                            else if (Model[i].Should_Be == "ABOVE")
                                            {
                                                <td class="text-td">
                                                    Above @Model[i].Target
                                                </td>
                                            }
                                            else if (Model[i].Should_Be == "BETWEEN")
                                            {
                                                <td class="text-td">
                                                    Between @Model[i].Lowest_Threshold and @Model[i].Highest_Threshold
                                                </td>
                                            }
                                        </tr>

                                        <tr class="equipmentresult">
                                            <td class="nw-rght">
                                                <label class="control-label">Result:</label>
                                            </td>
                                            <td class="text-td">
                                                @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "form-control input-validation-error" : String.Empty, @id = "equipment-sensor-result", @readonly = "true" })
                                                <span id="print-result-message"></span>
                                            </td>
                                        </tr>
                                    }
                                    else if (Model[i].Monitor_Type == "EQUIPMENT")
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Target Value:</label></td>
                                            <td class="text-td">
                                                @Model[i].Target
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Target:</label></td>
                                            <td class="text-td">
                                                @Html.TextBoxFor(x => Model[i].Target_Object, new { @class = "form-control monitorTemplate_Target" })
                                            </td>
                                        </tr>
                                        <tr class="equipmentresult">
                                            <td class="nw-rght">
                                                <label class="control-label">Result:</label>
                                            </td>
                                            <td class="text-td">
                                                @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "form-control input-validation-error" : String.Empty, @id = "equipment" })
                                                <span id="print-result-message"></span>
                                            </td>
                                        </tr>
                                    }

                                    <tr>
                                        <td class="nw-rght"><label class="control-label">If fails:</label></td>
                                        <td class="text-td">
                                            @if (!string.IsNullOrWhiteSpace(Model[i].Fail_Action))
                                            {
                                                failText = Model[i].FailActionList.Single(x => x.Value == Model[i].Fail_Action).Text;
                                                @Html.HiddenFor(x => Model[i].Fail_Action, Model[i].FailActionList)
                                            }
                                            @failText
                                        </td>
                                    </tr>
                                    @if (Model[i].Monitor_Type == "PASS_FAIL")
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Target:</label></td>
                                            <td class="text-td">
                                                @Model[i].Target_Object
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="nw-rght"><label class="control-label">Result:</label></td>
                                            <td class="text-td">
                                                @Html.TextBoxFor(x => Model[i].Print_Result, new { @class = !isPassing ? "input-validation-error form-control" : "form-control" })
                                            </td>
                                        </tr>
                                    }

                                    @if (Model[i].Opinion != 0)
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label"></label></td>
                                            <td class="text-td">
                                                This Monitor is based on Opinion
                                            </td>
                                        </tr>
                                    }
                                    @if (Model[i].Use_Result != 0)
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label"></label></td>
                                            <td class="text-td">
                                                This Monitor uses its result to match cases
                                            </td>
                                        </tr>
                                    }
                                    @if (Model[i].Hide_Target != 0)
                                    {
                                        <tr>
                                            <td class="nw-rght"><label class="control-label"></label></td>
                                            <td class="text-td">
                                                This Monitor will not show the user the target at entry time
                                            </td>
                                        </tr>
                                    }
                                    <tr>
                                        <td class="nw-rght"><label class="control-label">Comments:</label></td>
                                        <td>
                                            @if (Model[i].SENSOR_MAPPING_ID > 0)
                                            {
                                                @Html.TextAreaFor(x => Model[i].Comment, new { @class = "form-control", @readonly = "" })
                                            }
                                            else
                                            {
                                                @Html.TextAreaFor(x => Model[i].Comment, new { @class = "form-control", placeholder = "Comments to send in Email..." })
                                            }
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
    </div>
    if (Model.Count > 0 && !ViewBag.IsStepStatusClosed && ViewBag.HasStepRoles == true)
    {
        <div class="row">
            <div class="col-lg-offset-1 col-lg-8">
                <input class="btn btn-info monitor-save" value="Save" type="button" />
                <input class="btn btn-info monitor-save-close" id="monitor-save-close" data-stepid="@Model.FirstOrDefault().Step_Id" value="Save & Close Task" type="button" />
            </div>
        </div>
    }
}

<script type="text/javascript">

    $(document).ready(function () {

        ApplyCssForMonitor($('#yes-no-monitor'));

        // UpdateSensorCurrentValue();

        $('#yes-no-monitor').change(function () {
            ApplyCssForMonitor($(this));
        });

        // $('.equipmentresult').hide();

        $(".number").on("keyup keypress blur change",function (e) {
            if (isNaN($(this).val())) {
                $("#print-result-message").html("Please enter a number").show().fadeOut(1200);
                $(this).val('');
            }
        });

        $("#equipment").keypress(function (e) {
            if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                $("#print-result-message").html("Please enter a number").show().fadeOut("slow");
                return false;
            }
        });

    });

    $("#equipment-sensor-list").on('change', function () {
        UpdateSensorCurrentValue();
    });

    function UpdateSensorCurrentValue() {
        var sensorMappingID = $("#equipment-sensor-list").val();

        if (sensorMappingID != null && sensorMappingID != '' && sensorMappingID >= 1) {
            eLoaderOpen();

            $.ajax({
                type: "POST",
                url: "@Url.Action("GetSensorCurrentValue", "Wip")",
                dataType: 'json',
                data: { 'sensorMappingID': sensorMappingID },
                success: function (data) {
                    $('#spanSensorValue').text(data.SensorCurrentValue);
                    $('#equipment-sensor-result').val(data.SensorCurrentValue);
                    eLoaderClose();
                },
                error: function (error) {
                    $('#spanSensorValue').text("");
                    $('#equipment-sensor-result').val("");
                    eLoaderError(error);
                }
            });
        }
    }

    $(".monitor-save").on('click', function () {
        var form = $(this).parents('form:first');
        var taskId =form.find('input[name="[0].TASK_ID"]').val();

        eLoaderOpen();

        $.ajax({
            type: "POST",
            url: "/wip/UpdateStepMonitor",
            dataType: 'json',
            data: form.serialize(),
            success: function(response) {

                if (response.ErrorMessage !== '') {
                    eLoaderError(response.ErrorMessage);
                } else {
                    eLoaderClose();
                    var currentStep = $('#carousel ul.slides').find('[data-stepid="' + taskId + '"]');
                    $(currentStep).trigger("click");
                }
            },
            error: function(error) {
                eLoaderError(error);
            }
        });
    });

    $(".monitor-save-close").on('click', function (args) {
        var form = $(this).parents('form:first');

        eLoaderOpen();

        $.ajax({
            type: "POST",
            url: "/wip/UpdateStepMonitorAndClose",
            dataType: 'json',
            data: form.serialize(),
            success: function (data) {
                if (data === 'OK') {

                    if ($('#'+args.currentTarget.dataset['stepid']).find('.sendncremailnotification').val() === "True") {
                        var fillId = $('body').find('#fillid').val();
                        var stepId = $('body').find('#stepid').val();
                        var phStepId = $('body').find('#phstepid').val();

                        $.ajax({
                            type: "GET",
                            url: "/wip/GetNcrNotificationModal?fillId=" + fillId + "&stepId="+stepId+ "&phStepId=" + phStepId,
                            dataType: 'html',
                            success: function (data) {

                                $("#notifyCustomerNcrWasAddedModal").find('.modal-body').html(data);
                                eLoaderClose();
                                $("#notifyCustomerNcrWasAddedModal").modal("show");
                                $("#notifyCustomerNcrWasAddedModal").find('#sendncremailnotification').on('click',
                                    function () {

                                        eLoaderOpen();
                                        $("#ncrnotificatioemail").submit();

                                    });

                                $("#cancelncremailnotification").find("#cancelncremailnotification").on('click', 
                                    function() {

                                        window.reload();
                                    });

                            },
                            error: function (error) {

                                eLoaderError(error);
                            }
                        });
                    } else {

                        location.reload();

                    }


                } else {
                    eLoaderError(data);
                }
            },
            error: function (error) {

                eLoaderError(error);
            }
        });
    });

    $(".monitorTemplate_Target").on('change', function () {
        var textbox = $(this);
        var value = $(this).val();

        eLoaderOpen();

        $.ajax({
            type: "POST",
            url: "@Url.Action("CheckEquipmentStatusById", "Wip")",
            dataType: 'json',
            data: { 'Id': value },
            success: function(data) {
                if (data.CanUsed === false) {
                    eLoaderError(data.ErrorMessage);
                    textbox.val('');
                    $('.equipmentresult').hide();
                } else {
                    eLoaderClose();
                    $('.equipmentresult').show();
                }
            },
            error: function(error) {
                eLoaderError(error);
            }
        });
    });

    $('.select').select2();

    function ApplyCssForMonitor(target) {
        if (target.val() !== $('#yes-no-answer').val()) {
            target.addClass('red');
        } else {
            target.removeClass('red');
        }
    }

</script>
