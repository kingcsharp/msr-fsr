@model List<Msr.Services.Orders.Procedures.MonitorTemplateResult>
@{
    int i = 1;
}
<style>
    .red {
        background-color: red;
    }
</style>
@foreach (var monitorTemplate in Model)
{
    var isPassing = monitorTemplate.Is_Passing.HasValue && monitorTemplate.Is_Passing.Value;
    string failText = String.Empty;

    using (Html.BeginForm("UpdateStepMonitor", "Wip", FormMethod.Post, new { @class = "form form-horizontal", role = "form" }))
    {
        @Html.HiddenFor(x => monitorTemplate.Id)

        @Html.HiddenFor(x => monitorTemplate.TheSaurusId)
        @Html.HiddenFor(x => monitorTemplate.StrNtLogin)
        @Html.HiddenFor(x => monitorTemplate.FillId)
        @Html.HiddenFor(x => monitorTemplate.Task_Id)


        <div class="form-group">
            <label class="col-lg-2 control-label">Monitor Description:</label>
            <div class="col-lg-2">
                @monitorTemplate.Description
            </div>
        </div>

        if (monitorTemplate.Monitor_Type == "USER_NUMBER")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Should Be:</label>
                <div class="col-lg-2">
                    @monitorTemplate.Should_Be
                    @Html.HiddenFor(x => monitorTemplate.Should_Be)
                </div>
            </div>
            <div class="form-group">
                <label class="col-lg-2 control-label">Target:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => monitorTemplate.Target)
                </div>
            </div>

            <div class="form-group">
                <label class="col-lg-2 control-label">Tolerance %:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => monitorTemplate.Tolerance)
                </div>
            </div>
            <div class="form-group">
                <label class="col-lg-2 control-label">Result:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => monitorTemplate.Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
                </div>
            </div>
        }
        else if (monitorTemplate.Monitor_Type == "MULTIPLE")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Your Answer:</label>
                <div class="col-lg-2">
                    @Html.DropDownListFor(x => monitorTemplate.Mult_Choice_Answer, monitorTemplate.MonitorTemplateMultiChoices, new { @class = !isPassing ? "form-control input-validation-error" : "form-control" })
                </div>
            </div>
        }
        else if (monitorTemplate.Monitor_Type == "YES_NO")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Correct Answer:</label>
                @if (@monitorTemplate.Yes_No_Answer == "1")
                {
                    <div class="col-lg-2" style="font-weight: bold;">
                        YES
                    </div>
                }
                else
                {
                    <div class="col-lg-2" style="font-weight: bold;">
                        No
                    </div>
                }
            </div>
            <div class="form-group">
                <label class="col-lg-2 control-label">Your Answer:</label>
                <div class="col-lg-2">
                    @if (monitorTemplate.Yes_No_Answer == monitorTemplate.Print_Result)
                    {
                        @Html.DropDownListFor(x => monitorTemplate.Print_Result, monitorTemplate.ResultList, new { @class = "form-control" })
                    }
                    else
                    {
                        @Html.DropDownListFor(x => monitorTemplate.Print_Result, monitorTemplate.ResultList, new { @class = "form-control red" })
                    }
                </div>
            </div>
        }
        else if (monitorTemplate.Monitor_Type == "NUMBER")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Should Be:</label>
                <div class="col-lg-2">
                    @monitorTemplate.Should_Be
                </div>
            </div>
            if (!string.IsNullOrWhiteSpace(monitorTemplate.Highest_Threshold))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">HIGHEST_THRESHOLD:</label>
                    <div class="col-lg-2">
                        @monitorTemplate.Highest_Threshold
                    </div>
                </div>
            }
            if (!string.IsNullOrWhiteSpace(monitorTemplate.High_Threshold))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">HIGH_THRESHOLD:</label>
                    <div class="col-lg-2">
                        @monitorTemplate.High_Threshold
                    </div>
                </div>
            }
            if (!string.IsNullOrWhiteSpace(monitorTemplate.Target))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">Target:</label>
                    <div class="col-lg-2" style="font-weight: bold;">
                        @monitorTemplate.Target
                    </div>
                </div>
            }
            if (!string.IsNullOrWhiteSpace(monitorTemplate.Low_Threshold))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">LOW_THRESHOLD:</label>
                    <div class="col-lg-2">
                        @monitorTemplate.Low_Threshold
                    </div>
                </div>
            }
            if (!string.IsNullOrWhiteSpace(monitorTemplate.Lowest_Threshold))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">LOWEST_THRESHOLD:</label>
                    <div class="col-lg-2">
                        @monitorTemplate.Lowest_Threshold
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="col-lg-2 control-label">Result:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => monitorTemplate.Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
                </div>
            </div>
        }
        else if (monitorTemplate.Monitor_Type == "TEXT")
        {
            if (!string.IsNullOrWhiteSpace(monitorTemplate.Text_Target))
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">Target:</label>
                    <div class="col-lg-2" style="font-weight: bold;">
                        @monitorTemplate.Text_Target
                    </div>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label class="col-lg-2 control-label">Target:</label>
                    <div class="col-lg-2" style="font-weight: bold;">
                        BLANK -- Should be entered as a blank
                    </div>
                </div>
            }

            <div class="form-group">
                <label class="col-lg-2 control-label">Result:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => monitorTemplate.Print_Result, new { @class = !isPassing ? "input-validation-error" : String.Empty })
                </div>
            </div>
        }
        <div class="form-group">
            <label class="col-lg-2 control-label">Comments:</label>
            <div class="col-lg-2">
                @Html.TextAreaFor(x => monitorTemplate.Comment, new { @class = "form-control" })
            </div>
        </div>

        <hr />

        <div class="form-group">
            <label class="col-lg-2 control-label">Monitor #:</label>
            <div class="col-lg-2">
                @i
            </div>
        </div>

        <div class="form-group">
            <label class="col-lg-2 control-label">Monitor Type:</label>
            <div class="col-lg-2">
                @monitorTemplate.Monitor_Type
            </div>
        </div>
        if (monitorTemplate.Monitor_Type == "EQUIPMENT")
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">Target:</label>
                <div class="col-lg-2">
                    @Html.TextBoxFor(x => monitorTemplate.Target, new { @class = "form-control monitorTemplate_Target" })
                </div>
            </div>
        }

        <div class="form-group">
            <label class="col-lg-2 control-label">
                If fails:
            </label>
            <div class="col-lg-2">
                @if (!string.IsNullOrWhiteSpace(monitorTemplate.Fail_Action))
                {
                    failText = monitorTemplate.FailActionList.Single(x => x.Value == monitorTemplate.Fail_Action).Text;
                }
                @failText
            </div>
        </div>

        if (monitorTemplate.Step_Id != null && int.Parse(monitorTemplate.Step_Id) > 0)
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">
                    Proc Step Num
                </label>
                <div class="col-lg-2">
                    @monitorTemplate.Step_Id
                </div>
            </div>
        }

        if (monitorTemplate.Opinion != 0)
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">
                </label>
                <div class="col-lg-8">
                    This Monitor is based on Opinion
                </div>
            </div>
        }

        if (monitorTemplate.Use_Result != 0)
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">
                </label>
                <div class="col-lg-8">
                    This Monitor uses its result to match cases
                </div>
            </div>
        }

        if (monitorTemplate.Hide_Target != 0)
        {
            <div class="form-group">
                <label class="col-lg-2 control-label">
                </label>
                <div class="col-lg-8">
                    This Monitor will not show the user the target at entry time
                </div>
            </div>
        }

        <div class="form-group">
            <label class="col-lg-2 control-label">
                Fault Handling
            </label>
            <div class="col-lg-8">
                @Html.DropDownListFor(x => monitorTemplate.Fail_Action, monitorTemplate.FailActionList, new { @class = "form-control" })
            </div>
        </div>

        <div class="row">
            <div class="col-lg-offset-2 col-lg-8">
                <input class="btn btn-info" value="Save" type="submit" />
                <input class="btn btn-info" id="monitor-save-close" value="Save & Close Task" type="button" />
            </div>
        </div>
    }
    i++;
}
<script>
    $("#monitor-save-close").on('click', function () {
        var form = $(this).parents('form:first');
        $.ajax({
            type: "POST",
            url: "/wip/UpdateStepMonitorAndClose",
            dataType: 'json',
            data: form.serialize(),
            success: function (data) {
                location.reload();
            },
            error: function () {

            }
        });
    });

    $(".monitorTemplate_Target").on('change', function () {
        var textbox = $(this);
        var value = $(this).val();
        //alert(value);
        $.ajax({
            type: "POST",
            url: "@Url.Action("CheckEquipmentStatusById", "Wip")",
            dataType: 'json',
            data: { 'Id': value},
            success: function (data) {

                if (data.CanUsed == false) {
                    eModal.alert(data.ErrorMessage);
                    textbox.val('');
                }

            },
            error: function () {

            }
        });
    });

    $('.select').select2();
</script>
