@model Msr.Services.PurchesOrder.ViewModels.NewPurchaseOrderViewModel
@{
    ViewBag.Title = "Create Purchase Order";
}
<style>
    th {
        text-align:right;
        vertical-align:middle;
    }
</style>
<link href="~/assets/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Create Purchase Order @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                @using (Html.BeginForm("Create", "PurchaseOrder", FormMethod.Post, new { @class = "form form-horizontal" }))
                {
                    @Html.Partial("_Controls")
                }
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    <script src="~/assets/js/dataTables.bootstrap.min.js"></script>
    <script src="~/assets/js/grids/add-purchase-order.js"></script>
    
    @Scripts.Render("~/bundles/js/jqueryval")

    <script type="text/javascript">
        @{
            var productsJoin = string.Join(",", Model.Products);
        }
        $(document).ready(function() {
            Msr.AddPurchaseOrder.SetUp('@productsJoin');
        });
    </script>
}