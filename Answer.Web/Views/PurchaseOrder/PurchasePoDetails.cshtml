@model Msr.Services.PurchesOrder.ViewModels.PurchaseFormAccountViewModel
@{
                ViewBag.Title = "Purchasing";
}
<style>
    table.quote-header {
        width: 540px;
    }
    table.quote-header th {
        vertical-align: middle !important;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                New Purchase - Select Products <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            @Html.Partial("Message")
        <div class="col-lg-10">
            @using (Html.BeginForm("PurchasePoDetails", "PurchaseOrder", FormMethod.Post, new { @class = "form form-horizontal partCreate" }))
            {
                @Html.HiddenFor(x => x.OBJECT_ID);
                @Html.HiddenFor(x => x.Root);
                <input type="hidden" id="Id" name="Id" value="@Model.HISTORY_REF_ID" />
                <table class="table quote-header table-bordered">
                    <tr>
                        <th>Account Name:</th>
                        <td>
                            @Html.EditorFor(model => model.NAME, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.NAME, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th align="right">Reference PO#:</th>
                        <td>
                            @Html.EditorFor(model => model.REFERENCE_PO, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.REFERENCE_PO, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th align="right">Supplier:</th>
                        <td>
                            @Html.EditorFor(model => model.SUPPLIER_NAME, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.SUPPLIER_NAME, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th align="right">Customer:</th>
                        <td>
                            @Html.EditorFor(model => model.CUSTOMER_NAME, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.CUSTOMER_NAME, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th align="right">Open Date:</th>
                        <td>
                            @Html.EditorFor(model => model.OPEN_DATE, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.OPEN_DATE, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th align="right">Close Date:</th>
                        <td>
                            @Html.EditorFor(model => model.CLOSE_DATE, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            @Html.ValidationMessageFor(model => model.CLOSE_DATE, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                    <tr>
                        <th align="right">Max Amount to Charge:</th>
                        <td>
                            <div class="input-group">
                                <span class="input-group-addon">$</span>
                                @Html.EditorFor(model => model.TOTAL_PURCHASE_LIMIT, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.TOTAL_PURCHASE_LIMIT, "", new { @class = "text-danger" })
                        </td>
                    </tr>
                </table>

                <h2 class="page-header" style="margin-top:20px;"> Available Purchase Items</h2>

                <table class="table table-bordered">
                    <tr>
                        <th style="width:50%;">Product</th>
                        <th style="width:10%;">Purchase Qty</th>
                        <th><div id="show-hide">Work Order Creation</div></th>
                    </tr>
                    @for (int i = 0; i < Model.Products.Count; i++)
                    {
                        <tr>
                            <td>
                                @Html.HiddenFor(x => Model.ProductPo[i].ORDER_ID)
                                @Html.HiddenFor(x => Model.ProductPo[i].ACCT_ID)
                                @Html.HiddenFor(x => Model.ProductPo[i].ACCOUNT_OBJECT_ID)
                                @Html.HiddenFor(x => Model.ProductPo[i].Progress)
                                @Html.TextBoxFor(x => Model.ProductPo[i].Name, new { @class = "form-control", @readonly = "readonly" })
                            </td>
                            <td>
                                @Html.TextBoxFor(x => Model.ProductPo[i].Qty, new { @class = "form-control qty", @required = "", @id = "Qty" })
                                @Html.ValidationMessageFor(x => Model.ProductPo[i].Qty, "", new { @class = "text-danger" })
                            </td>
                            <td>
                                <div style="display: inline-block;" class="show-hide-button">
                                    <div class="make-switch switch-small" data-on="success" data-off="warning" style="display: inline-block">
                                        @Html.CheckBoxFor(x => Model.ProductPo[i].GroupWO, new { @class = "show-switch-button", @name = "completed-switch" })
                                    </div>
                                    <label>Group Quantity on One WO</label>
                                </div>
                            </td>
                        </tr>
                    }
                </table>
                <br />
                <table><tr><td>
                    <div id="message" class="alert-success success"></div>
                    <div id="error-message" class="alert-danger error"></div>
                    <input type="submit" name="BSUBMIT" class="btn btn-success" value="Create Purchase">
                </td></tr></table>
            }
        </div>
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript" src="~/assets/js/jquery.flexslider.js"></script>
    <script type="text/javascript" src="~/assets/js/bootstrap-select.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {

            $('.show-switch-button').bootstrapSwitch();

            $('.show-switch-button').on('switchchange.bootstrapswitch',
                function (e, state) {
                    e.preventDefault();
                    LoadShowHideButton(state);
                });

            $('.show-hide-button,.show-hide').hide();

            $(".qty").keyup(function () {
                var elem = $(this).parent().next().find('div');
                $(this).val() > 1 ? elem.show() : elem.hide();
            });

            $(".qty").each(function () {
                var elem = $(this).parent().next().find('div');
                $(this).val() > 1 ? elem.show() : elem.hide();
            });
        });


        function LoadShowHideButton(state) {
            if (state) {
                $(this).hide();
            } else {
                $(this).show();
            }
        }
    </script>
}