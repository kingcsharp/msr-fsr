@using Msr.Services.PurchesOrder.ViewModels

@{
    ViewBag.Title = "Purchase Orders";
}
<style>
    .navbar {
        z-index: 99;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Purchase Orders <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
                <button class="btn btn-primary help-btn pull-right" data-toggle="modal" data-target="#add-work-order" data-intro="Create a New PO" data-position="bottom" style="margin-right: 10px"><i class="fa fa-plus"></i> New</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>

    </div>
</div>


<div id="add-work-order" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">

        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">New Purchase Order</h4>
            </div>
            <style>
                .no-border {
                    border-bottom:0px !important;
                }
                .no-border th, .no-border td {
                    border: 1px !important;
                }
                .quote-header th {
                    text-align: right;
                }
                .items-table th {
                    text-align: center;
                }
                .items-table>tbody>tr>td {
                    min-height: 35px;
                    height: 35px;
                }
                .line-caption {
                    font-size: 9px;
                    padding-top: 2px !important;
                } 
            </style>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>

    </div>
</div>

@section scripts
{
    <script src="~/assets/js/plugins/bootstrap3/bootstrap-dialog.min.js"></script>
    <script type="text/javascript" src="~/assets/js/i18n/grid.locale-en.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.jqGrid.min.js"></script>
    <script type="text/javascript" src="~/assets/js/Grids/purchase-order.js"></script>

    <script type="text/javascript">
        
        $(document).ready(function () {

            $('.datepicker').datepicker();

            LoadPurchaseOrderGrid('@Url.Action("PurchaseOrderData", "PurchaseOrder")');

        });

        $('#add-work-order').on('hidden.bs.modal', function (event) {
            $(this).data('bs.modal', null);
        });

        $('#add-work-order').on('show.bs.modal', function (event) {
            var modal = $(this);

            $.ajax({
                type: "GET",
                url: '/purchaseOrder/add',
                dataType: 'html',
                success: function (data) {
                    modal.find('.modal-body').html(data);
                },
                error: function () {

                }
            });
        });



    </script>

}



