@using Msr.Services.PurchesOrder.ViewModels

@{
    ViewBag.Title = "Pricing";
}
<style>
    .navbar {
        z-index: 99;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-list-ul"></span>
                Purchase Orders @Html.Partial("_HelpViewButton")
                <a href="@Url.Action("Create", "PurchaseOrder")" class="btn btn-primary help-btn pull-right" style="margin-right: 10px"><i class="fa fa-plus"></i> New</a>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-purchase"></table>
                <div id="jq-grid-pager"></div> 
            </div>
        </div>
        <div class="row row-bottom-buttons">
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-purchase-order")

    <script type="text/javascript">
        var rootCompany = '@ViewBag.Company';

        $(document).ready(function () {
            Msr.PurchaseOrderGrid.LoadPurchaseOrderGrid('@Url.Action("PurchaseOrderData", "PurchaseOrder")');
        });
    </script>
}



