@model Msr.Services.PurchesOrder.ViewModels.NewPurchaseOrderViewModel

@{
    ViewBag.Title = "Create Purchase Order";
}

<link href="~/assets/css/bootstrap-datetimepicker.min.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Create Purchase Order<button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            @Html.Partial("Message")
            <div class="col-lg-10">
                @using (Html.BeginForm("Create", "PurchaseOrder", FormMethod.Post, new { @class = "form form-horizontal partCreate" }))
                {
                  @Html.Partial("_Controls")
                }
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/assets/js/moment.min.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    <script src="~/assets/js/grids/add-purchase-order.js"></script>
    <script src="~/assets/js/dataTables.bootstrap.min.js"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script src="~/assets/js/grids/add-purchase-order.js"></script>

}