@model Msr.Services.PurchesOrder.ViewModels.NewPurchaseOrderViewModel
    
@Html.AntiForgeryToken()
@Html.HiddenFor(x => x.ObjId)
<table class="table quote-header" width="100%">
    <tr>
        <th width="20%">Client:</th>
        <td width="30%">
            @Html.DropDownListFor(model => model.Client, Model.ClientList, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Client, "", new { @class = "text-danger" })
        </td>

        <th>PO Name :</th>
        <td>
            @Html.EditorFor(model => model.POName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter PO Name" } })
            @Html.ValidationMessageFor(model => model.POName, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">Account Type:</th>
        <td>
            @Html.DropDownListFor(model => model.AccountType, Model.AccountTypeList, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.AccountType, "", new { @class = "text-danger" })
        </td>

        <th align="right">Reference Cust PO #:</th>
        <td>
            @Html.EditorFor(model => model.RefCustPO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Reference Customer PO # (typically a blanket PO)" } })
            @Html.ValidationMessageFor(model => model.RefCustPO, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">Supplier / MSR-FSR Dept</th>
        <td>
            @Html.DropDownListFor(model => model.SupplierDepartment, Model.SupplierDepartmentList, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.SupplierDepartment, "", new { @class = "text-danger" })
        </td>
        <th align="right">Cust Ref# / MTTN:</th>
        <td>
            @Html.EditorFor(model => model.CustRefNum, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Reference Number" } })
            @Html.ValidationMessageFor(model => model.CustRefNum, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">Open Date:</th>
        <td>
            <div class="input-group">
                @Html.EditorFor(model => model.OpenDate, new { htmlAttributes = new { @class = "form-control datepick" } })
                <span class="input-group-addon">
                    <i class="fa fa-calendar"></i>
                </span>
            </div>
            @Html.ValidationMessageFor(model => model.OpenDate, "", new { @class = "text-danger" })
        </td>
        <th align="right">Close Date:</th>
        <td>
            <div class="input-group">
                @Html.EditorFor(model => model.CloseDate, new { htmlAttributes = new { @class = "form-control datepick" } })
                <span class="input-group-addon">
                    <i class="fa fa-calendar"></i>
                </span>
            </div>
            @Html.ValidationMessageFor(model => model.CloseDate, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">Total Purchase Limit:</th>
        <td>
            <div class="input-group">
                <span class="input-group-addon">$</span>
                @Html.EditorFor(model => model.TotalPurchaseLimit, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter total amount" } })
                <span class="input-group-addon">0.00</span>
            </div>
            @Html.ValidationMessageFor(model => model.TotalPurchaseLimit, "", new { @class = "text-danger" })
        </td>
        <th align="right">Tax %:</th>
        <td>
            <div class="input-group">
                @Html.EditorFor(model => model.Tax, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Tax %" } })
                @Html.ValidationMessageFor(model => model.Tax, "", new { @class = "text-danger" })
                <span class="input-group-addon">%</span>
            </div>
        </td>
    </tr>
    <tr>
        <th>Invoice Close / Cut Trigger:</th>
        <td>
            @Html.DropDownListFor(model => model.InvoiceTrigger, Model.InvoiceTriggerList, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.InvoiceTrigger, "", new { @class = "text-danger" })
        </td>
        <th>Invoice Period :</th>
        <td nowrap>
            @Html.EditorFor(model => model.InvoicePeriod, new { htmlAttributes = new { @class = "form-control", @width = "2", @placeholder = "00", @style = "width: 30%;display: inline-block;" } })
            @Html.ValidationMessageFor(model => model.InvoicePeriod, "", new { @class = "text-danger" })
            @Html.DropDownListFor(model => model.InvoicePeriodType, Model.InvoicePeriodTypeList, new { @class = "form-control", @style = "width: 68%;display: inline-block;" })
            @Html.ValidationMessageFor(model => model.InvoicePeriodType, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">First Invoice Date:</th>
        <td>
            <div class="input-group">
                @Html.EditorFor(model => model.FirstInvoiceDate, new { htmlAttributes = new { @class = "form-control datepick" } })

                <span class="input-group-addon">
                    <i class="fa fa-calendar"></i>
                </span>
            </div>

        </td>
        <th align="right">Payment Grace Period:</th>
        <td>
            @Html.EditorFor(model => model.GracePeriod, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Grace Period Days %" } })
            @Html.ValidationMessageFor(model => model.GracePeriod, "", new { @class = "text-danger" })
        </td>
    </tr>

    <tr>
        <th align="right">Late Payment Fee:</th>
        <td>
            <div class="input-group">
                @Html.EditorFor(model => model.LatePaymentFee, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter %" } })
                @Html.ValidationMessageFor(model => model.LatePaymentFee, "", new { @class = "text-danger" })
                <span class="input-group-addon">%</span>
            </div>
        </td>
        <th align="right">Re-Apply Frequency:</th>
        <td>
            @Html.EditorFor(model => model.ReApplyFrequency, new { htmlAttributes = new { @class = "form-control", @placeholder = "In Days" } })
            @Html.ValidationMessageFor(model => model.ReApplyFrequency, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">Products:</th>
        <td>
            
                <div style="width: 96%; float: left;">
                    @Html.ListBoxFor(m => m.Products, Model.ProductsList, new { @class = "form-control submitselect", multiple = "multiple" })
                </div>
                <div style="width: 3%; float: right;">
                    <span class="data-toggle=" data-call-back-id="Products" data-toggle="modal" data-target="#select-products"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="Products"><i class="icon fa fa-trash"></i></span>
                </div>
            
        </td>

    </tr>

    <tr>
        <td colspan="4">@Html.HiddenFor(model => model.Save, new { @class = "form-control" })
            @Html.HiddenFor(model => model.SaveClose, new { @class = "form-control" })
            @Html.HiddenFor(model => model.SaveWorkflow, new { @class = "form-control" })
        </td>
    </tr>
    <tr class="no-border">
        <td></td>
        <td colspan="3">
            <div id="message" class="alert-success success"></div>
            <div id="error-message" class="alert-danger error"></div>
            <input type="submit" name="BSUBMIT" onclick="return SaveFun()" class="btn btn-primary" value="Save">
            <input type="submit" name="BCLOSE" class="btn btn-warning" onclick="return SaveCloseFun()" value="Save &amp; Close">
            <input type="submit" name="BSaveSubmit" class="btn btn-success" onclick="return SaveSubmitApprovalFun()" value="Save &amp; Submit to Approval Workflow">
        </td>

    </tr>
</table>



<div id="select-products" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Products Account Can Purchase (Check All that Apply)</h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-info" onclick="SelectIds()"> Select</button>
                <button type="button" class="btn btn-warning" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>