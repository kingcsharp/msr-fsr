@model Msr.Services.PurchesOrder.ViewModels.NewPurchaseOrderViewModel
@Html.AntiForgeryToken()
@Html.HiddenFor(x => x.ObjId)
<input type="hidden" name="Id" id="Id" value="@Model.Id" />
<input type="hidden" name="AccountType" id="AccountType" value="PURCHASING_ACCOUNT" />
<input type="hidden" name="InvoiceTrigger" id="InvoiceTrigger" value="ALL_PURCHASE_ITEMS">

<table class="table" width="100%">
    <tr>
        <th width="20%">Customer:</th>
        <td width="30%">
            @Html.DropDownListFor(model => model.Client, Model.ClientList, new { @class = "form-control", @required="required" })
            @Html.ValidationMessageFor(model => model.Client, "", new { @class = "text-danger" })
        </td>
        <th>PO Name :</th>
        <td>
            @Html.EditorFor(model => model.POName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter PO Name", @required="required" } })
            @Html.ValidationMessageFor(model => model.POName, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">&nbsp;</th>
        <td>
            &nbsp;
        </td>
        <th align="right">Reference Cust PO #:</th>
        <td>
            @Html.EditorFor(model => model.RefCustPO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Reference Customer PO # (typically a blanket PO)", @required="required" } })
            @Html.ValidationMessageFor(model => model.RefCustPO, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">Cust Ref# / MTTN:</th>
        <td>
            @Html.EditorFor(model => model.CustRefNum, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Reference Number" } })
            @Html.ValidationMessageFor(model => model.CustRefNum, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">Open Date:</th>
        <td>
            <div class="input-group datepick">
                @Html.EditorFor(model => model.OpenDate, new { htmlAttributes = new { @class = "form-control datepick", @required="required" } })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
            @Html.ValidationMessageFor(model => model.OpenDate, "", new { @class = "text-danger" })
        </td>
        <th align="right">Close Date:</th>
        <td>
            <div class="input-group datepick">
                @Html.EditorFor(model => model.CloseDate, new { htmlAttributes = new { @class = "form-control datepick" } })
                <span class="input-group-addon">
                    <span class="glyphicon glyphicon-calendar"></span>
                </span>
            </div>
            @Html.ValidationMessageFor(model => model.CloseDate, "", new { @class = "text-danger" })
        </td>
    </tr>
    <tr>
        <th align="right">Total Purchase Limit:</th>
        <td>
            <div class="input-group">
                <span class="input-group-addon">$</span>
                @Html.EditorFor(model => model.TotalPurchaseLimit, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter total amount" } })
                <span class="input-group-addon">0.00</span>
            </div>
            @Html.ValidationMessageFor(model => model.TotalPurchaseLimit, "", new { @class = "text-danger" })
        </td>
        <th align="right">Tax %:</th>
        <td>
            <div class="input-group">
                @Html.EditorFor(model => model.Tax, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter Tax %" } })
                @Html.ValidationMessageFor(model => model.Tax, "", new { @class = "text-danger" })
                <span class="input-group-addon">%</span>
            </div>
        </td>
    </tr>

    <tr>
        <th align="right">Products:</th>
        <td colspan="3">
            <div>
                @Html.DropDownListFor(m => m.Products, Model.ProductsList, new { @class = "form-control select select-products", @required = "required" })
                @Html.ValidationMessageFor(m => m.Products, "", new { @class = "text-danger" })
            </div>
            <div id="product-message" class="alert-info">
            </div>
        </td>
    </tr>
    <tr>
        <td colspan="4">
            @Html.HiddenFor(model => model.Save, new { @class = "form-control" })
            @Html.HiddenFor(model => model.SaveClose, new { @class = "form-control" })
            @Html.HiddenFor(model => model.SaveWorkflow, new { @class = "form-control" })
        </td>
    </tr>
    <tr class="no-border">
        <td></td>
        <td colspan="3">
            <div id="message" class="alert-success success"></div>
            <div id="error-message" class="alert-danger error"></div>
            <input type="submit" name="BSUBMIT" onclick="return SaveFun()" class="btn btn-primary" value="Save">
            <input type="submit" name="BCLOSE" class="btn btn-warning" onclick="return SaveCloseFun()" value="Save &amp; Close">
            <input type="submit" name="BSaveSubmit" class="btn btn-success" onclick="return SaveSubmitApprovalFun()" value="Save &amp; Submit to Approval Workflow">
        </td>
    </tr>
</table>
