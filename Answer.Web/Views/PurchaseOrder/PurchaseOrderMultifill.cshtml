@model Msr.Services.PurchesOrder.ViewModels.PurchaseOrderMultiFillViewModel
@{
    ViewBag.Title = "Purchasing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <style>
        table.quote-header {
            width: 540px;
        }

            table.quote-header th {
                vertical-align: middle !important;
            }
    </style>

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Purchase Multi-Fill Item
                <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            @Html.Partial("Message")
            @using (Html.BeginForm("PurchaseOrderMultifill", "PurchaseOrder", FormMethod.Post, new { @class = "form form-horizontal", @id = "PurchaseOrderMultiFillForm" }))
            {
                @Html.HiddenFor(modelItem => Model.PurchaseApprovedData.OBJECT_ID)
                @Html.HiddenFor(modelItem => Model.PurchaseApprovedData.HISTORY_REF_ID)

                <table class="table table-bordered quote-header">
                    <tbody>
                        <tr>
                            <th>
                                Purchase #:
                            </th>

                            <td>
                                @Model.PurchaseApprovedData.ID
                            </td>
                        </tr>
                        <tr>
                            <th>
                                Customer Reference #:
                            </th>

                            <td>
                                @Model.PurchaseApprovedData.CUST_PURCH_NUM
                            </td>
                        </tr>
                        <tr>
                            <th>
                                Order Description:
                            </th>

                            <td>
                                @Model.PurchaseApprovedData.DESCRIPTION
                            </td>
                        </tr>
                        <tr>
                            <th>
                                Purchase Status:
                            </th>

                            <td>
                                @Model.PurchaseApprovedData.PURCHASE_STATUS
                            </td>
                        </tr>
                    </tbody>
                </table>
                <h2 class="page-header" style="margin-top:20px;"> Purchase Items</h2>

                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th style="width:10%">Cust Line #</th>
                            <th>Serial / Kit Number</th>
                            <th style="width:5%">Quantity</th>
                            <th style="width:15%">Part</th>
                            <th>Procedure</th>
                            <th style="width:10%">Site</th>
                        </tr>
                        @for (int i = 0; i < Model.FillList.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Html.HiddenFor(modelItem => Model.FillList[i].ID)
                                    @Html.HiddenFor(modelItem => Model.FillList[i].SUPPLIER)
                                    @Html.HiddenFor(modelItem => Model.FillList[i].OBJ_PROD_APPLIES_TO)
                                    @Html.HiddenFor(modelItem => Model.FillList[i].CO_ID)
                                    @Html.TextBoxFor(modelItem => Model.FillList[i].CUST_LINE_ITEM, new { @class = "form-control", @readonly = "readonly" })
                                </td>
                                <td>
                                    @Html.TextBoxFor(modelItem => Model.FillList[i].SERIAL_NUMBER, new { @class = "form-control", @id = "serial-number" })
                                    @if (Model.FillList.Count > 1)
                                    {
                                        @Html.ValidationMessageFor(model => Model.FillList[i].SERIAL_NUMBER, "", new { @class = "text-danger" })
                                    }
                                </td>
                                <td>@Html.TextBoxFor(modelItem => Model.FillList[i].PURCHASE_QTY, new { @class = "form-control" })</td>
                                <td>@Html.TextBoxFor(modelItem => Model.FillList[i].APP_OBJ_DESC, new { @class = "form-control", @readonly = "readonly" })</td>
                                <td>@Html.TextBoxFor(modelItem => Model.FillList[i].PROC_NAME, new { @class = "form-control", @readonly = "readonly" })</td>
                                <!-- <td>@Html.DropDownListFor(modelItem => Model.FillList[i].CO_ID, Model.FillList[i].OwnerList, new { @class = "form-control" })</td> -->
                                <td>
                                    @Html.DropDownListFor(modelItem => Model.FillList[i].LOCATION_ID, Model.FillList[i].LocationList, new { @class = "form-control select", @required = "", @id = "LOCATION_ID" })
                                    @Html.ValidationMessageFor(modelItem => Model.FillList[i].LOCATION_ID, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <br />
                <table>
                    <tr>
                        <td>
                            <div id="message" class="alert-success success"></div>
                            <div id="error-message" class="alert-danger error"></div>
                            <input id="Submit" type="submit" name="BSUBMIT" class="btn btn-success" value="Save" />
                        </td>
                    </tr>
                </table>
            }
            </div>
            </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqueryval")
    
    <script type="text/javascript">
        $(document).ready(function () {
        
            if ('@Model.FillList.Count' === '1') {
                $('#serial-number').val('N/A');
                $('#serial-number').attr('readonly');
            }

        });
    </script>

}
