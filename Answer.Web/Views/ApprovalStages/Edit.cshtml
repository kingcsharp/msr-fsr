@model Msr.Services.ApprovalStages.VIewModels.EditApprovalStagesViewModel
@{
    ViewBag.Title = "Update Approval Stage";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Approval Stage
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        @Html.Partial("Message")
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@Model.Id" />
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Groups, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.Groups, Model.ListGroups, new { @class = "form-control select selectroles", multiple = "multiple" })
                                        @Html.ValidationMessageFor(model => model.Groups, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-offset-2 col-md-8">
                                        <input type="submit" value="Submit" class="btn btn-success" />
                                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @{
        var MemberGroups = string.Join(",", Model.Groups);
    }
    
    @Scripts.Render("~/bundles/js/jqueryval")

    <script type="text/javascript">
         $(document).ready(function () {
            var selectRoles = $(".selectroles").select2({
               tags: [],
               tokenSeparators: [','],
               multiple: true,
               allowClear: true,
               placeholder: "Select Roles",
               formatNoMatches: function () {
                   return '';
               }
            });
            var values = '@MemberGroups';
            var selectedRoles = values.split(",")
            console.log(selectedRoles);
            selectRoles.val(selectedRoles).trigger("change");
        });
    </script>
}
