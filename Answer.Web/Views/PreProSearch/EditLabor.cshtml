@model Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Labor";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Labor Step Templates <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div style="width:100%;">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="@Url.Action("AddLabor", "PreProSearch", new { id = ViewBag.Id, procStepId = ViewBag.ProcedureStepId, relationship = ViewBag.relationship })" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/js/plugins/bootstrap3/bootstrap-dialog.min.js"></script>
    <script type="text/javascript" src="~/assets/js/i18n/grid.locale-en.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.jqGrid.min.js"></script>
    
    <script src="//cdn.rawgit.com/noelboss/featherlight/1.6.1/release/featherlight.min.js" type="text/javascript" charset="utf-8"></script>
    <script src="https://cdn.smooch.io/smooch.min.js"></script>
    <script type="text/javascript" src="~/assets/js/grids/labors-step.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            LoadLaborstepGrid('@Url.Action("LaborsData", "PreProSearch", new{ id= ViewBag.ProcedureStepId })',
                '@ViewBag.ProcedureStepId',
                '@ViewBag.Id',
                '@ViewBag.relationship');
        });
    </script>
}