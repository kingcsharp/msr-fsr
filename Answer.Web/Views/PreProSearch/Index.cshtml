@{
    ViewBag.Title = "Templates";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-file-text"></span>
                Templates @Html.Partial("_HelpViewButton")
            </h2>
            <div style="width:100%;">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="@Url.Action("Create", "PreProSearch")" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>

@section scripts
{
   @Scripts.Render("~/bundles/js/jqgrid")
   @Scripts.Render("~/bundles/js/jqgrid-procedurestep")

    <script type="text/javascript">
        $(document).ready(function () {
            LoadProcedureStepGrid('@Url.Action("PreProData", "PreProSearch")','@Request.Url.OriginalString');
        });
    </script>
}
