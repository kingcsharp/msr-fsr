@{
    ViewBag.Title = "Templates";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-file-text"></span>
                Templates
                @Html.Partial("_HelpViewButton")
            </h2>
            <div style="width:100%;">
                @Html.Partial("Message")
                <table id="jq-grid-template"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row">
            <a href="@Url.Action("Create", "PreProSearch")" class="btn btn-success help-btn">Add</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-procedurestep")

    <script type="text/javascript">
        $(document).ready(function () {
            Msr.ProcedureStepGrid.LoadProcedureStepGrid('@Url.Action("PreProData", "PreProSearch")','@Request.Url.OriginalString');
        });
    </script>
}
