@model Msr.Services.PrePro.ViewModel.ProcedurePreProViewModel
@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>


<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                View Part
                <div class=" pull-right" data-toggle="modal">
                    <!-- Split button -->
                    <div class="btn-group">
                        <button type="button" class="btn btn-warning">Action</button>
                        <button type="button" class="btn btn-warning dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                            <span class="sr-only">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a href="~/parts/deletePart/@Model.Id">Delete</a></li>
                        </ul>
                    </div>

                </div>
            </h2>

            <div>
                <dl class="dl-horizontal">
                    <dt>
                        @Html.DisplayNameFor(model => model.StartOnCounter)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.StartOnCounter)
                    </dd>
                    
                    <dt>
                        @Html.DisplayNameFor(model => model.Duration)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.Duration)
                    </dd>
                    
                    
                    <dt>
                        @Html.DisplayNameFor(model => model.DurationType)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.DurationType)
                    </dd>
                    
                    <dt>
                        @Html.DisplayNameFor(model => model.ReferenceObject)
                    </dt>
                    @foreach (var item in Model.ReferenceObject)
                    {
                        <dd>
                            @Html.DisplayFor(model => item.Text) <span class="data-toggle=" data-call-back-item="@item.Text" data-toggle="modal" data-target="#view-images" title="View File"><i class="icon fa fa-eye"></i></span>
                        </dd>
                    }
                    
                    <dt>
                        @Html.DisplayNameFor(model => model.ReferenceFiles)
                    </dt>
                    @foreach (var item in Model.ListPictureRefFiles)
                    {
                        <dd>
                            @Html.DisplayFor(model => item.Text) <span class="data-toggle=" data-call-back-item="@item.Text" data-toggle="modal" data-target="#view-images" title="View File"><i class="icon fa fa-eye"></i></span>
                        </dd>
                    }
                    
                    <dt>
                        @Html.DisplayNameFor(model => model.ReferenceTheories)
                    </dt>
                    @foreach (var item in Model.ReferenceTheoriesList)
                    {
                        <dd>
                            @Html.DisplayFor(model => item.Text) <span class="data-toggle=" data-call-back-item="@item.Text" data-toggle="modal" data-target="#view-images" title="View File"><i class="icon fa fa-eye"></i></span>
                        </dd>
                    }
                    
                    <dt>
                        @Html.DisplayNameFor(model => model.ReferenceProcedures)
                    </dt>
                    @foreach (var item in Model.ListProcFiles)
                    {
                        <dd>
                            @Html.DisplayFor(model => item.Text) <span class="data-toggle=" data-call-back-item="@item.Text" data-toggle="modal" data-target="#view-images" title="View File"><i class="icon fa fa-eye"></i></span>
                        </dd>
                    }
                    

                    <dt>
                        @Html.DisplayNameFor(model => model.StepText)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.StepText)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.SystemTask)
                    </dt>

                    <dd>
                        @Html.DisplayFor(model => model.SystemTask)
                    </dd>
                    <dt>
                        @Html.DisplayNameFor(model => model.Comments)
                    </dt>
                    <dd>
                        @Html.DisplayFor(model => model.Comments)
                    </dd>
                    
                   
                

                    <dd>
                        @Html.DisplayFor(model => model.Id)
                    </dd>
                   
                </dl>
            </div>
            <p>
                @Html.ActionLink("Edit", "Edit", new { id = Model.ID }) |
                @Html.ActionLink("Back to List", "Index")
            </p>
        </div>
    </div>
</div>
<div id="view-images" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">View</h4>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning closeClick" data-dismiss="modal"><i class="fa fa-close-o"></i> Close</button>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>

        $('#view-images').on('show.bs.modal',
            function (event) {

                var button = $(event.relatedTarget);
                var callBackitem = button.data('call-back-item');
                var modal = $(this);

                $.ajax({
                    type: "GET",
                    url: '/parts/ViewFile?callBackitem=' + callBackitem,
                    dataType: 'html',
                    success: function (data) {
                        modal.find('.modal-body').html(data);
                    },
                    error: function () {

                    }
                });

            });

    </script>
}

