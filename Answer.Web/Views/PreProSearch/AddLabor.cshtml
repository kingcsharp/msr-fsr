@model Msr.Services.PrePro.ViewModel.ProcedureObjectViewModel
@{
    ViewBag.Title = "Add Labor";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Add Labor
            </h2>
            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        @Html.Partial("Message")
                        @using (Html.BeginForm("AddLabor", "PreProSearch", FormMethod.Post, new { @class = "form form-horizontal", @onSubmit = "escapeAllSelects();", @name = "editForm", @target = "", @action = "" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ProcedureObjectId" value="@Model.ProcedureObjectId" />
                            <input type="hidden" name="ProcedureStepId" value="@Model.ProcedureStepId" />
                            <input type="hidden" name="Relationship" value="@Model.Relationship" />
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ApprovedObjectId, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.ApprovedObjectId, Model.ApprovedObjectList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.ApprovedObjectId, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Qty, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.EditorFor(model => model.Qty, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Qty, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.QtyType, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.QtyType, Model.QtyTypeList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.QtyType, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.LaborRole, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.LaborRole, Model.LaborRoleList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.LaborRole, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-md-offset-4 col-md-10">
                                        <input type="submit" value="Submit" class="btn btn-success" />
                                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script type="text/javascript">
        $(document).ready(function() {
            $('.select').select2();
        });
    </script>
}
