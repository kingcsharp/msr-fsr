@model Msr.Services.PrePro.ViewModel.ApplicableObjectsView
@{
    ViewBag.Title = "Manage Applicable Objects";
}

<link href="~/assets/textformater/general.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Manage Applicable Objects
                @Html.Partial("_HelpViewButton")
            </h2>

            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        @Html.Partial("Message")

                        @using (Html.BeginForm("ApplicableObjects", "PreProSearch", FormMethod.Post, new { @class = "form form-horizontal", @onSubmit = "escapeAllSelects();;", @name = "editForm", @target = "", @action = "" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="StepId" value="@Model.StepId" />
                        
                           
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                              
                                <div class="form-group">
                                    Object Name <br/><br/>
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__1, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__2, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__3, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__4, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__5, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__6, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__7, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__8, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__9, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__10, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__11, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.NEW__12, Model.ApplicableObjectsList, new { @class = "form-control select" })
                                    </div>
                                </div>

                              
                                <div class="form-group">
                                    <div class="col-md-offset-4 col-md-10">
                                        <input type="submit" value="Submit" class="btn btn-success" />
                                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                                 
                                    </div>
                                </div>                        
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    
    <script>
        $(document).ready(function () {
            $(".select").select2();
        });

    </script>
}


