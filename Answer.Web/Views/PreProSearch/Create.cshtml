@model Msr.Services.PrePro.ViewModel.ProcedurePreProViewModel
@{
    ViewBag.Title = "Create Procedure Step Template";
}
@Styles.Render("~/bundles/css/fileinput")
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Create Procedure Step Template @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                @using (Html.BeginForm("Create", "PreProSearch", FormMethod.Post, new { @class = "form form-horizontal", @onSubmit = "escapeAllSelects();;", @name = "editForm", @target = "", @action = "" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.LabelFor(model => model.Title, new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.StartOnCounter, new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.StartOnCounter, Model.BaseStartOnCounterList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.StartOnCounter, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Duration, new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.Duration, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.DurationType, new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.DurationType, Model.StepDurationTypeList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.DurationType, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Labor, new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.TextBoxFor(model => model.Labor, new { @class = "form-control", @readonly = "readonly" })
                                @Html.ValidationMessageFor(model => model.Labor, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.StepText, new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.Partial("_TextAdder")
                                @Html.TextAreaFor(model => model.StepText, new { onBlur = "checkMaxSize(this, 4000);;lastTextArea = 'document.editForm.StepText';", name = "StepText", rows = "10", cols = "80", @class = "text-formatter form-control", style = "height:150px;" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.SystemTask, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.SystemTask, Model.SystemTaskList, new { @class = "form-control select" })
                                @Html.ValidationMessageFor(model => model.SystemTask, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="systemcomptest">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NumTestQuestion, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-5">
                                    @Html.EditorFor(model => model.NumTestQuestion, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.NumTestQuestion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ApplicationObjects, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                <div style="width: 96%; float: left;">
                                    @Html.TextBoxFor(m => m.ApplicationObjects, new { @class = "form-control submitselect", @readonly = "readonly" })
                                    @Html.ValidationMessageFor(model => model.ApplicationObjects, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceProcedures, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                <div style="width: 96%; float: left;">
                                    @Html.ListBoxFor(m => m.ReferenceProcedures, Model.ReferenceProceduresList, new { @class = "form-control  submitselect" })
                                    @Html.ValidationMessageFor(model => model.ReferenceProcedures, "", new { @class = "text-danger" })
                                </div>
                                <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="ReferenceProcedures" data-toggle="modal" data-target="#select-referenceprocedures"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceProcedures"><i class="icon fa fa-trash-o"></i></span> </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceVerb, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                <div>
                                    @Html.DropDownListFor(m => m.ReferenceVerb, Model.ReferenceVerbList, new { @class = "form-control select" })
                                    @Html.ValidationMessageFor(model => model.ReferenceVerb, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceObject, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                <div>
                                    @Html.DropDownListFor(m => m.ReferenceObject, Model.ReferenceObjectsList, new { @class = "form-control  select" })
                                    @Html.ValidationMessageFor(model => model.ReferenceObject, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.Partial("_FileUpload")
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceTheories, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                <div style="width: 96%; float: left;">
                                    @Html.ListBoxFor(m => m.ReferenceTheories, Model.ReferenceTheoriesList, new { @class = "form-control submitselect", multiple = "multiple" })
                                </div>
                                <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="ReferenceTheories" data-toggle="modal" data-target="#select-theory"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceTheories"><i class="icon fa fa-trash-o"></i></span>  </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.TextAreaFor(model => model.Comments, new { onBlur = "checkMaxSize(this, 4000);lastTextArea = 'document.editForm.Comments';", name = "Comments", rows = "10", cols = "80", @class = "text-formatter", style = "height:150px;" })
                                @Html.ValidationMessageFor(model => model.Comments, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-10">
                                <input type="submit" value="Create " class="btn btn-success" style="height: 35px;" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/textformater/ValidateDocumentSubmit.js"></script>
    <script src="~/assets/textformater/textformatter.js"></script>
    @Scripts.Render("~/bundles/js/jqueryval")
    @Scripts.Render("~/bundles/js/fileinput")
    <script src="~/assets/js/grids/comman.js"></script>
    <script type="text/javascript">

        var fileUploaderGrid = new FileUploaderGrid();
        var fileUploader = new FileUploader();

        $(document).ready(function () {

            fileUploader.InitUploader($('#input-files'), '@Url.Action("FileUploaderBootstrap", "Doc")', [],[]);
            fileUploaderGrid.SetupSelectImage();

            $(".select").select2();

            $('.deletefiles').click(function() {

                var callBackId = $(this).data('call-back-id');

                eModal.confirm('Do you really want to Remove ' + callBackId + ' ?', 'Confirmation delete')
                    .then(confirmCallback, optionalCancelCallback);

                function confirmCallback() {
                    console.log("ok");
                    $('#' + callBackId + ' option:selected').remove();
                }

                function optionalCancelCallback() {
                    console.log("cancel");
                }

            });


        });
        function SelectIds() {
            fileUploaderGrid.SelectIdsForAdd(fileUploader, '@Url.Action("FileUploaderBootstrap", "Doc")');
        }
        function removeOldFile(e) {

            var control = $(e).closest(".modal-body").find('#target-control-id').val();
            $('#' + control).empty();
        };
        function getRecord(e) {
            removeOldFile(e);
            SelectlocationID();
            $('.closeClick').click();
        }

        function SelectlocationID() {

            $(".selected-file").each(function (Index) {

                if ($(this).is(":checked")) {

                    var ids = $(this).val().split('|');

                    var callBackId = $(this).closest(".modal-body").find('#target-control-id').val();
                    var options = $('#' + callBackId + '')[0].options;

                    var optionsArray = $.map(options, function (elem) {
                        return (elem.value);
                    });

                    if (optionsArray.length > 0) {

                        if ($.inArray(ids[0], optionsArray) !== -1) {
                            // found it
                        }
                        else {

                            $('#' + callBackId + '').append($('<option></option>').val(ids[0]).html(ids[1]));
                            $('#' + callBackId + ' option').prop('selected', true);

                        }

                    }
                    else {
                        $('#' + callBackId + '').append($('<option></option>').val(ids[0]).html(ids[1]));
                        $('#' + callBackId + ' option').prop('selected', true);
                    }
                }

            });
            $('.closeClick').click();

        }

    </script>
}

