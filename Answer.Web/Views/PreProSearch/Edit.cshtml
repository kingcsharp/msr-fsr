@model Msr.Services.PrePro.ViewModel.ProcedurePreProViewModel
@{
    ViewBag.Title = "Update Procedure Step Template";
}

@Styles.Render("~/bundles/css/fileinput")
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Procedure Step Template @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        @Html.Partial("Message")
                        @using (Html.BeginForm("Edit", "PreProSearch", FormMethod.Post, new { @class = "form form-horizontal", @onSubmit = "escapeAllSelects();;", @name = "editForm", @target = "", @action = "" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(x => x.PkId)
                            @Html.HiddenFor(x => x.ObjectId)
                            @Html.HiddenFor(x => x.ProcObjId)

                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.StartOnCounter, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.StartOnCounter, Model.BaseStartOnCounterList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.StartOnCounter, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Duration, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.EditorFor(model => model.Duration, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.DurationType, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.DurationType, Model.StepDurationTypeList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.DurationType, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ReplacementCost, new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.EditorFor(model => model.ReplacementCost, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ReplacementCost, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Utilization, new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.EditorFor(model => model.Utilization, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Utilization, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.UsefulLife, new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.EditorFor(model => model.UsefulLife, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.UsefulLife, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.StepText, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.Partial("_TextAdder")
                                        @Html.TextAreaFor(model => model.StepText, new { onBlur = "checkMaxSize(this, 4000);;lastTextArea = 'document.editForm.StepText';", name = "StepText", rows = "10", cols = "80", @class = "text-formatter form-control", })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.SystemTask, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.SystemTask, Model.SystemTaskList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.SystemTask, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="systemcomptest">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.NumTestQuestion, htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-8">
                                            @Html.EditorFor(model => model.NumTestQuestion, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.NumTestQuestion, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ApplicationObjects, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        <div style="width: 96%; float: left;">
                                            @Html.TextBoxFor(m => m.ApplicationObjects, new { @class = "form-control submitselect", @readonly = "readonly" })
                                            @Html.ValidationMessageFor(model => model.ApplicationObjects, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ReferenceProcedures, new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        <div style="width: 96%; float: left;">
                                            @Html.ListBoxFor(m => m.ReferenceProcedures, Model.ReferenceProceduresList, new { @class = "form-control  submitselect" })
                                            @Html.ValidationMessageFor(model => model.ReferenceProcedures, "", new { @class = "text-danger" })
                                        </div>
                                        <div style="width: 3%; float: right;">
                                            <span class="data-toggle=" data-call-back-id="ReferenceProcedures" data-toggle="modal" data-target="#select-referenceprocedures">
                                                <i class="icon fa fa-file"></i>
                                            </span>
                                            <span class="deletefiles" data-call-back-id="ReferenceProcedures">
                                                <i class="icon fa fa-trash-o"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.ReferenceVerb, new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    <div>
                                        @Html.DropDownListFor(m => m.ReferenceVerb, Model.ReferenceVerbList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.ReferenceVerb, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.ReferenceObject, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    <div>
                                        @Html.DropDownListFor(m => m.ReferenceObject, Model.ReferenceObjectsList, new { @class = "form-control  select" })
                                        @Html.ValidationMessageFor(model => model.ReferenceObject, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.Partial("_FileUpload")
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Roles, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8 margin-right">
                                    @Html.DropDownListFor(model => model.Roles, Model.RolesList, new { @class = "form-control select selectroles", multiple = "multiple" })
                                    @Html.ValidationMessageFor(model => model.Roles, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.ReferenceTheories, new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    <div class="input-group">
                                        @Html.DropDownListFor(m => Model.ReferenceTheories, Model.ReferenceTheoriesList, new { @class = "form-control submitselect", multiple= "multiple", size ="1"})
                                        <span class="input-group-addon btn btn-primary" data-call-back-id="ReferenceTheories" data-toggle="modal" data-target="#select-theory"><i class="fa fa-folder-open-o"></i></span>
                                        <span class="remove-files input-group-addon btn btn-danger" data-target-id="ReferenceTheories"><i class="fa fa-trash-o"></i></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.TextAreaFor(model => model.Comments, new { onBlur = "checkMaxSize(this, 4000);;lastTextArea = 'document.editForm.Comments';", name = "Comments", rows = "10", cols = "80", @class = "text-formatter", style = "height:150px;width:100%;" })
                                    @Html.ValidationMessageFor(model => model.Comments, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-offset-2 col-md-10">
                                    <input type="submit" value="Submit" class="btn btn-success" />
                                    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" }) | 
                                    @Html.ActionLink("Add-Update Applicable Objects", "ApplicableObjects", new { id = Model.ProcObjId }, new { @class = "btn btn-success" })
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/textformater/ValidateDocumentSubmit.js"></script>
    <script src="~/assets/textformater/textformatter.js"></script>
    @Scripts.Render("~/bundles/js/jqueryval")
    @Scripts.Render("~/bundles/js/fileinput")
    <script src="~/assets/js/grids/comman.js"></script>

    <script type="text/javascript">

        @{
        var roles = string.Join(",", Model.Roles);
        }
        var fileUploader = new FileUploader();

        $(document).ready(function() {

            fileUploader.InitEditUploader('input-files',
                '@Url.Action("FileUploaderForPrePro", "Doc")',
                [@Html.Raw(ViewBag.Preview)],
                @Html.Raw(ViewBag.PreviewConfig),
                '@Model.PkId',
                true,
                'TEMPLATE_STEP');

            $('.remove-files').click(Msr.FileComman.RemoveSelectItem);

            $(".select").select2();

            switch ('@Model.SystemTask') {
            case "SYS_COMP_TEST":
                $(".systemcomptest").show();
                break;
            default:
                    $(".systemcomptest").hide();
                break;
            }
            $('#SystemTask').on('change',
                function() {
                    switch (this.value) {
                    case 'SYS_COMP_TEST':
                        $(".systemcomptest").show();
                        break;
                    default:
                        $(".systemcomptest").hide();
                        break;
                    }
                });

            var selectRoles = $(".selectroles").select2({
                tags: [],
                tokenSeparators: [','],
                multiple: true,
                allowClear: true,
                placeholder: "Select Role",
                formatNoMatches: function () {
                    return '';
                }
            });
            var valueRoles = '@roles';
            var selectRolesList = valueRoles.split(",");
            selectRoles.val(selectRolesList).trigger("change");
        });

        function SelectIds() {
            new FileUploaderGrid().SelectIds();
        }

    </script>
}
