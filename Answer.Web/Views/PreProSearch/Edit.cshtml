@model Msr.Services.PrePro.ViewModel.ProcedurePreProViewModel
@{
    ViewBag.Title = "Edit";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Procedure Step
                <div class=" pull-right" data-toggle="modal">
                    <!-- Split button -->
                    <div class="btn-group">
                        <button type="button" class="btn btn-warning">Action</button>
                        <button type="button" class="btn btn-warning dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span class="caret"></span>
                            <span class="sr-only">Toggle Dropdown</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a href="~/PreProSearch/delete/@Model.Id">Delete</a></li>
                        </ul>
                    </div>

                </div>
            </h2>
            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info">
                        @Html.Partial("Message")
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="form-group">
                                    @Html.LabelFor(model => model.StartOnCounter, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.StartOnCounter, Model.BaseStartOnCounterList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.StartOnCounter, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Duration, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.EditorFor(model => model.Duration, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.DurationType, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.DurationType, Model.StepDurationTypeList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.DurationType, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.Labor, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.TextAreaFor(model => model.Labor, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Labor, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.StepText, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.TextAreaFor(model => model.StepText, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.StepText, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.SystemTask, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.DropDownListFor(model => model.SystemTask, Model.SystemTaskList, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.SystemTask, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="systemcomptest">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.Duration, htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-5">
                                            @Html.EditorFor(model => model.Duration, new { htmlAttributes = new { @class = "form-control" } })
                                            @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ReferenceProcs, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        <div style="width: 96%; float: left;">
                                            @Html.ListBoxFor(m => m.ReferenceProcs, Model.ProcFilesList, new { @class = "form-control  submitselect", multiple = "multiple" })
                                            @Html.ValidationMessageFor(model => model.ReferenceProcs, "", new { @class = "text-danger" })
                                        </div>
                                        <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="ReferenceProcs" data-toggle="modal" data-target="#select-images"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="ReferenceProcs"><i class="icon fa fa-trash"></i></span> </div>
                                    </div>
                                </div>


                                @*<div class="form-group">
                                        <label class="control-label col-md-2" for="Title">Refrence Verbs</label>
                                        <div class="col-md-5">
                                            @Html.DropDownListFor(model => model.REFERENCE_VERB, Model.Reference_Verb, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.REFERENCE_VERB, "", new { @class = "text-danger" })
                                        </div>
                                    </div>*@


                                <div class="form-group">
                                    @Html.LabelFor(model => model.ReferenceObject, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        <div style="width: 96%; float: left;">
                                            @Html.ListBoxFor(m => m.ReferenceObject, Model.ReferenceObjectsList, new { @class = "form-control submitselect" })
                                            @Html.ValidationMessageFor(model => model.ReferenceObject, "", new { @class = "text-danger" })
                                        </div>
                                        <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="REFERENCE_OBJECT" data-toggle="modal" data-target="#select-objects"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="REFERENCE_OBJECT"><i class="icon fa fa-trash"></i></span> </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    @Html.LabelFor(model => model.PictureFiles, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        <div style="width: 96%; float: left;">
                                            @Html.ListBoxFor(m => m.PictureFiles, Model.PictureRefFilesList, new { @class = "form-control submitselect", multiple = "multiple" })
                                        </div>
                                        <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="PictureFiles" data-toggle="modal" data-target="#select-images"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="PictureFiles"><i class="icon fa fa-trash"></i></span>  </div>
                                    </div>
                                </div>




                                <div class="form-group">
                                    @Html.LabelFor(model => model.ReferenceTheories, htmlAttributes: new { @class = "control-label col-md-2" })

                                    <div class="col-md-5">
                                        <div style="width: 96%; float: left;">
                                            @Html.ListBoxFor(m => m.ReferenceTheories, Model.ListReferenceTheories, new { @class = "form-control submitselect", multiple = "multiple" })
                                        </div>
                                        <div style="width: 3%; float: right;"><span class="data-toggle=" data-call-back-id="REFERENCE_THEORIES" data-toggle="modal" data-target="#select-images"><i class="icon fa fa-file"></i></span><span class="deletefiles" data-call-back-id="REFERENCE_THEORIES"><i class="icon fa fa-trash"></i></span>  </div>
                                    </div>
                                </div>


                                <div class="form-group">
                                    @Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-5">
                                        @Html.TextAreaFor(model => model.Comments, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Comments, "", new { @class = "text-danger" })
                                    </div>
                                </div>



                                <div class="form-group">
                                    <div class="col-md-offset-4 col-md-10">
                                        <input type="submit" value="Update" class="btn btn-default" />
                                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

@section scripts
{

    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script src="~/assets/js/grids/comman.js"></script>
    <script>
        $(document).ready(function () {
            $(".select").select2();
        });
        function removeOldFile(e) {

            var control = $(e).closest(".modal-body").find('#target-control-id').val();
            $('#' + control).empty();
        };
        function getRecord(e) {
            removeOldFile(e);
            SelectlocationID();
            $('.closeClick').click();
        }

        function SelectlocationID() {

            $(".selected-file").each(function (Index) {

                if ($(this).is(":checked")) {

                    var ids = $(this).val().split('|');

                    var callBackId = $(this).closest(".modal-body").find('#target-control-id').val();
                    var options = $('#' + callBackId + '')[0].options;

                    var optionsArray = $.map(options, function (elem) {
                        return (elem.value);
                    });

                    if (optionsArray.length > 0) {

                        if ($.inArray(ids[0], optionsArray) != -1) {
                            // found it
                        }
                        else {

                            $('#' + callBackId + '').append($('<option></option>').val(ids[0]).html(ids[1]));
                            $('#' + callBackId + ' option').prop('selected', true);

                        }

                    }
                    else {
                        $('#' + callBackId + '').append($('<option></option>').val(ids[0]).html(ids[1]));
                        $('#' + callBackId + ' option').prop('selected', true);
                    }
                }

            });
            $('.closeClick').click();

        }






        $('.deletefiles').click(function () {

            var callBackId = $(this).data('call-back-id');

            eModal.confirm('Do you really want to Remove ' + callBackId + ' ?', 'Confirmation delete')
                .then(confirmCallback, optionalCancelCallback);

            function confirmCallback() {
                console.log("ok")
                $('#' + callBackId + ' option:selected').remove();
            }
            function optionalCancelCallback() {
                console.log("cancel")
            }

        })
    </script>


}


