@model Msr.Services.Parts.ViewModels.AddPartViewModel
@{
    ViewBag.Title = "Update Part";
}
@Styles.Render("~/bundles/css/fileinput")
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Edit Part
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                <section class="panel">
                    <div class="panel-body bio-graph-info part">
                        @Html.Partial("Message")
                        @using (Html.BeginForm("Edit", "Parts", FormMethod.Post, new { @class = "form form-horizontal partEdit", enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(x => x.ObjID, new { id = "ObjectId" })
                            @Html.HiddenFor(x => x.WfId)

                            <div class="form-group">
                                @Html.LabelFor(model => model.CompanyPartNumber, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.CompanyPartNumber, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.CompanyPartNumber, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
