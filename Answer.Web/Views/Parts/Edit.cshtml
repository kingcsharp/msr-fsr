                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.Consumable, Model.Consumables, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Consumable, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.CustomerSeeAvailability, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.CustomerSeeAvailability, Model.Availabilities, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.CustomerSeeAvailability, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.SupplierSeeAvailability, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.SupplierSeeAvailability, Model.Availabilities, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.SupplierSeeAvailability, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.SupplierSeeInstallBase, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.SupplierSeeInstallBase, Model.Availabilities, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.SupplierSeeInstallBase, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.SelectedInternalEqualParts, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.EditorFor(model => model.SelectedInternalEqualParts, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                        @Html.ValidationMessageFor(model => model.SelectedInternalEqualParts, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.InternalEqualParts, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.DropDownListFor(model => model.InternalEqualParts, Model.ListInternalEqualParts, new { @class = "form-control select" })
                                        @Html.ValidationMessageFor(model => model.InternalEqualParts, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(model => model.ExternalEqualParts, htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-8">
                                        @Html.ListBoxFor(model => model.ExternalEqualParts, Model.ListExternalEqualParts, new { @class = "form-control", @readonly = "readonly" })
                                        @Html.ValidationMessageFor(model => model.ExternalEqualParts, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                                <div class="form-group">
                                    <div class="col-md-offset-2 col-md-8">
                                        <input type="submit" value="Submit" class="btn btn-success" />
                                        @Html.ActionLink("Update & Update Min/Max Inventory Levels", "EditSafetyStock", new { id = Model.ObjID }, new { @class = "btn btn-success" })
                                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                                    </div>
                                </div>

                          }
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqueryval")
    @Scripts.Render("~/bundles/js/fileinput")
    <script type="text/javascript">

        $(document).ready(function() {

            var fileUploader = new FileUploader();

            fileUploader.InitEditUploader('input-files',
                '@Url.Action("FileUploaderBootstrap", "Doc")',
                [@Html.Raw(ViewBag.Preview)],
                @Html.Raw(ViewBag.PreviewConfig),
                '@Model.ObjID',
                true);

            if ('@Model.CreateProd' === '') {
                $('.hiddenpart').hide();
            } else {
                $('.hiddenpart').show();
            }

            $('#CreateProd').on('change',
                function() {
                    $('.hiddenpart').toggle();
                });

            $(".select").select2({
                placeholder: "Select",
                allowClear: true
            });

            $("form").submit(function() {
                $('.partEdit .submitselect option').prop('selected', true);
            });
        });

        function SelectIds() {
            new FileUploaderGrid().SelectIds();
        }

 $("#add-sub-part-row").click(function () {
            var index = 0;
            var rowsLength = $('#sub-parts tbody tr').length;
            if (rowsLength > 0) {
                index = rowsLength;
            }

            var dropdownProcess = $('#defaultProcessList').html();

            $('#sub-parts').append("<tr>" +
                "<td><select class='form-control default-template-id' name='SubPartList[" + index + "].PartId' required>" + dropdownProcess + "</select><span class=" + "text-danger field-validation-error" + " data-valmsg-for=" + "AddSubPartViewModels[" + index + "].PartId" + " data-valmsg-replace=" + "true" + "></span></td>" +
                "<td><input type='text' name='SubPartList[" + index + "].Qty'  class='form-control' value='' onkeyup = 'javascript:checkType(this)' required/><span class=" +
                "text-danger field-validation-error" + " data-valmsg-for=" + "SubPartList[" + index + "].Qty" + " data-valmsg-replace=" + "true" + "></span></td>" +
                "<td><input type='text' name='SubPartList[" + index + "].NickName' class='form-control' data-val-required='The Nick Name field is required.'/><span class=" + "text-danger field-validation-error" + " data-valmsg-for=" + "AddSubPartViewModels[" + index + "].NickName" + " data-valmsg-replace=" + "true" +"></span></td>" +
                "<td><button type='button'  class='btn btn-xs btn-danger' onclick = 'javascript: DeleteSubPart(this);' title=''><i class='fa fa-trash-o'></i></button></td></tr>");
        });


        function DeleteSubPart(e, value) {

            if (value != null && value !== '') {
                eModal.confirm('Are you sure?')
                    .then(confirmCallback, optionalCancelCallback);

                function confirmCallback() {
                    eLoaderOpen();
                    $.ajax({
                        type: "POST",
                        url: '/Parts/SubPartDelete/',
                        data: {
                            id: value
                        },
                        dataType: 'Json',
                        success: function(data) {
                            location.reload();
                            //eLoaderError(data);
                        },
                        error: function (error) {
                            eLoaderError(error);
                        }
                    });
                }

                function optionalCancelCallback() {}

            } else {
                $(e).closest("tr").remove();
            }

        }
    </script>
}