@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Parts";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-cog"></span>
                Parts 
                @Html.Partial("_HelpViewButton")
                
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="~/parts/AddPart" class="btn btn-success help-btn">Add</a>
            <a href="~/parts/import" class="btn btn-success help-btn">Import</a>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")

    <script src="~/assets/js/grids/parts.js"></script>

    <script>
        $.jgrid.defaults.styleUI = 'Bootstrap';

        $(document).ready(function () {
            SetUpGrid('@Request.Url.OriginalString');
        });
        
    </script>
}
