@{
    ViewBag.Title = "Parts";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-cog"></span>
                Parts
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-part"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <h1>PartsUpdated</h1>
        <div class="row">
            <a href="~/parts/AddPart" class="btn btn-success help-btn">Add</a>
            <a href="~/parts/import" class="btn btn-success help-btn">Import</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-parts")

    <script type="text/javascript">

        var hasAdministratorRole = '@User.IsInRole("Administrators")' === 'True';

        $(document).ready(function() {
            Msr.PartsGrid.LoadPartsGrid('@Url.Action("PartsData", "Parts")', hasAdministratorRole);
        });

    </script>
}
