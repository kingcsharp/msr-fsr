@model IEnumerable<Msr.Services.Companies.ViewModels.CompanyImportViewModel>
@{
    ViewBag.Title = "Companies Import";
}
<style>
    .validation-summary-errors {
        color: red;
    }
</style>
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Add File<button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-10">
                <div class="form-horizontal">
                    @Html.Partial("Message")
                    <div class="row">
                        <div class="alert alert-warning">
                            The Import File must be an Excel<br />
                            The file must have the column names as the first row capitalized and spelled like above<br />
                            The field definitions are<br />
                            ParentID = unique ID in the external database for the Parent Company. It can be blank<br />
                            ParentName = The name of theparent company. It can be blank<br />
                            ID = unique ID in the external database for the company. It can not be blank<br />
                            NAME_OF_CO<br />
                            ADDRESS_OF_CO<br />
                            CITY_OF_CO<br />
                            STATE_OF_CO<br />
                            ZIP_OF_CO<br />
                            COUNTRY_OF_CO<br />
                            SHIP_NAME_OF_CO<br />
                            SHIP_ADDRESS_OF_CO<br />
                            SHIP_CITY_OF_CO<br />
                            SHIP_STATE_OF_CO<br />
                            SHIP_ZIP_OF_CO<br />
                            SHIP_COUNTRY_OF_CO<br />
                            PHONE_OF_CO<br />
                            LINKED_ID_OF_CO<br />
                        </div>
                        <div class="alert alert-info">
                            <a class="btn btn-link" href="https://ra2.s3.amazonaws.com/Answer2/51029aae-b96f-46e5-bf04-b7ac1e9dffbc-Part.xlsx" target="_blank">Download excel file sample </a>
                        </div>
                    </div>
                    @using (Html.BeginForm("Import", "Companies", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()
                        <label class="btn btn-primary" for="postedFile">
                            <input id="postedFile" type="file" name="postedFile" accept="application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" style="display:none" onchange="$('#upload-file-info').html(this.files[0].name)" />
                            Browse...
                        </label>
                        <span class='label label-info' id="upload-file-info"></span><br />
                        <input type="submit" class="btn btn-success" value="Process Import" />
                    }
                </div>
