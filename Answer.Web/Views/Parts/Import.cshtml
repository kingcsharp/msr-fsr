@model IEnumerable<Msr.Services.Parts.ViewModels.ImportPartViewModel>

@{
    ViewBag.Title = "Parts Import";
}
<style>
    .validation-summary-errors {
        color: red;
    }
</style>

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Parts Import @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                <div class="form-horizontal">
                    <div class="row">
                        @Html.Partial("Message")
                        <div class="alert ">
                            The import file must be a tab delimited text file (.csv)<br/>
                            The file must have these columns in any order: PartId, PartName<br/>
                            If the partID already exists it will be updated with the new name. If it does not it will be created.<br/>
                            The file must have the column names as the first row capitalized and spelled like above.<br/>
                            The field defiitions are:<br/>
                            partID = The unique ID of the part in your external database.<br/>
                            partName = The parts name or description.
                        </div>
                    </div>

                    @using (Html.BeginForm("Import", "Parts", FormMethod.Post, new
                    { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary()

                        <table>
                            <tr>
                                <td>
                                    <label class="btn btn-primary" for="postedFile">
                                        <input id="postedFile" type="file" name="postedFile" accept=".csv" style="display:none"  />
                                        Browse...
                                    </label>
                                </td>
                                <td style="padding-left: 5px;">
                                    <input type="submit" class="btn btn-success" value="Process Import"/>
                                </td>
                                <td style="padding-left: 5px;">
                                    <a class="btn btn-link" href="~/Parts/ImportSampleFile" target="_blank">Download sample file </a>
                                </td>
                            </tr>
                        </table>
                    }
                </div>

                @if (Model!= null && Model.Any())
                    {
                        <h2>Number of records failed :@Model.Count()</h2>

                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.PartId)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Name)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Messages)
                                    </th>
                                  
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Where(x=> x.Processed == false))
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.PartId)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Name)
                                        </td>
                                        <td>
                                            @foreach (var message in item.Messages)
                                            {
                                                @message <br/>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
            </div>
        </div>
    </div>
</div>