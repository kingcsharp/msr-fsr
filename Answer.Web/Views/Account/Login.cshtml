@using Msr.Web.Models
@model LoginViewModel
@{
    ViewBag.Title = "Log in";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div id="login" class="">
    <h1>Answer 2.0</h1>
    <section class="login animated bounceIn">
       @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", id= "loginForm" }))
       {
           @Html.Partial("Message")
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "color-red" })

        @Html.TextBoxFor(m => m.User, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.User, "", new { @class = "text-danger" })

        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "color-red" })
        @Html.CheckBoxFor(m => m.RememberMe)
           <label class="check" for="remember"><span></span>Remember Me</label>
           <div class="clear"></div>
           
           <input id="go-home" type="button" value="Login" onclick="javascript: document.getElementById('loginForm').submit();"/>
       }
    </section>
    <div class="forgot"><a href="~/account/forgotpassword">Forgot Password?</a></div>
</div>

@section Scripts {
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
}