@using Msr.Web.Models
@model ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div id="login" class="">
    <h1>Answer 2.0</h1>
    <section class="login animated bounceIn">
        @using (Html.BeginForm("ForgotPassword", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", id = "loginForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "color-white" })

            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder="Enter User Name" })
            @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "color-white" })
           
            <div class="clear"></div>
            <input id="go-home" type="button" value="Submit" onclick="javascript: document.getElementById('loginForm').submit();" />
        }
    </section>
    <div class="forgot"><a href="~/account/login">Login</a></div>
</div>

@section Scripts {
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
}

