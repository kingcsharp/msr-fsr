@using Msr.Services.Helps
@{

    var helpUrl =  HttpContext.Current.Request.RequestContext.RouteData.Values["controller"] +"/"+ @HttpContext.Current.Request.RequestContext.RouteData.Values["action"];

    helpUrl = "/" + helpUrl.ToLower().Replace("/index", "");

    var helpService = new HelpService();
    
    var vm = helpService.CanViewHelpPage(helpUrl, HttpContext.Current.User.Identity.Name);
 }

@if(vm.CanView)
{
    <button class="btn btn-info pull-right page-help" style="margin-left:10px;" data-page-url="@helpUrl">Help</button>
}
