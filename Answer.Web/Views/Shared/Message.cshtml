
@if (!String.IsNullOrEmpty(TempData["ErrorMessage"] as string))
   {
      <div class="alert alert-danger"> @Html.Raw(TempData["ErrorMessage"].ToString()) </div>       
   }
   else if (!String.IsNullOrEmpty(TempData["SuccessMessage"] as string))
   {
       <div class="alert alert-success"> @Html.Raw(TempData["SuccessMessage"].ToString()) </div>       
   }
   else if (!String.IsNullOrEmpty(TempData["WarningMessage"] as string))
   {       
       <div class="alert alert-warning"> @Html.Raw(TempData["WarningMessage"].ToString()) </div>        
   }
   else if (!String.IsNullOrEmpty(TempData["InformationMessage"] as string))
   {
        <div class="alert alert-info"> @Html.Raw(TempData["InformationMessage"].ToString()) </div>        
   }
  else
   {    
       
    }
