@using Answer.Web.Helpers
@using Answer.Web.ViewModel
@using Msr.Services.Users
@{
    var baseViewModel  = new BaseViewModel();

    if (User.Identity.IsAuthenticated && !string.IsNullOrWhiteSpace(User.Identity.Name))
    {
        ////TODO This need to be done with a better way
        var userService = new UserService();
        baseViewModel.LoggedUserIdResult = userService.GetUserId(User.Identity.Name);

        if (baseViewModel.LoggedUserIdResult != null)
        {
            baseViewModel.MenuViewModel = UIPermissionHelper.GetUserMenuPermissions(baseViewModel.LoggedUserIdResult);
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href='http://fonts.googleapis.com/css?family=Roboto+Condensed:300,400' rel='stylesheet' type='text/css'>
    <link href='http://fonts.googleapis.com/css?family=Lato:300,400,700,900' rel='stylesheet' type='text/css'>
    @Styles.Render("~/bundles/css/main")
</head>
<body class="flat-blue">
    <div class="app-container">
        <div class="row content-container">
            @Html.Partial("_Header", baseViewModel)
            @Html.Partial("_SideBar", baseViewModel)

            @RenderBody()

            @Html.Partial("_ModalWipHelp")
            @Html.Partial("_ModalWipWindows")
            @Html.Partial("_SupportForm")

            <div id="emodel" class="modal fade" role="dialog">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body" style="text-align:center;">
                            <span class="fa fa-circle-o-notch fa-spin fa-3x text-primary"></span><span class="h4"> Operations are in progress, please wait</span>
                        </div>
                        <div class="modal-footer">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @Html.Partial("_Footer")
        @Scripts.Render("~/bundles/js/main")
        @RenderSection("scripts", false)
        @Scripts.Render("~/bundles/js/jgridDefaults")
        
    </div>
</body>
</html>

