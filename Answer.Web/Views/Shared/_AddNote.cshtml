@model Answer.Web.ViewModel.Notes.AddNoteViewModel

@using (Html.BeginForm("AddUser", "User", FormMethod.Post, new { @class = "form form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label class="col-lg-2 control-label">Comment</label>
        <div class="col-lg-6">
            @Html.TextAreaFor(m => m.Comment, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Comment)
        </div>
    </div>
    <div class="form-group">
        <label class="col-lg-2 control-label">Confidentiality</label>
        <div class="col-lg-6">
            @Html.DropDownListFor(m => m.Confidentiality, Model.ConfidentialityList, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Comment)
        </div>
    </div>
}



