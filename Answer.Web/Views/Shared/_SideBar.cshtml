@using Msr.Models.Menus
@model Answer.Web.ViewModel.BaseViewModel

<div class="side-menu sidebar-inverse">
    <nav class="navbar navbar-default" role="navigation">
        <div class="side-menu-container">
            <div class="navbar-header">
                <a class="navbar-brand" href="#">
                    <div class="icon fa fa-paper-plane"></div>
                    <div class="title">Answer 2.0</div>
                </a>
                <button type="button" class="navbar-expand-toggle pull-right visible-xs" data-intro="Toggle the sidebar usting this button" data-position="right">
                    <i class="fa fa-times icon"></i>
                </button>
            </div>

            <ul class="nav navbar-nav">
                @if (Model.MenuViewModel != null && Model.MenuViewModel.UserModules.Any())
                {
                    foreach (var menuGroup in Model.MenuViewModel.UserModules.OrderBy(o => o.OrderNumber).GroupBy(x => new { x.GroupMenu, x.GroupIcon }))
                    {
                        if (menuGroup.First().IsParent)
                        {
                            <li class="panel panel-default dropdown">
                                <a href="~/@menuGroup.First().Url">
                                    <span class="icon fa @menuGroup.First().Icon"></span><span class="title">@menuGroup.First().Name</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="panel panel-default dropdown">
                                <a data-toggle="collapse" href="#dropdown-element-@menuGroup.Key.GroupMenu">
                                    <span class="icon fa @menuGroup.Key.GroupIcon"></span><span class="title">@menuGroup.Key.GroupMenu</span>
                                </a>
                                <div id="dropdown-element-@menuGroup.Key.GroupMenu" class="panel-collapse collapse">
                                    <div class="panel-body">
                                        <ul class="nav navbar-nav">
                                            @foreach (var menuItem in menuGroup)
                                            {
                                                <li>
                                                    @if (menuItem.Name == MenuGroupConstants.OpenASupportTicket)
                                                    {
                                                        <a href="~/@menuItem.Url" data-toggle="modal" data-target="#support-model">
                                                            <span class="icon fa @menuItem.Icon"></span><span class="title">@menuItem.Name</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a href="~/@menuItem.Url" title="@menuItem.Name">
                                                            <span class="icon fa @menuItem.Icon"></span><span class="title">@menuItem.Name</span>
                                                        </a>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        }
                    }
                }
            </ul>
        </div>
    </nav>
</div>