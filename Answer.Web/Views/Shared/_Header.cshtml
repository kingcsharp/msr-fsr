@model Answer.Web.ViewModel.BaseViewModel

<nav class="navbar navbar-default navbar-fixed-top navbar-top">
    <div class="container-fluid">
        <div class="navbar-header">
            <button type="button" class="navbar-expand-toggle" data-intro="Toggle the sidebar using this button" data-position="right">
                <i class="fa fa-bars icon"></i>
            </button>
            <ol class="breadcrumb navbar-breadcrumb">
                <li class="active">@ViewBag.Title</li>
            </ol>
            <button type="button" class="navbar-right-expand-toggle pull-right visible-xs">
                <i class="fa fa-th icon" data-intro="Toggle the sidebar using this button" data-position="right"></i>
            </button>
        </div>
        <ul class="nav navbar-nav navbar-right">
            <button type="button" class="navbar-right-expand-toggle pull-right visible-xs">
                <i class="fa fa-times icon"></i>
            </button>
           
            @if (Model.LoggedUserIdResult != null)
            {
                <li class="dropdown profile">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false" data-intro="View your profile or logout here" data-position="bottom">@Model.LoggedUserIdResult.Name @Model.LoggedUserIdResult.Last_Name <span class="caret"></span></a>
                    <ul class="dropdown-menu animated fadeInDown">
                        <li>
                            <div class="profile-info">
                                <h4 class="username"> @Model.LoggedUserIdResult.Name @Model.LoggedUserIdResult.Last_Name </h4>
                                
                                <div class="btn-group margin-bottom-2x" role="group">
                                    <a href="~/user/profile" class="btn btn-default"><i class="fa fa-user"></i> Profile</a>
                                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new {id = "logoutForm", @class = "navbar-right"}))
                                    {
                                        @Html.AntiForgeryToken()
                                        <a href="javascript:document.getElementById('logoutForm').submit()" class="btn btn-default"><i class="fa fa-sign-out"></i>Logout</a>
                                    }
                                </div>
                            </div>
                        </li>
                    </ul>
                </li>
            }
        </ul>
    </div>
</nav>