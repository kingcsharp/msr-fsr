@using Answer.Web.Helpers
@using Msr.Services.Workflows
@model Answer.Web.ViewModel.BaseViewModel

@{
    var notifications = new PendingApprovalService().GetNotifications();
}

<nav class="navbar navbar-default navbar-fixed-top navbar-top">
    <div class="container-fluid">
        <div class="navbar-header">
            <button type="button" class="navbar-expand-toggle" data-intro="Toggle the sidebar using this button" data-position="right">
                <i class="fa fa-bars icon"></i>
            </button>
            <ol class="breadcrumb navbar-breadcrumb">
                <li class="active">@ViewBag.Title</li>
            </ol>
            <button type="button" class="navbar-right-expand-toggle pull-right visible-xs">
                <i class="fa fa-th icon" data-intro="Toggle the sidebar using this button" data-position="right"></i>
            </button>
        </div>
        <ul class="nav navbar-nav navbar-right">
            <button type="button" class="navbar-right-expand-toggle pull-right visible-xs">
                <i class="fa fa-times icon"></i>
            </button>
            <li>
                <form class="navbar-form" role="search">
                    <div class="input-group">
                        <input class="form-control" placeholder="Search" name="srch-term" id="srch-term" style="margin-top: 5px;" type="text">
                        <div class="input-group-btn">
                            <button class="btn btn-info" type="submit"><i class="glyphicon glyphicon-search"></i></button>
                        </div>
                    </div>
                </form>
            </li>
            <li class="dropdown danger">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false"><i class="fa fa-bell" data-intro="View your notificiations" data-position="bottom"></i> @notifications.Total</a>
                <ul class="dropdown-menu danger  animated fadeInDown">
                    <li class="title">
                        Notification <span class="badge pull-right">@notifications.Total</span>
                    </li>
                    @if (notifications.Items.Any())
                    {
                        <li>
                            <ul class="list-group notifications">
                                @foreach (var item in notifications.Items)
                                {
                                    <a href="~/PendingApproval?itemType=@item.ItemType">
                                        <li class="list-group-item">
                                            <span class="@notifications.IconCssList.Dequeue()">@item.ItemCount</span> <i class="@(item.ItemType.GetNotificationIconCss())"></i> @item.Title
                                        </li>
                                    </a>
                                }
                                <a href="~/PendingApproval">
                                    <li class="list-group-item message">
                                        View all
                                    </li>
                                </a>
                            </ul>
                        </li>
                    }
                </ul>
            </li>
           
            @if (Model.LoggedUserIdResult != null)
            {
                <li class="dropdown profile">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false" data-intro="View your profile or logout here" data-position="bottom">
                        @Model.LoggedUserIdResult.Name @Model.LoggedUserIdResult.Last_Name <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu animated fadeInDown">
                        <li>
                            <div class="profile-info">
                                <h4 class="username"> @Model.LoggedUserIdResult.Name @Model.LoggedUserIdResult.Last_Name </h4>
                                
                                <div class="btn-group margin-bottom-2x" role="group">
                                    <a href="~/user/profile" class="btn btn-default"><i class="fa fa-user"></i> Profile</a>
                                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new {id = "logoutForm", @class = "navbar-right"}))
                                    {
                                        @Html.AntiForgeryToken()
                                        <a href="javascript:document.getElementById('logoutForm').submit()" class="btn btn-default"><i class="fa fa-sign-out"></i>Logout</a>
                                    }
                                </div>
                            </div>
                        </li>
                    </ul>
                </li>
            }
        </ul>
    </div>
</nav>