@model Msr.Services.Users.ViewModels.ClientBuyerEmailTemplateViewModel

@{
    Layout = null;
}

<p>Welcome <strong>@Model.CompanyName</strong></p>

<p>You have been invited and authorized as a Client Administrator  for the MSR-FSR Portal System for  <strong>@Model.CompanyName </strong>.</p>

Please follow the link below and select a unique password to gain secure access to your Organization's User Dashboard. As a Client Administrator, you have permission to Add Users to the system for your organization. Once you assign an issue to a User, he/she is notified by email and they can access a Personal Dashboard and organizational information related to MSR-FSR Work Orders and Invoice information.

If you need assistance or have questions, please click the Help link also located on the main navigation bar or email <strong>answer-support@msr-fsr.com</strong>

<p>
    Please <a href="@Model.ResetPasswordUrl"> click here</a>or navigate to the following url to set your new account password: <br/>
    @Model.ResetPasswordUrl
</p>
