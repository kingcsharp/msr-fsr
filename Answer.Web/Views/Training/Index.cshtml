@{
    ViewBag.Title = "Training";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-cog"></span>
                Training Certifications
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-training"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>

        <div class="row">
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-training")

    <script type="text/javascript">

        var hasAdministratorRole = '@User.IsInRole("Administrators")' === 'True';

        $(document).ready(function() {
            Msr.TrainingGrid.LoadTrainingGrid('@Url.Action("TrainingData", "Training")', hasAdministratorRole);
        });

    </script>
}
