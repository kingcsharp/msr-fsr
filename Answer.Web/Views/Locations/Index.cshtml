@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Locations";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-map"></span>
                Locations @Html.Partial("_HelpViewButton")
            </h2>
            <div style="width:100%;">
                @Html.Partial("Message")
                <table id="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="/Locations/Create" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-locations")
    
    <script type="text/javascript">

        $(document).ready(function() {

            SetUpGrid('@Request.Url.OriginalString');

        });
    </script>

}