@model Msr.Services.CustomerRequirements.ViewModel.CustomerRequirementViewModel

<style>
    .form-horizontal .control-label {
        text-align: right !important;
    }
</style>
<div class="container-fluid requirementsPrint">
    <div class="row">
        <div class="col-lg-11">
            <h2 class="page-header">Customer Requirements</h2>
        </div>
        <div class="col-lg-1">
            <button type="button" class="btn btn-info pull-right hidden-print printThis"><i class="fa fa-print"></i> Print </button>
        </div>
        <div class="col-lg-12">
            <form action="" id="formentry" class="form-horizontal" role="form">
                <div class="container-fluid shadow">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label col-lg-2 col-md-3" for="requirementName">Requirement Name:</label>
                                <div class="controls col-lg-10 col-md-9">
                                    @Html.EditorFor(model => model.RequirementName, new { htmlAttributes = new { @class = "form-control input-lg", @value = "7" } })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label col-lg-2 col-md-3" for="location">Location:</label>
                                <div class="controls col-lg-10 col-md-9">
                                    @Html.EditorFor(model => model.Location, new { htmlAttributes = new { @class = "form-control input-lg", @value = "7" } })
                                </div>
                            </div>
                        </div>
                     
                    </div>
                    <div class="row">
                        <div class="panel panel-primary">
                            <div class="panel-heading">Customer Information</div>
                            <div class="panel-body">
                                <div class="col-md-8">
                                    <div class="form-group" style="display: block;">
                                        <label class="control-label control-label-right col-sm-4" for="field7">Company:</label>
                                        <div class="controls col-sm-8">
                                            @Html.EditorFor(model => model.Company, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                    <div class="form-group" style="display: block;">
                                        <label class="control-label  col-sm-4" for="field9">Street Address:</label>
                                        <div class="controls col-sm-8">
                                            @Html.EditorFor(model => model.StreetAddress, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-4" for="field21">Division / Fab #:</label>
                                        <div class="controls col-sm-8">
                                            @Html.EditorFor(model => model.DivisionFab, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-4" for="field22">City, State, ZIP:</label>
                                        <div class="controls col-sm-8">
                                            @Html.EditorFor(model => model.CityStateZIP, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>

                                </div>
                                <div class="col-md-6" style="width:50%;float: left">
                                    <div id="panel15" class="panel panel-default" data-role="panel" style="display: block;">
                                        <div class="panel-heading">Commercial Contact Info</div>
                                        <div class="panel-body">
                                            <div class="form-group">
                                                <label class=" col-sm-3" for="field17">Name</label>
                                                <div class="controls col-sm-9">
                                                    @Html.EditorFor(model => model.CommercialName, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class=" col-sm-3" for="field18">Title</label>
                                                <div class="controls col-sm-9">
                                                    @Html.EditorFor(model => model.CommercialTitle, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class=" col-sm-3" for="field19">Phone</label>
                                                <div class="controls col-sm-9">
                                                    @Html.EditorFor(model => model.CommercialPhone, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class=" col-sm-3" for="field20">Email</label>
                                                <div class="controls col-sm-9">
                                                    @Html.EditorFor(model => model.CommercialEmail, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6" style="width:50%;float: right">
                                    <div id="panel23" class="panel panel-default" data-role="panel">
                                        <div class="panel-heading">Technical Contact Info:</div>
                                        <div class="panel-body">
                                            <div class="form-group">
                                                <label class=" col-sm-3" for="field24">Name</label>
                                                <div class="controls col-sm-9">
                                                    @Html.EditorFor(model => model.TechnicalName, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class=" col-sm-3" for="field26">Title</label>
                                                <div class="controls col-sm-9">
                                                    @Html.EditorFor(model => model.TechnicalTitle, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class=" col-sm-3" for="field25">Phone</label>
                                                <div class="controls col-sm-9">
                                                    @Html.EditorFor(model => model.TechnicalPhone, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class=" col-sm-3" for="field27">Email</label>
                                                <div class="controls col-sm-9">
                                                    @Html.EditorFor(model => model.TechnicalEmail, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-primary">
                            <div class="panel-heading">General Information</div>
                            <div class="panel-body">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field28">Short Description:</label>
                                        <div class="controls col-sm-9">
                                            @Html.EditorFor(model => model.ShortDescription, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field29">Part /Kit No:</label>
                                        <div class="controls col-sm-9">
                                            @Html.EditorFor(model => model.PartKitNo, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field33">Customer Specifications (if any):</label>
                                        <div class="controls col-sm-9">
                                            @Html.TextAreaFor(model => model.CustomerSpecifications, new { @class = "form-control", style = "width:580", @rows = 3 })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field37">In-Process Analytical Requirements:</label>
                                        <div class="controls col-sm-9">
                                            @Html.TextAreaFor(model => model.InProcessAnalyticalRequirements, new { @class = "form-control", style = "width:580", @rows = 3 })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field30">Detailed Description of Requested Service(s):</label>
                                        <div class="controls col-sm-9">
                                            @Html.TextAreaFor(model => model.DetailedDescription, new { @class = "form-control", style = "width:580", @rows = 3 })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field36">Critical-to-Function Attributes:</label>
                                        <div class="controls col-sm-9">
                                            @Html.TextAreaFor(model => model.CriticalToFunction, new { @class = "form-control", style = "width:580", @rows = 3 })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field35">Specific Customer Qualification Requirements:</label>
                                        <div class="controls col-sm-9">
                                            @Html.TextAreaFor(model => model.SpecificCustomerQualification, new { @class = "form-control", style = "width:580", @rows = 3 })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field34">Forecasted Volumes &amp; Start Dates:</label>
                                        <div class="controls col-sm-9">
                                            @Html.TextAreaFor(model => model.ForecastedVolumes, new { @class = "form-control", style = "width:580", @rows = 3 })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field38">Special Packaging/Shipping:</label>
                                        <div class="controls col-sm-9">
                                            @Html.TextAreaFor(model => model.SpecialPackagingShipping, new { @class = "form-control", style = "width:580", @rows = 3 })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field40">Expected Quote Date:</label>
                                        <div class="controls col-sm-9">
                                            @*<input id="field40" class="form-control" value="2/21/2017" type="date">*@
                                            @Html.EditorFor(model => model.ExpectedQuoteDate, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field41">Pickup Notification:</label>
                                        <div class="controls col-sm-9">
                                            @Html.EditorFor(model => model.PickupNotification, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field42">Expected Cycle Time:</label>
                                        <div class="controls col-sm-9">
                                            @Html.EditorFor(model => model.ExpectedCycleTime, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label  col-sm-3" for="field43">Shipping Method:</label>
                                        <div class="controls col-sm-9">
                                            @Html.DropDownListFor(model => model.ShippingMethod, Model.ShippingMehtodList, "--Select Shipping Method--", new { @class = "form-control no-radius" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-primary">
                            <div class="panel-heading">Contaminant Information</div>
                            <div class="panel-body">
                                <div class="row clearfix">
                                    <div class="col-md-12 column">
                                        <table class="table table-bordered table-hover table-striped table-condensed" id="process_steps">
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        Row #
                                                    </th>
                                                    <th class="text-center">
                                                        Contaminents By-Products
                                                    </th>
                                                    <th class="text-center">
                                                        Non-CU or CU Risk
                                                    </th>
                                                    <th class="text-center">
                                                        Material
                                                    </th>
                                                    <th class="text-center">
                                                        Approx. Dimensions
                                                    </th>
                                                    <th class="text-center">
                                                        Existing Process Spec. # or New
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.Process)
                                                {
                                                    <tr id="row0">
                                                        <td>
                                                            @Html.EditorFor(model => item.Id, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.Contaminents, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.NonCU, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.Material, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.ApproxDimensions, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.ExistingProcess, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                    </tr>
                                                }
                                                <tr id="row1"></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-primary">
                            <div class="panel-heading">Kit Breakdown by Part</div>
                            <div class="panel-body">
                                <div class="row clearfix">
                                    <div class="col-md-12 column">
                                        <table class="table table-bordered table-hover table-striped table-condensed" id="kit_parts">
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        Row #
                                                    </th>
                                                    <th class="text-center">
                                                        Part Description
                                                    </th>
                                                    <th class="text-center">
                                                        Substrate
                                                    </th>
                                                    <th class="text-center">
                                                        Coating/Surface Treatment
                                                    </th>
                                                    <th class="text-center">
                                                        Cust. Part No.
                                                    </th>
                                                    <th class="text-center">
                                                        Mfg. Part No.
                                                    </th>
                                                    <th class="text-center">
                                                        # Parts per Kit
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.Parts)
                                                {
                                                    <tr id="row0">
                                                        <td>
                                                            @Html.EditorFor(model => item.Id, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.PartDescription, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.Substrate, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.CoatingSurface, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.CustPartNo, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.MfgPartNo, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                        <td>
                                                            @Html.EditorFor(model => item.PartsPerKit, new { htmlAttributes = new { @class = "form-control", @value = "7" } })
                                                        </td>
                                                    </tr>
                                                }
                                                <tr id="rowa-1"></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="panel panel-primary">
                            <div class="panel-heading">Additional Information</div>
                            <div class="panel-body">
                                <div class="form-group">
                                    <label class="" for="field63">Additional Information or Comments</label>
                                    <div class="controls">
                                        @Html.TextAreaFor(model => model.AdditionalInformation, new { @class = "form-control", style = "width:820", @rows = 3 })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script type="text/javascript">
    $('.printThis').on('click', function () {
        $('.requirementsPrint').printThis({
            debug: true,
            importCSS: true,
            importStyle: true,
        });
    })
</script>