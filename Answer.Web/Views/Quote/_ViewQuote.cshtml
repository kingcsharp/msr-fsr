@model Msr.Services.Quotes.ViewModels.FreeFormQuoteViewModel
<style>
    .no-border {
        border-bottom: 0px !important;
    }

    .no-border th, .no-border td {
        border: 1px !important;
    }

    .quote-header th {
        text-align: right;
    }

    .items-table th {
        text-align: center;
    }

    .items-table > tbody > tr > td {
        min-height: 35px;
        height: 35px;
    }

    .line-caption {
        font-size: 9px;
        padding-top: 2px !important;
    }
</style>
<table class="table no-border" width="100%">
    <tbody>
        <tr>
            <td rowspan="2" width="60%" align="left"><img src="~/assets/img/msr-ccs.png" alt="MSR-FSR Critical Component Services"></td>
        </tr>
        <tr>
            <th align="right">Part / Kit No.:</th>
            <td>@Html.DisplayFor(x => x.PartKitNo)</td>
        </tr>
        <tr>
            <td colspan="3" align="center"><h2>Quotation</h2></td>
        </tr>
        <tr>
            <td colspan="3"></td>
        </tr>
    </tbody>
</table>
<table class="table quote-header" width="100%">
    <tbody>
        <tr>
            <th width="20%">Date: </th>
            <td width="30%">@Html.DisplayFor(x => x.Date)</td>
            <th width="20%">Customer Name:</th>
            <td width="30%">@Html.DisplayFor(x => x.CustomerName)</td>
        </tr>
        <tr>
            <th align="right">Supplier Name:</th>
            <td>@Html.DisplayFor(x => x.SupplierName)</td>
            <th align="right">Commercial Contact:</th>
            <td>@Html.DisplayFor(x => x.Contact)</td>
        </tr>
        <tr>
            <th align="right">
                Quote :
            </th>
            <td>@Html.DisplayFor(x => x.ProductId)</td>
            <th align="right">Title</th>
            <td>@Html.DisplayFor(x => x.Title)</td>
        </tr>
        <tr>
            <th align="right">Delivery:</th>
            <td>@Html.DisplayFor(x => x.Delivery)</td>
            <th align="right">Phone:</th>
            <td>
                @if (!string.IsNullOrWhiteSpace(Model.PhoneCSR))
                {
                    @Html.DisplayFor(x => x.PhoneCSR)
                }
                else
                {
                    @Html.DisplayFor(x => x.Phone)
                }
            </td>
        </tr>
        <tr>
            <th align="right">Cycle Time:</th>
            <td>@Html.DisplayFor(x => x.CycleTime)</td>
            <th align="right">Email:</th>
            <td>@Html.DisplayFor(x => x.Email)</td>
        </tr>
        <tr>
            <td colspan="4"></td>
        </tr>
    </tbody>
</table>
<table class="table table-bordered table-striped items-table" width="100%">
    <thead>
        <tr>
            <th>Item No.</th>
            <th>Quantity</th>
            <th>Unit</th>
            <th style="text-align: left !important">Description</th>
            <th>Price</th>
            <th>Extension</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.QuoteItems)
        {
            var index = 1;
            <tr>
                <td align="center">@index</td>
                <td align="center">@item.Quantity</td>
                <td align="center">Unit</td>
                <td>@Model.ProcessDescription</td>
                <td align="center">@item.Price.GetValueOrDefault().ToString("C")</td>
                <td align="center">@item.Extension.GetValueOrDefault().ToString("C")</td>
            </tr>
            index = index + 1;
        }
    </tbody>
</table>
<br />
<table class="table table-bordered table-striped items-table" width="100%">
    <thead>
        <tr>
            <th style="text-align: left;">Existing Process Spec. # or New</th>
        </tr>
    </thead>
    <tr>
        <td class="align-left">@Model.ExistingProcess</td>
    </tr>
</table>
<table class="table" width="100%">
    <tbody>
        <tr>
            <td width="100%">
                <small>
                    This quotation is subject to the following terms and conditions, and is good only for 30 Days from date of quotation.<br>
                    <ol>
                        <li>
                            All orders tendered to MSR-FSR are subject to credit approval and final acceptance by MSR-FSR<br>
                            MSR-FSR reserves the right to refuse any order tendered pursuant
                            to this quotation without incurring any liability because of such
                            refusal.
                        </li>
                        <li>
                            MSR-FSR guarantees to the purchaser that all goods sold
                            pursuant to an accepted purchase order(s) shall conform to MSR-FSR
                            process specifications and shall be free from defects in materials and
                            workmanship. MSR-FSR expressly disclaims all other warranties, whether
                            express, implied or statutory, including the warranty of merchantability
                            and fitness for use.<br>
                            In no event will MSR-FSR be liable for consequential damages arising out of the use of the products described herein.
                        </li>
                        <li>
                            MSR-FSR will use its reasonably best efforts to expedite the
                            delivery of any goods sold: however, MSR-FSR does not guarantee any
                            specific delivery date nor assume any responsibility for delays due to
                            any cause beyond the control of MSR-FSR.
                        </li>
                        <li>
                            Prices indicated are good for thirty (30) days from date of
                            this quotation and based on quantities specificed unless otherwise
                            noted.
                        </li>
                        <li>
                            Prices are in USD unless specified otherwise. If services are
                            provided outside of the US and in USD, pricing may be adjusted based on
                            foreign currency effects.
                        </li>
                        <li>
                            This quote is based on a projected process flow derived from
                            best known methods, and may require re-negotiation and change based on
                            subsequent validation results or process changes.
                        </li>
                    </ol>
                </small>
            </td>
        </tr>
    </tbody>
</table>
<table class="table  no-border" width="100%">
    <tbody>
        <tr>
            <td colspan="5" width="60%"></td>
            <td colspan="2">Respectfully submitted,</td>
        </tr>
        <tr>
            <td colspan="5" width="60%"></td>
            <td style="border-bottom: 1px solid #000 !important;" width="20%">@Html.DisplayFor(x => x.CreatedBy)</td>
            <td style="border-bottom: 1px solid #000 !important;" width="30%">@Html.DisplayFor(x => x.TitleSubmit)</td>
        </tr>
        <tr>
            <td colspan="5" width="60%"></td>
            <td class="line-caption" width="20%">Created By</td>
            <td class="line-caption" width="30%">Title</td>
        </tr>
        <tr>
            <td colspan="5" width="60%"></td>
            <td colspan="2" style="border-bottom: 1px solid #000 !important;" width="40%"></td>
        </tr>
        <tr>
            <td colspan="5" width="60%"></td>
            <td colspan="2" class="line-caption" width="40%">Address</td>
        </tr>
        <tr>
            <td colspan="5" width="60%"></td>
            <td colspan="2" width="40%">@Model.AddressSubmit</td>
        </tr>
    </tbody>
</table>
