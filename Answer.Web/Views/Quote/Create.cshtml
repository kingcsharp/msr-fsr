@model Msr.Services.Quotes.ViewModels.FreeFormQuoteViewModel
@{
    ViewBag.Title = "FreeForm Quote";
}
<div class="app-container">
    <div class="row content-container">
        <div class="container">
            <div class="side-body padding-top">
                @using (Html.BeginForm())
                {
                    @Html.Partial("Message")

                    @Html.AntiForgeryToken()

                    <div class="row">
                        <h2 class="page-header">
                            <span class="icon fa fa-usd"></span>
                            Freeform Quote <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
                        </h2>
                        <table class="table no-border quote-header" width="100%">
                            <tbody>
                                <tr>
                                    <td rowspan="2" width="60%" align="left"><img src="~/assets/img/msr-ccs.png" alt="MSR-FSR Critical Component Services"></td>
                                    <th align="right">
                                        Date:
                                    </th>
                                    <td>
                                        <div class="input-group datepicker">
                                            @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control datepicker" } })
                                            <span class="input-group-addon">
                                                <span class="glyphicon glyphicon-calendar fa fa-calendar"></span>
                                            </span>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2"></td>
                                </tr>
                                <tr>
                                    <td colspan="3" align="center">
                                        <h2>Quotation</h2>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3"></td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table quote-header" width="100%">
                            <tbody>
                                <tr>
                                    <th align="right">Customer:</th>
                                    <td>
                                        @Html.DropDownListFor(model => model.CustomerId, Model.Customers, "Select Customer", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.CustomerId, "", new { @class = "text-danger" })
                                    </td>
                                    <th align="right">Contact:</th>
                                    <td>
                                        @Html.EditorFor(model => model.Contact, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Contact, "", new { @class = "text-danger" })
                                    </td>
                                    <th align="right">F.O.B.:</th>
                                    <td>
                                        @Html.EditorFor(model => model.FOB, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.FOB, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <th align="right">Supplier :</th>
                                    <td>
                                        @Html.DropDownListFor(model => model.Supplier, Model.Suppliers, "Select Supplier", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Supplier, "", new { @class = "text-danger" })
                                </td>

                                    <th align="right">Title:</th>
                                    <td>
                                        @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                                    </td>
                                    <th align="right">Terms:</th>
                                    <td>
                                        @Html.EditorFor(model => model.Terms, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Terms, "", new { @class = "text-danger" })
                                    </td>
                                   
                                </tr>
                                <tr>
                                    <th align="right"></th>
                                    <td></td>

                                    <th align="right">Phone:</th>
                                    <td>
                                        @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                                    </td>
                                    <th align="right">Delivery:</th>
                                    <td>
                                        @Html.EditorFor(model => model.Delivery, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Delivery, "", new { @class = "text-danger" })
                                    </td>                                
                                </tr>

                                <tr>
                                    <td colspan="6"></td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table table-bordered table-striped items-table" width="100%" id="quote_items">
                            <thead>
                                <tr>
                                    <th width="10%">Item No.</th>
                                    <th width="10%">Quantity</th>
                                    <th width="30%" style="text-align: left !important">Description</th>
                                    <th>Lead Time</th>
                                    <th>Customer Part No.</th>
                                    <th>Price</th>
                                    <th>Extension</th>
                                </tr>
                            </thead>
                            <tbody>

                                @for (int i = 0; i < Model.QuoteItems.Count; i++)
                                {
                                    <tr id="row0">
                                        <td>
                                            @(i + 1)
                                        </td>
                                        <td>
                                            @Html.TextBoxFor(x => Model.QuoteItems[i].Quantity, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(x => Model.QuoteItems[i].Quantity, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.TextBoxFor(x => Model.QuoteItems[i].Description, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(x => Model.QuoteItems[i].Description, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.TextBoxFor(x => Model.QuoteItems[i].LeadTime, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(x => Model.QuoteItems[i].LeadTime, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.TextBoxFor(x => Model.QuoteItems[i].CustomerPartNo, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(x => Model.QuoteItems[i].CustomerPartNo, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.TextBoxFor(x => Model.QuoteItems[i].Price, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(x => Model.QuoteItems[i].Price, "", new { @class = "text-danger" })
                                        </td>
                                        <td>
                                            @Html.TextBoxFor(x => Model.QuoteItems[i].Extension, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(x => Model.QuoteItems[i].Extension, "", new { @class = "text-danger" })
                                        </td>
                                    </tr>
                                }
                                <tr id="row1"></tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7">
                                        <a id="add_row" class="btn btn-primary pull-left" data-toggle="tooltip" data-placement="top" title="" data-original-title="Add an Item to the Quote"><i class="fa fa-plus-circle"></i> Add Item</a>
                                        <a id="delete_row" class="pull-left btn btn-warning" style="margin-left: 10px;" data-toggle="tooltip" data-placement="top" title="" data-original-title="Removes Last Item from the Quote"><i class="fa fa-minus-circle"></i> Remove Item</a>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                        <table class="table table-bordered table-striped items-table" width="100%" id="process_specs">
                            <thead>
                                <tr>
                                    <th width="20%">Existing Process Spec. # or New</th>
                                    <th width="80%">Process Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        @Html.TextAreaFor(model => model.ExistingProcess, new { @class = "form-control", style = "width:100", @rows = 3 })
                                        @Html.ValidationMessageFor(model => model.ExistingProcess, "", new { @class = "text-danger" })
                                    </td>
                                    <td>
                                        @Html.TextAreaFor(model => model.ProcessDescription, new { @class = "form-control", style = "width:100", @rows = 3 })
                                        @Html.ValidationMessageFor(model => model.ProcessDescription, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table" width="100%">
                            <tbody>
                                <tr>
                                    <td width="100%">
                                        <small>
                                            This quotation is subject to the following terms and conditions, and is good only for 30 Days from date of quotation.<br>
                                            <ol>
                                                <li>
                                                    All orders tendered to MSR-FSR are subject to credit approval and final acceptance by MSR-FSR<br>
                                                    MSR-FSR reserves the right to refuse any order tendered pursuant to this quotation without incurring any liability because of such refusal.
                                                </li>
                                                <li>
                                                    MSR-FSR guarantees to the purchaser that all goods sold pursuant to an accepted purchase order(s) shall conform to MSR-FSR process specifications and shall be free from defects in materials and workmanship. MSR-FSR expressly disclaims all other warranties, whether express, implied or statutory, including the warranty of merchantability and fitness for use.<br>
                                                    In no event will MSR-FSR be liable for consequential damages arising out of the use of the products described herein.
                                                </li>
                                                <li>MSR-FSR will use its reasonably best efforts to expedite the delivery of any goods sold: however, MSR-FSR does not guarantee any specific delivery date nor assume any responsibility for delays due to any cause beyond the control of MSR-FSR.</li>
                                                <li>Prices indicated are good for thirty (30) days from date of this quotation and based on quantities specificed unless otherwise noted.</li>
                                                <li>Prices are in USD unless specified otherwise. If services are provided outside of the US and in USD, pricing may be adjusted based on foreign currency effects.</li>
                                                <li>This quote is based on a projected process flow derived from best known methods, and may require re-negotiation and change based on subsequent validation results or process changes. </li>
                                            </ol>
                                        </small>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="table  no-border" width="100%">
                            <tbody>
                                <tr>
                                    <td colspan="5" width="60%"></td>
                                    <td colspan="2">Respectfully submitted,</td>
                                </tr>
                                <tr>
                                    <td colspan="5" width="60%"></td>
                                    <td width="20%" style="border-bottom: 1px solid #000 !important;">
                                        @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                                    </td>
                                    <td width="30%" style="border-bottom: 1px solid #000 !important;">
                                        @Html.EditorFor(model => model.TitleSubmit, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.TitleSubmit, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="5" width="60%"></td>
                                    <td width="20%" class="line-caption">Created By</td>
                                    <td width="30%" class="line-caption">Title</td>
                                </tr>
                                <tr>
                                    <td colspan="5" width="60%"></td>
                                    <td colspan="2" width="40%" style="border-bottom: 1px solid #000 !important;">
                                        @Html.EditorFor(model => model.AddressSubmit, new { htmlAttributes = new { @class = "form-control", style = "width:100%" } })
                                        @Html.ValidationMessageFor(model => model.AddressSubmit, "", new { @class = "text-danger" })
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="5" width="60%"></td>
                                    <td colspan="2" width="40%" class="line-caption">Address</td>
                                </tr>
                                <tr>
                                    <td colspan="5" width="60%"></td>
                                    <td colspan="2" width="40%">MSR-FSR LLC</td>
                                </tr>
                            </tbody>
                        </table>
                        <input type="submit" id="submit" class="pull-right btn btn-success fa fa-send" style="margin-left: 10px;" data-toggle="tooltip" data-placement="top" title="" data-original-title="Save and Send Quote to Client" value="Save &amp; Submit" />
                        <a class="pull-right btn btn-danger fa" style="margin-left: 10px;" href="~/ProductionPlanning">Cancel</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section scripts{

    <script type="text/javascript" src="~/assets/js/moment.min.js"></script>
    <script type="text/javascript" src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="~/assets/js/dataTables.bootstrap.min.js"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script type="text/javascript">

        $(document).ready(function () {

            $('.datepicker').datetimepicker();

            $('.dateSelecter').click(function (parameters) {
                $(this).closest('td').find('.datepicker').focus();
            });

            var i = 1;

            $("#add_row").click(function () {

                $('#row' + i).html("<td>" + (i + 1) + "</td><td><input type='text' name='QuoteItems[" + i + "].Quantity' class='form-control' /></td><td><input type='text' name='QuoteItems[" + i + "].Description' " +
                    "class='form-control'/></td><td><input type='text' name='QuoteItems[" + i + "].LeadTime' class='form-control'/></td><td><input type='text' name='QuoteItems[" + i + "].CustomerPartNo' " +
                    "class='form-control'/></td><td><input type='text' name='QuoteItems[" + i + "].Price' class='form-control'/></td><td><input type='text' name='QuoteItems[" + i + "].Extension' class='form-control'/></td>");
                $('#quote_items').append('<tr id="row' + (i + 1) + '" ></tr>');

                i++;
            });

            $("#delete_row").click(function () {
                if (i > 1) {
                    $("#row" + (i - 1)).html('');
                    i--;
                }
            });
        });
    </script>
}