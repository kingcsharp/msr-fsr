@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Files";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Files
                @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGridFiles"></table>
                <div id="jqGridPagerFiles"></div>
            </div>
        </div>
        <div class="row">
            <a href="@Url.Action("Add","Files")" class="btn btn-success help-btn">Add</a>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")

    <script type="text/javascript" src="~/assets/js/grids/files.js"></script>
  
}