@model Msr.Services.Documents.ViewModels.SaveDocumentViewModel
@{
    ViewBag.Title = "Create";
}
<link href="~/assets/textformater/general.css" rel="stylesheet" />
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Add Document @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-10">
                @using (Html.BeginForm("Create", "Documents", FormMethod.Post, new { @class = "form form-horizontal", @onSubmit = "escapeAllSelects();;", @name = "editForm", @target = "", @action = "" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="ReferenceFiles" name="ReferenceFiles" value="" />
                    <div class="form-horizontal">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Id, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.Id, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Rev, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.Rev, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.Rev, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Company, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.Company, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                @Html.ValidationMessageFor(model => model.Company, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ReferenceFiles, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                <div style="width: 100%; float: left;">
                                    <table id="tblRefrencefile" class="table table-bordered"></table>
                                </div>
                                <span class="btn btn-success btn-default" data-call-back-id="ReferenceFiles"  data-toggle="modal" data-target="#select-images">Upload File</span>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Comments, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.Partial("_TextAdder")
                                @Html.TextAreaFor(model => model.Comments, new { onBlur = "checkMaxSize(this, 4000);;lastTextArea = 'document.editForm.Comments';", name = "Comments", rows = "10", cols = "80", @class = "text-formatter form-control", })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.ApprovalStatus, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.ApprovalStatus, Model.ApprovalStatusList, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.ApprovalStatus, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.Roles, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-5">
                                @Html.DropDownListFor(model => model.Roles, Model.ListRoles, new { @class = "form-control", multiple = "multiple" })
                                @Html.ValidationMessageFor(model => model.Roles, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-offset-2 col-md-5">
                                <input type="submit" value="Submit" class="btn btn-success" style="height: 35px;" />
                                @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-warning" })
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/textformater/ValidateDocumentSubmit.js"></script>
    <script src="~/assets/textformater/textformatter.js"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script type="text/javascript">
        var ary = [];
        $(document).ready(function () {


            $(".selectroles").select2({
                tags: true,
                multiple: true
            });

            $('#select-images').on('show.bs.modal',
                function (event) {

                    var button = $(event.relatedTarget);
                    var callBackId = button.data('call-back-id');
                    var modal = $(this);

                    $.ajax({
                        type: "GET",
                        url: '/Files/GetFiles?callBackId=' + callBackId,
                        dataType: 'html',
                        success: function (data) {
                            modal.find('.modal-body').html(data);
                        },
                        error: function () {

                        }
                    });

                });
        });


        function deletefile(element) {

            var callBackId = element;
            // alert(val);
            eModal.confirm('Do you really want to Remove ' + callBackId + ' ?', 'Confirmation delete')
                .then(confirmCallback, optionalCancelCallback);

            function confirmCallback() {
                var row = $(element).closest("tr");
                var name = $("td", row).eq(0).html();

                var tblRefrencefile = $("#tblRefrencefile")[0];

                tblRefrencefile.deleteRow(row[0].rowIndex);


                ary.splice($.inArray(element, ary), 1);
                $('#ReferenceFiles').val(ary);

            }

            function optionalCancelCallback() {
            }
        }

        function SelectIds() {

            $(".selected-file").each(function (index) {

                if ($(this).is(":checked")) {
                    var ids = $(this).val().split('|');

                    var callBackId = $(this).closest(".modal-body").find('#target-control-id').val();
                    var tblRefrencefile = $("#tblRefrencefile");
                    if (ary.length > 0) {

                        if ($.inArray(ids[0], ary) != -1) {

                        }
                        else {
                            var imageUrl;
                            var deleteUrl;

                            ary.push(ids[0]);
                            $('#ReferenceFiles').val(ary);
                            var items = ids[1].split('.').pop();

                            switch (items) {

                                case 'xls':
                                    imageUrl = '<a title="Download" href="/Doc/Download?Id="' + ids[0] + '><img src="/assets/img/icon-xls.png" /></a>';
                                    deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                    break;

                                case 'jpg':
                                case 'png':
                                case 'jpeg':
                                case 'gif':
                                    imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/jpg.png" /></a>';
                                    deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                    break;

                                case 'docx':
                                    imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/icon-doc.png" /></a>';
                                    deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                    break;

                                case 'pdf':
                                    imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/icon-pdf.png" /></a>';
                                    deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                    break;

                                case 'xlsx':
                                    imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/icon-xls.png" /></a>';
                                    deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                    break;

                                case 'txt':
                                    imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/txt.png" /></a>';
                                    deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                    break;

                                default:
                                    imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/default.png" /></a>';
                                    deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                    break;
                            }

                            var tr = $("<tr></tr>");
                            tr.html(("<td class='hidden'>" + ids[0] + "</td>") + "" + ("<td>" + ids[1] + "</td>") + " " + ("<td>" + imageUrl + "</td>") + " " + ("<td>" + deleteUrl + "</td>"));
                            tblRefrencefile.append(tr);

                        }
                    }

                    else {
                        $('#' + callBackId + '').append($('<option></option>').val(ids[0]).html(ids[1]));
                        var items = ids[1].split('.').pop();

                        switch (items) {
                            case 'xls':
                                imageUrl = '<a title="Download" href="/Doc/Download?Id= ' + ids[0] + '"><img src="/assets/img/icon-xls.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;

                            case 'jpg':
                            case 'png':
                            case 'jpeg':
                            case 'gif':
                                imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/jpg.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;

                            case 'docx':
                                imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/icon-doc.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;

                            case 'pdf':
                                imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/icon-pdf.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;

                            case 'xlsx':
                                imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/icon-xls.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;

                            case 'txt':
                                imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/txt.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;

                            case 'zip':
                                imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/icon-zip.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;

                            case 'ppt':
                                imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/icon-ppt.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;
                            default:
                                imageUrl = '<a title="Download" href="/Doc/Download?Id=' + ids[0] + '"><img src="/assets/img/default.png" /></a>';
                                deleteUrl = '<span onclick="deletefile(this);" style="color:#ff0000"><i class="icon fa fa-trash-o"></i></span>';
                                break;
                        }

                        var tr = $("<tr></tr>");
                        tr.html(("<td class='hidden'>" + ids[0] + "</td>") + "" + ("<td>" + ids[1] + "</td>") + " " + ("<td>" + imageUrl + "</td>") + " " + ("<td>" + deleteUrl + "</td>"));
                        tblRefrencefile.append(tr);
                        ary.push(ids[0]);
                        $('#ReferenceFiles').val(ary);
                    }
                }
            });
            $('.closeClick').click();

        }

    </script>
}
