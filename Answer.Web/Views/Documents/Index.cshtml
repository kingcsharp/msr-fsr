@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel
@{
    ViewBag.Title = "Documents";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                <span class="icon fa fa-file-text"></span>
                Documents @Html.Partial("_HelpViewButton")
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jq-grid-documents"></table>
                <div id="jq-grid-pager"></div>
            </div>
        </div>
        <div class="row row-bottom-buttons">
            <a href="/Documents/Create" class="btn btn-success help-btn">Add</a>
            <button type="button" id="clear-state" class="btn btn-success help-btn">Clear State</button>
        </div>
    </div>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/js/jqgrid")
    @Scripts.Render("~/bundles/js/jqgrid-documents")

    <script type="text/javascript">
        var hasAdministratorRole = '@User.IsInRole("Administrators")' === "True";

        $(document).ready(function () {

            Msr.DocumentsGrid.LoadDocumentsGrid('@Url.Action("DocumentsData", "Documents")');
        });
    </script>
}
