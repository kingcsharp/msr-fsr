@*@model  Msr.Web.ViewModel.Engineering.EngineeringViewModel*@
@model Msr.Services.Procedures.ViewModels.GetMoniterViewModel
@{
    ViewBag.Title = "Monitors";
    ViewBag.ObjectId = Request.Url.OriginalString.Substring(Request.Url.OriginalString.LastIndexOf("/") + 1);
}

<link rel="stylesheet" type="text/css" href="~/assets/css/people.css">
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">
                Monitors <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button>
            </h2>
            <div class="col-lg-12">
                @Html.Partial("Message")
                <table id="jqGrid" name="jqGrid"></table>
                <div id="jqGridPager"></div>
            </div>
        </div>
        <div class="row">
            <a href="@Url.Action("Add", "ProcedureMonitors", new {Id = ViewBag.ObjectId })" class="btn btn-success">Add</a>
            <a value="Re-Order Now Based On Latest Monitor" class="btn btn-success">Re-Order Now Based On Latest Monitor</a>
        </div>
    </div>
</div>
@section scripts
{
    <script src="~/assets/js/plugins/bootstrap3/bootstrap-dialog.min.js"></script>
    <script type="text/javascript" src="~/assets/js/i18n/grid.locale-en.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.jqGrid.min.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.mockjax.js"></script>
    <script src="//cdn.rawgit.com/noelboss/featherlight/1.6.1/release/featherlight.min.js" type="text/javascript" charset="utf-8"></script>
    <script src="https://cdn.smooch.io/smooch.min.js"></script>
    <script src="~/assets/js/grids/procedure-monitors.js"></script>
    <script type="text/javascript">
      
        $(document).ready(function () {
          
            LoadProcedureMonitorGrid('@Url.Action("ProcedureMonitorsData", "ProcedureMonitors",new { objectId = ViewBag.ObjectId })','@Request.Url.OriginalString');
        });


    </script>
}
