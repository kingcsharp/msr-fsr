{
  "name": "light-blue",
  "version": "7.1.2",
  "description": "Light Blue - Angular 4 & React Dashboard",
  "scripts": {
    "install": "napa",
    "ng": "ng",
    "start": "nswag run && ng serve",
    "startdev": "nswag run /runtime:NetCore21 && ng serve --configuration dev",
    "nswag": "nswag run",
    "build": "nswag run && ng build",
    "builddev": "ng build --configuration=dev",
    "builduat": "ng build --configuration=uat",
    "builddevprodsetting": "ng build --prod --configuration=dev",
    "builduatprodsetting": "ng build --prod --configuration=uat",
    "buildprod": "ng build --prod --configuration=prod",
    "test": "ng test",
    "lint": "ng lint",
    "fixlint": "ng lint -- --fix",
    "cypress": "./node_modules/.bin/cypress open",
    "cypress:test": "concurrently \"npm run start\" \"npm run cypress:wait\"",
    "cypress:wait": "wait-on http://localhost:3000/ && npm run cypress -env configFile=local"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "11.2.14",
