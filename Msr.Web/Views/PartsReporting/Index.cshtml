@model Msr.Web.ViewModel.PartsReportsViewModel
@{
    ViewBag.Title = "Parts Monitor Trending";
}
<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">Parts Monitor Trending <button class="btn btn-info help-btn pull-right" data-toggle="modal" data-target="#wipHelpModal">Help</button></h2>
            <div class="col-md-3 col-sm-12">
                @using (Html.BeginForm("Index", "PartsReporting", FormMethod.Post, new { @class = "form form-horizontal", role = "form", id="report-form" }))
                {
                    <fieldset>
                        <legend>Monitor Criteria</legend>

                        <div class="form-group">
                            <label class="control-label col-md-4" for="search-type">Report Type<span class="error"></span></label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.ReportTypeId, Model.ReportTypes, new {@class = "form-control"})
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-4" for="search-type">Report by<span class="error"></span></label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.SearchById, Model.ReportByItems, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group" id="container-serial">
                            <label class="control-label col-md-4" for="serial">Serial<span class="error"></span></label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.Serial, Model.Serials, new {@class = "form-control"})
                            </div>
                        </div>

                        <div class="form-group" id="container-number">
                            <label class="control-label col-md-4" for="number">Part<span class="error"></span></label>
                            <div class="col-md-8">
                                @Html.DropDownListFor(m => m.Number, Model.PartNumbers, new { @class = "form-control" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="control-label col-md-6" for="monitors" data-toggle="tooltip" data-placement="right" data-html="true" title="" data-original-title="Updated dynamically based on your selections above">Select Monitor</label>
                            <div class="col-md-6">
                                @Html.DropDownListFor(m => m.MonitorId, new List<SelectListItem>(), new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label col-md-6" for="range">Date Range</label>
                            <div class="col-md-6">
                                @Html.DropDownListFor(m => m.DateRangeId, Model.DateRangeItems, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12">
                                <input type="button" name="orgeditsubmit" class="btn btn-primary pull-right" id="submit-report" value="Submit">
                            </div>
                        </div>
                    </fieldset>
                }
            </div>
            <div class="col-md-9 col-sm-12" id="report-data"></div>
        </div>
    </div>
</div>

@section scripts
{

    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="~/assets/js/monitor_chart.js"></script>

    <script type="text/javascript">

        $(document).ready(function() {

            $('#submit-report').prop('disabled', true);

            $('#container-serial').hide();
            $('#container-number').hide();

            $('#container-serial').on('change', function () {
                GetMonitors();
            });

            $('#container-number').on('change', function () {
                GetMonitors();
            });

            $('#SearchById').on('change', function () {

                if ($(this).val() === '1') {
                    $('#container-number').show();
                    $('#container-serial').hide();

                } else if ($(this).val() === '2') {
                    $('#container-serial').show();
                    $('#container-number').hide();
                }

            });

            $('#ReportTypeId').on('change', function() {
                GetMonitors();
            });

            $(".js-programmatic-set-val").on("click", function() {
                $(this).val("CA").trigger("change");
            });

            $("#MonitorId").on('change', function() {
                if ($(this).val().length > 0) {
                    $('#submit-report').prop('disabled', false);
                }
            });

            $('#submit-report').on('click', function(e) {

                e.preventDefault();

                var form = $('#report-form').serialize();

                $.ajax({
                    type: "POST",
                    url: '/PartsReporting/Index',
                    data: form,
                    dataType: 'html',
                    success: function(data) {
                        $('#report-data').html(data);
                    },
                    error: function() {

                    }
                });

            });

        });

        function GetMonitors(input) {

            var input = '';

            if ($('#SearchById').val() === '1') {
                input = $('#Number').val();
            } else if ($('#SearchById').val() === '2') {
                input = $('#Serial').val();
            }

        var type = $('#SearchById').val();
        var reportTypeId = $('#ReportTypeId').val();

        var $monitor = $("#MonitorId");
        $monitor.empty();

        $('#submit-report').prop('disabled', true);

        if (input.length > 0) {

            $.ajax({
                type: "POST",
                url: '/PartsReporting/GetMonitors?input=' + input + '&type=' + type + '&reportTypeId=' + reportTypeId,
                dataType: 'json',
                success: function(response) {

                    if (response.length > 0) {

                        $monitor.select2({
                            data: response
                        });
                    }
                },
                error: function() {

                }
            });
        } else {
        }
    }

    </script>


}
