@model  Msr.Services.Tasks.Messaging.MonitorHistoryResponse

<h4>Monitors - Work Order #110458</h4>
<table class="table table-bordered">
    <tr>
        <td>MSR-FSR IRE</td>
        <td>Actual Part # 110465, s/n:Kit 12, CLND_CO_REX_SS_KIT (p/n:93491)</td>
    </tr>
</table>



<table class="table table-bordered monitor-tabel">

    @foreach (var task in Model.MonitorItem)
    {
        <thead>
        <tr>
            <th colspan=3>@task.Description</th>
        </tr>
        <tr>
        <th>Monitor 111771</th>
        <th>Result</th>
        <th>Pass/Fail</th>
        </thead>
    <tbody>
    @foreach (var monitor in task.MonitorResults)
    {
        <tr>
            <td>@monitor.Description</td>
            <td>@monitor.UseResult</td>
            <td>@monitor.YesNoAnswer</td>
        </tr>
    }
    </tbody>
    }

</table>
