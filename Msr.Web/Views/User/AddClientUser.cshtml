@model List<Msr.Models.Orders.UserView>
@{
    ViewBag.Title = "Home Page";
}

<link rel="stylesheet" type="text/css" href="/assets/css/themes/flat-blue.css">

<link rel="stylesheet" type="text/css" href="/assets/css/style.css">
<link rel="stylesheet" type="text/css" href="/assets/css/hopscotch.css">

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <h2 class="page-header">Add Client User</h2>
            <div class="col-lg-10">
                
                @using (Html.BeginForm("AddClientUser", "User", FormMethod.Post, new {@class = "form form-horizontal", role = "form"}))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UserId" value="@ViewBag.UserId"  />


                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th></th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>User Name</th>
                                <th>Role</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <th scope="row"><input type="checkbox" name="usderIds" value="@Model[i].Id"></th>
                                    <td>@Model[i].FirstName</td>
                                    <td>@Model[i].LastName</td>
                                    <td>@Model[i].UserName</td>
                                    <td>@Model[i].RoleName</td>
                                </tr>
                            }
                        </tbody>
                    </table>


                    <div class="form-group">
                        <label class="col-md-2 control-label"></label>
                        <div class="col-md-8 inputGroupContainer">
                            <div class="input-group">
                                <button type="submit" class="btn btn-success">Submit<span class="fa sa-send"></span></button>
                                <a href="~/user/edituser/@ViewBag.UserId" class="btn btn-default">Cancel</a>
                            </div>
                        </div>
                    </div>

                }
            </div>
        </div>
    </div>
</div>





@section scripts
{


        
}

