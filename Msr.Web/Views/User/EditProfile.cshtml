@model Msr.Web.ViewModel.EditUserProfileViewModel
@{
    ViewBag.Title = "Edit User Profile";
}

<div class="container-fluid">
    <div class="side-body padding-top">
        <div class="row">
            <div class="col-lg-12">
                <section class="panel">
                    <header class="panel-heading tab-bg-info">
                        <ul class="nav nav-tabs profile-tabs">
                            <li class="">
                                <a  href="~/user/profile">
                                    <i class="icon-user"></i>
                                    My Profile
                                </a>
                            </li>
                            <li class="active">
                                <a data-toggle="tab" href="#edit-profile">
                                    <i class="icon-envelope"></i>
                                    Edit Profile
                                </a>
                            </li>
                        </ul>
                    </header>
                    <div class="panel-body">
                        <div class="tab-content">
                            <div id="profile" class="tab-pane profile-tab  animated fadeInDown">
                               
                            </div>
                            <div id="edit-profile" class="tab-pane profile-tab  active animated fadeInDown">
                                <section class="panel">
                                    <div class="panel-body bio-graph-info">
                                        <h1>Edit Profile Info</h1>

                                        @using (Html.BeginForm("EditProfile", "User", FormMethod.Post, new {@class = "form form-horizontal", role = "form"}))
                                        {
                                            @Html.AntiForgeryToken()
                                            <div class="form-group">
                                                <label class="col-lg-2 control-label">First Name</label>
                                                <div class="col-lg-6">
                                                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "First Name" })
                                                    @Html.ValidationMessageFor(m => m.FirstName)
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-lg-2 control-label">Last Name</label>
                                                <div class="col-lg-6">
                                                    @Html.TextBoxFor(m => m.LastName, new {@class = "form-control", placeholder = "First Name"})
                                                    @Html.ValidationMessageFor(m => m.LastName)
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-lg-2 control-label">Email</label>
                                                <div class="col-lg-6">
                                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "First Name" })
                                                    @Html.ValidationMessageFor(m => m.Email)
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-lg-2 control-label">Phone</label>
                                                <div class="col-lg-6">
                                                    @Html.TextBoxFor(m => m.Phone, new {@class = "form-control", placeholder = "First Name"})
                                                    @Html.ValidationMessageFor(m => m.Phone)
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-lg-2 control-label">Phone2</label>
                                                <div class="col-lg-6">
                                                    @Html.TextBoxFor(m => m.Phone2, new { @class = "form-control", placeholder = "First Name" })
                                                    @Html.ValidationMessageFor(m => m.Phone2)
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="col-lg-offset-2 col-lg-10">
                                                    <button type="submit" class="btn btn-primary">Save</button>
                                                    <a href="~/user/profile" class="btn btn-danger">Cancel</a>
                                                </div>
                                            </div>
                                        }
                                        
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>


@section scripts
{
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
}
